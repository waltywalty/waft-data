  <div class="hero-next" id="heroNext"></div>
</div>

<!-- SIX-LINE SUMMARY
     Directly under the countdown and above every card, because the whole point
     is to be readable without scrolling. It ships EMPTY rather than pre-rendered
     with plausible values: this bar's only claim is that each line is what its
     card currently says, and a baked line would be the one thing on the page
     that can be true-looking and unowned. -->
<section class="sum" id="sumBar" data-rail="Summary" aria-label="Six-line summary">
  <div class="sum-body" id="sumBody"><div class="sum-row" data-k="clock"><div class="sum-lab">Session</div><div class="sum-fig">5.6h</div><div class="sum-txt">European hours — that long until the New York open</div></div><div class="sum-row warn" data-k="tone"><div class="sum-lab">Risk</div><div class="sum-fig">+20</div><div class="sum-txt">Mixed to Constructive · the missing weight spans both · ±10 on missing weight · spans +10 to +30</div></div><div class="sum-row" data-k="kz"><div class="sum-lab">Levels</div><div class="sum-fig">0.4×</div><div class="sum-txt"><b>neither side close</b> — Neither pool is inside a typical move.</div></div><div class="sum-row" data-k="plan"><div class="sum-lab">Plan</div><div class="sum-fig">0/2</div><div class="sum-txt">nothing armed — 2 still waiting, 0 decided against in advance · 2 actionable of 2</div></div><div class="sum-row" data-k="feed"><div class="sum-lab">Feed</div><div class="sum-fig">12m</div><div class="sum-txt">freshest around-the-clock quote is that old — the feed is behaving</div></div><div class="sum-row" data-k="next"><div class="sum-lab">Next</div><div class="sum-fig">—</div><div class="sum-txt">nothing left on this week’s calendar</div></div></div>
  <div class="sum-note" id="sumNote">Each line is published by the card that owns it, not recomputed here — so this bar cannot disagree with the board below it.</div>
</section>

<!-- COMPOSITE SENTIMENT -->
<!-- THE DECK — every content card, in one container so the desktop layout has
     something to flow. The chrome above it (masthead, rail, feed bar, health
     banner, countdown, summary) stays full width at every size, because those
     are the things a reader looks at once per visit and they read worse split
     into a column. -->
<div class="deck">
<div class="tone" id="toneCard" data-rail="Sentiment">
  <div class="tone-lab">Composite sentiment</div>
  <div class="tone-fig" id="toneFig" style="color: var(--text-muted);">+20</div>
  <!-- The uncertainty the missing weight buys, in its own element: toneFig's
       textContent is read by sentedge and verify as THE number, and appending
       to it would quietly change what those two are asserting about. -->
  <div class="tone-pm" id="tonePm">±10 on missing weight · spans +10 to +30</div>
  <div class="tone-band" id="toneBand" style="color: var(--warning);">Mixed to Constructive · the missing weight spans both</div>
  <div class="dbar"><span class="mid"></span><span class="fill" id="toneFill" style="width: 10%; left: 50%; background: var(--div-pos); opacity: 0.35;"></span></div>
