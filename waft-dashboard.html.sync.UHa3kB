/td></tr><tr><td>5Y</td><td>4.37</td><td>4.38</td><td>4.45</td><td>4.40</td><td>4.33</td><td>4.33</td><td>4.40</td><td>4.35</td><td>4.41</td><td>4.39</td><td>4.38</td><td>4.32</td><td>4.36</td><td>4.38</td><td>4.37</td><td>4.35</td><td>4.39</td><td>4.43</td><td>4.41</td><td>4.35</td><td>4.37</td></tr><tr><td>10Y</td><td>4.67</td><td>4.68</td><td>4.75</td><td>4.70</td><td>4.63</td><td>4.63</td><td>4.69</td><td>4.65</td><td>4.72</td><td>4.70</td><td>4.68</td><td>4.63</td><td>4.68</td><td>4.72</td><td>4.71</td><td>4.65</td><td>4.69</td><td>4.74</td><td>4.70</td><td>4.64</td><td>4.66</td></tr><tr><td>30Y</td><td>5.20</td><td>5.21</td><td>5.27</td><td>5.23</td><td>5.18</td><td>5.17</td><td>5.22</td><td>5.19</td><td>5.25</td><td>5.24</td><td>5.24</td><td>5.21</td><td>5.25</td><td>5.31</td><td>5.28</td><td>5.19</td><td>5.23</td><td>5.27</td><td>5.23</td><td>5.17</td><td>5.18</td></tr><tr><td>2s10s</td><td>+0.45</td><td>+0.45</td><td>+0.47</td><td>+0.45</td><td>+0.43</td><td>+0.45</td><td>+0.44</td><td>+0.46</td><td>+0.47</td><td>+0.48</td><td>+0.48</td><td>+0.48</td><td>+0.51</td><td>+0.53</td><td>+0.52</td><td>+0.46</td><td>+0.50</td><td>+0.50</td><td>+0.46</td><td>+0.47</td><td>+0.47</td></tr></tbody></table></div>
