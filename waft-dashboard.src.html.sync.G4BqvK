/* ---------------------------------------------------------------
   PACE — the one divisor behind every "×30m" on this page.

   Three generators publish a field called `t30`, and for a while three cards
   divided by three different ones. On 31 July the ladder said a level was
   8.4× away and the liquidity map said 14.1× — the same level, the same
   instant, the same page. Both were arithmetically correct: the ladder divided
   by the 53-hour all-hours median (6.20) and the map by the median of the last
   eight hours (3.7). Each card explained its own divisor in its own footnote
   and neither footnote mentioned the other, so a reader with both open had no
   way to discover they were being answered in different units.

   Auditing it against the bars turned up why the third number existed at all:
   reach.py sliced SEVEN bars and gap-checked six, so its "t30" was a
   thirty-FIVE minute range shipped under a thirty-minute name, running 6–18%
   wide on RTY and ~8% on ES. With the window corrected all three generators
   agree wherever they measure the same quantity — MOVES.t30 6.20 is REACH.ALL
   6.20, MOVES.rth 13.60 is REACH.RTH 13.60 — which is the evidence that the
   spread was one bug plus one real distinction, not three methods drifting.

   The real distinction is the session, and it is large: RTY covers a median
   13.6 points in a cash-session half hour and 4.7 in an Asian one. An
   all-hours median of 6.20 describes neither. The trailing-eight-hours window
   describes whichever sessions happen to land in it — this morning that is
   eight hours of Asian trade, but at 14:00Z the identical window is half
   European and half cash open and means nothing in particular. So the divisor
   is the measured pace of the session the clock is actually in, and every card
   uses this function to get it.

   What that buys, beyond consistency: the ladder now changes at the bell. A
   level thirteen points out is nearly three typical moves away overnight and
   one after the open, and until now the ladder showed the same × at 3am as at
   9:31. Distance did not change; reach did. That is the whole point of the
   column.

   The "is today unusual" question that the trailing window was really
   answering has not been dropped — it is answered properly by decPace on the
   decision board, which compares the last hour's realised travel against this
   session's own expectation with the right time-scaling. A regime check is a
   different thing from a divisor, and it stops being able to contradict
   anything once it is no longer dividing.
   --------------------------------------------------------------- */
var PACE_MINN = 12;      /* under twelve clean windows is not a median, it is an anecdote */
var PACE_LIVE = null;    /* per-session t30 recomputed from the live bar feed, when there is one */

function pace(sym, atMs){
  var s = sessAt(atMs == null ? Date.now() : atMs);
  var lv = PACE_LIVE && PACE_LIVE[sym] && PACE_LIVE[sym][s];
  if (lv && lv.v > 0 && lv.n >= PACE_MINN)
    return { v:lv.v, sess:s, n:lv.n, src:"live", sub:false };
  var R = REACH[sym];
  if (R && R.t30 && R.t30[s] > 0)
    return { v:R.t30[s], sess:s, n:(R.t30n && R.t30n[s]) || null, src:"archive",
             sub:false };
  /* THE SESSION IS IN THE TABLE AND HAS NO SAMPLE. REFUSE. (DECISIONS.md D15)
     This used to fall through to the all-hours line below and come back marked
     sub:true, which put a number beside a session name that the session had no
     part in. HSI's RTH and EVE are the case: Hong Kong is shut for both, 1,434
     samples in RTH across the quote archive with not one price change, so there
     is no pace to measure rather than a thin one.
     A labelled substitution still shows the figure, and the figure is what a
     reader takes away at a glance while the label is what gets skipped. Two
     multiples of an all-hours median is not two multiples of anything that
     happens in a US session, because nothing happens in a US session.
     Returning null drops the × wherever it would have been drawn; every caller
     already guards on !p or !(p.v > 0). paceGap() below says WHY, so the
     absence is a statement rather than a blank. */
  if (R && R.t30 && R.t30.hasOwnProperty(s) && R.t30[s] === null) return null;
  /* No session table at all — a symbol the archive has never bucketed by
     session. Fall back to the all-hours figure and mark it, because a footnote
     that does not admit the fallback is how a guess starts reading like a
     measurement. This is a DIFFERENT case from the refusal above: there, the
     table exists and this session is empty; here, there is no table to ask. */
  var mv = MOVES[sym];
  if (mv && mv.t30 > 0)
    return { v:mv.t30, sess:s, n:mv.n || null,
             src:(mv.src === "est" ? "est" : "allhours"), sub:true };
  return null;
}

/* Why there is no × right now, in one sentence, or "" if there is one. Kept
   apart from pace() so the refusal does not have to travel through every
   caller as a special shape — they all handle a null pace already. */
function paceGap(sym, atMs){
  var s = sessAt(atMs == null ? Date.now() : atMs);
  var R = REACH[sym];
  if (!R || !R.t30 || !R.t30.hasOwnProperty(s) || R.t30[s] !== null) return "";
  var L = LADDERS[sym] || { label:sym };
  var n = (R.t30n && R.t30n[s]);
  return 'No <b>&times;</b> figures during <b>' + (SESSNAME[s] || s) + '</b>. ' +
         L.label + '&rsquo;s pace is measured per session, and this one has ' +
         (n ? 'only ' + n + ' clean windows' : 'no sample at all') +
         ' &mdash; its market is shut for the whole of it. The all-hours median ' +
         'would divide by a number from other hours and print it under this ' +
         'session&rsquo;s name, so the distances are given in points only until ' +
         'the market that sets them reopens.';
}

var SESSNAME = { RTH:"the US cash session", EUR:"European hours",
                 EVE:"the post-close hour", ASIA:"Asian hours" };
/* The same four names without the articles, for headers and tags where the
   sentence form does not fit. Two maps, one place — so a session cannot be
   called one thing in a footnote and another in the header above it. */
var SESSTAG  = { RTH:"cash session", EUR:"European hours",
                 EVE:"post-close hour", ASIA:"Asian hours" };

/* One sentence, written once, printed by every card that shows a × figure. The
   two footnotes it replaces each justified a different divisor in different
   words, which is precisely how the page came to disagree with itself without a
   single line of arithmetic being wrong. */
/* The archive's depth, from the block rather than from memory. It was the
   string "53-hour" sitting between two figures that ARE read from REACH — the
   median and the window count — so one sentence carried two measurements and a
   recollection, in the footnote whose entire purpose is to disclose the
   divisor. A reader has no way to tell which of three numbers is the stale one. */
function archTxt(sym){
  var h = REACH[sym] && REACH[sym].span_h;
  return h ? ' in the ' + (h >= 10 ? Math.round(h) : h.toFixed(1)) + '-hour archive'
           : ' in the archive';
}
function paceTxt(sym, atMs){
  var p = pace(sym, atMs);
  if (!p) return paceGap(sym, atMs);
  var L = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  var R = REACH[sym], rth = R && R.t30 && R.t30.RTH, asia = R && R.t30 && R.t30.ASIA;
  var s = 'The <b>&times;</b> figures are distances in typical 30-minute moves. The divisor is ' +
          'the measured pace of <b>the session the clock is in</b>, not an all-hours average: ' +
          L.label + ' does not move at one speed, and a median that blends a dead overnight ' +
          'hour with the New York open describes neither of them. Right now that is <b>' +
          (SESSNAME[p.sess] || p.sess) + '</b>, where one move is <b>' +
          fmt(p.v, L.dp) + ' ' + L.unit + '</b>';
  if (p.src === "est"){
    s += ' &mdash; <b>estimated</b>, not measured. There is no bar history for this contract in ' +
         'the feed, so this is today’s full range divided by ' + MOVE_RATIO +
         ', the ratio ES and RTY actually show. Treat it as a rough scale.';
  } else if (p.src === "allhours"){
    s += ' &mdash; the <b>all-hours</b> median, because this contract has no session breakdown ' +
         'in the archive. It will read too fast overnight and too slow after the bell.';
  } else {
    s += ' (median of ' + (p.n != null ? p.n : 'the') + ' clean half-hour windows' +
         (p.src === "live" ? ' of live 5-minute bars' : archTxt(sym)) + ')';
    s += p.sub ? ', filled from the all-hours figure because this session is too thin to stand ' +
                 'on its own. ' : '. ';
    if (p.sess === "RTH" && asia > 0)
      s += 'This is the fastest it runs all day &mdash; about <b>' + (p.v / asia).toFixed(1) +
           '&times;</b> its Asian-hours pace. Levels that looked out of reach overnight are not now.';
    else if (rth > 0 && p.v > 0)
      s += 'At the bell that median becomes <b>' + fmt(rth, L.dp) + ' ' + L.unit +
           '</b>, so every &times; here divides by about <b>' + (rth / p.v).toFixed(1) +
           '&times;</b> when the cash session opens. The distance does not change; the reach does.';
  }
  return s + ' Under <b>1&times;</b> is inside normal reach for the next half hour; past <b>2&times;</b> ' +
             'needs a fresh catalyst or a change of session.';
}

/* Built-in snapshot — the payload every card below is written against.
   It lives HERE, in the outer scope with the other data blocks, and not down
   in the live() closure where it started. The ladder resolves its anchor price
   at build-tab time, hundreds of lines before live() is entered; while this was
   a local of live() that lookup could not see it, so liqPx threw and the whole
   ladder card rendered empty. Data the page paints from is page-wide data.
   Regenerated at each brief — replace everything between the SNAP markers. */
/* SNAP-BEGIN */
