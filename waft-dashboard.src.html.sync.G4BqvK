/* Derived, never hand-maintained. Reassigned if the live calendar lands. */
var EVENTS = CATALYSTS.map(function(c){ return { t:c.t, n:c.n, h:c.h }; });

/* ---------------------------------------------------------------
   JUDGEMENT TABLE — the half of the catalyst board that is mine.

   The relay now publishes latest/calendar.json: what is scheduled,
   when, and the consensus impact rating. That is fact and it
   refreshes itself, so the board can no longer run dry.

   What a calendar feed cannot tell you is which contract an event
   hits, how far it can travel, or why it matters. That is this
   table. Each entry matches a release by name and supplies the
   judged half. First match wins, so specific patterns come first.

   An event with no match still renders — with a default multiplier
   and a line saying so out loud. A default dressed up as a call is
   the failure mode worth avoiding here.
   --------------------------------------------------------------- */
var CCY_SYM = { USD:"RTY", EUR:"ES", GBP:"ES", JPY:"HSI", CNY:"HSI" };

/* `arg` is the sign of the EQUITY move that an actual above forecast argues for.
   -1 is the hawkish reading: a hot number takes the cut out of the curve and
   the rate-sensitive index wears it. +1 is the cycle reading: growth and
   confidence surveys, where the expansion matters more than what it does to
   rates. 0 is "no number to beat", and a speech is never scored as though there
   were one.

   It is FIRST ORDER and it is REGIME-DEPENDENT, and the landed board says both
   out loud. Monotone: mild labour weakness is rate relief and severe labour
   weakness is a growth scare, so this map is wrong in the tails by
   construction -- the entry below for the jobs report says as much in its own
   `cold` line. Regime: every -1 here rests on this tape trading good news as
   hawkish, which is a judgement with a date on it and not a constant.

   argOv is the exception list, and there is one. Payrolls, hourly earnings and
   the unemployment RATE print in the same instant under a single heading, and
   more jobs is a hot labour market while a higher unemployment rate is a cold
   one. One sign for the group would score one of the three backwards every
   month it ran. */
/* Actuals, curated. The relay's calendar carries a forecast and a prior and NO
   ACTUAL, so without this the landed board can say what the tape did and never
   what it was reacting to.

   catgen.py recovers most of them by itself, one week late: this week's PRIOR
   is last week's ACTUAL, so a recurring release hands over its own missing
   number as soon as the relay publishes the next occurrence. What is left for
   this table is the gap before that arrives, and the releases that never recur.

   Keyed on the event's epoch, which is what catgen emits, because a release
   name repeats every week and a name alone would score three Thursdays of
   claims against one number. `a` is the printed figure as a string, kept in the
   feed's own units so it can sit beside f and p without a conversion nobody
   checked. `src` says where it came from, and the card prints that: a figure
   read off a wire at the time is a different object from one reconstructed
   later, and the difference is exactly the kind of thing that stops mattering
   right up until it matters. */
var CATACT = {
  /* JOLTS, 4 Aug 14:00 UTC. Cited in this board's own ADP paragraph before
     there was anywhere to put it: 7.359M against a 7.400M forecast on the day.
     The relay's forecast field has since moved to 7.44M, which is why the
     surprise is computed against the relay's number and the discrepancy is
     shown rather than reconciled -- two sources disagreeing about what was
     expected is information, and picking one silently throws it away. */
  1785852000: { a:"7.359M", src:"the release, as cited in this board's 5 Aug brief",
                 /* `f` is what THIS PAGE called consensus on the day. The relay's
                    field has since moved to 7.44M. Both are recorded and the card
                    prints the disagreement, because a forecast that changed after
                    the fact is a fact about the forecast, and silently adopting
                    either number would hide it. It moves the size of the miss and
                    not its sign, which is why the verdict is unaffected. */
                 f:"7.400M" }
};

var CATJ = [
  { re:/FOMC (Statement|Economic Projections)|Federal Funds Rate/i, sym:"RTY", x:2.2, imp:3,
    arg:-1,
    n:"FOMC decision",
    why:"The binary everything else in the week is priced around.",
    hotL:"Hold with hawkish language", hotD:-1, coldL:"A cut, or a pre-commitment to one", coldD:1,
    hot:"A hold with hawkish language takes the next cut out of the curve and RTY leads the move down — it is the highest-beta index to the front end.",
    cold:"A cut, or language that pre-commits to one, and the reach is upward with small caps leading." },
  { re:/FOMC Press Conference/i, sym:"RTY", x:1.8, imp:3, n:"Powell press conference",
    arg:0,
    why:"Where the statement's wording gets walked back or hardened. The move that sticks usually starts here, not at the release." },
  { re:/Core PCE Price Index/i, sym:"RTY", x:1.5, imp:3,
    arg:-1,
    why:"The Fed's preferred inflation gauge. This is the number that moves rates, and rates are what move small caps.",
    hotL:"Above consensus", hotD:-1, coldL:"In line or below", coldD:1,
    hot:"Above consensus and the next cut comes out of the curve — RTY reaches the downside pool first.",
    cold:"In line or below is the goldilocks combination and is the one path that reaches the upside pool." },
  { re:/\bCore CPI\b/i, sym:"RTY", x:1.6, imp:3,
    arg:-1,
    why:"The headline the tape trades even though the Fed watches PCE. The core figure is the one that matters; the headline is energy noise." },
  { re:/\bCPI (m\/m|y\/y)\b/i, sym:"RTY", x:1.2, imp:3,
    arg:-1,
    why:"Headline inflation. Moves the front end, but the core print released alongside it is the deciding number." },
  { re:/Non-Farm Employment Change|Average Hourly Earnings|Unemployment Rate/i, sym:"RTY", x:1.9, imp:3,
    n:"US jobs report",
    arg:-1, argOv:[[/Unemployment Rate/i, 1]],
    why:"The month's biggest scheduled move. Payrolls, the unemployment rate and hourly earnings land together, and they can disagree — a strong headline with soft wages is a different trade from both being hot.",
    hotL:"Hot print, firm wages", hotD:-1, coldL:"A weak headline", coldD:0,
    hot:"A hot print with firm wages pushes the cut further out and hits the rate-sensitive index hardest.",
    cold:"A weak headline is only bullish while it stays short of a growth scare. Past that the bid leaves small caps first." },
  { re:/ADP Non-Farm/i, sym:"RTY", x:0.7, imp:2,
    arg:-1,
    why:"A rehearsal for Friday with a poor record of predicting it. Worth watching for the reaction, not the number." },
  { re:/(Advance|Prelim|Final) GDP/i, sym:"RTY", x:1.3, imp:3,
    arg:1,
    why:"Growth rather than inflation, so it moves the cycle trade more than the rate trade — but the quarterly core PCE buried inside the release is what the desk actually reads." },
  { re:/ISM Manufacturing PMI|ISM Services PMI/i, sym:"RTY", x:1.0, imp:3,
    arg:1,
    why:"The cleanest monthly read on whether the domestic economy is expanding. The 50 line is the one the desk reacts to, and small caps are the domestic index." },
  { re:/Unemployment Claims/i, sym:"RTY", x:0.6, imp:2,
    arg:1,
    why:"Weekly and noisy on its own. It matters when it confirms a turn the monthly data has already hinted at." },
  { re:/Retail Sales/i, sym:"RTY", x:0.9, imp:3,
    arg:1,
    why:"The consumer, who is most of the economy. The control group inside it is the figure that feeds GDP." },
  { re:/JOLTS Job Openings|Employment Cost Index/i, sym:"RTY", x:0.7, imp:2,
    arg:-1,
    why:"Slower-moving labour data. Rarely the move on its own, often the thing that makes a later print land harder." },
  { re:/(CB )?Consumer Confidence|UoM Consumer Sentiment/i, sym:"RTY", x:0.5, imp:2,
    arg:1,
    why:"Survey data. It moves the tape when it diverges sharply from the hard data, not otherwise." },
  { re:/PPI/i, sym:"RTY", x:0.7, imp:2,
    arg:-1,
    why:"Producer prices feed the PCE components released later in the month, which is the reason to watch it." },
  { re:/Official Bank Rate|MPC Official Bank Rate Votes|BOE Gov/i, sym:"ES", x:0.4, imp:2,
    n:"Bank of England",
    arg:-1,
    why:"Matters for cable and gilts. For your contracts it is background unless the vote split shocks.",
    hotL:"A hawkish surprise", hotD:-1, coldL:"A cut already in the base case", coldD:0,
    hot:"A hawkish surprise lifts global yields and leans on RTY, which is the rate-sensitive one.",
    cold:"A cut that was already the base case does very little to US index futures." },
  { re:/Main Refinancing Rate|ECB Press Conference|Monetary Policy Statement.*EUR/i, sym:"ES", x:0.5, imp:2,
    n:"ECB decision",
    arg:-1,
    why:"Transmits to your board through the dollar and global yields rather than directly." },
  { re:/BOJ Policy Rate|BOJ Press Conference|Monetary Policy Statement.*JPY/i, sym:"HSI", x:0.7, imp:2,
    n:"Bank of Japan",
    arg:-1,
    why:"Reaches your board through the yen and the carry trade, not directly. A hawkish surprise is the tail that has moved US futures before." },
  { re:/Caixin Manufacturing PMI/i, sym:"HSI", x:0.9, imp:2,
    arg:1,
    why:"The private survey, weighted to smaller exporters. It disagrees with the official number often enough to be worth reading separately." },
  { re:/Manufacturing PMI|Non-Manufacturing PMI/i, sym:"HSI", x:1.0, imp:2,
    arg:1,
    why:"Released straight into the HSI session. The sub-50 line is the one the desk reacts to." },
  { re:/German (Prelim|Final)? ?CPI|German ifo|German Flash/i, sym:"ES", x:0.4, imp:2,
    arg:-1,
    why:"Europe's lead indicator. Background for US futures unless it is a large miss." },
  { re:/Trump Speaks|President .* Speaks/i, sym:"ES", x:0.6, imp:2,
    arg:0,
    why:"Unscheduled in substance even when scheduled in time. The risk is a headline on tariffs or the Fed's independence, not the speech itself." }
];

/* The live calendar, once a mirror answers. Null until then, and null again is
   never written back — a failed fetch leaves the baked list standing rather
   than blanking the board. Everything downstream reads (CATLIVE || CATALYSTS),
   so the baked list is the fallback and not a second source of truth. */
var CATLIVE = null;

/* The relay stamps events in UTC; the reader is in Hong Kong. Rendered to match
   the hand-written `h` field exactly — "20:30 HKT Thu" — so a live row and a
   baked row are indistinguishable on the card. */
function catHKT(iso){
  var d = new Date(iso);
  if (!isFinite(d.getTime())) return "";
  return d.toLocaleTimeString("en-GB", { timeZone:"Asia/Hong_Kong", hour:"2-digit", minute:"2-digit", hour12:false }) +
         " HKT " + d.toLocaleDateString("en-GB", { timeZone:"Asia/Hong_Kong", weekday:"short" });
}

/* First match wins, so CATJ is ordered specific-before-general. */
function catJudge(n){
  for (var i = 0; i < CATJ.length; i++) if (CATJ[i].re.test(n)) return CATJ[i];
  return null;
}

/* Which way a beat argues, for THIS release rather than for its group.

   The override list is checked first and by design: a group entry exists to
   share prose across releases that behave alike, and the one group whose
   members do not behave alike is the jobs report, where payrolls and the
   unemployment rate move the same tape in opposite directions from the same
   instant. Returning the group's sign for all three would be a scoring error
   that repeats monthly and always looks like a bad month.

   Returns 0 for anything unjudged, which the landed board renders as "no
   direction to test" rather than as a failed prediction. A release this page
   has never thought about has not been got wrong. */
function catArg(name){
  var j = catJudge(name), k;
  if (!j) return 0;
  if (j.argOv) for (k = 0; k < j.argOv.length; k++)
    if (j.argOv[k][0].test(name)) return j.argOv[k][1];
  return j.arg || 0;
}

/* calendar.json -> the shape drawCat already draws. The feed supplies when, what
   and how big the consensus thinks it is; CATJ supplies which contract it hits,
   how far it can travel and why. An event that matches nothing still renders —
   with a default band and a line saying it is a default. */
function catMerge(doc){
  var evs = doc && doc.events;
  if (!evs || typeof evs.length !== "number" || !evs.length) return null;
  var out = [], i;
  for (i = 0; i < evs.length; i++){
    var e = evs[i];
    if (!e || !e.n || !e.t || !isFinite(new Date(e.t).getTime())) continue;
    var imp = (e.i === 1 || e.i === 2 || e.i === 3) ? e.i : 2;
    var j = catJudge(e.n);
    var c = { t:e.t, h:catHKT(e.t), n:(j && j.n) ? j.n : e.n,
              imp:(j && j.imp) ? j.imp : imp,
              sym:j ? j.sym : (CCY_SYM[e.c] || "ES"),
              x:j ? j.x : (imp >= 3 ? 1.0 : 0.5),
              judged:!!j, ccy:e.c || "", f:e.f || "", p:e.p || "",
              arg:catArg(e.n) };
    if (j){
      if (j.why)  c.why  = j.why;
      if (j.hot)  c.hot  = j.hot;
      if (j.cold) c.cold = j.cold;
      /* The branch labels and directions travel with the prose they belong to.
         Left behind, the live path renders a branch with no condition named and
         no arrow — which is the one state whytest treats as a defect rather than
         as an honest zero. */
      if (j.hotL)  c.hotL  = j.hotL;
      if (j.coldL) c.coldL = j.coldL;
      if (j.hotD  != null) c.hotD  = j.hotD;
      if (j.coldD != null) c.coldD = j.coldD;
    } else {
      c.why = "Not on my judged list. The contract below is inferred from the release's country and the " +
              "band is a generic multiplier for a " + (imp >= 3 ? "high" : "medium") + "-impact print. " +
              "Read it as a placeholder, not as a call about this event.";
    }
    out.push(c);
  }
  if (!out.length) return null;
  out.sort(function(a,b){ return new Date(a.t).getTime() - new Date(b.t).getTime(); });
  return out;
}

/* One place that swaps the list, so EVENTS and the board can never disagree.
   The hero clock reads EVENTS every second at call time, so reassigning it here
   is enough to move the countdown onto the live calendar too. */
function catApply(list){
  if (!list || !list.length) return false;
  CATLIVE = list;
  EVENTS = list.map(function(c){ return { t:c.t, n:c.n, h:c.h }; });
  try { drawCat(Date.now()); } catch(e){}
  return true;
}

/* ---------------------------------------------------------------
   HEADLINES — curated in the 8:00 HKT brief, not streamed. Each one
   carries the time it was filed so the card can say how stale it is
   rather than implying it is live.
   --------------------------------------------------------------- */
/* NEWS-BEGIN */
var NEWS = [
  { t:"2026-08-03T06:20:00Z", s:"Tape", h:"The island broke upward and then stopped — and the small cap is second-strongest",
    w:"RTY +0.732%, NQ +0.858%, ES +0.602%, YM +0.553%. Twelve basis points now separate the Russell contract from the Nasdaq, where Friday's cash session put a hundred and eleven between them, and the ORDER has inverted: the only index that fell on Friday is the second-strongest thing on the board tonight. The ranges were tight — ES 23.5 points, 0.31% of price; RTY 13.5 points, 0.46% — and both contracts have taken out the top of them. On Friday this page called that shape an island and published the test in the same sentence: an island resolves on volume rather than on time. It has resolved on time. The last half-hour covered 2.3 points on RTY and 5.75 on ES against measured 30-minute ranges of 5.4 and 10.5, so the break happened and the tape then went to sleep on it, seven hours before anybody who can ratify it turns up. A breakout nobody has traded is a level, not a verdict." },
  { t:"2026-08-03T06:15:00Z", s:"Commodities", h:"WTI has lost 80 as well — the war premium is not coming back this week",
    w:"Crude is below the 81.51 pre-strike floor this page uses as its own trigger, and has held below it since Sunday. That level was named a week ago as the price at which the Iran risk premium stops mattering for headline inflation; it was tested on Friday and HELD, and crude spent the rest of Friday going the other way, 81.45 in the morning to 85.85 by mid-afternoon and 84.57 at the 21:00Z close. It went on the Sunday reopen instead — 84.67 to 79.55 inside six minutes, straight through the floor and through 81 and 80 without trading at any of them. Nothing has printed above 81.25 since, so there are three and a half dollars of untraded air overhead: a retrace up into it carries no supply and means nothing until it reaches 84.67. It removes the one input that was putting a floor under headline CPI just as the Fed's hawkish minority was looking for a reason, and it does so in the week of a payrolls print. It also sharpens Monday's ISM prices-paid: with no commodity floor left, a hot print is a domestic price-pressure read rather than an energy pass-through, which is the more worrying of the two. Note the mechanical consequence for the card below: the oil component of the sentiment score is pinned at its positive rail, so it has stopped discriminating. Read it as a state, not as a reading." },
  { t:"2026-08-03T06:10:00Z", s:"Data", h:"One of the two frozen references has started rolling again — which is not the same as being fixed",
    w:"HSI and WTI are the only two quotes on this relay that come from CNBC, and both had been carrying a prior close that stopped rolling forward after Thursday. WTI still is: it publishes −6.24% today against a session that has moved about three quarters of a per cent. HSI is not: its reference has rolled, and the session opened 0.40% above it, which is exactly what a working previous close looks like. HSI stays suppressed anyway, and the reason is the whole point of the list. The defect was never that a payload read wrong — it was that no single payload can tell a frozen reference from a correct one, because they are the same object. One payload that looks right is one observation of the thing that was already unobservable, and an intermittent fault is worse than a permanent one, because the readings that look fine are the ones that get traded. Clearing this needs the field watched across sessions, which is relay-side work, not page-side. Levels from both feeds remain usable; changes do not." },
  { t:"2026-07-31T20:15:00Z", s:"Tape", h:"The S&P beat the Nasdaq while small caps fell — a rates session, not a tech one",
    w:"SPX +0.698%, NDX +0.593%, RUT −0.522%. That ranking is diagnostic and it is unusual. A tech story puts the Nasdaq on top; a risk-off session takes the broad index down with everything else. Here the broad index led, the growth index kept up, and the only index that fell is the one whose earnings are levered to the front end. This is the clean signature of a term-premium regime rather than an AI story, and it is the most useful thing Friday produced. The practical consequence is immediate: semiconductor headlines carried no daily information on Friday and should not be read this week as though they did." },
  { t:"2026-07-31T20:10:00Z", s:"Rates", h:"The 30-year closed at 5.27%, above the level being called a multidecade high two days earlier",
    w:"Treasury close: 2-year 4.28%, 5-year 4.45%, 10-year 4.75%, 30-year 5.27%. The 10-year added 8.2bp on the day and 2s10s steepened 2bp to +47bp — the long end doing the work, which is exactly what separates a term-premium move from an inflation move. This is the input that caps RTY and it did not improve. One caveat before anything is traded off it: the curve here is Friday's official Treasury close, while the futures on this page are live to the minute, so the two are not the same vintage and a comparison between them is not a spread." },
  { t:"2026-07-31T20:05:00Z", s:"Volatility", h:"VIX fell 6.4% to 15.99 going into a payrolls week",
    w:"Down from 17.09. A sixteen handle is the market declining to pay for protection ahead of the only genuinely binary event on the week's calendar, which is either confidence or complacency — and the tape does not distinguish between them in advance. What it does mean mechanically is that the options market is pricing a smaller move around Friday's print than the measured 30-minute ranges on this board imply, so the payrolls band on the catalyst card above is wider than what is currently being sold." }
];
/* NEWS-END */

/* ---------------------------------------------------------------
   SESSION CLOCK — the trading day in Hong Kong time.
   Minutes past midnight HKT. The segments tile 0..1440 with no gaps,
   so the strip is a true 24-hour axis and "now" always lands inside
   exactly one phase.
   tr = break-trust: 3 high, 2 medium, 1 low, 0 shut. Encoded by bar
   HEIGHT, never by a colour step — see the CSS note.
   July 2026: the US is on EDT, so ET + 12 = HKT. Cash close 16:00 ET
   = 04:00 HKT; CME maintenance halt 17:00–18:00 ET = 05:00–06:00 HKT.
   --------------------------------------------------------------- */
/* WHY THIS SITS UP HERE, ABOVE THE SESSION CARD, AND NOT DOWN BESIDE TICK WHERE
   IT WAS FIRST WRITTEN. The session card paints once at top level, synchronously,
   the moment the script reaches `paintSession(Date.now())` -- which is roughly a
   hundred lines ABOVE the ladder region. `var CONTRACT` hoists, so a reference to
   it from the card compiles and runs without complaint; it is merely `undefined`
   until the assignment further down executes. On a weekday that costs nothing,
   because the only line of the card that reads CONTRACT is the weekend one. On a
   Saturday the card threw, the whole init chain after it died, and the page
   rendered as a shell. It shipped a build and two guards before a determinism
   test that happened to use a Sunday clock found it.

   A declaration must live above its FIRST reader, not above its most obvious one.

/* CONTRACT -- what the reader is trading, as opposed to what the relay quotes.
   On ES and RTY the two coincide and there is nothing to say. On the HK board
   they do not: every level is measured on the cash index, every fill happens on
   MHI, and until now the page stated nowhere what MHI even is -- not its size,
   not its tick, not when the front month dies. A reader who took a level off
   this board had to know the contract from somewhere else, which for a board
   whose whole claim is "here is what you would be risking" is a hole.

   Sourced from HKEX's own contract summary rather than inferred from the tape,
   because none of it is visible in a price series: multiplier HK$10 per index
   point; minimum fluctuation one index point; contract months spot, next
   calendar month and the next two quarter months; last trading day the SECOND
   -last trading day of the contract month, which for Aug-26 is Friday 28 August
   (Monday 31 August being the last); final settlement the average of index
   quotations taken at five-minute intervals from five minutes after the SEHK
   continuous session opens to five minutes before it closes, plus the closing
   quotation itself.

   basis is the one measured number here and it carries its own date, because a
   basis is not a constant -- it is carry plus dividends and it walks toward
   zero as expiry approaches. -5.8 is MHI Aug-26's HKEX settlement of 25,910 on
   5 Aug against this relay's HK close of 25,915.82 the same session. It is
   stated so the reader can subtract it, and dated so he can distrust it once it
   is old. Anything reading this must treat it as a measurement with an age, not
   as a property of the instrument. */
/* WHAT A POINT IS WORTH, per tradeable contract.

   The page knew every input a sizing calculation needs — the level, the
   invalidation, the measured pace of the session you are in, the typical
   excursion — and knew nothing about how big anything is traded, so it stopped
   one step short of the decision every other card was preparing. These are the
   multipliers, and the MICROS are here on purpose: at this account size the
   difference between sizing in minis and sizing in micros is the difference
   between a drawdown that is survivable and a week that is not, and a
   calculator that only offers the big contract quietly pushes toward the big
   contract.

   `px` is the symbol whose PRICE this instrument follows — a micro tracks its
   mini exactly, so MES reads the ES board rather than needing a feed of its
   own. ccy is carried per instrument rather than assumed: MHI settles in HK
   dollars and adding it to a US-dollar risk total would be a category error
   wearing a number's clothes. */
var SIZE_SPEC = [
  { k:"ES",  px:"ES",  label:"ES  · E-mini S&P 500",     mult:50,   ccy:"US$", tick:0.25 },
  { k:"MES", px:"ES",  label:"MES · Micro E-mini S&P",   mult:5,    ccy:"US$", tick:0.25 },
  { k:"RTY", px:"RTY", label:"RTY · E-mini Russell 2000",mult:50,   ccy:"US$", tick:0.1  },
  { k:"M2K", px:"RTY", label:"M2K · Micro Russell 2000", mult:5,    ccy:"US$", tick:0.1  },
  { k:"NQ",  px:"NQ",  label:"NQ  · E-mini Nasdaq 100",  mult:20,   ccy:"US$", tick:0.25 },
  { k:"MNQ", px:"NQ",  label:"MNQ · Micro Nasdaq 100",   mult:2,    ccy:"US$", tick:0.25 },
  { k:"YM",  px:"YM",  label:"YM  · E-mini Dow",         mult:5,    ccy:"US$", tick:1    },
  { k:"MYM", px:"YM",  label:"MYM · Micro Dow",          mult:0.5,  ccy:"US$", tick:1    },
  { k:"MHI", px:"HSI", label:"MHI · Mini Hang Seng",     mult:10,   ccy:"HK$", tick:1    }
];

/* ltdMs and basisMs are EPOCHS, and they are here rather than parsed out of the
   display strings beside them for a reason this page has already paid for once:
   a countdown that reads its own label is a countdown that starts lying the day
   somebody rewrites the label. `ltd` and `basisOn` are what a reader sees; these
   two are what the arithmetic uses, and a guard checks they agree.

   ltdMs anchors on 16:30 HKT (08:30Z) on Friday 28 August 2026, the close of the
   SEHK continuous session on MHI Aug-26's last trading day — the T+1 session does
   not run on an expiry day, so that bell is the contract's last tradeable minute
   on this board. basisMs anchors on the 5 August HKEX settlement the -5.8 was
   measured against, so the figure's age is computed rather than remembered. */
/* ===================== THE INDEPENDENT CROSS-CHECK =====================
   XCHK — the one thing this board had never done to itself.

   Its whole standard for believing a number is TWO SOURCES AGREEING. That rule
   was not written in the abstract: on 31 July the tiles published a close that
   agreed with nothing, and what fixed it was four numbers from three sources
   landing within a tick of each other. Every card since has been built to that
   bar. The board itself was not. Every figure on it comes from one relay, and
   until 12 August nobody had ever asked a second vendor whether the relay was
   right.

   THE FIRST ATTEMPT AT THIS WAS WRONG AND IS WORTH RECORDING. I proposed
   checking the board against Yahoo. The relay's own payload stamps `src:"yahoo"`
   on ES, RTY, NQ, YM, SPX, RUT, NDX, DXY, GOLD, CRUDE and US10Y — so that would
   have compared the source against itself and produced agreement that proves
   nothing while looking exactly like verification. Worse than no check. CHECK THE
   `src` FIELD BEFORE CALLING ANYTHING INDEPENDENT.

   WHAT THIS IS. A dated measurement, in the same shape as the MHI basis: taken
   once, stated with its date, and to be distrusted as it ages. It compares the
   SESSION MOVE the relay published against the same session's move at an
   unrelated vendor, using each index's liquid ETF proxy.

   WHAT IT IS NOT, and the page says so rather than letting a reader assume:
     * It is a check on DIRECTION AND MAGNITUDE, not on price. An ETF tracks its
       index with a few basis points of slippage from dividends and fees, so a
       small gap is expected and is not evidence of a fault in either feed.
     * It says nothing about the FUTURES prices the levels are actually drawn on.
       It checks the cash indices those futures are quoted against.
     * HSI and VIX cannot be checked from here at all: they are the two figures
       the relay sources from cnbc, and cnbc is unreachable from this container.
       They are listed as unchecked rather than quietly omitted, because a
       cross-check that silently covers nine of eleven instruments and reports a
       clean bill is the same defect in a new place.
     * It does not run itself. There is no path from the toolchain to an
       independent vendor without a key, and keys do not come into this container,
       so this is refreshed by hand and its age is the reader's warning. */
var XCHK = {
  at: 1786520521000,          /* when the comparison was taken */
  vendor: "Alpha Vantage",
  session: "Tue 11 Aug cash close",
  method: "each index's session move against the same session at an unrelated vendor, via its liquid ETF proxy",
  rows: [
    { k:"SPX", proxy:"SPY", ours:-0.3315, theirs:-0.3195 },
    { k:"RUT", proxy:"IWM", ours: 0.3084, theirs: 0.3367 },
    { k:"NDX", proxy:"QQQ", ours:-0.3338, theirs:-0.3357 }
  ],
  unchecked: [
    { k:"HSI", why:"relay sources it from cnbc, which is unreachable from the build container" },
    { k:"VIX", why:"relay sources it from cnbc, which is unreachable from the build container" }
  ],
  /* Past this the row stops being evidence and starts being a memory. Two
     sessions: long enough that a weekend does not expire it, short enough that
     it cannot quietly vouch for a week of drift. */
  ttlH: 60
};

var CONTRACT = {
  HSI: { name:"MHI", full:"Mini-Hang Seng Index Futures", tick:1, unit:"pt",
         mult:10, ccy:"HK$", month:"Sep-26", ltd:"Tue 29 Sep 2026",
         ltdMs:1790670600000,
         /* ROLLED 25 Aug, Aug-26 -> Sep-26, three days before Aug-26's last
            trading day. `ltd` is derived by the convention the Aug entry already
            followed -- the business day before the month's last business day,
            which gives Fri 28 Aug for August and Tue 29 Sep for September --
            and `ltdMs` is that date at 16:30 HKT, the same session close the Aug
            stamp used.

            BASIS IS NULL, AND THAT IS A MEASUREMENT RATHER THAN AN OMISSION.
            The Aug-26 figure was -5.8, taken at the 5 August settlement. It is
            NOT carried forward: a basis belongs to one contract and decays to
            zero into that contract's expiry, so quoting August's against a
            September contract would be a number with nothing behind it.
            There is no Sep-26 figure to put in its place. mhi-ibkr.json is a
            frozen 7 August fixture covering Aug-26 only and cannot refresh
            itself, and the page's own MHI.basis already declines to publish for
            the cash-versus-futures pair on its own evidence. The card says all
            of this rather than printing a dash. */
         basis:null, basisOn:null, basisMs:null,
         hours:"09:15-12:00 &middot; 13:00-16:30 &middot; 17:00-03:00 HKT",
         settle:"average of five-minute HSI quotations across the SEHK continuous session on the last trading day, plus the close" }
};

/* MHI_HOURS — the Mini-Hang Seng future's own trading day, in HKT minutes past
   midnight, kept DELIBERATELY SEPARATE from the SESSION partition below.

   The temptation is to fold it in, and folding it in would be a mistake for a
   reason that has nothing to do with taste. SESSION is a partition: it tiles
   0..1440 with no gaps and no overlaps, kzNow() takes unions of its phases and
   kzlib.py asserts the tiling on every build. MHI's day does not respect those
   boundaries anywhere — it opens fifteen minutes before the HK cash auction
   finishes, it trades half an hour past the cash close, and its overnight
   session ends at 03:00 in the middle of a phase called "US afternoon trend".
   Splitting SESSION to accommodate it would either break the killzone unions or
   quietly change what a killzone means, to record a fact that fits in nine rows
   of its own table.

   The fact worth recording, and the reason this exists at all: THE CONTRACT
   SHUTS AT 03:00 HKT, ONE HOUR BEFORE THE US CASH CLOSE. A reader watching the
   power hour on this board has no HK contract to trade it in, and every level
   on the HK ladder is unreachable for the five and three quarter hours after
   that. Nothing on this page said so before.

   Hours are HKEX's, for the front month; the expiring month closes at 16:00
   rather than 16:30 on its last trading day, which is a rule this table does
   not encode because it applies on one day per quarter and encoding it wrong
   would be worse than saying it in the prose. See CONTRACT for that date. */
var MHI_HOURS = [
  { s:   0, e: 180, st:"open", d:"T+1 session &mdash; the overnight half" },
  { s: 180, e: 525, st:"shut", d:"closed at 03:00 &mdash; an hour before the US cash close" },
  { s: 525, e: 555, st:"pre",  d:"pre-market opening &mdash; matching, not trading" },
  { s: 555, e: 720, st:"open", d:"HK morning &mdash; it opens 15 min before the cash index does" },
  { s: 720, e: 750, st:"shut", d:"lunch break" },
  { s: 750, e: 780, st:"pre",  d:"pre-market opening &mdash; matching, not trading" },
  { s: 780, e: 990, st:"open", d:"HK afternoon &mdash; it runs 20 min past the cash close" },
  { s: 990, e:1020, st:"shut", d:"changeover into the T+1 session" },
  { s:1020, e:1440, st:"open", d:"T+1 session &mdash; through Europe and the US open" }
];
var MHI_WORD = { open:"MHI OPEN", pre:"MHI PRE", shut:"MHI SHUT" };

/* Where MHI is at a given HKT minute, and how long until that changes. The
   countdown crosses midnight because the T+1 session does: at 23:50 the next
   transition is 03:00, which is 190 minutes away and not -1250. */
function mhiAt(min){
  var n = MHI_HOURS.length, i, k;
  for (i = 0; i < n; i++){ if (min >= MHI_HOURS[i].s && min < MHI_HOURS[i].e) break; }
  if (i === n) i = n - 1;
  var cur = MHI_HOURS[i], end = cur.e;
  /* Walk forward through rows carrying the SAME state, wrapping past 24:00. The
     T+1 session is one session written as two rows because the table is keyed on
     minutes past midnight, and a countdown that stopped at the row boundary would
     tell a reader at 23:50 that MHI shuts in ten minutes. It does not; it shuts
     in three hours and ten. */
  for (k = 1; k < n; k++){
    var nx = MHI_HOURS[(i + k) % n];
    if (nx.st !== cur.st) break;
    end = nx.e;
  }
  var left = end - min; if (left <= 0) left += 1440;
  return { st: cur.st, d: cur.d, left: left };
}

var SESSION = [
  { s:   0, e:  60, tr:1, n:"US midday lull", tz:"ET", lm:720,
    note:"The dead middle of the US session. Breaks here reverse more often than they run — the desks that would push it are away from the screen. If you are early, this is the hour that stops you out for nothing." },
  { s:  60, e: 180, tr:3, n:"US afternoon trend", tz:"ET", lm:780,
    note:"Volume comes back and the day's direction usually settles here. A level that gives way in this window tends to stay given. The best window on the clock for an entry you actually intend to hold." },
  { s: 180, e: 240, tr:3, n:"Power hour → cash close", tz:"ET", lm:900,
    note:"Index funds and closing imbalances dominate the last hour. Moves are quick and they stick into the bell — but the cause is flow, not opinion, so do not read the direction as a signal for tomorrow. MHI has just shut, at 03:00, so whatever this hour does to the China complex cannot be traded in Hong Kong until 09:15." },
  { s: 240, e: 300, tr:1, n:"After the US cash close", tz:"ET", lm:960,
    note:"Cash is shut, futures still trade on a thin book. A break here is often one order finding no bids. Do not act on it." },
  { s: 300, e: 360, tr:0, n:"CME halt — futures shut", tz:"ET", lm:1020,
    note:"The one hour a day RTY and ES do not trade at all. MHI has already been shut for two hours by this point. Nothing to do but sleep." },
  { s: 360, e: 540, tr:1, n:"Globex reopen · Asia pre-dawn", tz:"ET", lm:1080,
    note:"Futures reopen into the thinnest book of the day. Highs and lows printed in this window get run straight over the moment Europe arrives — do not carry them into your level map." },
  { s: 540, e: 570, tr:1, n:"HK pre-open auction", tz:"HK", lm:540,
    note:"The cash index is matching orders, not trading, and its indicative price swings around meaning very little until the bell. MHI is different and this is the one place it matters: the future has been trading since 09:15, fifteen minutes ahead of the cash open, so the contract prints a real two-way price while the index underneath it is still an auction. Those fifteen minutes are the only window on the clock where the HK ladder's price is more honest than the levels drawn on it." },
  { s: 570, e: 720, tr:2, n:"HK morning session", tz:"HK", lm:570,
    note:"Your one properly liquid window for MHI — levels tested in the first hour here are real. RTY and ES are still thin, so a US break during Asia hours is Asian flow, not a US decision." },
  { s: 720, e: 780, tr:1, n:"HK lunch break", tz:"HK", lm:720,
    note:"MHI is shut for the first half hour and matching in the second; US futures drift throughout. The flattest hour on the board. A good time to plan the entry; a bad time to take it." },
  { s: 780, e: 900, tr:2, n:"HK afternoon session", tz:"HK", lm:780,
    note:"MHI reopens at 13:00 and the afternoon usually resolves the morning's range. Whether the morning high or the morning low goes first is the day's tell for the whole China complex." },
  { s: 900, e: 970, tr:2, n:"Europe opens · HK closes", tz:"LON", lm:480,
    note:"Europe arrives and RTY and ES get their first genuine two-way flow of the day. This is the earliest hour a US level break is worth trusting. The cash index closes at 16:10 into it; MHI keeps trading until 16:30, so the last twenty minutes of the HK day are the contract moving with no index behind it." },
  { s: 970, e:1230, tr:2, n:"European session", tz:"HK", lm:970,
    note:"Steady, moderate volume. Breaks here follow through perhaps half the time — useful for starting a position, not for taking the whole one." },
  { s:1230, e:1290, tr:1, n:"US data window · pre-open", tz:"ET", lm:510,
    note:"Numbers land at 20:30 and the pre-open book is thin enough that the first move is regularly the wrong one. This is exactly where a right call becomes a wrong entry. Let the bell confirm it." },
  { s:1290, e:1350, tr:3, n:"US cash open — first hour", tz:"ET", lm:570,
    note:"The highest-volume hour RTY sees all day. A level that breaks here on volume is the most reliable break on the board. It is also the fastest — that is an argument for smaller size, not larger." },
  { s:1350, e:1440, tr:1, n:"US midday lull", tz:"ET", lm:630,
    note:"Volume falls off a cliff once the first hour is done. False breaks are the norm and the range usually survives until the afternoon." }
];

/* ---------------------------------------------------------------
   TYPICAL MOVE — the empirical 30-minute range, in points.
   Median high-low across every rolling 6-bar window of the 5-minute
   bars (91 windows from 96 bars). Not a Wilder ATR: this is the plain
   median of what actually happened, which is what "can price get
   there before the phase changes" needs.
   Refreshed live from latest/free-bars.json. The values below are the
   fallback for a reader with no network.
   --------------------------------------------------------------- */
var MOVE_RATIO = 10;   /* day range ÷ typical 30m move, measured on ES and RTY */
/* MOVES-BEGIN */
/* Measured on 5511 archived 5-minute bars, 30 Jul 00:10Z – 27 Aug 07:45Z, from the
   git-history reconstruction and the relay's append-only archive combined. The
   statistic is the MEDIAN of every rolling six-bar HIGH-LOW span — the distance
   price actually covered in thirty minutes, not close-to-close displacement,
   because the question this answers is "can price get there" and price gets there
   on the extreme. `lo`/`hi` are the 10th and 90th percentiles of that same
   distribution, so they describe a quiet half-hour and a violent one.

   `rth` is the identical statistic restricted to the US cash session, and it is
   roughly TWICE the all-hours figure on both contracts. That gap is the whole
   reason it is carried separately: a level "two moves away" at 3am Hong Kong is
   inside one move after the bell, and an event landing at 12:30Z must have its
   blast radius drawn against the session it lands in, not against a median
   dragged down by dead overnight hours.

   Generated by reach.py from the same span distribution REACH publishes, so
   MOVES.t30 is REACH.ALL and MOVES.rth is REACH.RTH by construction rather
   than by retyping. */
var MOVES = {
  ES:  { t30:7.25, lo:3.5, hi:16.5, n:5300, src:"bars", rth:11.0 },
  HSI: { t30:52.33, lo:30.69, hi:101.06, n:930, src:"bars", rth:null },
  NQ:  { t30:48.75, lo:26.25, hi:101.5, n:3798, src:"bars", rth:62.75 },
  RTY: { t30:3.6, lo:1.7, hi:8.9, n:5293, src:"bars", rth:5.8 },
  YM:  { t30:44.0, lo:19.0, hi:102.0, n:3843, src:"bars", rth:68.0 },
};
/* MOVES-END */

/* ---------------------------------------------------------------
   REACH — how long until price can get somewhere, measured.

   MOVES answers "how big is a move". This answers "how long until a level is
   inside normal reach", which is the question that decides whether a level is
   today's decision or tomorrow's.

   Dividing distance by typical travel and calling the answer hours is wrong by a
   wide margin: price does not travel in a straight line, so distance grows with
   roughly the SQUARE ROOT of time. `H` is that exponent, fitted per contract on
   the 15m-2h end of the measured excursion curve where the sample is in the
   hundreds. Both contracts come out near 0.52, which is textbook diffusion —
   worth noting, because it was measured rather than assumed.

   TWO THIRTY-MINUTE NUMBERS LIVE ON THIS PAGE AND THEY ARE NOT THE SAME THING.
     t30 is the full HIGH-LOW RANGE of a half hour — the width of the box price
         drew. That is what "x30m" distances elsewhere are quoted in.
     e30 is the ONE-SIDED EXCURSION from where you stand — how far price gets in
         one direction. It runs about half of t30.
   Reaching a level is one-sided, so the walk accumulates e30. Anchoring it to t30
   by mistake made the first build over-predict four-hour travel by 88-158%.

   The generator grades itself out of sample every run: fitted on 15m-2h, then
   asked to predict the FOUR-hour excursion it never saw. As of this build it lands
   within +6%/-4% in European and Asian hours, where the sample is deep and where
   you are usually looking at this page. It UNDER-states cash-session travel by
   26-45% on a 42-start sample — the error is real, it is stated on the card, and
   it points the safe way: the board will call a level out of reach before it will
   falsely promise you a touch.

   Sample depth is whatever span_h says below — it grows with every refresh, which
   is why no prose on this page types it. Treat this as a well-calibrated rule of
   thumb, not a clock.
   --------------------------------------------------------------- */
/* REACH-BEGIN */
