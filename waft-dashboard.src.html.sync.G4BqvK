  var when = D.getUTCDate() + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul',
      'Aug','Sep','Oct','Nov','Dec'][D.getUTCMonth()] + ' ' +
      P(D.getUTCHours()) + ':' + P(D.getUTCMinutes());
  return '<div class="smt-when smt-gen">measured ' + when + ' UTC' +
    (days >= 1 ? ' &middot; ' + days + (days === 1 ? ' day' : ' days') + ' ago' : '') +
    ' <span class="dim">as measured</span>' +
    (carried ? ' <span class="dim">&middot; carried forward: the last refresh could not ' +
               'regenerate this card</span>' : '') +
    '</div>';
};

