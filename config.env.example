# WaFT relay configuration — copy to config.env and fill in.
# Paste keys DIRECTLY from the Webull developer dashboard (avoid retyping:
# secrets are hex — only 0-9 and a-f, no capital O).
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here
# Region of the portal where WaFT was approved: hk or us
WEBULL_REGION=hk

# Symbols to stream. US ETFs proxy the futures: SPY~ES, IWM~RTY, QQQ~NQ, DIA~Dow.
US_SYMBOLS=SPY,IWM,QQQ,DIA
# HK symbols (probe run will tell you what your subscription covers), e.g. 00700,02800
# 02800 = Tracker Fund of Hong Kong (HSI proxy ETF)
HK_SYMBOLS=02800,00700
# How many 1-minute bars to pull each cycle (rolling window)
BAR_COUNT=120
