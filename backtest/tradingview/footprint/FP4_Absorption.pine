//@version=6
// FP4 - ABSORPTION PROXY + CVD PROXY (module 4 of 7) ----------------------------
// The best idea in footprint trading, translated honestly to bar data.
// Absorption = heavy aggressive volume that produces almost no price progress,
// because passive limit interest on the other side is soaking it. In the order
// book this is directly visible; bars can only shadow it as EFFORT (volume
// percentile high) vs RESULT (range percentile low), located AT an extreme
// (an N-bar low that closes in its upper half on heavy volume = someone bought
// everything thrown at them).
//
// CVD PROXY, stated plainly: Pine has NO aggressor-side data. The lower-TF
// up/down-volume split below correlates only moderately with true bid/ask
// delta and misses everything inside each 1-minute bucket. It refines the
// absorption read; it is NOT real delta and is labeled PROXY on the pane.
indicator("FP4 Absorption Proxy", overlay = false)

// Defaults loosened for chart visibility (75/50/14; the r33b research spec
// was 80/40/20 - restore those for the strict read). Neither setting is a
// validated signal; looser just means "show me more candidates to judge".
lookN  = input.int(100, "Percentile lookback (bars)", minval = 20)
volTh  = input.int(75, "Volume percentile >=", minval = 50, maxval = 99)
rngTh  = input.int(50, "Range percentile <=", minval = 1,  maxval = 60)
extN   = input.int(14, "Extreme lookback (bars)", minval = 5)
// Delta-flip marker (USER HYPOTHESIS, TESTED r34b: REFUTED - a red candle
// with positive delta, even a big one after a selloff, performs the same
// as or slightly worse than an ordinary red candle; 24+6 cells, 9k-26k
// events each). OFF by default; turn on to watch the null live.
showFlip = input.bool(false, "Delta-flip marker (r34b: no edge - study only)")
useLTF = input.bool(true, "CVD proxy from lower TF")
ltfRes = input.string("1", "Lower TF")
dispMode = input.string("delta columns", "Pane display (one scale at a time)",
     options = ["delta columns", "CVD line"])

volP = ta.percentrank(volume, lookN)
tr   = ta.tr(true)
rngP = ta.percentrank(tr, lookN)
clv  = high != low ? (2 * close - high - low) / (high - low) : 0.0   // -1..+1

atLow  = low  <= ta.lowest(low, extN)
atHigh = high >= ta.highest(high, extN)
effortNoResult = volP >= volTh and rngP <= rngTh
absorbBuy  = effortNoResult and atLow  and clv > 0    // sellers pressed a low, someone ate it
absorbSell = effortNoResult and atHigh and clv < 0    // buyers pressed a high, someone faded it

// CVD proxy: sum of signed lower-TF volume (up-close = +, down-close = -).
deltaArr = request.security_lower_tf(syminfo.tickerid, ltfRes, close >= open ? volume : -volume)
deltaPx  = useLTF and array.size(deltaArr) > 0 ? array.sum(deltaArr) : (close >= open ? volume : -volume)
var float cvd = 0.0
cvd += nz(deltaPx)

// One series per scale: the cumulative line is ~10,000x the size of a single
// bar's delta, so plotting both in one pane crushes the columns to nothing
// (as seen in live use). Pick the view; markers stay on in both.
plot(dispMode == "delta columns" ? deltaPx : na, "delta PROXY (per bar)",
     deltaPx >= 0 ? color.new(color.teal, 40) : color.new(color.maroon, 40), 1, plot.style_columns)
plot(dispMode == "CVD line" ? cvd : na, "cum delta PROXY", color.new(color.blue, 0), 2)
plotshape(absorbBuy,  "absorption (buy side)",  shape.triangleup,   location.belowbar, color.teal,   size = size.small, force_overlay = true)
plotshape(absorbSell, "absorption (sell side)", shape.triangledown, location.abovebar, color.maroon, size = size.small, force_overlay = true)

// divergence flag: price makes an extN-bar extreme the CVD proxy does not
// confirm - weak evidence by itself, context for sweeps (FP6).
divBull = atLow  and cvd > ta.lowest(cvd, extN)
divBear = atHigh and cvd < ta.highest(cvd, extN)
flipBull = showFlip and close < open and deltaPx > 0
flipBear = showFlip and close > open and deltaPx < 0
plotshape(flipBull, "delta flip bull (study)", shape.diamond, location.belowbar, color.new(color.teal, 30),   size = size.tiny, force_overlay = true)
plotshape(flipBear, "delta flip bear (study)", shape.diamond, location.abovebar, color.new(color.maroon, 30), size = size.tiny, force_overlay = true)
plotshape(divBull, "delta divergence bull", shape.circle, location.bottom, color.new(color.teal, 50),   size = size.tiny)
plotshape(divBear, "delta divergence bear", shape.circle, location.top,    color.new(color.maroon, 50), size = size.tiny)

alertcondition(absorbBuy,  "Absorption BUY side",  "FP4: effort/no-result at a low, close upper half")
alertcondition(absorbSell, "Absorption SELL side", "FP4: effort/no-result at a high, close lower half")
