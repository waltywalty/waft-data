//@version=6
// FP4 - ABSORPTION PROXY + CVD PROXY (module 4 of 7, v2) ------------------------
// Absorption = heavy aggressive volume that produces almost no price progress,
// because passive limit interest on the other side is soaking it.
//
// v2 REDESIGN (why the old triangles never printed): volume and range are
// strongly POSITIVELY correlated - big-volume bars are usually big-range bars -
// so the old hard conjunction "volume >= 75th pct AND range <= 50th pct" is
// structurally rare (a handful of events per month even loosened). v2 uses a
// graded ABSORPTION SCORE = volume percentile minus range percentile (0..100
// scale, positive = more volume than the range 'deserves'). Score >= threshold
// at an N-bar extreme with a confirming close = event. Tune the threshold to
// taste; lower = more candidates. None of this is a validated signal - it is
// a lens for judging effort-vs-result, and r33b/r34b results stand.
//
// CVD PROXY, stated plainly: Pine has NO aggressor-side data. The lower-TF
// up/down-volume split is a shadow of true bid/ask delta and misses everything
// inside each 1-minute bucket. Labeled PROXY everywhere on purpose.
indicator("FP4 Absorption Proxy", overlay = false)

lookN   = input.int(100, "Percentile lookback (bars)", minval = 20)
scoreTh = input.int(35, "Absorption score >= (vol pct - range pct)", minval = 10, maxval = 90,
     tooltip = "Lower = more events. 35 prints a few per week on 15m; 50+ approaches the old strict behaviour")
extN    = input.int(14, "Extreme lookback (bars)", minval = 5)
useLTF  = input.bool(true, "CVD proxy from lower TF")
ltfRes  = input.string("1", "Lower TF")
dispMode = input.string("delta columns", "Pane display (one scale at a time)",
     options = ["delta columns", "CVD line"])
// Delta-flip coloring (USER HYPOTHESIS, TESTED r34b: REFUTED - no forward
// edge, base and big-delta variants, 30 cells, 9k-26k events each). Kept as
// a STUDY lens at the user's request: columns recolor when the bar's delta
// fights the candle AND clears the magnitude threshold, so only meaningful
// disagreements light up instead of every tiny one.
showFlip = input.bool(true, "Highlight delta-flip columns (study only - r34b: no edge)")
flipTh   = input.int(70, "Flip: |delta| percentile >=", minval = 50, maxval = 95)

// ---- absorption score ---------------------------------------------------------
volP  = ta.percentrank(volume, lookN)
rngP  = ta.percentrank(ta.tr(true), lookN)
score = volP - rngP
clv   = high != low ? (2 * close - high - low) / (high - low) : 0.0   // -1..+1
atLow  = low  <= ta.lowest(low, extN)
atHigh = high >= ta.highest(high, extN)
absorbBuy  = score >= scoreTh and atLow  and clv > 0    // sellers pressed a low, someone ate it
absorbSell = score >= scoreTh and atHigh and clv < 0    // buyers pressed a high, someone faded it

// ---- CVD proxy ----------------------------------------------------------------
deltaArr = request.security_lower_tf(syminfo.tickerid, ltfRes, close >= open ? volume : -volume)
deltaPx  = useLTF and array.size(deltaArr) > 0 ? array.sum(deltaArr) : (close >= open ? volume : -volume)
var float cvd = 0.0
cvd += nz(deltaPx)

// ---- pane ---------------------------------------------------------------------
// Delta-flip: sign of the bar's delta disagrees with the candle AND the delta
// is big (>= flipTh percentile of |delta|). Lime column = positive delta into
// a red close; fuchsia = negative delta into a green close.
bigDelta = math.abs(deltaPx) >= ta.percentile_nearest_rank(math.abs(deltaPx), lookN, flipTh)
flipBull = showFlip and close < open and deltaPx > 0 and bigDelta
flipBear = showFlip and close > open and deltaPx < 0 and bigDelta
colCol = flipBull ? color.new(color.lime, 0) : flipBear ? color.new(color.fuchsia, 0) :
     deltaPx >= 0 ? color.new(color.teal, 40) : color.new(color.maroon, 40)
plot(dispMode == "delta columns" ? deltaPx : na, "delta PROXY (per bar)", colCol, 1, plot.style_columns)
plot(dispMode == "CVD line" ? cvd : na, "cum delta PROXY", color.new(color.blue, 0), 2)

// absorption events on the price panel (the headline output)
plotshape(absorbBuy,  "absorption (buy side)",  shape.triangleup,   location.belowbar, color.teal,   size = size.small, force_overlay = true)
plotshape(absorbSell, "absorption (sell side)", shape.triangledown, location.abovebar, color.maroon, size = size.small, force_overlay = true)

// ---- CVD divergence circles ---------------------------------------------------
// These compare PRICE extremes against the CUMULATIVE delta line, not single
// bars: teal circle (pane bottom) = price made a new extN-bar LOW but the
// running delta sum did not - the decline happened without fresh net selling
// (a "hollow selloff"). Maroon circle (pane top) = new price HIGH without a
// new delta high - a rally without fresh net buying (a "hollow rally").
// Weak evidence alone; context at levels.
divBull = atLow  and cvd > ta.lowest(cvd, extN)
divBear = atHigh and cvd < ta.highest(cvd, extN)
plotshape(divBull, "hollow selloff (CVD divergence)", shape.circle, location.bottom, color.new(color.teal, 50),   size = size.tiny)
plotshape(divBear, "hollow rally (CVD divergence)",   shape.circle, location.top,    color.new(color.maroon, 50), size = size.tiny)

alertcondition(absorbBuy,  "Absorption BUY side",  "FP4: effort/no-result at a low, close upper half")
alertcondition(absorbSell, "Absorption SELL side", "FP4: effort/no-result at a high, close lower half")
