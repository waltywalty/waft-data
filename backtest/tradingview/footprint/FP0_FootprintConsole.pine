//@version=6
// FP0 - FOOTPRINT CONSOLE (merged FP1 + FP3 + FP6) ------------------------------
// One indicator slot for the whole validated overlay core. Merge logic:
//   FP1 Session Map  - shading, key minutes, session VWAP +/- sigma, prior close
//   FP3 HTF Bias     - the round-30 overnight-drift + trend bias CARD
//                      (the full cumulative decomposition plot stays in FP3)
//   FP6 Liquidity    - PDH/PDL/ON/OR levels + sweep scoreboard (CONTEXT ONLY:
//                      round 33 - all 12 sweep-entry cells lose net)
// These three never conflict: they are all price-panel context with no shared
// state and no opposing "signals" (only FP3 renders a directional read at all).
// FP2 RVOL stays separate because it needs its own pane (and real CME volume).
// Every layer has a master toggle - turn off what you do not use.
indicator("FP0 Footprint Console", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ================================ inputs ======================================
tz      = input.string("America/New_York", "Timezone", group = "Session")
rthSess = input.session("0930-1600", "RTH session", group = "Session")
preset  = input.string("Index", "Instrument preset", options = ["Index", "Gold"], group = "Session")
useMap  = input.bool(true, "Layer: session map (shading, key minutes, VWAP)", group = "Session")
useBias = input.bool(true, "Layer: HTF bias card (round-30 read)", group = "Bias")
winN    = input.int(63, "Bias: overnight-drift window (days)", group = "Bias")
smaN    = input.int(200, "Bias: trend SMA (days)", group = "Bias")
useLvls = input.bool(true, "Layer: liquidity levels + sweep scoreboard", group = "Levels")
orMins  = input.int(30, "Opening range (minutes)", group = "Levels")
failK   = input.int(6, "Sweep failure window (bars)", group = "Levels")

// Session bands: killzone-style background shading for the full 24h clock
// (concept after ICT Killzones [TFO]; implementation ours). Visual only -
// VWAP, levels, and the scoreboard still key off the RTH session above.
grpB   = "Session bands (visual only)"
useBands = input.bool(true, "Show session bands", group = grpB)
bandStyle = input.string("Range boxes", "Band style", options = ["Range boxes", "Background"], group = grpB,
     tooltip = "Range boxes = a box hugging each session's actual high-low range with its name inside (killzone style). Background = full-height tint")
bandT  = input.int(85, "Band transparency", minval = 50, maxval = 98, group = grpB)
maxSess = input.int(3, "Sessions kept per band", minval = 1, maxval = 10, group = grpB)
showDays = input.bool(true, "Day dividers + weekday labels", group = grpB)
b1on = input.bool(true, "", inline = "B1", group = grpB)
b1c  = input.color(color.blue, "", inline = "B1", group = grpB)
b1s  = input.session("2000-0000", "Asia", inline = "B1", group = grpB)
b2on = input.bool(true, "", inline = "B2", group = grpB)
b2c  = input.color(color.red, "", inline = "B2", group = grpB)
b2s  = input.session("0200-0500", "London", inline = "B2", group = grpB)
b3on = input.bool(true, "", inline = "B3", group = grpB)
b3c  = input.color(color.teal, "", inline = "B3", group = grpB)
b3s  = input.session("0930-1100", "NY AM", inline = "B3", group = grpB)
b4on = input.bool(false, "", inline = "B4", group = grpB)
b4c  = input.color(color.gray, "", inline = "B4", group = grpB)
b4s  = input.session("1200-1300", "NY Lunch", inline = "B4", group = grpB)
b5on = input.bool(true, "", inline = "B5", group = grpB)
b5c  = input.color(color.fuchsia, "", inline = "B5", group = grpB)
b5s  = input.session("1330-1600", "NY PM", inline = "B5", group = grpB)

vwapMode = input.string("Session bands", "VWAP/sigma anchor", options = ["RTH", "Session bands"], group = grpB,
     tooltip = "RTH = one VWAP from the 09:30 open (the validated value-proxy convention). Session bands = reset and accumulate within EACH enabled band (Asia, London, NY AM...), so every session gets its own mean and sigma bands")

grpD   = "Display"
tszStr  = input.string("normal", "Table text size", options = ["small", "normal", "large"], group = grpD)
biasPos = input.string("top right", "Bias card position", options = ["top left", "top right", "middle left", "middle right", "bottom left", "bottom right"], group = grpD)
lvlPos  = input.string("bottom left", "Sweep scoreboard position", options = ["top left", "top right", "middle left", "middle right", "bottom left", "bottom right"], group = grpD)

inRTH    = not na(time(timeframe.period, rthSess, tz))
rthStart = inRTH and not inRTH[1]
rthEnd   = not inRTH and inRTH[1]
mins     = hour(time, tz) * 100 + minute(time, tz)
isIdx    = preset == "Index"

tsz    = tszStr == "small" ? size.small : tszStr == "large" ? size.large : size.normal
C_LBL  = color.rgb(42, 49, 64)          // slate cells, readable on light and dark
get_pos(p) =>
    p == "top left" ? position.top_left : p == "top right" ? position.top_right :
     p == "middle left" ? position.middle_left : p == "middle right" ? position.middle_right :
     p == "bottom left" ? position.bottom_left : position.bottom_right

// ========================= FP1 layer: session map =============================
t1 = b1on and not na(time(timeframe.period, b1s, tz))
t2 = b2on and not na(time(timeframe.period, b2s, tz))
t3 = b3on and not na(time(timeframe.period, b3s, tz))
t4 = b4on and not na(time(timeframe.period, b4s, tz))
t5 = b5on and not na(time(timeframe.period, b5s, tz))
bandId = t1 ? 1 : t2 ? 2 : t3 ? 3 : t4 ? 4 : t5 ? 5 : 0
boxMode = useBands and bandStyle == "Range boxes"
// Background style: full-height tint
bgcolor(useBands and not boxMode and t1 ? color.new(b1c, bandT) : na)
bgcolor(useBands and not boxMode and t2 ? color.new(b2c, bandT) : na)
bgcolor(useBands and not boxMode and t3 ? color.new(b3c, bandT) : na)
bgcolor(useBands and not boxMode and t4 ? color.new(b4c, bandT) : na)
bgcolor(useBands and not boxMode and t5 ? color.new(b5c, bandT) : na)
bgcolor(useMap and not useBands and not inRTH ? color.new(color.blue, 96) : na)

// Range-box style (killzone look, after ICT Killzones [TFO]; implementation
// ours): one box per session hugging its running high-low range, session name
// inside, last maxSess sessions kept.
f_band(bool active, color c, string nm, array<box> bxs) =>
    if boxMode
        if active and not active[1]
            array.unshift(bxs, box.new(time, high, time, low, xloc = xloc.bar_time,
                 border_color = color.new(c, 45), bgcolor = color.new(c, bandT),
                 text = nm, text_color = color.new(c, 45), text_size = size.large))
            if array.size(bxs) > maxSess
                box.delete(array.pop(bxs))
        if active and array.size(bxs) > 0
            bx = array.get(bxs, 0)
            box.set_right(bx, time)
            box.set_top(bx, math.max(box.get_top(bx), high))
            box.set_bottom(bx, math.min(box.get_bottom(bx), low))

var bx1 = array.new_box()
var bx2 = array.new_box()
var bx3 = array.new_box()
var bx4 = array.new_box()
var bx5 = array.new_box()
f_band(t1, b1c, "Asia", bx1)
f_band(t2, b2c, "London", bx2)
f_band(t3, b3c, "NY AM", bx3)
f_band(t4, b4c, "NY Lunch", bx4)
f_band(t5, b5c, "NY PM", bx5)

// Day dividers: dotted vertical line at each new calendar day (chart timezone
// setting tz), weekday label at the pane bottom.
newDay = ta.change(dayofweek(time, tz)) != 0
var dayLines = array.new_line()
if showDays and newDay
    array.unshift(dayLines, line.new(bar_index, high, bar_index, low, extend = extend.both,
         color = color.new(color.gray, 70), style = line.style_dotted))
    if array.size(dayLines) > 8
        line.delete(array.pop(dayLines))
dowNow = dayofweek(time, tz)
plotchar(showDays and newDay and dowNow == 1, "Sun", "", location.bottom, text = "SUNDAY",    textcolor = color.new(color.gray, 40), size = size.tiny)
plotchar(showDays and newDay and dowNow == 2, "Mon", "", location.bottom, text = "MONDAY",    textcolor = color.new(color.gray, 40), size = size.tiny)
plotchar(showDays and newDay and dowNow == 3, "Tue", "", location.bottom, text = "TUESDAY",   textcolor = color.new(color.gray, 40), size = size.tiny)
plotchar(showDays and newDay and dowNow == 4, "Wed", "", location.bottom, text = "WEDNESDAY", textcolor = color.new(color.gray, 40), size = size.tiny)
plotchar(showDays and newDay and dowNow == 5, "Thu", "", location.bottom, text = "THURSDAY",  textcolor = color.new(color.gray, 40), size = size.tiny)
plotchar(showDays and newDay and dowNow == 6, "Fri", "", location.bottom, text = "FRIDAY",    textcolor = color.new(color.gray, 40), size = size.tiny)
mark(cond, col) =>
    useMap and cond ? color.new(col, 82) : na
bgcolor(mark(isIdx     and mins == 930,  color.teal))
bgcolor(mark(isIdx     and mins == 1000, color.orange))
bgcolor(mark(isIdx     and mins >= 1550 and mins < 1600, color.maroon))
bgcolor(mark(not isIdx and mins == 530,  color.orange))
bgcolor(mark(not isIdx and mins == 1000, color.orange))
bgcolor(mark(not isIdx and mins == 1330, color.maroon))
bgcolor(mark(not isIdx and mins == 2215, color.purple))

// Anchor: classic RTH-only, or per session band (each killzone gets its own
// mean and sigma - the value-proxy resets at every band open). Same math,
// different clock; the RTH mode remains the validated convention.
perBand = vwapMode == "Session bands"
inVW    = perBand ? bandId != 0 : inRTH
vwStart = perBand ? bandId != 0 and bandId != bandId[1] : rthStart
var float sPV = na
var float sV = na
var float sP2V = na
if vwStart
    sPV := 0.0
    sV := 0.0
    sP2V := 0.0
if inVW
    p = hlc3
    sPV  := nz(sPV)  + p * volume
    sV   := nz(sV)   + volume
    sP2V := nz(sP2V) + p * p * volume
vwap = sV > 0 ? sPV / sV : na
sig  = sV > 0 ? math.sqrt(math.max(sP2V / sV - vwap * vwap, 0)) : na
plot(useMap and inVW ? vwap : na,       "sVWAP", color.new(color.blue, 0),  2, plot.style_linebr, display = display.pane)
plot(useMap and inVW ? vwap + sig : na, "VAH~",  color.new(color.blue, 55), 1, plot.style_linebr, display = display.pane)
plot(useMap and inVW ? vwap - sig : na, "VAL~",  color.new(color.blue, 55), 1, plot.style_linebr, display = display.pane)

var float rthClose = na
var float priorClose = na
if rthEnd
    priorClose := rthClose
if inRTH
    rthClose := close
plot(useMap ? priorClose : na, "prior RTH close", color.new(color.gray, 30), 1, plot.style_linebr, display = display.pane)

// ========================= FP3 layer: HTF bias card ===========================
// The drift SMA is computed INSIDE the daily context (request.security
// expression), so it uses the daily feed's full history - it fills even when
// the intraday chart itself holds only a few weeks of bars. [1] = yesterday's
// completed value: no lookahead, no repaint.
onDrift = request.security(syminfo.tickerid, "D",
     ta.sma(open / close[1] - 1, winN)[1], lookahead = barmerge.lookahead_off) * 1e4
dSMA    = request.security(syminfo.tickerid, "D", ta.sma(close[1], smaN), lookahead = barmerge.lookahead_off)
trendUp = close > dSMA
biasLong  = trendUp and onDrift > 0
biasShort = not trendUp and onDrift < 0

var biasTbl = table.new(get_pos(biasPos), 2, 3, border_width = 1)
if barstate.islast and useBias
    bias = biasLong ? "LONG" : biasShort ? "SHORT" : "NEUTRAL"
    bcol = biasLong ? color.teal : biasShort ? color.maroon : color.gray
    table.cell(biasTbl, 0, 0, "ON drift " + str.tostring(winN) + "d", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(biasTbl, 1, 0, na(onDrift) ? "warmup" : str.tostring(onDrift, "#.##") + " bps/n", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(biasTbl, 0, 1, "trend vs " + str.tostring(smaN) + "d", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(biasTbl, 1, 1, trendUp ? "above" : "below", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(biasTbl, 0, 2, "BIAS", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(biasTbl, 1, 2, bias, text_color = color.white, bgcolor = bcol, text_size = tsz)

// ==================== FP6 layer: levels + sweep scoreboard ====================
var float dayH = na
var float dayL = na
var float pdh = na
var float pdl = na
var float onH = na
var float onL = na
var float onHf = na
var float onLf = na
var float orH = na
var float orL = na
var int orEndT = na
if rthStart
    pdh := dayH
    pdl := dayL
    dayH := high
    dayL := low
    onHf := onH
    onLf := onL
    orH := high
    orL := low
    orEndT := time + orMins * 60000
if inRTH
    dayH := math.max(nz(dayH, high), high)
    dayL := math.min(nz(dayL, low), low)
    if time < orEndT
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low), low)
if rthEnd
    onH := high
    onL := low
if not inRTH
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)

plot(useLvls and inRTH ? pdh : na, "PDH", color.new(color.maroon, 30), 1, plot.style_linebr, display = display.pane)
plot(useLvls and inRTH ? pdl : na, "PDL", color.new(color.teal, 30), 1, plot.style_linebr, display = display.pane)
plot(useLvls and inRTH ? onHf : na, "ON high", color.new(color.maroon, 65), 1, plot.style_linebr, display = display.pane)
plot(useLvls and inRTH ? onLf : na, "ON low", color.new(color.teal, 65), 1, plot.style_linebr, display = display.pane)
plot(useLvls and inRTH and time >= orEndT ? orH : na, "OR high", color.new(color.orange, 45), 1, plot.style_linebr, display = display.pane)
plot(useLvls and inRTH and time >= orEndT ? orL : na, "OR low", color.new(color.orange, 45), 1, plot.style_linebr, display = display.pane)

evalLevel(bool active, float lvl, bool upSide, int state, int sinceBreach) =>
    s = state
    sb = sinceBreach
    failed = false
    if active and not na(lvl)
        if s == 0 and (upSide ? high > lvl : low < lvl)
            s := 1
            sb := 0
        else if s == 1
            sb += 1
            if upSide ? close < lvl : close > lvl
                failed := true
                s := 2
            else if sb >= failK
                s := 2
    [s, sb, failed]

var int s1 = 0
var int b1 = 0
var int s2 = 0
var int b2 = 0
var int s3 = 0
var int b3 = 0
var int s4 = 0
var int b4 = 0
if rthStart
    s1 := 0
    s2 := 0
    s3 := 0
    s4 := 0
[ns1, nb1, f1] = evalLevel(useLvls and inRTH, pdh,  true,  s1, b1)
[ns2, nb2, f2] = evalLevel(useLvls and inRTH, pdl,  false, s2, b2)
[ns3, nb3, f3] = evalLevel(useLvls and inRTH, onHf, true,  s3, b3)
[ns4, nb4, f4] = evalLevel(useLvls and inRTH, onLf, false, s4, b4)
s1 := ns1
b1 := nb1
s2 := ns2
b2 := nb2
s3 := ns3
b3 := nb3
s4 := ns4
b4 := nb4
anyFailUp = f1 or f3
anyFailDn = f2 or f4
plotshape(useLvls and anyFailUp, "failed break high", shape.labeldown, location.abovebar, color.maroon, text = "sweep x", textcolor = color.white, size = size.tiny)
plotshape(useLvls and anyFailDn, "failed break low",  shape.labelup,   location.belowbar, color.teal,   text = "sweep x", textcolor = color.white, size = size.tiny)

var int swDone = 0
var int swFail = 0
trans(prev, now) =>
    prev == 1 and now == 2
if trans(s1[1], s1)
    swDone += 1
if trans(s2[1], s2)
    swDone += 1
if trans(s3[1], s3)
    swDone += 1
if trans(s4[1], s4)
    swDone += 1
if anyFailUp or anyFailDn
    swFail += 1

var lvlTbl = table.new(get_pos(lvlPos), 2, 2, border_width = 1)
if barstate.islast and useLvls
    table.cell(lvlTbl, 0, 0, "sweep events", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(lvlTbl, 1, 0, str.tostring(swDone), text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(lvlTbl, 0, 1, "% failed (context)", text_size = tsz, text_color = color.white, bgcolor = C_LBL)
    table.cell(lvlTbl, 1, 1, swDone > 0 ? str.tostring(100.0 * swFail / swDone, "#.#") + "%" : "-", text_size = tsz, text_color = color.white, bgcolor = C_LBL)

// ================================ alerts ======================================
alertcondition(biasLong  and not biasLong[1],  "Bias -> LONG",  "FP0: overnight drift + trend aligned long")
alertcondition(biasShort and not biasShort[1], "Bias -> SHORT", "FP0: overnight drift + trend aligned short")
alertcondition(anyFailDn, "Sweep failure at a LOW",  "FP0: failed break below PDL/ON low (context only)")
alertcondition(anyFailUp, "Sweep failure at a HIGH", "FP0: failed break above PDH/ON high (context only)")
