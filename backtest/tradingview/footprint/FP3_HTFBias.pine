//@version=6
// FP3 - HTF BIAS: OVERNIGHT/INTRADAY FLOW DECOMPOSITION (module 3 of 7) ---------
// The honest version of "institutional flow". Our round-30 study on 21 years of
// index data: the equity drift lives almost entirely CLOSE -> OPEN (SPX +2.3,
// NDX +3.8 bps per night gross, stable across both decade-halves); open->close
// is ~nothing. Whoever is patiently accumulating does it around the close and
// overnight - that persistent pressure is the most defensible "smart money"
// bias available from bars. (Costs kill it as a standalone trade - round 30 -
// its job here is DIRECTIONAL BIAS for other setups, nothing more.)
indicator("FP3 HTF Bias", overlay = false)

winN   = input.int(63, "Drift window (days)", minval = 20)
smaN   = input.int(200, "Trend SMA (days)", minval = 50)

// All daily figures computed INSIDE the daily context (request.security
// expressions with [1] = yesterday's completed value): they use the daily
// feed's full history, fill regardless of intraday chart depth, and cannot
// repaint or look ahead.
[onDriftRaw, cumON, cumID] = request.security(syminfo.tickerid, "D",
     [ta.sma(open / close[1] - 1, winN)[1],
      ta.cum(nz(open / close[1] - 1))[1],
      ta.cum(nz(close / open - 1))[1]], lookahead = barmerge.lookahead_off)
onDrift = onDriftRaw * 1e4                 // bps/night
dSMA    = request.security(syminfo.tickerid, "D", ta.sma(close[1], smaN), lookahead = barmerge.lookahead_off)
trendUp = close > dSMA

// Combined bias: overnight drift sign agrees with the slow trend -> conviction;
// disagreement -> stand down. This is a FILTER for other modules' setups.
biasLong  = trendUp and onDrift > 0
biasShort = not trendUp and onDrift < 0

plot(cumON * 100, "cum overnight ret %", color.new(color.teal, 0), 2)
plot(cumID * 100, "cum intraday ret %", color.new(color.orange, 0), 2)
hline(0, "0", color.gray, hline.style_dotted)

var tbl = table.new(position.top_right, 2, 3, border_width = 1)
if barstate.islast
    bias = biasLong ? "LONG" : biasShort ? "SHORT" : "NEUTRAL"
    bcol = biasLong ? color.teal : biasShort ? color.maroon : color.gray
    table.cell(tbl, 0, 0, "ON drift " + str.tostring(winN) + "d", text_size = size.small)
    table.cell(tbl, 1, 0, (na(onDrift) ? "warmup" : str.tostring(onDrift, "#.##") + " bps/n"), text_size = size.small)
    table.cell(tbl, 0, 1, "trend vs " + str.tostring(smaN) + "d", text_size = size.small)
    table.cell(tbl, 1, 1, trendUp ? "above" : "below", text_size = size.small)
    table.cell(tbl, 0, 2, "BIAS", text_size = size.small)
    table.cell(tbl, 1, 2, bias, text_color = color.white, bgcolor = bcol, text_size = size.small)

alertcondition(biasLong  and not biasLong[1],  "Bias -> LONG",  "FP3: overnight drift + trend aligned long")
alertcondition(biasShort and not biasShort[1], "Bias -> SHORT", "FP3: overnight drift + trend aligned short")
