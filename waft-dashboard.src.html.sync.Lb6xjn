var SCENARIOS = [
  { id:"A", name:"The break was a flush and the shelf is reclaimed", prob:45, st:"good",
    tag:"The condition this branch wrote for itself has FIRED: ES closed the cash session inside its shelf &mdash; the 19:55Z auction bar, seventy-eight thousand contracts, closed 7,778.50 &mdash; the full cash-session close this branch said would make it live again. RTY came within two points of joining it and did not. ||| Each contract still has a dense shelf, a hollow directly beneath it, and the balance this board was describing two days ago beneath the hollow; that part is measured rather than argued. ES reclaimed its shelf three times today &mdash; the payrolls half-hour, then again after a midday fade pressed the floor from beneath, and then for keeps: the cash session CLOSED at 7,778.50, inside 7,760.00 to 7,785.00, after trading 7,786.75 through the shelf&rsquo;s top. It is {{px ES}} in the evening stub. RTY got to 3,041.00 on Thursday, 3,040.00 at the print, and 3,046.80 in the afternoon &mdash; its first trade INSIDE the lost shelf &mdash; but closed 3,040.90, two points under the 3,043.00 floor: its half of the reclaim printed intraday and did not close. A reclaim that printed and failed on both contracts was why this branch was cut to 30; the payrolls bid took it back to 40; the cash close its own text demanded is why it carries 45 tonight &mdash; with the two points RTY still owes named as the reason it is not higher. What still argues for it is the one thing that has not stopped: the shelf gets HEAVIER while it breaks. {{above RTY 3043.00}}% of the window traded at or above 3,043.00, against the 11.06 per cent the same measurement carried yesterday, because the selling kept leaving volume behind in it on the way down. Inventory changing hands is not inventory leaving &mdash; and today the hands that took it showed up: the afternoon traded INTO the shelf on both contracts, and on ES it closed there.",
    rows:[
      ["RTY", "The shelf runs <b>3,043.00</b> to <b>3,050.00</b>, eight bins, and <b>3,046.00</b> is the heaviest of them at {{share RTY 3046.00}}%, though no longer the cash-session point of control &mdash; the payrolls volume moved that crown down to the <b>3,035.00</b> bin. Spot at {{px RTY}} finished the cash session two points of travel from the floor it lost &mdash; it was thirty-four points away at the European low, thirteen after the payrolls half-hour, and 3,046.80 printed INSIDE the shelf in the afternoon before the close backed off to just beneath it. The structure had never had to defend itself, then it did and it lost, and the walk back this row was waiting for has now been attempted and failed &mdash; RTY traded 3,041.00 at 22:20 HKT, two points short of 3,043.00, and gave the whole move back inside two hours. A failed reclaim is worse for this branch than no reclaim at all, because it prices who was willing to buy it. That was Thursday&rsquo;s verdict; the payrolls print has forced a second vote &mdash; a 95th-percentile half-hour carried RTY from the day&rsquo;s low region to 3,040.00, one point shy of Thursday&rsquo;s failed-reclaim high, and it now trades from the middle of the ladder rather than staring up at it from the floor. The afternoon held the third vote: 3,046.80 traded, THROUGH the floor and inside the shelf, before the close settled two points back beneath it &mdash; each attempt has ended higher than the last, which is the shape of a level being worn down rather than defended. The ladder this branch had to climb was climbed on Friday and eaten on the way up, and the weekend has put one rung back &mdash; on paper rather than on the tape, which is a distinction worth the sentence. WITHDRAWN &mdash; this row said <b>3,030.44</b> was still absent and that nothing had re-formed there. Both halves were false the day they were written, and what has happened since is the more useful fact: the pool that re-formed keys <b>{{pool RTY 3029.48}}</b>, carries {{turns RTY 3029.48}} turns and was last touched {{age RTY 3029.48}} hours ago, and it has drifted to the far edge of the tolerance that lets this page call two prices one object. A little further and they stop being one object &mdash; not because anything traded there, but because a cluster boundary moved under a level nobody has been near in days. Emptied, rebuilt and then quietly re-keyed is a different history from emptied and left empty, and the last of those three steps is the one no chart will show you. The rung above it came back on the map overnight, and this line then said it had gone again. That claim is WITHDRAWN rather than restated: what stands in that band now is {{pool RTY 3038.54}}, and an absence cannot be asserted at a price a pool occupies. The level was listed, de-listed and listed again inside three sessions before this row stopped watching it, which is the behaviour worth carrying forward &mdash; not any one of those states. Twice in three sessions this level has been listed and de-listed without the market doing anything there, which is worth more as a warning about the measurement than as news about the level &mdash; a cluster boundary a few tenths wide will hand you a pool and take it away again on the same tape. Overhead is NOT unchanged, and that is the finding. The rung that stood at the top of the shelf is no longer on the map at all &mdash; it was not taken, it dissolved as Monday and Tuesday re-formed the clustering beneath it. <b>{{gone RTY 3046.45}}</b> is WITHDRAWN &mdash; nothing is clustered there now &mdash; and so is {{gone RTY 3036.52}}. THE CONSOLIDATION IS THE FINDING, and it is larger than either withdrawal. Three shelves this row described separately inside a ten-point band have become one object over eleven days: <b>{{pool RTY 3038.54}}</b> now holds {{turns RTY 3038.54}} turns, {{mix RTY 3038.54 RTH}} of them cash-made, last touched {{age RTY 3038.54}} hours ago. It is not one of the three relocated. At 0.23, 2.02 and 7.91 bins from the prices they were keyed to, no single predecessor is near enough to be the same structure under a new key; what happened is that a band this row read as three separate rungs traded into one shelf, and the count that matters is the new object&rsquo;s, not the sum of theirs. <b>3,002.00</b> is the other anchor and it is still the low of the trailing day, thirty-nine points beneath the close &mdash; the standing start at the bottom of the day was converted into the top of the ladder inside one session. Note what kept moving, because it finally moved the other way: 3,015.00 was the low when this row was first written and price made a lower one three times; today it made a HIGHER high three times through the payrolls session and the afternoon."],
      ["ES",  "The same structure at a different scale, and the day ended it split finer than any session yet: ES closed the cash session inside its shelf; RTY traded inside its own &mdash; 3,046.80 against a 3,043.00 floor &mdash; and could not close there. The convergence of damage this row opened with is gone; what is left is a two-point question on the smaller contract. <b>7,760.00</b> to <b>7,785.00</b> is eleven bins, {{range ES 7760.00 7785.00}}% of the window between them, and still the densest stretch on the ES map. What it carries has now resolved three times in one day. At the print the payrolls bid consumed everything resting at <b>7,766.49</b>; the level rebuilt within the hour as price camped on it; the afternoon walk consumed it AGAIN on the way to the close &mdash; and it has REBUILT A THIRD TIME since. <b>{{pool ES 7764.68}}</b> now carries {{turns ES 7764.68}} turns &mdash; heavier than either of the rebuilds described above, and the heaviest this level has held all week. That is the SIXTH state of one level: emptied, defended-and-losing, consumed, rebuilt, consumed again, and now rebuilt heavier than before. The absence this row used to record has been overtaken; the level is back and it is thicker than it was. This row spent the week reading the level as defended-and-losing while price walked away; the day validated the defence twice over, and the second consumption is the cleaner signal: resting interest at the centre of the shelf keeps getting filled in the buyers&rsquo; direction and keeps re-forming until it is filled again. It sits under the cash point of control, which Wednesday's session moved to <b>7,772.50</b>, so the price the session keeps turning at and the price it spent its time at are the same price. What has changed is the distance. The trailing range now runs <b>7,725.50</b> to <b>7,786.75</b>; ES spent the European morning near the bottom of it, the payrolls half-hour carried it back to the top quarter, and the cash close printed 7,778.50 &mdash; the top sixth of the day, inside the shelf. The void underneath did not fill on the way up: from <b>7,640.00</b> to <b>7,745.00</b> there are forty-three bins, {{range ES 7640.00 7745.00}}% of the window between all of them, {{rangebin ES 7640.00 7745.00}}% a bin against a 0.53% average for the contract &mdash; ES fell into that stretch on Thursday and has been lifted back out, so the hollow is once again beneath price rather than around it. <b>7,636.42</b> is the first real structure beneath the fresh pools, well over a hundred points down. The narrowing this row was watching resolved in one half-hour: the reclaim both contracts needed, ES was handed intraday &mdash; RTY&rsquo;s never quite printed &mdash; and what neither has is the cash close that turns an intraday visit into a reclaim."],
      ["HSI", "The reference close stays flagged and stays untrusted, so read the session in its own prices. Friday&rsquo;s HK session is the first counter-example in five days: it opened at 25,526.65, traded to 25,669.52, and finished at 25,668.03 &mdash; parked on its own high, the first session this week HK has closed on strength inside its own hours rather than selling it. One session against four is a change of behaviour rather than a change of regime. Note the direction, because it rhymes with the rest of this branch: HK stopped selling on the same day the payrolls bid stopped the RTY slide."]
    ],
    invalid:"CALL: this branch was tradeable on Thursday and it lost, and that is the first thing on it. The trigger as written &mdash; long ES on a five-minute close back above 7,760.00, stop under 7,746.75 &mdash; printed at 14:00Z on the leg that carried to 7,768.50, and the stop printed at 15:15Z on a five-minute close of 7,739.25. Call it twenty-two points against, taken exactly as specified, recorded here rather than quietly re-specified afterwards. The RTY half of the same call never triggered at all: it needed a cash bar closing back above 3,043.00 and the high of the day was 3,041.00, two points short &mdash; so the contract this board told you NOT to buy is the one that cost nothing. It is worth naming why the ES trigger was a bad trigger before it was a losing one. ES closed a five-minute bar on the other side of 7,760.00 twenty-five separate times that Thursday. A level-close entry on a price oscillating through that level is not an entry, it is a coin flip with commission attached, and the repair is a distance or a persistence filter rather than a different level: a close a full point clear of it, or two consecutive closes on the same side. RE-ENTRY, because this is a re-entry board and not a management one: the payrolls print has moved this branch from &lsquo;no long here&rsquo; to &lsquo;restore condition live&rsquo;. THE CONDITION HAS FIRED. This row demanded a full cash-session close inside 7,760.00 to 7,785.00 &mdash; not a five-minute close, not a payrolls spike &mdash; and the bell delivered exactly that: the closing auction printed 7,778.50, eighteen points inside the floor, after the fade this row feared pressed 7,760.00 from beneath at midday and was bought back. The slower timeframe was chosen for precisely today and it did its job in both directions: it kept this branch out of the morning whipsaw, and it certifies the reclaim now. What the weekend holds: the branch is live by its own written test; RTY&rsquo;s half remains unclosed (3,046.80 traded, 3,040.90 closed, floor at 3,043.00); and Monday opens on a gap this page cannot see past. WHAT WOULD BREAK IT from here: a Monday open that trades back under 7,760.00 and stays there through the first hour &mdash; a reclaim that fails over a weekend is Thursday&rsquo;s lesson at a larger scale. Two calibration notes that still apply. In cash hours the reach model UNDER-states ES travel by 25%, so ES levels arrive sooner than the arithmetic says once the bell rings; on RTY it OVER-states by 18% in cash hours, so RTY levels are further away than the board reads. And the archive behind this window is a SIX-MINUTE SAMPLE rather than a tape: it can establish that a level was crossed and can never establish that one was untouched." },
  { id:"B", name:"The break continues and the hollow does its work", prob:30, st:"warning",
    tag:"Both contracts confirmed it on Thursday; the payrolls print bought half of it back and the cash close bought most of the rest, which is why this branch ends the week second on the board. ||| RTY did not fall THROUGH the hollow on Thursday, it filled the hollow and then fell out of the bottom of it: between 3,019.00 and 3,042.00 there are twenty-four bins, and the 7.04% of the window they held when this branch was written has become {{range RTY 3019.00 3042.00}}% &mdash; {{rangebin RTY 3019.00 3042.00}}% a bin against a 0.65% average for the contract, so the stretch price was supposed to drop through ended up DENSER than the map around it. That read like a defeat for this branch and was scored the opposite while spot sat beneath the stretch; the payrolls half-hour has flipped the side that mattered. Spot is {{px RTY}}, back INSIDE the stretch, trading through inventory this branch needs to act as a ceiling. ES un-confirmed at the same moment and then buried the case at the bell: it CLOSED the cash session inside its shelf, at 7,778.50. This branch needed the print&rsquo;s move to fail &mdash; a 30-minute close back under 3,015.00 &mdash; and got the opposite: RTY closed twenty-six points above that line after trading inside its own shelf. What this branch keeps is the record, and one live fact: the RTY close still sits under 3,043.00, so the break has been un-broken everywhere except the one line that started it.",
    rows:[
      ["RTY", "Price WAS out of the hollow, out of the BOTTOM of it, for exactly one overnight session &mdash; the sentence this row waited three refreshes to write, un-written by the payrolls print inside half an hour. Between <b>3,019.00</b> and <b>3,042.00</b> there are twenty-four bins, and the 7.04% of the window they held when this row was written has become {{range RTY 3019.00 3042.00}}% &mdash; {{rangebin RTY 3019.00 3042.00}}% a bin against a 0.65% average for the contract, so the twenty-three points price was supposed to fall through ended up thicker than the map around them. The heaviest of them is <b>3,035.00</b> at {{share RTY 3035.00}}%, and every bit of that weight was laid down by the session that was meant to be falling through it. What matters is which side of it price stands on, and the payrolls half-hour changed the answer. Spot at {{px RTY}} is no longer beneath the stretch, it is back inside it, trading through the inventory this row read as a ceiling &mdash; and two full sessions have since been dealt inside it, which has rebuilt this part of the map rather than confirmed the old reading of it. Monday sold RTY 10.90 points while ES held its bid; Tuesday inverted that exactly, RTY taking 14.50 back while ES gave up 15.50 &mdash; opposite directions on consecutive days, both of them transacted here. What they left is three clusters where this row saw inventory it expected to be crossed once: <b>{{pool RTY 3029.48}}</b> and <b>{{pool RTY 3022.05}}</b>, plus a third that is now <b>{{gone RTY 3036.52}}</b> &mdash; WITHDRAWN, with nothing clustered at that price any more. The two that stand carry {{turns RTY 3029.48}} and {{turns RTY 3022.05}} turns respectively. That last one has been taken into {{pool RTY 3038.54}}, {{turns RTY 3038.54}} turns, which formed across the band above it. So this part of the map is no longer three objects rather than one: the upper two of the three have become the one. <b>3,030.44</b> was run clean out of the map by the payrolls bid, and it has since rebuilt &mdash; the first of the three clusters above IS that level re-formed, keyed <b>{{pool RTY 3029.48}}</b> and carrying {{turns RTY 3029.48}} turns. This row asserted it was gone for two days while listing it three sentences earlier. The rung above briefly re-appeared under a new key overnight and is now unlisted again, its turns having been Friday&rsquo;s all along &mdash; a boundary redrawn twice, not a level rebuilt. What this row was watching as ceiling was traded through on Friday, in the direction that argues against the branch writing it, and nothing since has tested that verdict. The day&rsquo;s high at <b>3,041.00</b> was the top of Thursday&rsquo;s failed attempt, and the payrolls push has now printed 3,040.00, one point shy of it &mdash; twice rejected two-and-change under the shelf floor is the strongest fact left on this row&rsquo;s side. <b>3,002.00</b> is the trailing day&rsquo;s low, thirty-nine points beneath the close: the fresh session opened in the bottom of the old one and the payrolls day lifted it all the way out. Underneath is where the map has gone thin, which is the other half of the change. The four bins from <b>3,015.00</b> to <b>3,018.00</b> are {{range RTY 3015.00 3018.00}}% of the window between all of them, {{rangebin RTY 3015.00 3018.00}}% a bin &mdash; thicker than the map&rsquo;s 0.65% average, and spot has been carried back above them &mdash; the thin stretch beneath is underfoot again rather than the air price was falling through. The thin part starts under 3,015.00 and runs down. Widen it and the picture holds: <b>2,988.00</b> to <b>3,015.00</b> is twenty-eight bins, {{range RTY 2988.00 3015.00}}% of the window between all of them, {{rangebin RTY 2988.00 3015.00}}% a bin. <b>3,005.00</b> at {{share RTY 3005.00}}% is the only thing resembling a shelf in the first twelve points down. Then the shelf Monday&rsquo;s cash session built, where it stops being thin: <b>2,988.00</b> is the densest bin in that stretch. The pool that anchored that stretch is no longer on the map &mdash; three sessions of trade above it re-formed the clustering, and the nearest thing beneath price now is <b>{{pool RTY 3004.01}}</b> at {{turns RTY 3004.01}} turns. The <b>2,951.11 pool</b> has sixteen turns, eight of them Asian, on a round number, and it is the oldest structure on this part of the map by a wide margin. Then <b>2,941.00</b>, and <b>2,936.00</b> &mdash; the old balance&rsquo;s heaviest bin, though no longer the point of control across all hours: one payrolls day moved that crown ninety-nine points up the map, to <b>3,035.00</b>."],
      ["ES",  "The trigger printed a third time and held into Thursday&rsquo;s close; the payrolls print has taken ES back above it, which un-does the difference this row was rewritten to record. The void under the shelf runs from <b>7,640.00</b> to <b>7,757.50</b>: forty-eight bins, {{range ES 7640.00 7757.50}}% of the window between all of them, up from 13.67% when this row was written. Most of that thickening is still at the ceiling &mdash; the five bins from <b>7,747.50</b> up come to {{range ES 7747.50 7757.50}}% between them, and <b>7,752.50</b> alone carries {{share ES 7752.50}}% &mdash; but spot has been carried back OVER that ceiling &mdash; the 13:00Z thirty-minute bar closed at 7,770.25, thirteen points above it. Take those five off and the body, <b>7,640.00</b> to <b>7,745.00</b>, forty-three bins, comes to {{range ES 7640.00 7745.00}}% of the window between all of them, {{rangebin ES 7640.00 7745.00}}% a bin against a 0.53% average for the contract. ES fell inside that on Thursday and has been lifted back out. A hundred points of thin, and spot spent the European morning in it &mdash; a sentence this row got to keep for one session before the print un-wrote it. What it is doing in there deserves more attention than the fact that it is there. <b>7,735.00</b> at {{share ES 7735.00}}% is the heaviest bin in the entire body of the void, with <b>7,732.50</b> at {{share ES 7732.50}}% just beneath it, and neither was there on Thursday morning, so Thursday&rsquo;s session filled the void from the top downward as it walked. That slow work was the shape of a void being worked rather than gapped &mdash; and it is why the payrolls reversal weighs so much here: levels built at walking pace are real, and they traded back through in one half-hour anyway. What it lands on is the densest thing ES has built all week. <b>7,632.50</b> at {{share ES 7632.50}}% is the heaviest bin down there, with <b>7,630.00</b> just under it at {{share ES 7630.00}}%, and the <b>7,636.42 pool</b> sits on top of them with twenty-four turns, twelve of them Asian and ten European, and it is the oldest structure in the cluster. That cluster is real support and it is well over a hundred points beneath the market. Beneath it <b>7,552.39</b> is a bin and NOT a pool &mdash; no resting turns are recorded there, only volume traded through it &mdash; and <b>7,470.00</b> is the floor of the balance the market left behind in July."],
      ["HSI", "HK&rsquo;s Friday session came and went without the US delivering anything to gap into &mdash; and then closed on its own high. Whatever this branch does next resolves in US hours and lands on Monday&rsquo;s HK open; carrying it over the weekend gap is a bet on Monday&rsquo;s US tape wearing an HSI ticker, the same trade with worse liquidity and a prior close this page has flagged."]
    ],
    invalid:"CALL: both triggers have now printed and the trade as written has worked, which is a thing this board should say as plainly when it happens as when it does not. On RTY the five-minute close under 3,043.00 came at Thursday&rsquo;s cash open. The sell zone this row specified &mdash; a failure in 3,038.00 to 3,043.00, stop above 3,043.00 &mdash; filled at 22:10 HKT when the reclaim ran to 3,041.00 and turned two points shy of the shelf&rsquo;s floor, and the stop was never threatened because 3,043.00 was never traded. First target 3,021.10 filled in the last half hour of the cash session. Second target 3,005.00 has FILLED &mdash; the low is 3,002.00, three points through it. On ES the restated trigger &mdash; a five-minute close below 7,746.75 &mdash; printed at 15:15Z at 7,739.25 and held through Thursday&rsquo;s close, giving none of it back inside that session. MANAGEMENT, for once, rather than re-entry: the first target is banked, so the runner is free. Stop to entry on the balance, and the level that matters for the rest of it is <b>3,015.00</b>, the floor of the four bins price has just dropped out of. While price stays under it the thin part of the map is doing the work; a reclaim of it puts price back inside a hollow that is now DENSER than the map around it, which is a different trade and not this one. UPDATE AT THE PRINT: that reclaim HAS fired &mdash; the 13:00Z thirty-minute bar closed at 3,032.40, seventeen points back inside the hollow &mdash; so by this row&rsquo;s own sentence the runner&rsquo;s edge is gone. The payrolls session printed 3,040.00 into the 3,038.00-to-3,043.00 entry zone, so the balance is in all likelihood flat at entry under the stop-to-entry rule &mdash; the exact fill decides that, not this page &mdash; and the afternoon settled direction by closing the cash session at 3,040.90, inside the zone itself. What the campaign banked before the print: first target in full, second target in full, and at worst a scratch on the runner. WHAT WOULD BREAK IT: RTY trading back up into 3,043.00 to 3,050.00 and leaving on the upside within the hour, which converts a shelf that broke into a shelf that was defended and is the strongest bullish signal available on this board. UPDATE AT THE CLOSE: the first half of that has happened &mdash; RTY traded 3,046.80, inside the zone &mdash; and the second half has not: it backed out to close 3,040.90, beneath the floor. Entered-and-rejected is not the signal; it is the zone doing its job as supply, and this branch survives the weekend on that two-point rejection. Short of that, the pace hazard this row named has resolved against the branch: the void ES was working one bin at a time gave back the whole walk in a single payrolls half-hour. The scheduled-headline warning written here belonged to an earlier session&rsquo;s clock and retires with the position; the rule it stated survives it &mdash; a thin book plus a scheduled print is how stops become suggestions &mdash; and the next such print belongs to the next brief&rsquo;s calendar, not to this card." },
  { id:"C", name:"It goes back up and retakes the highs", prob:25, st:"warning",
    tag:"A forecast on Tuesday, half-run on Wednesday, failed into Thursday &mdash; then handed a 95th-percentile payrolls print and a cash close that did most of the repair work, which is the whole of the news. ||| RTY has now traded <b>3,046.80</b>, inside the shelf it lost, eleven under the <b>3,058.00</b> top of its window &mdash; and closed two points beneath the shelf floor at <b>3,043.00</b>. ES traded <b>7,786.75</b>, through its shelf&rsquo;s top and thirty-three under its own <b>7,820.00</b>, and closed the cash session at 7,778.50. Neither contract has reached the highs this branch is named after, but both finished the week pointed at them rather than away from them, which no session since Tuesday could say. What kept this branch alive was what stood above and who built it, and half of that has been withdrawn by the tape rather than by me: the shelf-edge pool is off the map. What this row named above spot on RTY, <b>{{gone RTY 3046.45}}</b>, is WITHDRAWN &mdash; nothing is clustered there now, and the weight that was in that band sits in {{pool RTY 3038.54}} instead; the ES structure this row compared against was withdrawn when it left the map, and has since rebuilt: <b>{{pool ES 7821.06}}</b> keys there now on {{turns ES 7821.06}} turns, {{age ES 7821.06}}. So the comparison has both its sides back &mdash; and it is not the comparison this row was written to make, because the ES side is a far heavier object than the one it was weighed against. Read the two as both present and not as equals until someone re-argues it. Where a week ago the only structure above was overnight inventory. A high the bell built is a high the bell has to defend or hand back.",
    rows:[
      ["RTY", "Above <b>3,049.00</b> the map still runs out, and today did not change that. {{above RTY 3049.00}}% of the window traded at or above 3,049.00 &mdash; {{abovebins RTY 3049.00}} bins out of {{bins RTY}}. Seven points higher it collapses: {{above RTY 3056.00}}% of the window traded at or above 3,056.00 &mdash; {{abovebins RTY 3056.00}} bins out of {{bins RTY}}. The high itself is <b>3,058.00</b>, one bin holding {{share RTY 3058.00}}% of the window, the top of the whole measurement and the thinnest print RTY has made in six days. That is a spike rather than an auction: price went up, found nobody, and left. What was up there is no longer up there. That pool has left the map without being traded through &mdash; RTY&rsquo;s high across Monday and Tuesday was 3,045.80, so price never reached it and it was not consumed; the cluster simply re-formed lower and the key went with it. The object this row called the one above spot, <b>{{gone RTY 3046.45}}</b>, is WITHDRAWN &mdash; nothing rests at that price now, so it has no turns, no age and no rank left to quote. What occupies the band is {{pool RTY 3038.54}} at {{turns RTY 3038.54}} turns, {{rank RTY 3038.54}}-heaviest of the RTY stop map by score. Everything scoring at or above it sits BELOW it in price, and Friday&rsquo;s climb took two of them: <b>3,030.44</b> was run straight through by the payrolls bid and has since been re-posted: it keys <b>{{pool RTY 3029.48}}</b> now, carrying {{turns RTY 3029.48}} turns. A level the map stops listing is showing you consumption, the one exit that kind of structure is built for, and Friday printed it twice on the way up &mdash; but consumption is not removal, and this one came back inside three sessions. One of the two flickered back onto the map under a shifted key overnight and has since dropped off it again, carrying turns that predated the reopen throughout; the honest reading is a clustering boundary moving twice, not stops being re-posted over a weekend. That is the finding &mdash; the ladder under the shelf was eaten by exactly the move this branch needed. It also sits on the upper edge of the <b>3,043.00</b> to <b>3,050.00</b> shelf RTY lost on Thursday, so this branch has to travel the whole shelf before it gets there: {{above RTY 3043.00}}% of the window traded at or above 3,043.00 &mdash; {{abovebins RTY 3043.00}} bins out of {{bins RTY}} &mdash; and price is underneath all of it. The measurement beneath has swung all the way to this branch&rsquo;s side in one day. WITHDRAWN &mdash; the all-hours value area no longer tops out at <b>3,060.00</b>, which it did when this was written, at the window high then &mdash; that ceiling stood at 3,020 this morning &mdash; and the busiest price across all hours is now <b>3,035.00</b>. The old balance at 2,936 no longer holds that crown; one payrolls day moved it ninety-nine points up the map. Value did not creep toward the highs, it relocated to them in a single session. Spot at {{px RTY}} finished the cash session inside the new value&rsquo;s upper half. What is left of the bear case here is one line: the shelf floor at 3,043.00, tagged to 3,046.80 and not closed above."],
      ["ES",  "The same region, a completely different answer, and this is the divergence that matters. {{above ES 7787.50}}% of the window traded at or above 7,787.50 &mdash; {{abovebins ES 7787.50}} bins out of {{bins ES}} &mdash; where RTY&rsquo;s equivalent stretch is nearly empty. {{above ES 7810.00}}% of the window traded at or above 7,810.00, {{abovebins ES 7810.00}} bins out of {{bins ES}}. Where RTY has a rounding error near its high, ES has an auction. The strongest single statement on this board about the ES upside is a boundary rather than a level. <b>7,820.00</b> is no longer the top of the window nor, measured across all hours, the upper edge of the 70% value area &mdash; so value expanded all the way to the high instead of being left behind by it. RTY could not say that this morning &mdash; its value area then topped out thirty-eight points beneath its window high &mdash; and by the close it nearly could: one payrolls session expanded RTY&rsquo;s value to within a point of its own high, so the divergence this row was built on has closed. What remains of the old balance is a bin rather than a pool, down there &mdash; the turns that made it are still in the profile, but no cluster keys on them any more. The pool this row quoted here yesterday is no longer on the map at all, which is its own small piece of evidence: the structure down there is thinning rather than building. WITHDRAWN &mdash; yesterday this row said the ES map carried no inferred stop of any kind above 7,782.11. That is no longer true. WITHDRAWN, THEN OVERTAKEN &mdash; and the sequence is the finding. This row said something was now there where nothing had been; the two cash-session turns behind that were thin evidence, a two-turn cluster is the easiest kind to run, and it was duly run, so the point was withdrawn. It has since rebuilt far heavier than it ever was: <b>{{pool ES 7821.06}}</b> holds {{turns ES 7821.06}} turns, {{mix ES 7821.06 A}} of them from Asian hours alone. Emptied, withdrawn, and rebuilt at thirty times the weight is a different history from a level that simply held, and the original claim does not get retrospective credit for it &mdash; what it asserted was run out, and what stands there now was built afterwards by a different session. What changed today is the distance to it, twice. The payrolls half-hour closed most of it, the afternoon closed more, and the cash session ended at 7,778.50 with spot at {{px ES}} in the evening stub &mdash; the top of the map is inside a normal session&rsquo;s reach for the first time since this branch was written. The structure between here and there turned over completely on the way and has since rebuilt: <b>{{pool ES 7764.68}}</b> was consumed at the print, rebuilt within the hour, consumed a SECOND time by the afternoon walk, and now carries {{turns ES 7764.68}} turns again &mdash; while the day&rsquo;s buying left two heavyweights bracketing the close, and the reopen has thickened the upper one. Well beneath, <b>{{gone ES 7755.66}}</b> no longer carries a pool at all &mdash; the structure that stood there has left the map, and it is NOT re-pointed at the nearest survivor: that one is four bins away and is the very level this paragraph has just been discussing, so moving the sentence onto it would make one level stand in for two. OVERTAKEN &mdash; the structure the Asian session built here was withdrawn when it left the map, and the reasoning for withdrawing it rather than re-anchoring was sound WHEN IT WAS WRITTEN: the only candidate then sat 1.25 bins away on a different turn count. It has since been overtaken by events. <b>{{pool ES 7784.43}}</b> is where that cluster keys now, on {{turns ES 7784.43}} turns. When this row called it a re-formation rather than a neighbour it stood just under half a bin from the price the withdrawal named; it has widened since, and the reading that justified the call is no longer the reading the map holds. Heavy enough is still true and is not the half spending itself. Close enough is, and when it runs out the page will stop being able to call the two one object &mdash; a boundary moving rather than a level going anywhere, which is the fact worth carrying &mdash; Friday&rsquo;s closing-auction cluster at the shelf top has been consumed on the way through. At the top of the ES map, the claim this row withdrew has been overtaken: the turns it named were run out, and <b>{{pool ES 7821.06}}</b> has since built {{turns ES 7821.06}} turns in their place. The withdrawal stands as the record of what happened; it is not a description of the map as it is now."],
      ["HSI", "Has the least to say about this branch and should not be asked. Nothing here resolves in HK hours."]
    ],
    invalid:"CALL: no chase, and on RTY no entry at all until branch A has happened first. RTY is beneath the <b>3,043.00</b> shelf it lost at the cash open, so a long here is not a breakout trade, it is a reclaim trade wearing a breakout&rsquo;s clothes, and the two want different stops. The sequence this branch NEEDED on RTY was a cash close back above 3,043.00, then the structure above that line taken and held through a full cash hour on real volume. THE SECOND LEG CANNOT BE SATISFIED AS WRITTEN: that pool is gone from the map, and it went without being traded through, so the condition has been voided by a structure change rather than resolved by the market. It is left as written rather than re-pointed at a nearer price &mdash; quietly moving a trigger onto a different object is how a condition stops meaning what it was agreed to mean. The restatement this row offered is no longer available: it would have pointed the second leg at <b>{{gone RTY 3046.45}}</b>, which is WITHDRAWN and holds nothing to point at. It is NOT re-pointed at {{pool RTY 3038.54}}, the object that consumed that band &mdash; moving a leg onto a structure that formed after the branch was written is the same quiet substitution this paragraph already refuses one sentence above. Only then is the stop under 3,043.00 &mdash; the same line as branch A, because a breakout that needs a different stop from the pullback it replaces is two trades pretending to be one. ES is the cleaner expression and always was on this branch, though it is now under its shelf rather than on it, which puts the trigger further away rather than making it different: a cash close above <b>7,787.50</b>, forty-eight points overhead from here. The stop moves DOWN rather than up, and the reason is a correction. Yesterday this row put it at 7,746.75 on the argument that the line had been closed through twice and reclaimed twice, so price argued about it rather than respecting it. Today it was closed through at 15:15Z and NOT reclaimed &mdash; price has left it, which makes it a poor stop and a worse story. A long that needs a reclaim of 7,787.50 to be right has no business being stopped out above the day&rsquo;s low, so the stop belongs under the session low at <b>7,724.25</b>: wider, fewer contracts, same money at risk. WHAT WOULD BREAK IT: ES back at its own high while RTY is still under 3,043.00. That is the non-confirmation, and note that it has swapped ends since yesterday &mdash; the worry used to be the small cap making a high the broad index could not follow, and today it is the broad index leaving the small cap under a level it already lost. Read it as a warning about the ES long rather than as a reason to buy RTY cheaply. Two measurement caveats belong on any branch that quotes an absence. Every unmapped claim above is a claim about COVERAGE, because the archive samples once every six minutes and can never prove a level was untouched. And that archive begins on 30 July with a thirteen-and-a-half-hour hole in it, plus a second unrecoverable hole of 9.83 hours across Tuesday&rsquo;s Asian and European sessions from the squash." }
];

/* Chain nodes that carry a defeat condition, registered by the chain painter
   and filled by drawChainBi once the ledger's evaluator is in scope. */
var CHAINBI = [];
var CHAINBI_LAST = [];
var CHAIN = [
  { node:"The long end", val:"10-yr 4.69% on the feed &middot; 30-yr 5.22% &mdash; and it IS on this feed now (treasury.gov daily), so the 5.15% regime line is testable from this page: it sits exactly on the 2004&ndash;2007 monthly plateau (5.15&ndash;5.20 at the tops of Aug 04, Jun 06, Jun 07). The last calendar month whose AVERAGE 30-yr sat at or above today&rsquo;s 5.22 was <b>July 2004</b> &mdash; twenty-two years &mdash; measured 7 Aug against the full monthly series since 1977, so &ldquo;multidecade&rdquo; is now a dated fact rather than a headline word &middot; Tuesday cash: RUT +1.850%, NDX beat it by 145bp",
    link:{ to:"RTY / small caps", st:"weakened", label:"TWICE NOW &mdash; a second day of rate relief and the Russell still did not lead",
      why:"The rule rewritten on 28 Jul after it cost money says small caps cannot lead while the long end is under pressure. It has now been handed two clean relief days in a row and it has survived both, and the way it survived them is the part worth being uncomfortable about. Monday: the curve fell five to six basis points at every tenor on the Hormuz de-escalation headline, 2s10s FLATTER rather than steeper, and RUT closed +1.72% against NDX +1.77% &mdash; a dead heat on the exact input this chain has said for a month is the only configuration that lets the Russell lead. Tuesday: another 5.9bp off the ten-year, 4.686% to 4.627%, and RUT closed +1.850%, which is a strong day in isolation and a loss of 145bp to the Nasdaq in the only comparison this node makes. Twice given what it asked for, twice no leadership. The stated break condition &mdash; the thirty-year closing below 5.15% &mdash; is not testable from this page today, because the thirty-year is not on this feed and the last reading held here is Monday&rsquo;s 5.23%. That figure is carried, not current, and it is not restated as though it were. Now the defect, which is in the node rather than in the market. The DEFEAT condition written on 3 Aug is RUT out-gaining NDX by more than 50bp on a day the long end is UNCHANGED &mdash; leadership without permission from rates. The ten-year has moved on every session since it was written. A condition that requires a flat tape in a week that has not produced one cannot fire, and a condition that cannot fire is indistinguishable from a condition that keeps passing, which is the failure this whole board is built against. It is left exactly as written. The alternative is to loosen &lsquo;unchanged&rsquo; until the week can satisfy it, and refitting a rail so a pinned component moves again is how a measurement turns into an opinion &mdash; the oil node below refuses that same trade and this one does not get an exemption for being inconvenient. What it needs is a flat-rates session, and if the week ends without one the condition should be re-specified deliberately and dated, not quietly widened. RE-SPECIFIED 13 AUG, and the paragraph above is left standing because it is the reason this was not done sooner. The week ended without a flat-rates session, which is the trigger that paragraph wrote for itself, so the condition is re-cut here rather than quietly widened &mdash; and the threshold is DERIVED rather than chosen. Across the ten completed US sessions the relay has banked (30 July to 12 August, which is a thin sample and is stated as one), the absolute day-over-day move in the long end sorts to 0, 0, 2, 2, 4, 5, 6, 7, 7, 8 basis points on the ten-year and 0, 1, 1, 3, 4, 5, 5, 6, 7 on the thirty. The bottom quartile of that pooled distribution is TWO BASIS POINTS at both the 25th and the 33rd percentile, so &ldquo;the long end did not move&rdquo; is now two basis points or less on BOTH tenors, measured on treasury.gov closes. Four of those ten sessions qualify, so the condition can fire, which the old one could not. THE NUMBER WAS TAKEN FROM THE DISTRIBUTION AND NOT FROM THE ANSWER, and the reader should be told that the answer is sensitive to it: at one basis point only two sessions qualify and Tuesday 11 August is not one of them; at two, it is. One basis point is roughly the tenth percentile, not the bottom quartile, so it would have to be argued for rather than derived. WHAT THE RE-SPECIFIED CONDITION SAYS ABOUT TUESDAY. On 11 August the ten-year moved two basis points and the thirty-year one, both inside the threshold, and RUT beat NDX by 66 basis points. The DEFEAT fires. The rule that small caps cannot lead while the long end is under pressure has been beaten once, on a session where rates gave no permission either way. THE READING THAT DISAGREES, stated rather than buried, because two honest readings of one sentence is exactly the case this board says to disclose. &ldquo;Unchanged&rdquo; can be read as a magnitude &mdash; the long end did not move &mdash; or as a direction: the long end did not EASE, since the rule has always been about small caps needing relief. Under the direction reading Tuesday is excluded, because both tenors fell, and the node survives. The magnitude reading is adopted, for a reason that is about the rule rather than about the outcome: the node&rsquo;s own examples of &ldquo;clean relief days&rdquo; were five and six basis point moves, so a two basis point drift is inside the noise the rule was never about &mdash; and the direction reading admits one session in ten, which puts the condition straight back where it started, unable to fire. ONE DEFEAT IS NOT A RETIREMENT. It is one session, recorded with its terms, on a rule that has been handed relief twice and refused to lead both times. What it removes is the position this node was in for a week: a claim nothing could contradict." },
    bi:[ { n:"the long-end DEFEAT &mdash; RUT beating NDX by more than 50bp on a session the long end moved 2bp or less (re-specified 13 Aug)",
           legs:[ { src:"chgspread", sym:"RUT", vs:"NDX", op:"above", v:50,
                    label:"RUT over NDX", dp:1, suf:"bp" },
                  { src:"curvechg", sym:"Y10", op:"not_above", v:2,
                    label:"the 10-year&rsquo;s move", dp:1, suf:"bp" },
                  { src:"curvechg", sym:"Y30", op:"not_above", v:2,
                    label:"the 30-year&rsquo;s move", dp:1, suf:"bp" } ] } ] },
  { node:"Megacap concentration", val:"Tuesday cash: NDX beat SPX by 152bp &middot; RUT +1.850% &mdash; the dispersion came back and the re-arm still did not fire",
    link:{ to:"Index level vs breadth", st:"broken", label:"STILL RETIRED &mdash; one leg of the re-arm arrived, the other did not, which is why it was written with two",
      why:"This node was retired on 3 Aug because Friday did not fit it, and the re-arm condition was written down at the same moment: an up day in which NDX out-gains SPX by more than 50bp WHILE RUT is negative. Tuesday delivered the first leg emphatically and the second not at all. NDX beat SPX by 152bp, three times the threshold and the widest dispersion since Friday. RUT closed +1.850%, one of its better sessions of the week. So the tape produced concentration in the growth complex without producing the breadth failure that would make concentration the story, and a node re-armed on the first leg alone would now be back on the board describing a day the small-cap index rose 1.85%. That is the entire argument for writing re-arm conditions with two legs and for not editing one when the other arrives. Dispersion is not direction: everything went up, and the Nasdaq went up more. The live single-name evidence cuts the same way and is worth more than the dispersion figure. AMD reported Tuesday after the close and beat and raised &mdash; revenue $11.54B against roughly $11.25B to $11.31B expected, adjusted EPS $1.66 against $1.60 to $1.62, data-centre revenue doubled, and Q3 guided to about $13.0B plus or minus $300M against a $12.51B consensus &mdash; and fell six and a half to seven per cent in the after-hours session, having come into the print up 142.2% on the year. Palantir reported Monday, beat on every line, guided Q3 to $2.16B, and rose about 10% toward $140. A beat-and-raise sold and a beat-and-raise bought in the same forty-eight hours is a statement about positioning rather than about fundamentals, and the one that was sold was the one that had already tripled. This board should be explicit that it holds no view on AMD. What it holds is the mechanism: if the growth complex is priced past its own delivery, the NDX-over-RUT ordering can inflect without the long end doing anything at all &mdash; which is precisely the test the node above cannot get a flat-rates day to run. Re-arm is unchanged: NDX over SPX by more than 50bp on an up day with RUT negative." } },
  { node:"Dollar and gold", val:"gold 4,229.40, +3.27% from Tuesday&rsquo;s 4,095.40 close, session LOW 4,121.60 &mdash; the whole range above the 4,119.40 trigger &middot; DXY 99.803, session high 99.90, never saw 100",
    link:{ to:"Risk appetite", st:"transmitting", label:"CONFIRMED &mdash; the condition was written in advance and both legs cleared it by a margin",
      why:"CONFIRMED, on a condition written in advance and left alone. This node fired on Thursday because the dollar fell while yields rose and gold was bid, which is an inflation risk premium being demanded rather than financial conditions easing. It lapsed on Friday when the dollar took it back above 100, and the lapse was published, because a warning that never stands down is not a warning, it is a mood. It re-armed on Monday with both legs inside a rounding error &mdash; DXY under 100 by four hundredths, the thirty-year over 5.20% by three basis points &mdash; and this board said out loud that a condition met by 0.04 and 0.03 is met and is also one ordinary hour from not being met. What was missing was the third leg, and the confirm test was stated as exactly that: gold through 4,119.40, the overnight high, while the dollar stays beneath 100. Both halves are now true and the margin is not a rounding error. Gold is 4,229.40, up 3.27% from Tuesday&rsquo;s 4,095.40 close, and the relevant number is not the last print but the session LOW of 4,121.60 &mdash; the entire overnight range traded above the trigger, so this is not a level touched once on a wick. The dollar never saw 100: DXY is 99.803 against a session high of 99.90. Two things have to be said against it, and they are said here rather than after the fact. First, this board cannot see the third leg it was worrying about on Monday: the thirty-year is not on this feed, so whether yields are still elevated while the dollar falls &mdash; the actual shape that made this node mean something &mdash; is not readable today, and the ten-year falling 5.9bp is the wrong sign for the story. A confirm on two legs of a three-leg thesis is a confirm of what was written, and it is weaker than what was meant. Second, this board has not established WHY gold moved and should not furnish a reason it did not measure; a search returned rate-expectation and dollar-weakness framing and nothing that settles it. What can be stated is the mechanical read-across: a three per cent day in the metal with the dollar pinned under 100 is the market paying up for a hedge on the night before ADP and two days before payrolls, and it is not a risk-on tape wearing a different hat. What breaks it now: the dollar closing back above 100, or gold giving back the 4,119.40 line on a session close &mdash; a hundred and ten dollars of room, which is the difference between this reading and Monday&rsquo;s." } },
  { node:"Oil", val:"broken since Sunday&rsquo;s gap under 81 &middot; Tuesday round-tripped 82.25 to 74.25 &middot; re-arm rail 85.94 is eleven and a half dollars away",
    link:{ to:"Headline inflation floor", st:"broken", label:"BROKEN, AND FURTHER FROM RE-ARMING THAN AT ANY POINT SINCE IT WAS WRITTEN",
      why:"This node was written against a floor near 83 and it named its own invalidation in advance: a session close under 81 takes the war premium out of the inflation argument entirely. That break came on Sunday&rsquo;s reopen as a gap &mdash; 84.67 at 22:06Z, 79.55 six minutes later, through 81.51 and 81 and 80 in a single print &mdash; and the node has been broken since. The scored MISS on the Friday call stays exactly as it was scored: a call is judged at its resolution and never re-judged when the market comes round to it over a weekend, and pretending otherwise is how a scorecard becomes fiction. What Tuesday added is a full round trip. Crude ran back to 82.25 and then gave all of it up, trading down to 74.25 &mdash; eight dollars in a session, on the Iran and Oman interim-deal headlines that Trump was trailed to speak to at 20:30Z that evening. The consequence for the chain is unchanged and now larger: with crude beneath the pre-strike floor there is no commodity floor under headline inflation this week, which makes today&rsquo;s ISM services prices-paid component a cleaner read of underlying pressure than it would otherwise be. One thing this node has to disclose about its own evidence. The run to 82.25 falls inside the archive&rsquo;s only unrecoverable hole &mdash; 9.83 hours from 00:25Z to 10:15Z on 4 Aug, destroyed when the droplet squashed the repository and took 4,001 commits with it. So the collapse out of that high is reconstructable from the record and the spike into it is not: the 82.25 figure is carried from the session ledger rather than from anything this page can re-derive. Re-arms above 85.94, a rail dated 30 Jul, and crude is eleven and a half dollars beneath it &mdash; which is the furthest this node has been from re-arming since it was written, and the rail is left uncut on purpose." } },
  { node:"Everything", val:"a payrolls week in which rates have eased twice and small caps have led neither time, no commodity floor under headline inflation, one node confirming on a condition it wrote in advance, and a scheduled headline into the thinnest book of the day", link:null }
];

var CALLS = [
  { d:"7 Aug", cat:"market", c:"Payrolls continuation &mdash; short RTY on a 30-minute close below 3,004.90 after the 12:30Z print, first qualifying close the bar ending 13:00Z; no ES trade between 7,724.25 and 7,745.00; no MHI trade", r:"notrade", o:"NO TRADE, and the entry condition is the whole reason. Targets were 2,992.00, 2,988.00 and a 2,951.11 runner, stop a 30-minute close back above 3,012.00, invalidation a full 30-minute close above 3,015.00. The judged leg was written as a precondition rather than a hope: the trade was live only if the survey internals printed soft. They did not. Payrolls came in hot enough to bid four contracts into their 84th-to-95th percentiles over the 42 minutes bracketing the print, and RTY went the other way from the first bar. THE TRIGGER NEVER FIRED, and it was not close. The first qualifying 30-minute close, the bar ending 13:00Z, printed <b>3,034.50</b> &mdash; not merely above the 3,004.90 entry but 19.5 points above the 3,015.00 invalidation, so the call was dead at the first moment it could be read. The lowest RTY traded at any point after the window opened was <b>3,023.00</b>, eighteen points above the entry, so no entry style would have filled: not a close, not a touch, not a limit sitting at the level. THE PART WORTH KEEPING is what a careless reading would have said. RTY DID trade 3,004.90 &mdash; it printed 3,002.00 at 00:20Z, twelve hours before the trade window opened, on the overnight session this call explicitly stood aside from. A status chip derived from the trailing-day range, which is what this page had until 8 Aug, would have reported the trigger level TRADED and left the reader to work out that it happened half a day early. The window-aware chip shipped that weekend reads the 30-minute closes inside the entry&rsquo;s own stated hours and reported exactly what the archive reports here: invalidated at 13:00Z, never triggered. This resolution is the first live test of that machinery and it agrees with the tape. HOW TO SCORE THIS, and it is a new column rather than a judgement call. The directional read was WRONG &mdash; the tape went up hard and a looser entry would have paid for it. The entry discipline was RIGHT and cost nothing. Filing that as a hit would inflate the record with a trade nobody took; filing it as a miss would punish the one habit worth building. It is counted in neither, and the hit rate above is computed without it. The other two legs stand as written: ES was left alone between 7,724.25 and 7,745.00 and the 13:00Z close at 7,770.25 took it out of that band, which retired the no-trade by its own terms rather than converting it into an entry; MHI was left alone because Hong Kong was shut for the print, which is a decision the clock makes rather than the analyst." },
  { d:"6 Aug", cat:"market", c:"Short RTY on acceptance beneath 3,023.00 &mdash; the shelf broke, the hollow underneath it did NOT fill, and the delta profile says the whole board is standing on a shelf built on top of a void rather than on a floor", r:"miss", o:"Written FLAT, as a re-entry rather than a management decision. The evidence is a bin-for-bin difference of the two most recent profiles, which needs no value-area anchor and is not open to interpretation: every contract traded between the two builds &mdash; 535,732 ES and 52,015 RTY &mdash; landed inside twelve ES bins and eighteen RTY bins, and NOT ONE BIN DECLINED ANYWHERE. That is a shelf thickening on top of a hollow, not a hollow filling. Beneath the session floor RTY falls thirty-one bins from 3,022.00 to the first bin holding even one per cent at 2,991.00, with 8.53% of the window in the gap; ES falls forty-four bins from 7,742.50 to 7,632.50 with 12.23% in the gap. The trade is the retest of 3,024.60&ndash;3,027.30 once 3,023.00 is lost, or a sell-stop at 3,022.50 for anyone who will not sit for the retest. T1 2,999.00, T2 2,991.00, runner 2,936.00. The stop is a 30-minute close above 3,031.20 and that is deliberately not a touch. NO ES TRADE: spot sits nine points from the six-day point of control, which is the definition of no edge. NO HSI TRADE. The reaction function is the other half of the case &mdash; ADP printed 44,000 against a 68,000 forecast and ES moved 2.50 points over forty-two minutes, a 35th-percentile move; ISM services then missed by four tenths with the employment sub at 47.4 and ES fell 10.00, an 80th-percentile move. The tape ignored the jobs miss and sold the services miss, which says it is repricing the SLOPE rather than the number, and AMD beating every line and falling 8.94% after hours says the same thing from the other side of the market. RESOLVED 6 Aug, a MISS, and the way it missed is worth more than the fact that it did. The entry filled: the 30-minute bar to 13:30Z closed 3,022.60, beneath 3,023.00, and the retest zone 3,024.60&ndash;3,027.30 was traded inside the next half hour. The stop then filled too. A 30-minute close above 3,031.20 was written as the stop deliberately, to avoid being taken out on a touch, and it printed TWICE &mdash; 3,036.80 to 14:30Z and 3,031.70 to 15:00Z. Out at roughly eleven to fourteen points against. Direction was right and the trade still lost, which is the only outcome that teaches anything: price never traded 3,043.00, turned at 3,041.00, and has since made the day&rsquo;s low at 3,015.00 &mdash; below the entry, on its way toward a T1 of 2,999.00 that is still eighteen points away. The defect is the stop&rsquo;s LOCATION rather than its timeframe. 3,031.20 sits inside the hollow, three quarters of a point above where 3,030.44 sat before the payrolls bid emptied it &mdash; no turns are listed there now &mdash; with the 3,038.31 pool and its nine turns above that. A stop placed just over a stop pool, inside the one stretch of the map where price has no reason to slow down, is a stop placed where the sweep goes. The rule this earns: in a low-volume pocket the stop belongs ABOVE the pools that pocket contains, not between them &mdash; here that meant 3,043.00, the shelf floor, which was never touched. Wider stop, same size, fewer contracts. That is a real cost and it is smaller than this one was.",
    bi:[ { n:"price trades through 3,031.20 &mdash; the early reading, stricter than the stop",
           win:[13.5, 20], from:1785974400,
           legs:[ { sym:"RTY", src:"px", unit:"quoted", op:"above", v:3031.2,
                    label:"RTY", dp:2, suf:"" } ] },
         { n:"the 30-minute close above 3,031.20 that is the actual stop",
           why:"the ledger measures five-minute bar extremes and has no notion of a thirty-minute close, so it can only read the TOUCH above. Those are different instruments and this board has already paid for confusing them once: on 31 July a call defined on half-hour closes survived while a stop resting at the same number was taken out an hour into the session and did not participate in the thirty-four-point recovery. The condition above will fire before this one does, every time, and it is not a substitute for it." }
 ] },
  { d:"6 Aug", cat:"system", c:"The quote archive stamps thirteen prices with one timestamp &mdash; the instant of the fetch &mdash; so every US futures price in it has been filed ten minutes late since the archive began, and the board published a New York session low that was made in London", r:"hit",
    o:"Each row of archive/quotes is one fetch: a timestamp, then thirteen prices hung off it. The file those prices are lifted FROM, latest/free.json, carries a per-symbol ts and age_s and a meta note in plain English &mdash; &lsquo;US index futures are exchange-delayed ~15min. Overnight ranges and levels are unaffected by the delay; the last tick is.&rsquo; The live page honours that, because the live page still has age_s. The archiver throws it away and stamps everything with the moment the request returned, and every consumer downstream inherits a clock belonging to the observer rather than to the market. THE DELAY IS MEASURED, NOT ASSUMED. ES and RTY are the only symbols with both a quote series and a bar series, so they are the only place the offset can be seen: ask what share of quotes fall inside the high-low range of the bar N minutes earlier, and at zero it is 44&ndash;49%, which is what noise looks like, while at ten minutes it is 99.7% of 932 on ES and 95.9% on RTY, on every day of the archive. That is an identification, not a fit. NQ and YM inherit it, and the inheritance is CHECKED rather than assumed: all four futures come back under one ts and one src in latest/free.json, and the day that splits, the build fails. WHAT IT COST. TYPQ &mdash; the displacement threshold that decides continuation from reversal &mdash; was understated 58.2% on NQ and 84.2% on YM, and was exactly 0.00 for HSI, NDX, RUT, SPX and VIX, because a repeated quote contributes a zero-width step and those five repeat 63&ndash;86% of the time. A threshold of zero resolves every sweep as a continuation on the first sample that moves. And the print that set NQ&rsquo;s 4 August NEW YORK low was stamped 13:30:02Z, two seconds inside the New York killzone, and was actually made at 13:20:02Z, inside London. Correcting it lifts New York&rsquo;s real low 103.25 points, 29,225.00 to 29,328.25. THE ARITHMETIC RECONCILES, and it took a second look to make it. Correcting the archive drops NQ from 1,461 samples to 937, yet the per-session counts barely moved &mdash; 90 to 88, 65 to 65, 75 to 74. Those two facts only agree once the populations are named: 463 of the 524 drops are WEEKEND rows, bucketed into Asia, London and New York by hour of day and repeating at 91&ndash;100% because there was no market in them. Inside live sessions on the days the block actually keeps, repeats run 2.5%. So the repeat rule does almost nothing during trading hours &mdash; the DELAY does the work, and it does it exactly where it hurts: 26 samples change killzone, and every one is among the first two after a session edge. WHAT WOULD BREAK IT. The offset is measured on two symbols and inherited by two more; HSI is neither, and its delay is only BOUNDED &mdash; its first value change lands six minutes after the 09:30 HKT open on all three measurable days, with a fourteen-to-twenty-minute tail after the 16:10 auction &mdash; so HSI gets the repeat rule and no delay at all. The repeat rule itself cannot tell a market that did not move from a feed that did not update, and treats both as silence, which is the right default and still a guess. A sixth build gate now re-measures the peak every build and compares it against KZD.clk, the delay stamped into the killzone block at generation; a measured constant that is never re-measured is just a remembered one. The near-miss is why all of this exists: I scored Monday&rsquo;s dispersion call off this archive and got RTY &minus;13.5bp against a bar-measured +61.2bp. A 74.7bp error on a question whose threshold was 60bp &mdash; the instrument noisier than the thing it was measuring, with a confident sign, and nothing said so." },
  { d:"5 Aug", cat:"system", c:"The static file shipped two attributes painted from the build clock instead of the snapshot, and the reason six rounds of freezing everything else never caught them is that they are invisible in a browser", r:"hit",
    o:"baketest loads the page under two injected clocks forty-five days apart and diffs the output: anything frozen at the snapshot instant is byte-identical, anything reading the wall clock moves. It reported two regions. The guard banner&rsquo;s icon read one glyph under the first clock and another under the second, and the fix line beneath it carried an inline display:none in one run and not the other. Both came from one asymmetry. paintGuard&rsquo;s healthy branch cleared its three text nodes and returned; the unhealthy branches also set the icon and the display, and nothing put those back. On the live page that residue cannot be seen, because the healthy branch drops the on class and the whole card is hidden by CSS &mdash; which is precisely why it survived. The bake is where invisible stops being harmless: a build that runs while the market is shut paints a weekend guard from the WALL clock, freeze() then repaints the page at the snapshot instant, the guard comes back healthy, and the glyph and the display:none it left behind ship inside a file whose entire premise is that nothing in it came from build time. The repair is that the healthy branch now resets to the element&rsquo;s declared initial state rather than to nothing. That moved the diff without clearing it, and the remainder was the more interesting half: an empty style attribute against no style attribute at all. Setting style.display to the empty string clears the PROPERTY but leaves the ATTRIBUTE behind on an element that had one, and creates nothing on an element that did not, so the serialised form depended on the element&rsquo;s history rather than on its state. Two runs arriving at the same state by different routes wrote different bytes. WHAT WOULD BREAK IT: only these two instances are fixed, not the class. Any painter here that sets an inline style or an innerHTML in one branch and not another has the same shape, and baketest can only see the ones that differ between two particular instants &mdash; a leak that happens to serialise identically at both is still a leak and this suite would call it stable. The second fix also assumes nothing else ever writes an inline style to that element: it removes the whole attribute once it has emptied, so the day something else writes one, it goes too." },
  { d:"5 Aug", cat:"system", c:"A suite went red against a page that was behaving perfectly, and it is the third fixture on this toolchain to rot the same way", r:"hit",
    o:"verify asserts the catalyst board is non-empty in all five modes. On 5 Aug it failed: live mode rendered no rows and the words Nothing scheduled. Nothing on the page or the relay was wrong &mdash; the real feed was carrying seven future events at the time. verify fulfils raw.githubusercontent.com from local fixtures, and calendar.json was captured on 30 July holding nine events dated 30 and 31 July. By 5 August every one had passed, so the page was handed a calendar with nothing upcoming in it and correctly said there was nothing upcoming. The check went red against correct behaviour, which is the failure mode that costs most, because the cheapest response to it is to relax the check. Third instance of one defect and worth naming rather than fixing quietly: free-bars-future.json stopped being in the future, free-bars-alt.json stopped being different, and now calendar.json has stopped being upcoming. A fixture that decays turns a suite into a clock. The repair is NOT to re-stamp the file, because caltest pins its own clock to 2026-07-30T08:00:00Z and asserts on those exact nine events, their consensus figures and which of them falls inside a default band. That suite is testing the calendar&rsquo;s CONTENT and is right to freeze it. So verify shifts the events in memory instead, keeping every relative gap intact and landing the first one forty minutes out. Same fixture, two jobs, and neither can rot the other. WHAT WOULD BREAK IT: the shift is computed from the earliest event in the file, so a fixture whose events were NOT all in the past would be dragged backwards rather than forwards. That is harmless while the file stays frozen at 30 July and stops being harmless the moment somebody refreshes it, and nothing asserts the direction. The wider hole is plainer: three fixtures have now rotted and there is still no check that asks, of every fixture this toolchain ships, whether it still means what it meant on the day it was captured." },
  { d:"5 Aug", cat:"system", c:"The repository history was squashed again while the standing decision was that squashing is off, and the only reason two days of it still exist is that a container nobody trusts had a copy", r:"hit",
    o:"At 2026-08-04T18:23:01Z the droplet squashed waft-data and destroyed 4,001 commits. The decision to stop squashing was taken in conversation and the squash is a droplet-side cron, so nothing about that decision ever reached the machine that performs it. It will happen again. What it costs is specific: the commit history is where the bar archive is reconstructed from, roughly 1,440 snapshots a day of latest/free-bars.json, each holding the last 96 five-minute bars, deduped by bar timestamp with the last sighting winning. The clone in /tmp/wd was the only surviving copy of 2 Aug 16:22 to 4 Aug 00:36 and a git pull would have discarded it, which it tried to do &mdash; the pull failed only because the rewrite made the branches divergent and git refused to guess. That refusal is the whole reason the data exists. The orphaned tip is now tagged presquash-20260804 with gc.auto set to 0, and rebuilding across both lines walked 3,595 commits and grew hist-bars.json from 56,685 to 90,762 bytes and hist-quotes.json from 2,238,781 to 3,220,939. The unrecoverable hole is exactly one window, 9.83 hours from 2026-08-04 00:25Z to 10:15Z, Tuesday&rsquo;s Asian and European sessions &mdash; which contains crude&rsquo;s run to its 82.25 high, so the collapse that followed is reconstructable and the spike into it is not. Every other gap is benign: 49.08 hours of weekend, two CME maintenance breaks of 1.08 hours, one hiccup of 0.17. The asymmetry worth keeping is that the archive jsonl files under archive/bars and archive/quotes came through untouched, because they are files and not commits, and a squash rewrites commits. That is the entire argument for the archive existing alongside the history rather than instead of it, and it just got paid. WHAT WOULD BREAK IT: the recovery is a tag in one container, which is the same class of thing as the history it rescued &mdash; if this container is reclaimed before presquash-20260804 is pushed somewhere durable, the second copy dies with it and the next squash finds nothing to divergence-check against. The archive files survive that; the reconstruction does not. Note also what this entry cannot claim: nothing here fixed the cron. The fix is on a machine this page cannot reach, and calling a recovery a fix is how a workaround becomes the plan." },
  { d:"4 Aug", cat:"system", c:"The archive that makes this container disposable could not be opened, and in the whole time it has been counted as insurance nothing had ever tried", r:"hit",
    o:"waft-toolchain.tgz has sat in the repository since 13:40 HKT on 3 August and is the only copy that has ever been there &mdash; it postdates the squash, so there is no earlier one to check against. It cannot be extracted. It was gzipped twice, a tar inside a gzip inside a gzip, so tar xzf waft-toolchain.tgz &mdash; the exact line in the RESTORE.md packed inside it &mdash; peels one layer, hands tar a gzip stream, and stops with &lsquo;This does not look like a tar archive&rsquo;. Every cheap check passed on the way there: the name ends in .tgz, file(1) reports gzip compressed data from Unix, 252,770 bytes is a plausible size, it committed and it downloaded. What it holds is the reason this container is treated as disposable. waft-dashboard.src.html is not a layout, it is the store &mdash; CALLS, CATALYSTS, NEWS, SENT, SCENARIOS, CHAIN and all twenty-eight ladder why-texts are curated judgement with no generator behind them &mdash; and beside it sit the eleven suites and the four build gates. The second fault is independent and would have outlived a fix to the first: the archive was packed before this morning, so it predates the BI_BASIS correction, the ladder rebuild and all three suite repairs. Restored, it would have rebuilt a page that disagrees with the page sitting next to it in the same repository, and the disagreement would have been in the constant that converts a cash-quoted stop into futures terms. Both are fixed. Repacked single-gzipped, extracted into an empty directory with the documented command, diffed file by file against what was packed, and the source&rsquo;s sha256 read back against the WAFT-BAKED-FROM line stamped into the built page, so the three artifacts are provably one set rather than three things with matching dates. RESTORE.md now carries the pack procedure with that restore-and-diff as a required step. WHAT WOULD BREAK IT: nothing enforces it. The pack is a hand procedure described in a document, not a gate, and a gate is the one thing that could not have caught this &mdash; build.mjs guards the page and no guard here has ever had an opinion about the archive. The family resemblance is the part worth keeping: a thing is verified by being USED for its purpose and never by being produced. A suite that cannot go red, a fixture that asserts an agreement instead of constructing one, a constant typed into the test that guards it, and a backup nobody has ever restored are four instances of a single error, and three of them were found this morning." },
  { d:"4 Aug", cat:"system", c:"All four index futures were publishing a full session of move as an overnight change, and a 1.5% threshold was deciding which two of the four identical faults got suppressed", r:"hit",
    o:"The board read RTY +1.964%, NQ +1.974%, ES +1.549% and YM +1.33% overnight. Every one of those references is FRIDAY&rsquo;s settle, so what was labelled an overnight change was three days of move. The archive settles it without needing a theory about the feed: RTY&rsquo;s prev_close is 2938.00 against a 20:00Z bar that opened 2939.60 on 31 July and 2990.00 on 3 August; ES&rsquo;s is 7519.25 against 7520.00 and 7628.25; NQ carries 28404.25 against 28927.25 at 20:00Z Monday. Measured from Monday the overnight moves are about +0.19%, +0.10% and +0.13%. For someone flat and deciding whether to re-enter, &lsquo;the complex is up two per cent overnight&rsquo; and &lsquo;nothing happened overnight&rsquo; are not two shades of one read, they are opposite instructions, and the wrong one was on the page. The detector is the more uncomfortable half. PREV_GAP_TOL measures the gap as a percentage of price and fires at 1.5, which flagged RTY at 1.77% and NQ at 1.75% and let ES at 1.45% and YM at 1.33% through &mdash; four identical defects, sorted into published and suppressed by a threshold that has no view about any of them. A percentage of price is the wrong unit. The right one is the session&rsquo;s own overnight range, and in those units the four separate cleanly from everything else on the board: ES 9.7 ranges, YM 6.2, RTY 6.1, NQ 5.1, against crude 4.1, gold 4.0, VIX 1.9 and the dollar 1.5. All four are suppressed now and print an em dash where a percentage was, and the two that no detector ever flagged say so in their own entries &mdash; suppressing the two that tripped a line while publishing the two that did not would be the exact error this section exists to prevent. WHAT WOULD BREAK IT: the new predicate does not re-derive the judgement and cannot. Nothing inside a single payload separates a stale reference from a real weekend gap, which is what the PREV_OK list is for; the judgement was made against the archive and lives in each entry&rsquo;s text, and the predicate only asks whether the condition persists. NQ sits at 5.1 against a threshold of 4.5, so it is expected to stop firing before the defect stops existing, and 4.5 is a number I read off a gap in a sorted list rather than measured." },
  { d:"4 Aug", cat:"system", c:"The futures-to-cash basis was wrong on both contracts, and the invalidation ledger went on converting stops with the old number after the prose had corrected it", r:"hit",
    o:"The page carried RTY &asymp; RUT &times; 1.0030 and ES &asymp; SPX &times; 1.0041. Re-derived from the archive against the settled cash close, 31 July gives RTY 2939.60/2931.34 for 1.002818 and ES 7520.00/7489.72 for 1.004043; 3 August gives RTY 2990.00/2981.91 for 1.002714 and ES 7628.25/7600.50 for 1.003651. Against Monday&rsquo;s close the old ES constant places a cash-quoted level 3.4 points high, which is more than one 2.5-point bin, and the old RTY constant 0.85 points high on a one-point bin. The mechanism matters more than the correction: basis has to be read at the OPEN of the 20:00Z bar, because that bar&rsquo;s close is already the 20:05 print and the cash index has stopped moving by then &mdash; measure off the close and you are silently comparing a futures price from one minute with a cash price from another. The part worth keeping is what happened next. Both ladder subs were corrected to 1.0037 and 1.0027 this morning, and BI_BASIS &mdash; the constant the invalidation ledger uses to convert a cash-quoted stop into futures terms &mdash; was left on 1.0041 and 1.0030 for another several hours. The page agreed with itself in the paragraph and disagreed with itself in the machine, in the one conversion whose own source comment says a level in the wrong frame is the difference between a stop and a decoration. Three places were holding this constant, not two: correcting BI_BASIS turned the invalidation suite red, because its conversion test had the old multiplier and the converted level 2,949.82 typed into it as literals. It was checking a number rather than the mechanism, so it failed for a change of constant it has no opinion about. It now reads the multiplier out of the artifact and places its probe prices either side of whatever that produces, which is what it should have done from the start &mdash; the direction of the conversion is the invariant, and it has to hold at every basis the page might carry. WHAT WOULD BREAK IT: a second estimator built from same-instant medians on the same feed, sixty-five paired samples a session, reads ES 1.00352 then 1.00334. It corroborates the direction and not the level, and it disagrees outright with the bar-open method about which way RTY moved day to day, which means at most one of the two is measuring what I think it is and I cannot tell which. The basis compressed 2.53 points on ES between Friday and Monday and a six-basis-point fall in the curve accounts for about 0.56 of that, so most of the move is unexplained rather than explained. No cash-quoted leg is live today, so the wrong constant converted nothing; it was dormant, not harmless." },
  { d:"4 Aug", cat:"system", c:"Both ladder subs were quoting reach-calibration grades that had moved, and the story built on them &mdash; the two contracts swap places at the bell, in opposite directions &mdash; is now false", r:"hit",
    o:"The reach model is graded against what actually happened and the grades are regenerated with the profile. The two ladder subs were not. They asserted, with numbers and with confidence, that RTY under-predicts by 2% in cash hours and over-predicts by 22% overall while ES under-predicts by 42% in cash hours: a tidy account of two contracts trading places when the bell rings. The live block reads RTY {RTH +18, EUR &minus;11, ASIA +23, ALL +12} and ES {RTH &minus;25, EUR &minus;24, ASIA +1, ALL &minus;5}, where negative means the model under-predicts. RTY&rsquo;s cash-hour figure has crossed from &minus;2 to +18 &mdash; the sub was telling a reader the model is conservative in precisely the session where it is now the most generous, which is the one direction of error that turns a reach estimate into a reason to hold something too long. Both subs are rewritten against the live grades and both now say out loud that the previous rebuild published the comparison the other way round. WHAT WOULD BREAK IT: these are grades over the LAST window &mdash; 396 cash-hour windows and 562 Asian ones at the thirty-minute horizon &mdash; not properties of the model, and a figure that crossed zero inside five sessions can cross back inside five more. The subs now describe a measurement with a date on it rather than a characteristic of the model, which is the honest framing and is also a weaker claim than the one it replaced." },
  { d:"4 Aug", cat:"system", c:"Third ladder rewrite in three sessions, and this time two guards caught prose that read perfectly and joined on nothing", r:"hit",
    o:"Both boards were re-cut against the 773-bar, 119.9-hour profile, with every zone sum and cash-equivalent turn count recomputed by script rather than carried forward by hand. Three failures came out of it and not one of them would have looked like an error to a reader. ladtest rejected three levels for claiming a rank they do not hold &mdash; and in all three cases the prose was REFERRING to a different level&rsquo;s rank, and in one case explicitly WITHDRAWING a claim, neither of which the check can see, because it matches the first rank phrase in the text and does not parse negation. That is the gate being right for a reason worth writing down: a rank named in grey text beside a price is a rank the reader attaches to that price, whatever the sentence around it was doing. All three now name prices instead of ordinals. paceguard then failed with &lsquo;ladder and map quote no price in common&rsquo; on RTY, because I had rounded four pool levels to whole points for readability &mdash; 2,951.11 to 2,951, and three like it &mdash; and the guard joins the ladder to the liquidity map on the RENDERED price string. Rounding for the reader silently unlinked the ladder from the card it exists to quote, and it did it on the contract he actually trades. The exact prices are restored and every volume share was recomputed to confirm the move changed no bin. WHAT WOULD BREAK IT: prose_levels scans six curated blocks and LADDERS is not one of them, so ladder text is checked only by ladtest and only for the single pattern &lsquo;N% of window volume&rsquo;. Every zone sum and every cash-equivalent turn count across these twenty-eight why-texts is computed by hand, checked by nothing, and will be the first thing here to rot." },
  { d:"4 Aug", cat:"system", c:"A curated paragraph re-argued a crude call the ledger had already scored a miss &mdash; and a six-minute sample cannot carry the sentence it was asked to carry", r:"hit",
    o:"The 31 July entry graded the &lsquo;oil premium is leaking&rsquo; node a MISS on the day, on the grounds that crude printed 81.06, did not close under it, and rallied to 86.45. That grade stands and has not been touched. What a later paragraph did was re-tell the story in a way that quietly converted it to a hit, and it did so by asserting a CLOSE for the one instrument on this page carrying an explicit note saying its close cannot be sourced &mdash; a live tick relabelled as a settle, which is the same error the tiles block was rewritten for. Two properties of the archive govern what it can settle and are now written where the arguing about crude actually happens. It is a SIX-MINUTE SAMPLE, 987 observations between 30 July and this morning, so any extreme between two samples is invisible: it can establish that a level WAS crossed and can never establish that one was not touched. And it has a hole &mdash; nothing between 16:30Z Thursday and 06:00Z Friday, thirteen and a half hours covering the US Thursday afternoon and the Friday Asian morning. Both figures the ledger scored on fall outside what it saw, the 81.06 test inside the hole and the 86.45 rally plausibly between two samples. The archive does not contradict the ledger; it was not looking. What it does establish, because a positive is the only thing a sample can establish, is the Sunday reopen: 84.67 at 22:06Z on 2 August, 79.55 six minutes later, through 81.51 and 81 and 80 without trading at any of them. A level that is tested and rejected has an auction behind it; a level that is skipped does not, and those 3.42 dollars hold no transacted supply at all. WHAT WOULD BREAK IT: the discipline only runs one way &mdash; prose is made to agree with the ledger and the ledger is never re-graded to agree with the prose &mdash; and nothing on this page can enforce it. No check can detect a paragraph re-arguing a call that was already scored, because it looks exactly like a paragraph." },
  { d:"4 Aug", cat:"system", c:"Two suites were passing for the wrong reason: one asserted an agreement instead of constructing it, the other let one filter carry a claim it could not support", r:"hit",
    o:"stamptest&rsquo;s first case is labelled &lsquo;payload agrees with AS_OF&rsquo; and checks that the header does NOT warn when the prices and the prose describe one session. It built that case from the baked snapshot&rsquo;s date, which was the day the prose was curated &mdash; until the snapshot rolled to 4 August while AS_OF stayed on 3 August, because most of the prose beneath it genuinely is still Monday&rsquo;s. The page warned, correctly, and the suite reported it as a failure of the ordinary case: a fixture asserting an agreement instead of constructing one, which is the same category of error that file was written to prevent, one level up. The agreement case is now built FROM AS_OF &mdash; walk back from the snapshot until the payload&rsquo;s Hong Kong date is the day AS_OF names &mdash; so the branch under test is the branch in the label however far the snapshot has since drifted. dectest failed the opposite way round. It restricts its session comparison to levels inside four hours of the slower start, for a documented and correct reason, and it was reading that same restricted set for a second and different claim: that the walk consults the clock at all. After the rebuild exactly one level sits inside four hours &mdash; ES 7,636.25, one five-minute step from both clocks &mdash; so &lsquo;every near level took exactly as long&rsquo; was perfectly true and carried no information, while the evidence sat in the rows the filter had discarded. ES 7,606.67 is 880 minutes away from an Asian start and 1,215 from the cash open; RTY 2,983.55 is 540 and 330. Opposite directions, which is the whole reason the walk is stepped five minutes at a time instead of divided out. WHAT WOULD BREAK IT: the first claim keeps its restriction and now prints its sample size, because a filter that admits one level does not make a claim false, it makes it vacuous &mdash; and a vacuous pass gets credited exactly like a real one. That line reads &lsquo;1 level inside four hours&rsquo; today, which is thin evidence honestly labelled rather than strong evidence, and no assertion anywhere can tell those two apart on my behalf." },
  { d:"3 Aug", cat:"system", c:"Two clock faults in the bake: the invalidation ledger was frozen at the build machine&rsquo;s clock, and the hero&rsquo;s follow-on events were never baked at all", r:"hit",
    o:"The determinism suite loads the page under two injected clocks forty-five days apart and diffs the output, on the principle that anything reading the wall clock moves by forty-five days and anything frozen at the snapshot instant is byte-identical. It failed on the newest card. paintAll threads ONE instant through every painter so the whole page agrees on what now is, and the freeze step repaints at the snapshot instant for a reason its own comment states plainly &mdash; the liquidity map and the decision board are walks FORWARD from an instant, so a board built two hours late is not wrong by two hours, it is wrong by a session. The scorecard was called with no argument and read Date.now() instead. Live, the two differ by microseconds and nothing shows. In the static file they differ by however long the build ran after the snapshot, which means a file whose every price comes from 12:48 was carrying break states evaluated at some other moment &mdash; and once the cash-open window closes, that file would say Survived or Blind about an hour the snapshot never reached. An invalidation baked at the wrong clock is precisely the thing the ledger was added to stop shipping, so it arrived carrying the disease it was written to cure. The second fault was found while fixing the first and is worse in kind. freeze() named `after` in its page callback and never put it in the payload object; page.evaluate serialises only the properties it is handed, a missing one arrives undefined, and `(after || [])` swallowed it in silence. The strip under the hero &mdash; the two events following the next one &mdash; has baked EMPTY in every file this toolchain has ever shipped. Nothing caught it: node --check sees a valid program, this very suite sees empty under both clocks and calls that stable, and afterEvents() went on being called by two callers with a paragraph above it explaining why it was needed. A silent no-op is the one defect shape that looks like maintenance. So the invariant is now asserted on the OUTPUT rather than the plumbing: freeze reports what actually landed in the strip and throws if there were events to name and nothing is there. WHAT WOULD BREAK IT: that assertion proves the strip is populated, not that it names the RIGHT two events &mdash; a freeze that baked the wrong pair would pass it without complaint. The general form of this bug is any value computed by the build and handed across the page.evaluate boundary, and I have fixed the one instance the empty strip made visible." },
  { d:"3 Aug", cat:"system", c:"The invalidation ledger now has a suite that drives all six of its states, because the live tape only ever exercises two of them", r:"hit",
    o:"Four of the ledger&rsquo;s six states are unreachable on any tape that exists today &mdash; nothing on the board is currently waiting, blind, fired or defeated &mdash; so every build since it shipped has been testing one branch of a six-branch machine, and the untested branches include the one carrying the whole argument. BLIND is the state that distinguishes no bar shows a breach from I hold no bars, and those two render identically as not-broken while only one of them is a measurement. The suite drives the evaluator directly with synthetic bars and a synthetic clock, which is why bars and the instant are parameters of that function rather than reads off page state, and it reaches each state by the input that defines it: a bar through the level fires a touch condition and DEFEATS a stays-condition on the same bar, a closed window with full coverage settles, a closed window missing bars goes blind and says how many of the twelve it holds, and twelve bars of which four fall outside the window still goes blind &mdash; a coverage count that took the array length would call that complete and hand back a verdict built on bars from after the bell. It checks the basis conversion in both directions, because getting it backwards swaps two verdicts rather than producing an obvious error. It then checks the wiring separately, since a correct state machine nobody rendered is not a feature. Two failures came out of the first run and both were the suite&rsquo;s own needles rather than the page: prices are printed grouped, and the verdicts carry an en-dash as an HTML entity. The second turned into a real check &mdash; that entity is safe only for as long as every consumer injects it with innerHTML, so the suite now asserts that no verdict reached the reader with its entities unrendered. Last, it hands its own assertion something false on purpose and requires it to register the failure, then consumes it. A green suite that cannot go red is worse than no suite, because it gets credited. WHAT WOULD BREAK IT: this proves the state machine and proves the wiring, and cannot touch the thing between them &mdash; whether the conditions attached to the live calls are written against the right levels. A condition carrying a typo&rsquo;d price evaluates flawlessly through all six states and answers a question nobody asked." },
  { d:"3 Aug", cat:"system", c:"Stop pools abbreviated EUR and EVE to the same letter, so half the ladder&rsquo;s pedigree claims could not be read back &mdash; and one of them was wrong", r:"hit",
    o:"The tally a pool publishes reads &lsquo;9 turns (4E+3RTH+1A+1E)&rsquo;, and the ladder&rsquo;s prose is written by hand from exactly that string. It abbreviated with the first letter of the session name, which sends both EUR and EVE to E, so a pool carrying both printed the letter twice with no way to tell which was which. That is not a display nit and it is not cosmetic: a European turn is made by desks who will still be at their seats at 13:30Z and an evening turn is made after the cash book has gone home, which is the entire reason the composition gets quoted at all. Collapsing them destroyed the evidence for a claim the page was still making &mdash; &lsquo;one in the evening&rsquo; had no way to be either right or wrong, which is a worse state than being wrong. Two letters fix it, EU and EV, and the fix immediately caught a live error: RTY&rsquo;s 2,965.04 cluster is six Asian turns, three EUROPEAN and one cash, and the shipped page said evening. Nothing on this board would ever have found that, because the evidence had been destroyed upstream of the sentence. WHAT WOULD BREAK IT: the same argument applies to every other lossy label on this page, and I have only checked this one &mdash; a tally that cannot be decoded is a claim that cannot be graded, wherever it appears." },
  { d:"3 Aug", cat:"system", c:"Rewrote the ladder against the profile the 04:48Z refresh moved underneath it &mdash; nine sentences that were true on Friday", r:"hit",
    o:"The refresh regenerates every measured block and then says out loud what it does not touch: the ladder is judgement, and there is no generator for judgement. So the guard failed nine times, and the nine are worth separating because they are not one fault. Two levels &mdash; RTY 2,956.01 and ES 7,552.83, the entries both boards led with &mdash; had no stop pool within a bin of them any more. Not moved: gone, while still being quoted with turn counts and a rank each. ES&rsquo;s &lsquo;Window high&rsquo; was naming a bin seven and a half points under the actual top of the window and quoting a volume share an order of magnitude too small. RTY&rsquo;s seed sat 8.90 from its own payload on a 4.10 typical half-hour move. And two rank claims went stale in the subtler way: the pools underneath them now TIE, so &lsquo;rank 1&rsquo; and &lsquo;rank 3&rsquo; are not wrong, they are undefined &mdash; a tie has no Nth member, and a level can lose its rank without moving at all, because a rank is a claim about the others. None of the nine was a coding error and none would have looked wrong to a reader: they rendered in the same typeface, at the same size, with the same confidence as the true ones. WHAT WOULD BREAK IT: the guard checks the claims it knows how to check &mdash; named structures, turn counts, ranks, single-bin volume shares, positional prose. The ZONE sums (&lsquo;the six bins from 2,952 to 2,957 hold 11.59%&rsquo;) are recomputed by hand here and checked by nothing, so those are the ones that will rot first." },
  { d:"3 Aug", cat:"system", c:"Every open call now carries its invalidation in a form the page can check &mdash; and says so out loud when it cannot", r:"hit",
    o:"The house voice is a lean plus the condition that would break it, and that second half has never been held to any standard. It is prose in the outcome paragraph, read once on the morning it is written, and nothing is obliged to notice when the condition it names occurs. Two failures follow. The first is a selection effect in the headline: the hit rate is computed over the calls I chose to resolve, so a pending call whose invalidation fired three sessions ago sits here marked pending, in neither numerator nor denominator, and the only thing between it and a miss is whether I remember to look &mdash; a rate computed over a curated set measures attention, not accuracy. The second is invisible from inside: an invalidation written against something this page cannot observe looks exactly like one written against something it can. Both are a sentence in grey text; only one is a stop. So every open market call now carries structured conditions, evaluated on every poll, reporting one of six states. The uncomfortable number is that two of today's four conditions cannot be checked at all, and neither fails vaguely: the dispersion call breaks on RTY against NQ and the relay banks bars for ES and RTY only, and the term-premium call's diagnosis leg breaks on an ISM print while calendar.json carries a forecast and a prior but never an actual. Both are known relay-side gaps, so the ledger does what the defect list could not do alone &mdash; it names which calls those gaps make unfalsifiable. What breaks it: a negative conclusion drawn on partial bars. One bar through a level proves a breach on any coverage; zero bars through it proves nothing unless every bar in the window is present, so a closed window with a gap in it reports BLIND rather than survived. That is the same fault the sentiment card had this morning wearing different clothes &mdash; there a clamped value scored like a measured one, here an empty record would read like a clean one." },
  { d:"3 Aug", cat:"system", c:"Sentiment card now marks a component that has run out of scale as pinned", r:"hit",
    o:"Crude's level leg evaluates well above +1 and clamps to +1, and its change leg is null because CRUDE sits on the untrusted-reference list. So the component was flat against its rail: every WTI price from 81.51 all the way to zero produced the same score, the same 12 points of contribution, and the same headline. The card meanwhile said Crude is carrying the read, which is arithmetically true and completely misleading — a reader takes that as the thing to watch, and watching a railed component is exactly the wasted effort, because crude can fall another twenty dollars without moving this number by a point. The condition was written down in a source comment, which is not a feature; nobody reading the page can see a comment. tone() now keeps each component's pre-clamp legs and marks it pinned when none is still inside its range — exact, not a heuristic: if every leg is railed the blend is constant, if any leg is inside range the blend responds. The row says so, the lead sentence says so in the same breath as the name, it names the largest component still free to answer its input, and it states how much of the live weight is railed. Today that reads 12 of 80 points, alongside a regime leg that has dropped out on a 55-hour-old 10-year. What breaks it: a component whose legs stop being recorded would read as never pinned and be invisible, so the patch asserts that every component except regime records its legs — regime is a discrete classifier with no scale to overshoot, which is why it is the one exception." },
  { d:"3 Aug", cat:"system", c:"Split the scorecard — engineering entries no longer count toward the hit rate", r:"hit",
    o:"Four of the 33 entries on this board are decisions about the page rather than calls about the market: gold onto the untrusted-reference list, the two CNBC-sourced percentages suppressed, the 2,912 and 2,903.7 targets withdrawn, and the refusal to publish an overnight tick when three public sources disagreed by 80 RTY points. All four are marked hit, and not because the judgement was good — an engineering entry is only ever written down after it works, so hit is the only value the field can take, and a 100% rate by construction carries no information. Averaged into the headline they read as market accuracy: the board said 77% where the calls themselves score 73%. Three of the four were added in the last two sessions, and this morning's gold fix was about to add a fifth before the arithmetic got looked at, so the drift was accelerating rather than settling. Category is now declared on every entry instead of guessed from the text, because there is no reliable way to tell the two apart by reading them and a classifier that guessed would be wrong silently; an entry carrying no category is counted in neither bucket and named in the note as a defect. Both rates are computed and printed side by side, so the size of the distortion stays visible. What breaks it: an entry filed as market that is really a build decision. The split is exactly as honest as the label, and nothing on the page can check the label — only the person writing it." },
  { d:"3 Aug", cat:"system", c:"Put gold on the untrusted-reference list and rewrote the chain node that was arguing from its percentage — the guard had been flagging it for a day and nothing was obliged to answer", r:"hit", o:"agegate section 6 flagged gold at +2.03% the day that check was written, printed the flag on every build afterwards, and was recorded in the entry below. Nothing acted, because section 6's hard failure only fires when a flagged quote sits on a TILE printing its percentage, and gold has no tile. It has something worth more: it is one of the three legs of regime(), at 20% of the composite. Three facts settle it and none needs a theory about the upstream source. The payload contradicts itself — on_open 4,131.10 above px 4,109.20, so gold is DOWN 0.53% overnight while the field publishes +1.48%. The relay's own history contradicts the reference — three consecutive payloads across Sunday's closed market all carry Friday's final print at 4,107.00, from which gold is +0.05%. And the reference rolled DOWNWARD at the Sunday reopen, from 4,100.10 to 4,049.10, past the close it was meant to be replacing. The fix is three-part because the bug was: gold joins the list, so regime() reads unreadable rather than scoring gold as bid; the list is renamed from FROZEN_PREV to UNTRUSTED_PREV, because gold's reference is not frozen, it rolled to the wrong number, and a list named after one cause reads as an argument that the other does not belong on it; and the guard now hard-fails when a flagged quote feeding a SCORE appears on neither UNTRUSTED_PREV nor the new PREV_OK, so the next one cannot be found by hand a day late. The prose mattered more than the number. The chain node had built an argument on the figure and named an invalidation — gold giving up the overnight gain — against a gain that never existed, so that clause could not have fired under any tape. A suppressed number stops being published; a number already inside an argument goes on working, because it reads as reasoning rather than as data." },
  { d:"3 Aug", cat:"market", c:"Friday's 112bp cash dispersion between NDX and RUT is a cash-session artefact — the overnight tape has RTY and ES within one basis point of each other and carries no memory of it", r:"hit", o:"Written on a 17bp overnight spread &mdash; RTY +0.456% and ES +0.455% against NQ +0.629% &mdash; where Friday's cash session had run 111.5bp between NDX +0.593% and RUT −0.522%. The resolution is worth more than the score. THE STATED TEST CANNOT BE ANSWERED AT ALL, and not only for the reason recorded below it. The break clause named RTY and NQ over the first cash half-hour; the relay banks no bars for NQ, which the ledger already said. What it could not say is that the cash proxy fails too: RUT does not print a NEW value until 13:48Z, eighteen minutes after the bell, so the 13:30, 13:36 and 13:42 samples are all repeats of a price fixed before the open. Measuring the half-hour off that frozen baseline is exactly how I first got RUT +69.6bp, and the archive reader now REFUSES that window instead of answering it. What can honestly be measured, 13:48Z to the 20:00Z close, is NDX +138.4bp against RUT +148.3bp &mdash; 9.9bp apart against Friday's 111.5. The dispersion did not merely evaporate; it INVERTED. Friday's worst index led Monday's session. And it was real while it lasted: 52.8bp across 13:48&ndash;14:30, small caps on the right side of it this time, decaying to ten by the close. So the claim was right and right for the reason given &mdash; the overnight carried no memory of Friday &mdash; while the break clause was still built wrong. 52.8bp came within eight of a 60bp threshold that would have scored this call WRONG, on a divergence whose SIGN was the opposite of the one the threshold existed to catch. A dispersion condition needs a direction. This one had a magnitude and a pair of instruments the feed cannot see.",
    bi:[ { n:"the overnight was carrying the spread",
           why:"the relay banks five-minute bars for ES and RTY only, so NQ&rsquo;s half-hour move cannot be measured on this page at all. The condition is written against an instrument this feed does not carry bars for, which makes it a sentence rather than a stop &mdash; and nothing said so until this line existed.",
           legs:[] } ] },
  { d:"3 Aug", cat:"market", c:"ES has nothing measured overhead — 0.18% of ninety-seven hours traded at or above spot, so the first cash hour either extends on air or comes back into the distribution", r:"hit", o:"Written with ES at 7,553.50 and resolved from the twelve archived five-minute bars covering 13:30&ndash;14:30Z. The hour opened 7,546.25, ran to 7,600.00 and closed 7,597.25 &mdash; a 57.25-point range and a 51.00-point advance &mdash; on 46,749 lots in the first bar against 2,079 on the overnight 00:00Z bar. A contract with two bins out of eighty-four above it found new business up there, decisively, and the 7,537.50 re-entry was never revisited. THE INVALIDATION WAS THE DEFECT, NOT THE CALL. It was written as ES holding above the 7,543.50 overnight low through the whole hour, and the very first five-minute bar printed 7,542.75 &mdash; 0.75 points, three ticks, under the line &mdash; before closing 7,559.25 and never returning. Not one bar in the hour CLOSED below 7,543.50. So the condition whose job was to declare this call wrong was defeated by the opening print on precisely the tape that proved it right, and the call survives on an accident of three ticks rather than on its instrument. A stays_above anchored ON the overnight low and read against five-minute bar LOWS is taken out by the opening sweep almost every time it is written, whichever way the hour then goes, which makes it a condition carrying no information in either direction. It needs a buffer beneath the level, or it needs evaluating on closes. This is the same touch-versus-close error the board paid for on 31 July, in a new place, three days later.",
    bi:[ { n:"the new business up here is real",
           win:[13.5, 14.5], from:1785715200,
           legs:[ { sym:"ES", src:"px", unit:"quoted", op:"stays_above", v:7543.5,
                    label:"ES", dp:2, suf:"" } ] } ] },
  { d:"3 Aug", cat:"market", c:"Term premium, not inflation, is what is pricing this tape — and ISM prices-paid at 22:00 HKT Monday is the cleanest single test of it", r:"hit", o:"Friday's ranking is the evidence and it is unusual enough to be diagnostic: SPX +0.698% BEAT NDX +0.593% while RUT fell 0.522%. A tech story does not look like that. A rates story looks exactly like that — the broad index fine, the growth index fine, and the one index whose earnings live on the front end taking the whole hit. The 30-year closed at 5.27%, above the 5.24% that was being called a multidecade high on Thursday, and 2s10s steepened 2bp to +47bp, which is the long end doing the work rather than the short end. This breaks two ways and they are different questions. The REGIME breaks if a long-end auction stops through with the 30-year closing below 5.15% and the dollar above 100 &mdash; and it is those two numbers that are checked, because the auction is the mechanism rather than a second test: if the long end closes there, how it got there does not change the trade. The DIAGNOSIS breaks if ISM Manufacturing Prices prints at or above 73, which would hand the wheel back to inflation and make every yield move this week a price story rather than a supply one. Resolves at Friday&rsquo;s payrolls close. HAND READING, 7 Aug, and it is not a resolution &mdash; the call resolves on the REGIME at tonight&rsquo;s close and this settles only the branch the relay cannot read. July ISM Manufacturing Prices printed 71.1 against a prior of 73.0, so the DIAGNOSIS did NOT break, by 1.9 points. Note how close that was: the threshold WAS the prior, so an unchanged print would have broken it and the index had to fall to leave the call standing. The REGIME is going the other way and going there quickly &mdash; the 30-year was 5.17% entering Friday and is 5.22% now, seven basis points ABOVE the 5.15% that would break it, while the dollar at 99.95 is five cents BELOW the 100 that would break it. Both legs would have to move, in opposite directions, inside one session. RESOLVED 7 Aug at the payrolls close, a HIT, and the honest reading of it is narrower than the tick suggests. NEITHER break condition fired. The 30-year closed at <b>5.19%</b> — it fell three basis points on the day, travelling TOWARD the 5.15% that would have broken it and stopping four short. The dollar closed at <b>99.62</b>, having printed 99.988 intraday: twelve thousandths of a point from the 100 handle, and the closest either leg came to its own threshold all week. So one leg moved toward its break and missed, the other brushed its break and retreated. WHAT THIS HIT IS WORTH, stated because the number will be read without the sentence: this call breaks only if BOTH legs go, and a conjunctive condition is a great deal harder to break than a single one. Surviving it is weaker evidence than the hit column implies, and a board that does not say so is flattering itself by construction. The DIAGNOSIS branch was settled by hand on 7 Aug and stands as recorded — July ISM Manufacturing Prices 71.1 against a threshold of 73.0 that was also the prior, so the index had to FALL to leave the call standing, and it did. What actually happened on the day is the part worth carrying: payrolls printed hot enough to bid four contracts into their 84th-to-95th percentiles, and the long end RALLIED into it. A strong labour print that takes yields DOWN is the term-premium reading working — supply and risk premium easing, rather than growth being repriced — which is the mechanism this call named. That is corroboration, not proof: one session, and the call is judged on its stated levels rather than on this paragraph.",
    bi:[ { n:"the REGIME",
           from:1785715200,
           legs:[ { sym:"Y30", src:"rate", op:"below", v:5.15,
                    label:"the 30-year", dp:2, suf:"%" },
                  { sym:"DXY", src:"px", unit:"quoted", op:"above", v:100,
                    label:"the dollar", dp:2, suf:"" } ] },
         { n:"the DIAGNOSIS",
           why:"the trigger is an ISM prices-paid print at or above 73, and calendar.json publishes what is scheduled, its forecast and its prior, but never an ACTUAL. No economic release on this page can be read by anything, including this one. That is a relay-side gap and it is the reason this branch resolves by hand." } ] },
  { d:"3 Aug", cat:"system", c:"Suppressed the published percentage on both CNBC-sourced quotes rather than print a change measured against Thursday", r:"hit", o:"HSI and WTI are the relay's only two cnbc-sourced quotes and both carry a prior close that has not rolled since Thursday. WTI was reporting −5.09% on a session in which it had moved about half a per cent. The fix is structural rather than a re-typing, because a hand-corrected number is a bug class and not a bug: the tiles now carry judgement only and read their price from the snapshot at paint time, and a suppression flag prints an em dash where the percentage would have gone. The generic detector compares every quote's stated prior close against its own session open and flags a gap over 1.5% — it catches WTI at −5.50% and gold at +2.03% — then hard-fails the build if a flagged quote still sits on a tile printing its percentage. That guard was proved by reopening the hole: removing the flag from the WTI tile turned the build red, and restoring it turned it green. A guard that has never failed is not known to work. The feed said so has never been a reason to publish a number." },
  { d:"3 Aug", cat:"system", c:"Withdrew the published 2,912 and 2,903.7 downside targets — both were cut from a window that no longer exists", r:"hit", o:"Recomputed against the page's own profile rather than against the brief that published them. The value-area low is 2,915.00, not 2,912, and 2,903.7 sits beneath the entire ninety-seven-hour window, whose floor is 2,905.00. The honest map below the market runs 2,936.00 at 4.01% of the window, 2,941.00 at 3.23%, 2,927.00 at 3.07%, then the 2,925.69 pool and 2,920.00 at 1.18% — and beneath 2,920 there are fourteen consecutive bins, not one of which holds even a single per cent, the thinnest of them 0.19%. That is not somewhere to put a target; it is somewhere with no information in it. The replacement is a sentence rather than a number: below 2,920 this map has nothing to say, and the correct output is unmapped rather than a decimal. A precise number in a region with no data is the most persuasive kind of wrong." },
  { d:"31 Jul", cat:"system", c:"Refused to publish an overnight futures tick — three public sources disagreed by 80 RTY points", r:"hit", o:"Investing.com had ES 7,495.25; Yahoo had ES 7,529.00 and RTY 2,856.80 against my archive's verified 2,936.90. Same failure shape as the 20 Jul incident that voided a whole board. Anchored to the archive and said so instead of picking one. A number you cannot verify is worse than no number." },
  { d:"31 Jul", cat:"market", c:"RTY at the 2,927 point of control is the decision — heaviest bin on the board, and the first real bid since 2,951", r:"hit", o:"Written at 22:10 HKT with RTY at 2,932.20 after a 47.8-point fall, and resolved from the archived five-minute bars rather than from the closing price, because the close alone would have flattered it. No cash half-hour closed beneath the stated 2,917.94 — the lowest was 2,919.60 at the 14:00Z half-hour, 1.66 points clear. After three half-hours closing under the point of control (2,919.60, 2,924.10, 2,925.40) price reclaimed it and finished the session at 2,939.50, 34.2 points off the low. The mean-reversion case was the right one. The qualification matters more than the score: the 14:10Z low printed 2,905.30, twelve and a half points THROUGH the invalidation level. A call defined on half-hour closes survived; a stop resting at 2,917.94 was taken out an hour into the session and did not participate in the 34-point recovery. An invalidation line and a stop are not the same instrument, and this board has been writing them as though they were." },
  { d:"31 Jul", cat:"market", c:"RTY ladder named the downside sequence: 2,957, then the 2,953 value-area high, then the 2,951.3 pool, then the 2,927 point of control", r:"hit", o:"Price walked it in order. The 13:35Z bar stopped and closed at 2,953.60 on the value-area high. The 13:40Z bar tested 2,951.50 against the mapped 2,951.32 pool, held it, and closed back above. The 13:45Z bar broke it on 7,782 lots, the largest of the session, and ran to 2,937.50. Low so far 2,928.50, sitting on the point of control. Four mapped levels, four reactions, in the mapped order. This is what the liquidity map was built to do." },
  { d:"31 Jul", cat:"market", c:"Pre-open: RTY travels further than ES on a downside open — it sat in the thinnest bin on its own profile while ES thickened beneath", r:"hit", o:"Called at 21:06 HKT, 24 minutes before the bell, with the invalidation named in advance: RTY reclaims 2,965 and holds it through the first cash half-hour. It never did. From the opening bar's high to the session low RTY fell 1.32% against ES 0.65% — a clean 2x, and that is the number that generalises. Measured point-to-point from the call it reads 11x (RTY -0.98%, ES -0.09%), but that flatters it: ES rallied to 7,515.50 first and came back, so the endpoints hide the path. Trust the 2x, not the 11x." },
  { d:"31 Jul", cat:"market", c:"ECI: on a hawkish front-end repricing, RTY gives the overnight move back first", r:"hit", o:"Written into the catalyst card before the 12:30Z print. On the print bar RTY fell 0.18% against ES 0.11%, on 3x prior volume against 2x, and the move extended all session — RTY -0.75% on the day with NQ still +0.46%, a 1.2-point dispersion spread. Third consecutive test of the rule rewritten on 28 Jul after it cost money. The ECI number itself was never published anywhere reachable, so only the consequent is scored; the antecedent is unverifiable and is not claimed." },
  { d:"31 Jul", cat:"market", c:"Chain node had oil weakening — 'the premium is leaking', with 81 named as the level that breaks it", r:"miss", o:"Crude printed 81.06, did not close under it, and rallied to 86.45. The node was wrong, and its own invalidation line is what caught it — in hours, rather than at the end of the week. Flipped to strengthening on the tape rather than on narrative. Worth keeping on the board precisely because it is the case that justifies writing the breaking condition down every time." },
  { d:"31 Jul", cat:"market", c:"Fade RTY strength into 2,971 unless the long end eases first", r:"hit", o:"RTY topped at 2,976.30 overnight, through the level, and the long end never eased — the 10-year went to 4.735, the top of its range, and is still there. Faded to 2,928.50, 47.8 points off the high. The condition attached to the call is what made it tradeable: the long end was the thing to watch, and it never gave the signal to stand down. The UoM leg at 22:00 HKT is not yet visible in the delayed bars, but it can only add to this." },
  { d:"31 Jul", cat:"market", c:"Month-end: the 19:50Z imbalance is the largest non-news move of the session", r:"partial", o:"Right about which event, wrong about what kind of event. The 19:55Z bar traded 21,127 contracts against 1,994 in the bar before it — a factor of ten, and roughly three-quarters of its entire half-hour's volume inside five minutes. Only two half-hours in the whole cash session traded more than the 19:30–20:00 window, and both were the opening and ECI shock, so on VOLUME the call is exactly and unambiguously right: it was the largest non-news event of the session. On PRICE it was nothing — 8.80 points of range, eighth of fourteen half-hours, and a net move of one point down. The claim said move. Month-end imbalances are volume events, not price events, and the correct forecast is that a large quantity gets filled rather than that the price goes somewhere. Scored partial because the identification was right and the forecast quantity was the wrong quantity." },
  { d:"30 Jul", cat:"market", c:"Corrected chain rule — small caps cannot lead while the long end is under pressure", r:"hit", o:"Tested on an UP day for the first time. NQ +2.34% and RTY +0.82% with the 30-yr pinned near 5.24%. The rule was rewritten on Tuesday after it cost money; it has now paid in both directions." },
  { d:"29 Jul", cat:"market", c:"Three-scenario FOMC map: hold+dovish 30 / hold+hawkish 40 / hike 30", r:"partial", o:"Branch B resolved — hold with a hawkish September, and three members wanted a hike. Right branch at the modal weight. But branch B said 'back below 7,400 cash' and stopped there; it did not anticipate that Microsoft's Azure print would overwhelm the macro within 24 hours. Correct on the Fed, incomplete on what else was in the week." },
  { d:"29 Jul", cat:"market", c:"ES shelf third approach from below — knocking, not through", r:"hit", o:"Never reclaimed. Cash fell from 7,444.88 to ~7,316 before Thursday's rally recovered it only to 7,411 — still under the 7,457 cash-equivalent. Three approaches, three rejections." },
  { d:"28 Jul", cat:"market", c:"RTY the cleanest structure — long above 2,957.4 targeting 2,968.5", r:"miss", o:"Opened 2,960.40, closed 2,950.90. Faded all session. Cause identified and the framework rule was rewritten: rate sensitivity outranks sector composition." },
  { d:"28 Jul", cat:"market", c:"2,941 was a liquidity sweep of the 2,940 shelf, not a breakdown", r:"partial", o:"Correct that it held and reclaimed. Wrong that it would propel — it held and went nowhere." },
  { d:"28 Jul", cat:"market", c:"Rotation open, not liquidation — read the dispersion not the level", r:"hit", o:"Dow +1.20%, VIX -3.16%. No de-grossing. Exactly a sector rotation." },
  { d:"28 Jul", cat:"market", c:"Don't chase NQ shorts into the bell — first bounce lives there", r:"hit", o:"Nasdaq closed +0.08% after Kospi -11%. Chasing the gap would have been wrong." },
  { d:"28 Jul", cat:"market", c:"Chain amendment: oil ↓ moved the hike to September, didn't cancel it", r:"hit", o:"Monday: crude -8%, S&P +0.02%. The transmission break was called before the close confirmed it." },
  { d:"27 Jul", cat:"market", c:"2,982.4 (61.8% fib) is the gate — sweep-reject risk there", r:"hit", o:"Topped at 2,981.9 and rejected. Called in real time on the chart." },
  { d:"27 Jul", cat:"market", c:"RTY leads the relief leg", r:"hit", o:"RTY +0.87% vs ES +0.73% during Asia." },
  { d:"27 Jul", cat:"market", c:"'Hollow relief' detector — if RTY and breadth don't confirm, expect a pre-FOMC fade", r:"hit", o:"Fired correctly. The fade arrived on schedule." },
  { d:"24 Jul", cat:"market", c:"Oil blow-off warning at $97–99 — watch for the reversal", r:"hit", o:"Brent kissed $102 then gave back ~$15 in three sessions." },
  { d:"24 Jul", cat:"market", c:"NQ is the weak leg, not RTY — don't autopilot the small-cap short", r:"hit", o:"Week of 20–24 Jul: NQ -2.1% vs RTY -0.3%." },
  { d:"23 Jul", cat:"market", c:"ES below the shelf targets 7,493 in your frame", r:"hit", o:"Hit in full." },
  { d:"22 Jul", cat:"market", c:"RTY 3,000-wall rejection short", r:"hit", o:"Rejected and traded down as mapped." },
  { d:"23 Jul", cat:"market", c:"Intel: the market pays sellers of AI compute", r:"partial", o:"Right that it was conditional and that SAP/Oracle/ServiceNow held gains. Wrong-footed by the -6.5% reversal after a blowout beat — that reversal became the 'distribution into strength' lesson." },
  { d:"21 Jul", cat:"market", c:"Post-opex week weakness prior", r:"hit", o:"S&P -0.6% on the week. Prior scored." },
  { d:"21 Jul", cat:"market", c:"Turnaround Tuesday prior", r:"hit", o:"Squeeze delivered on schedule." },
  { d:"20 Jul", cat:"market", c:"RTY levels from Investing.com futures page (~2,738 pivot cluster)", r:"miss", o:"Data was ~8% wrong — actual RTY was ~2,970. Levels voided the same day; all RTY levels now cross-checked against cash Russell 2000. This one is a process failure, and it stays on the board." }
];

/* ==========================================================
   RENDER
   ========================================================== */

var STATE_META = {
  held:     { c:"var(--good)",     i:"●", l:"Held" },
  swept:    { c:"var(--warning)",  i:"◆", l:"Swept" },
  broken:   { c:"var(--critical)", i:"✕", l:"Broken" },
  untested: { c:"var(--text-muted)", i:"○", l:"Untested" }
};
/* FIVE states, and the fifth exists because four could not tell the truth about
   a conditional whose condition never happened.

   Friday's RTY call said: short on a 30-minute close below 3,004.90. The low
   after the print was 3,019.10 — fourteen points above the trigger — so there
   was never a position. Scoring that a HIT would inflate the record with a
   trade that was never taken: the directional read was wrong, and a looser
   trigger would have cost money. Scoring it a MISS would punish the entry
   discipline for working, which is the one habit this board is trying to build.
   Neither number should move, and the reader should be told the call existed
   and did not fire.

   So NO TRADE is counted separately and excluded from the hit rate, the same
   way the build log is — for the same reason, that mixing it in answers a
   different question than the one the number is asked. It is drawn in text ink,
   not a status colour: not firing is not a fault. */
var RES_META = {
  hit:     { c:"var(--good)",         i:"✓", l:"Hit" },
  partial: { c:"var(--warning)",      i:"◐", l:"Partial" },
  miss:    { c:"var(--critical)",     i:"✕", l:"Missed" },
  notrade: { c:"var(--text-secondary)", i:"—", l:"No trade" },
  pending: { c:"var(--text-muted)",   i:"○", l:"Pending" }
};
var TILE_ST = { good:"var(--good)", warn:"var(--warning)", crit:"var(--critical)" };
var ORD = ["var(--ord-1)","var(--ord-2)","var(--ord-3)","var(--ord-4)","var(--ord-5)"];

function el(tag, cls, html){ var e=document.createElement(tag); if(cls)e.className=cls; if(html!=null)e.innerHTML=html; return e; }
function fmt(n, dp){ return n.toLocaleString("en-US",{minimumFractionDigits:dp,maximumFractionDigits:dp}); }
function chip(meta){ return '<span class="chip"><i style="color:'+meta.c+'">'+meta.i+'</i>'+meta.l+'</span>'; }

/* ---- tiles ---- */
var tileFoldOpen = {};
function tileNote(t){
  /* THROUGH THE RESOLVER, like every other block that writes {{tokens}}.
     Until 18 Aug this did not, and TILES carried fourteen of them: the card
     rendered "{{pool ES 7766.49}}" as literal text the moment a reader opened
     either fold. Invisible with the folds shut, which is how it survived — and
     invisible to the gate as well, because prose_levels RESOLVES the tokens
     itself before checking, so it read a correct sentence the reader never saw.
     Two implementations of one grammar, diverging exactly the way KNOWN TRAPS
     says they do.

     NOT frozen. renderTiles repaints on every feed update — paintTiles calls it —
     so a tile price IS current and marking it "as built" would be a false
     disclaimer. That is the opposite of the scenario branches, which never
     repaint and are labelled for that reason (D10).

     Both tile paths converge here: paintTiles updates px/chg and calls
     renderTiles, which is this function's only caller. One place, not two. */
  var note = (typeof scenTok === "function") ? scenTok(t.note) : t.note;
  var cut = note.indexOf("|||");
  if (cut < 0) return note;
  var lead = note.slice(0, cut), work = note.slice(cut + 3);
  return lead +
    '<details class="disc tile-disc" data-tile="' + t.k + '"' +
    (tileFoldOpen[t.k] ? " open" : "") + ">" +
    '<summary><span>The working</span></summary>' +
    '<div class="disc-body">' + work + "</div></details>";
}
function wireTileFolds(host){
  var ds = host.querySelectorAll("details[data-tile]"), i;
  for (i = 0; i < ds.length; i++)
    (function(el2){
      el2.addEventListener("toggle", function(){
        tileFoldOpen[el2.getAttribute("data-tile")] = el2.open;
      });
    })(ds[i]);
}
function renderTiles(){
  var host = document.getElementById("tiles");
  host.innerHTML = "";
  TILES.forEach(function(t){
    /* A missing change is printed as a dash, not as a crash and not as zero.
       This whole paint sits inside the try/catch that swallows exceptions, so a
       null here used to take the entire tile strip out and leave a blank card —
       and "no number" is a legitimate state: the feed carries a close for every
       instrument but not a prior close for every one of them. */
    /* And the price is no longer allowed to be hand-typed. A curated px is a
       number that was true when it was written and is silently false after the
       next refresh — the exact failure the age guard was built to catch, on the
       most prominent five numbers on the page. So the tile carries JUDGEMENT
       only (label, bias, state, note) and reads its price out of the snapshot
       that ships with the build, which the live feed then overwrites. A literal
       left in px still wins, so an override is possible; the guard just refuses
       to bake one that disagrees with the payload underneath it. */
    /* nochg suppresses the percentage entirely. It exists because the relay's
       two CNBC-sourced quotes — HSI and crude — carry a prev_close that stopped
       rolling after Thursday, so their chg_pct is computed against the wrong
       day and is wrong by whole per cent. The level is still good; only the
       comparison is broken. Printing an em dash and explaining why in the note
       is the honest treatment. Printing −5.09% because the feed said so is not,
       and "the feed said so" has never been a reason to publish a number. */
    var q = SNAPSHOT && SNAPSHOT.quotes ? SNAPSHOT.quotes[TILE_MAP[t.k]] : null;
    var px = (typeof t.px === "number" && isFinite(t.px)) ? t.px
           : (q && typeof q.px === "number" && isFinite(q.px)) ? q.px : null;
    /* UNTRUSTED_PREV is consulted as well as t.nochg, so the flag can be set in
       either place and both agree. Two independently-maintained lists of the
       same fact is how they drift apart. */
    /* The payload branch goes through liveChg rather than re-implementing it.
       This asked the list correctly and then read q.chg_pct inline, which is the
       right ANSWER reached by a second copy of the same logic -- and a second
       copy is how the two drift. The untrusted() gate stays in front, because
       here it also suppresses a hand-typed t.chg override, which liveChg knows
       nothing about; liveChg's own check is then redundant and can only agree,
       being the same quote and the same key. */
    var cg = (t.nochg || untrusted(q, TILE_MAP[t.k])) ? null
           : (typeof t.chg === "number" && isFinite(t.chg)) ? t.chg
           : liveChg(q, TILE_MAP[t.k]);
    var sign = (cg != null && cg > 0) ? "+" : "";
    var d = el("div","tile");
    d.innerHTML =
      '<div class="tile-label">'+t.label+'</div>'+
      '<div class="tile-val">'+(px==null ? "—" : fmt(px, 2))+'</div>'+
      /* The note honours the page's LEAD ||| WORKING convention. ES's note had
         grown to 338 words against 27-33 on the small tiles -- twelve times the
         reading cost, in the row whose whole job is a glance -- because a note
         with no fold has nowhere to put its evidence except in front of the
         reader. A note with no ||| still renders whole, which is the documented
         fallback everywhere else on this page. THE SPLIT IS A CUT, NOT A
         REWRITE: the lead is the note's own opening sentences, so it cannot
         drift from the working it summarises. Open state persists per symbol in
         tileFoldOpen, keyed to the THING, same as every other fold store. */
      '<div class="tile-delta">'+(cg==null?"—":sign+cg.toFixed(2)+"%")+' · '+tileNote(t)+'</div>'+
      '<div class="tile-bias"><span class="dot" style="background:'+TILE_ST[t.st]+'"></span>'+t.bias+'</div>';
    host.appendChild(d);
  });
  wireTileFolds(host);
}
renderTiles();

/* ---- hero countdown ---- */
(function heroClock(){
  var figEl=document.getElementById("heroFig"),
      labEl=document.getElementById("heroLabel"),
      subEl=document.getElementById("heroSub"),
      nxtEl=document.getElementById("heroNext");
  function tick(){
    /* Through nextEvent(), which the summary bar also calls. These used to be two
       loops over one list, which is two chances to disagree about which event is
       next across a boundary minute — the countdown showing one name while the
       line six pixels below it showed another. */
    var now = Date.now(), nxt = nextEvent(now);
    /* The "what's after that" strip has to be cleared here too. It is only
       written in the branch below, so on the last event of the week it would
       otherwise keep displaying two catalysts that have already happened —
       under a headline saying the week is complete. */
    if (!nxt){
      labEl.textContent="Week complete"; figEl.textContent="—";
      figEl.className = "hero-fig";
      subEl.textContent="Next brief 8:00 AM HKT."; nxtEl.textContent=""; return;
    }
    var ms = new Date(nxt.t).getTime() - now;
    var h = Math.floor(ms/3600000), m = Math.floor(ms%3600000/60000), s = Math.floor(ms%60000/1000);
    labEl.textContent = "Time to " + nxt.n;
    figEl.textContent = (h>0? h+"h " : "") + String(m).padStart(2,"0") + "m " + String(s).padStart(2,"0") + "s";
    figEl.className = "hero-fig" + (ms < 3600000 ? " imminent" : "");
    subEl.innerHTML = "<b>" + nxt.h + "</b>";
    var after = EVENTS.filter(function(e){ return new Date(e.t).getTime() > now; }).slice(1,3);
    nxtEl.innerHTML = after.map(function(e){ return e.n + " · " + e.h; }).join("&nbsp;&nbsp;·&nbsp;&nbsp;");
  }
  tick(); setInterval(tick, 1000);
})();

/* ---- session clock ----
   Everything here derives from a supplied instant, never from an implicit
   "now". That is what lets the pre-render step freeze the card at the
   snapshot time instead of baking a moment that is wrong by tomorrow. */
var TRUST_WORD = ["Shut", "Low", "Moderate", "High"];

/* Hong Kong does not observe daylight saving, so HKT is a fixed UTC+8 and the
   arithmetic below is exact all year. Doing it by hand rather than through
   toLocaleString keeps the pre-render honest: the build container is on UTC. */
function hkParts(ms){
  var d = new Date(ms + 8*3600000);
  return { min: d.getUTCHours()*60 + d.getUTCMinutes(), dow: d.getUTCDay(), sec: d.getUTCSeconds() };
}
function hhmm(m){
  m = ((m % 1440) + 1440) % 1440;
  return String(Math.floor(m/60)).padStart(2,"0") + ":" + String(m%60).padStart(2,"0");
}
/* Contracts are shut from Sat 05:00 HKT until Mon 06:00 HKT. The weekday phase
   table cannot express that, so it is checked separately and wins. */
function weekendShut(p){
  if (p.dow === 6 && p.min >= 300) return true;   /* Saturday after the halt */
  if (p.dow === 0) return true;                   /* Sunday */
  if (p.dow === 1 && p.min < 360) return true;    /* before Monday's reopen */
  return false;
}
/* ------------------------------------------------------------------------
   THE SESSION CLOCK IS DERIVED FROM REAL TIMEZONES, NOT FROM FIXED UTC HOURS.

   Until 10 Aug 2026 this table's s/e were hard-coded HKT minutes and sessAt()
   classified by hard-coded UTC hours, both of which silently assumed the US
   would be on EDT forever. Hong Kong has no daylight saving; New York and
   London do, on DIFFERENT dates. Run 2 November 2026 through the old code and
   the power hour (20:30Z) and the cash close (21:00Z) both come back EVE
   instead of RTH — and since sessAt() picks the divisor for pace(), and pace()
   sets every x-distance on this page, the two highest-volume half hours of the
   day would have been divided by the post-close median. Every distance would
   have read about half as far as it is, in the direction that puts levels "in
   reach" that are not.

   It is not a two-state problem either. Europe leaves DST on 25 Oct and the US
   on 1 Nov, so for one week London opens an hour later relative to New York
   than it does in either steady state. A boolean cannot express that; a real
   timezone database can.

   So each row now carries the exchange whose clock DEFINES it (tz) and its
   local start minute in that clock (lm), and the boundaries are projected into
   the display timezone at paint time. s/e remain in the table as the
   EDT/BST-era reference values, because kzlib.load_phases() parses this literal
   and maps killzones onto row INDICES; the row order and count are unchanged,
   so that contract holds. Nothing on the page reads s/e any more.
   ------------------------------------------------------------------------ */

/* Minutes east of UTC for a named zone at a given instant. Formats the instant
   in that zone and reads it back as if it were UTC — the difference IS the
   offset, and it is correct across every DST rule without a table to maintain. */
function tzOffMin(ms, tz){
  var d = new Date(ms);
  var s = d.toLocaleString("en-US", { timeZone: tz, hour12: false,
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit" });
  var m = /(\d+)\/(\d+)\/(\d+),?\s+(\d+):(\d+)/.exec(s);
  if (!m) return 0;
  var hh = +m[4] % 24;   /* en-US can hand back 24:00 at local midnight */
  var asUtc = Date.UTC(+m[3], +m[1] - 1, +m[2], hh, +m[5], 0);
  var utc = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(),
                     d.getUTCHours(), d.getUTCMinutes(), 0);
  return Math.round((asUtc - utc) / 60000);
}
var TZ_NAME = { ET: "America/New_York", LON: "Europe/London", HK: "Asia/Hong_Kong" };
/* The display clock. HKT by standing decision — Hong Kong keeps no daylight
   saving, so this one never moves, and everything that DOES move is now
   projected onto it rather than assumed against it. */
var DISPLAY_TZ = "Asia/Hong_Kong";

/* A row's start, in display-clock minutes, on the date of `ms`. */
function phaseStart(row, ms){
  if (row.tz == null || row.lm == null) return row.s;      /* pre-anchor rows */
  var off = tzOffMin(ms, DISPLAY_TZ) - tzOffMin(ms, TZ_NAME[row.tz] || DISPLAY_TZ);
  var v = (row.lm + off) % 1440;
  return v < 0 ? v + 1440 : v;
}
/* The whole table projected and re-sorted for the given instant. Boundaries are
   contiguous by construction — each row runs to the next row's start — so a
   projection that moves one row moves its neighbour's end with it and no gap
   can open up. Sorted because a DST shift can rotate a row past midnight. */
function phaseTable(ms){
  var out = [], i;
  for (i = 0; i < SESSION.length; i++)
    out.push({ i: i, row: SESSION[i], s: phaseStart(SESSION[i], ms) });
  out.sort(function(a, b){ return a.s - b.s; });
  for (i = 0; i < out.length; i++)
    out[i].e = out[(i + 1) % out.length].s;
  return out;
}
function phaseAt(min, ms){
  var T = phaseTable(ms == null ? Date.now() : ms), i;
  for (i = 0; i < T.length; i++){
    var s = T[i].s, e = T[i].e;
    if (e > s ? (min >= s && min < e) : (min >= s || min < e)) return T[i].i;
  }
  return SESSION.length - 1;
}

function buildStrip(){
  var host = document.getElementById("sessStrip");
  host.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  var axis = el("div","sess-axis");
  host.appendChild(axis);
  /* Height carries break-trust. A shut phase still gets a visible sliver so the
     axis never looks broken, but it is unmistakably the shortest thing there. */
  var H = { 0:5, 1:11, 2:20, 3:30 };
  /* Geometry from the PROJECTED table. A segment keeps its row index as its id
     so paintSession can outline the current one, but its position comes from
     where that phase actually falls today. A row rotated past midnight by a DST
     shift is drawn as two pieces rather than as a negative width. */
  phaseTable(Date.now()).forEach(function(e){
    var ph = e.row;
    var pieces = e.e > e.s ? [[e.s, e.e]] : [[e.s, 1440], [0, e.e]];
    pieces.forEach(function(pc, k){
      if (pc[1] <= pc[0]) return;
      var seg = el("div","sess-seg" + (ph.tr===0 ? " shut" : ""));
      seg.style.left   = (pc[0] / 1440 * 100) + "%";
      seg.style.width  = "calc(" + ((pc[1] - pc[0]) / 1440 * 100) + "% - 2px)";
      seg.style.height = H[ph.tr] + "px";
      seg.id = k === 0 ? "sseg" + e.i : "sseg" + e.i + "b";
      host.appendChild(seg);
    });
  });
  [0,360,720,1080,1440].forEach(function(m){
    var t = el("div","sess-tick", m===1440 ? "24:00" : hhmm(m));
    t.style.left = (m/1440*100) + "%";
    if (m === 0)    { t.style.left = "0";    t.style.transform = "none"; }
    if (m === 1440) { t.style.left = "auto"; t.style.right = "0"; t.style.transform = "none"; }
    host.appendChild(t);
  });
  var mk = el("div","sess-now-mk");
  mk.id = "sessMk";
  host.appendChild(mk);
}

function paintSession(atMs, frozenNote){
  var p = hkParts(atMs);
  var nphS = 0;
  var atRef = atMs == null ? Date.now() : atMs;
  var PT = phaseTable(atRef);                 /* projected once, used throughout */
  var byIdx = {}; for (var pi = 0; pi < PT.length; pi++) byIdx[PT[pi].i] = PT[pi];
  var idx = phaseAt(p.min, atRef);
  var ph = SESSION[idx];
  var shut = weekendShut(p);

  /* marker + current-phase outline */
  var mk = document.getElementById("sessMk");
  if (mk) mk.style.left = (p.min / 1440 * 100) + "%";
  for (var i=0;i<SESSION.length;i++){
    var s = document.getElementById("sseg"+i);
    if (s) s.classList.toggle("cur", i === idx && !shut);
  }

  var tr   = shut ? 0 : ph.tr;
  var name = shut ? "Weekend — everything is shut" : ph.n;
  var note = shut
    ? "RTY and ES are closed from 05:00 Saturday until 06:00 Monday; MHI is shut from 03:00 Saturday until 09:15 Monday, which is the longest gap of the week and the one that carries the most headline risk. Any price you see quoted now is a stale last print, not a market."
    : ph.note;

  var bars = "";
  for (var b=1;b<=3;b++){
    bars += '<i class="'+(b<=tr?"on":"")+'" style="height:'+(b*4)+'px"></i>';
  }

  document.getElementById("sessNow").innerHTML =
    '<div class="sess-lab">Right now &middot; Hong Kong time</div>'+
    '<div class="sess-name">'+name+'</div>'+
    '<div class="sess-meta">'+(shut ? "Reopens 06:00 Monday HKT"
        : hhmm(byIdx[idx].s)+"–"+hhmm(byIdx[idx].e)+" HKT &middot; it is "+hhmm(p.min))+'</div>'+
    '<div class="sess-trust"><u>'+bars+'</u>Break follow-through: '+TRUST_WORD[tr]+'</div>'+
    mhiRow(p.min, shut)+
    '<div class="sess-note">'+note+'</div>'+
    (frozenNote ? '<div class="sess-meta" style="margin-top:9px">'+frozenNote+'</div>' : '');

  var nxt = document.getElementById("sessNext");
  if (shut){
    nxt.innerHTML = "Next phase: <b>Globex reopen</b> at 06:00 HKT Monday.";
  } else {
    /* The midday lull straddles midnight as two rows, so the naive "next" can be
       the same phase again — announcing a change that is not one. Skip ahead to
       the first phase that actually reads differently. */
    /* Walked in PROJECTED order, not in table order: a DST shift can rotate a
       row across midnight, and "the next row in the literal" would then be a
       phase that has already happened. */
    var pos = 0; for (var pk = 0; pk < PT.length; pk++) if (PT[pk].i === idx) pos = pk;
    var nph = null, end = byIdx[idx].e, guard = 0, k2 = pos;
    while (guard++ < PT.length){
      k2 = (k2 + 1) % PT.length;
      if (PT[k2].row.n !== ph.n){ nph = PT[k2].row; nphS = PT[k2].s; break; }
      end = PT[k2].e;
    }
    if (!nph){ nph = PT[(pos + 1) % PT.length].row; nphS = PT[(pos + 1) % PT.length].s; }
    var left = end - p.min; if (left <= 0) left += 1440;
    var h = Math.floor(left/60), mm = left % 60;
    nxt.innerHTML = "In <b>" + (h ? h + "h" + (mm ? " " + mm + "m" : "") : left + "m") +
                    "</b> this becomes <b>" + nph.n + "</b> · " + hhmm(nphS) + " HKT" +
                    ' <span style="color:var(--text-muted)">(' + TRUST_WORD[nph.tr].toLowerCase() + ' follow-through)</span>';
  }
}

/* One line, not a paragraph. The reader needs to know three things about the HK
   contract at a glance -- is it trading, what is this window, and how long until
   that changes -- and a fourth sentence explaining any of them would put this
   card back where the rest of the board already is. */
function mhiRow(min, shut){
  if (shut) return '<div class="sess-mhi"><span class="mchip">MHI SHUT</span>' +
                   '<span>weekend &mdash; the front month is ' + CONTRACT.HSI.month +
                   ', last trading day ' + CONTRACT.HSI.ltd + '</span></div>';
  var m = mhiAt(min);
  var h = Math.floor(m.left / 60), mm = m.left % 60;
  var lt = h ? (h + "h" + (mm ? " " + mm + "m" : "")) : (mm + "m");
  var cls = m.st === "open" ? " on" : m.st === "pre" ? " pre" : "";
  return '<div class="sess-mhi"><span class="mchip' + cls + '">' + MHI_WORD[m.st] + '</span>' +
         '<span>' + m.d + ' &middot; <b>' + lt + '</b> to the change</span></div>';
}

function buildSessTable(){
  var t = document.getElementById("sessTv");
  t.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  var rows = ['<thead><tr><th>Window (HKT)</th><th>Phase</th><th>Follow-through</th></tr></thead><tbody>'];
  /* Projected, and in projected order, so the table reads down the day as it
     actually falls rather than as it fell in July. */
  phaseTable(Date.now()).forEach(function(e){
    var ph = e.row;
    /* hhmm wraps 1440 to 00:00, which reads as the start of the day rather than
       the end of it. A final boundary landing there is spelled out. */
    rows.push('<tr><td>'+hhmm(e.s)+'–'+(e.e===0 ? "24:00" : hhmm(e.e))+'</td><td style="text-align:left;white-space:normal">'+
              ph.n+'</td><td>'+TRUST_WORD[ph.tr]+'</td></tr>');
  });
  rows.push('</tbody>');
  t.innerHTML = rows.join("");
}

buildStrip();
buildSessTable();
paintSession(Date.now());
setInterval(function(){ paintSession(Date.now()); }, 30000);

/* The only export off this page. The pre-render step needs to freeze the clock
   at the snapshot instant rather than at build time; everything else it can do
   through the DOM. Nothing here mutates state on its own. */
window.__wf = { paintSession: paintSession };

document.getElementById("sessTvBtn").onclick = function(){
  var w = document.getElementById("sessTvWrap");
  var on = w.classList.toggle("on");
  this.textContent = on ? "Hide table view" : "Show table view";
};

/* ---- ladder ---- */
/* liqPx and pxSource are declared further down, in the liquidity block; function
   declarations hoist to the top of this IIFE, so calling them here is safe. The
   ladder deliberately shares them with the map rather than keeping a price of its
   own — two cards quoting two different prices for the same contract is the exact
   failure this dashboard exists to avoid. pxManual latches the moment the reader
   types: after that the tape stops overwriting their number. */
/* THE LIVE-PRINT STATE IS DECLARED HERE, ahead of every consumer, and the
   position is load-bearing rather than tidy. var hoists the declaration and not
   the assignment, so any of this sitting beside the code that READS it is
   `undefined` for every call that happens earlier in the file — and the very
   next line calls liqPx(), which now consults it. Declared late, LIVEPRINT took
   the ladder out at parse time and LP_SYMS took out the wiring; both failed
   silently as an empty card rather than loudly, which is exactly how the tile
   map's identical bug behaved and why that one carries a comment too. */
var PRINT_TTL_MS = 15 * 60 * 1000;   /* how long a print you typed stays current */
var LIVEPRINT = {};                  /* sym -> { px, at } — your own print, top rung */
var LP_SYMS = ["ES", "RTY", "NQ", "YM", "HSI"];

var curKey = "RTY", curPx = liqPx("RTY"), pxManual = false;

/* TICK PRECISION IS NOT BIN PRECISION, AND THE BOX NEEDS THE FIRST ONE.
   LADDERS[k].dp comes from the volume profile's bin width and belongs to the
   levels: a value-area edge inferred from a 2.5-point bin has no business
   printing three decimals. The live price is not an inference from a bin, and
   when ES's bins widened past a point and dp fell from 2 to 1, the box started
   rendering 7760.75 as "7760.8" -- a price that does not exist on the ES tape,
   in the one field on this page whose whole job is to show what the tape says.

   Measured over the archive's 5-minute bars: ES prints only .00/.25/.50/.75
   across 384 prices, RTY prints all ten tenths. The tick is DECLARED here and
   the ladder guard checks the tape against it, rather than the reverse -- a
   quiet window that happened to print only halves would yield a measured tick
   of 0.50, and a box built on that would round real prices away and call it a
   measurement. Declared-and-falsified is the arrangement where being wrong is
   loud. NQ and YM carry no board yet; their ticks are here so that adding one
   cannot reintroduce this bug by omission.

   THE HK ROW IS ABSENT FROM THIS MAP ON PURPOSE, AND THE REASON IS NOT THE ONE
   THAT USED TO BE WRITTEN HERE. This map answers exactly one question -- what
   grid does the TAPE print on -- and the HK tape on this board is the cash Hang
   Seng, a weighted average of constituents that legitimately reads 25915.8203
   and sits on no grid at all. HSI:1 was written in here on the first pass and
   the guard rejected it the same minute, which is the arrangement working.

   What the old note then did was draw the wrong conclusion out loud: that
   because the FEED has no tick, the BOARD is not about a futures contract. It
   is. The instrument this board exists for is the Mini-Hang Seng future, and
   MHI has a tick -- one index point, HK$10 a point. The feed and the contract
   are different things and the error was ever asking one map to hold both.
   The contract's own facts live in CONTRACT above, declared with MHI's clock
   because the session card reads it before this region runs; that is where the
   price box now takes its step from; this map stays what it always was, the tape's
   grid, so the guard that falsifies it keeps testing something it can see. */
var TICK = { ES:0.25, RTY:0.1, NQ:0.25, YM:1 };

function tickDp(k){
  var t = TICK[k];
  if (!t) return (LADDERS[k] || { dp:2 }).dp;   /* unknown contract: old behaviour */
  var d = 0, x = t;
  while (Math.abs(x - Math.round(x)) > 1e-9 && d < 6){ x *= 10; d++; }
  return d;
}

/* toFixed, not fmt: fmt groups thousands, and "2,970.0" in a number box is a
   value parseFloat reads as 2. The step goes with the value because a spinner
   that moves an ES price by a tenth walks it off the tick grid one arrow-press
   at a time, which is the same defect as the display bug wearing gloves. */
function setPxBox(k, p){
  var box = document.getElementById("priceIn");
  if (!box) return;
  /* the STEP is the reader's grid, so it comes from the contract he trades;
     TICK is the tape's grid and is the fallback for the boards where the two
     are the same instrument. An index feed with neither still gets "any". */
  box.step = (CONTRACT[k] && CONTRACT[k].tick) || TICK[k] || "any";
  if (p == null || !isFinite(p)) return;
  box.value = p.toFixed(tickDp(k));
}

(function buildTabs(){
  var host = document.getElementById("ladderTabs");
  host.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  Object.keys(LADDERS).forEach(function(k){
    var b = el("button","tab",LADDERS[k].label);
    b.type="button"; b.setAttribute("role","tab");
    b.setAttribute("aria-selected", k===curKey ? "true":"false");
    b.onclick = function(){
      /* A new contract is a new price, so the manual latch releases here. Keeping
         it would carry an RTY number the reader typed onto the ES board. */
      curKey = k; pxManual = false; curPx = liqPx(k);
      Array.prototype.forEach.call(host.children,function(c){ c.setAttribute("aria-selected","false"); });
      b.setAttribute("aria-selected","true");
      setPxBox(k, curPx);
      drawLadder();
    };
    host.appendChild(b);
  });
  setPxBox(curKey, curPx);
})();

document.getElementById("priceIn").addEventListener("input", function(e){
  var v = parseFloat(e.target.value);
  /* The ladder's own box now writes into the SAME store as the bar at the top.
     Two inputs for one fact is how they end up disagreeing, and the one the
     reader is not looking at is always the one that wins. */
  if (!isNaN(v) && v > 0){
    LIVEPRINT[curKey] = { px: v, at: Date.now() };
    curPx = v; pxManual = true;
    var top = document.getElementById("lpIn"), sel = document.getElementById("lpSym");
    if (sel && sel.value !== curKey){ sel.value = curKey; }
    if (top) top.value = String(v);
    lpPaint();
    lpRepaint();
  }
});

(function wireSizing(){
  var eq = document.getElementById("szEq"), rk = document.getElementById("szRisk"),
      inst = document.getElementById("szInst"), st = document.getElementById("szStop"),
      eqc = document.getElementById("szEqCcy");
  if (!eq || !rk || !inst || !st) return;
  /* The default comes from the state's owner, not from a second copy of it
     here — that duplication is exactly what the setSize door exists to stop. */
  var cur = (window.__wf && window.__wf.sizeState) ? window.__wf.sizeState().inst : SIZE_SPEC[0].k;
  var o = "";
  for (var i = 0; i < SIZE_SPEC.length; i++)
    o += '<option value="' + SIZE_SPEC[i].k + '"' + (SIZE_SPEC[i].k === cur ? " selected" : "") +
         ">" + SIZE_SPEC[i].label + "</option>";
  inst.innerHTML = o;
  /* The currency list is DERIVED from the contract table, not typed beside it.
     A second list here would be a hand-maintained copy of a set the table
     already owns, and it would go stale in exactly one direction: a contract
     added in a currency this select does not offer becomes a contract nobody
     can size, with no error anywhere. See the floor-beside-typed-list entry in
     lessons.json. */
  if (eqc){
    var seen = {}, co = "", cc, j;
    var curc = (window.__wf && window.__wf.sizeState) ? window.__wf.sizeState().eqCcy : null;
    for (j = 0; j < SIZE_SPEC.length; j++){
      cc = SIZE_SPEC[j].ccy;
      if (seen[cc]) continue;
      seen[cc] = 1;
      co += '<option value="' + cc + '"' + (cc === curc ? " selected" : "") + ">" + cc + "</option>";
    }
    eqc.innerHTML = co;
  }
  var read = function(){
    if (!window.__wf || !window.__wf.setSize) return;
    window.__wf.setSize({ eq: parseFloat(eq.value), risk: parseFloat(rk.value),
                          eqCcy: eqc ? eqc.value : undefined,
                          inst: inst.value, stop: parseFloat(st.value) });
  };
  eq.addEventListener("input", read);
  rk.addEventListener("input", read);
  st.addEventListener("input", read);
  /* The contract change also re-proposes stops, because a stop measured in ES
     points is a different object from one measured in YM points and carrying it
     across is how a reader ends up sizing a Dow trade off an S&P distance. */
  inst.addEventListener("change", read);
  if (eqc) eqc.addEventListener("change", read);
  read();
})();

(function wireJournal(){
  var inst = document.getElementById("jrInst"), add = document.getElementById("jrAdd"),
      exp = document.getElementById("jrExport"), clr = document.getElementById("jrClear"),
      box = document.getElementById("jrOutBox");
  if (!inst || !add) return;
  /* Every tradeable contract the sizing card knows, in the same order and with
     the same labels — one table, so a journal entry and a size calculation
     cannot be about different instruments under one name. */
  var o = "";
  for (var i = 0; i < SIZE_SPEC.length; i++)
    o += '<option value="' + SIZE_SPEC[i].k + '">' + SIZE_SPEC[i].label + "</option>";
  inst.innerHTML = o;

  var v = function(id){ var e = document.getElementById(id); return e ? e.value : ""; };
  add.addEventListener("click", function(){
    var pin = parseFloat(v("jrIn")), pout = parseFloat(v("jrOut"));
    if (!isFinite(pin) || !isFinite(pout)){
      /* Refused rather than recorded as a blank. A journal row with no prices is
         a row that will be believed later and cannot be checked. */
      box.classList.add("on");
      box.value = "Entry and exit are both needed — a row without them cannot be scored, " +
                  "and a journal that accepts one will be trusted for it later.";
      return;
    }
    window.__wf.jrAdd({ inst: v("jrInst"), dir: v("jrDir"), in: pin, out: pout,
                        qty: parseInt(v("jrQty"), 10) || 1, note: v("jrNote") });
    var n = document.getElementById("jrNote"); if (n) n.value = "";
    box.classList.remove("on");
  });
  exp.addEventListener("click", function(){
    var j = window.__wf.journal();
    box.classList.add("on");
    /* The export is the DATA, in the shape the page would bake it in — not a
       rendered table. A pretty summary cannot be pasted back. */
    box.value = j.length
      ? "var JOURNAL_IN = " + JSON.stringify(j.map(function(e){
          return { at:e.at, inst:e.inst, dir:e.dir, in:e.in, out:e.out, qty:e.qty, note:e.note };
        })) + ";"
      : "No trades recorded in this session.";
    box.focus(); box.select();
  });
  clr.addEventListener("click", function(){
    window.__wf.jrClear();
    box.classList.remove("on"); box.value = "";
  });
  /* NOT drawJournal() here. This IIFE runs while the script is still on its way
     down the file, and `var JOURNAL` is declared further down beside the painter
     — hoisted, so it exists and is UNDEFINED, and the first paint threw on
     .length. On this page a top-level throw does not cost one card: it aborts
     the rest of the script and takes every painter after it with it, which is
     what happened on this feature's first run. The first paint is issued by the
     engine itself, immediately after its own state exists. */
})();

(function wireLivePrint(){
  var sel = document.getElementById("lpSym"), box = document.getElementById("lpIn"),
      clr = document.getElementById("lpClr");
  if (!sel || !box || !clr) return;
  /* Only contracts this page can actually measure a distance for. A symbol with
     no ladder and no profile would accept a number and change nothing, which is
     a worse outcome than not offering it. */
  var opts = "";
  for (var i = 0; i < LP_SYMS.length; i++){
    var k = LP_SYMS[i];
    if (!LADDERS[k] && !LIQ[k]) continue;
    opts += '<option value="' + k + '"' + (k === curKey ? " selected" : "") + ">" +
            ((LADDERS[k] && LADDERS[k].label) || k) + "</option>";
  }
  sel.innerHTML = opts;
  sel.addEventListener("change", function(){
    var e = printAt(lpSym());
    box.value = e ? String(e.px) : "";
    lpPaint();
  });
  box.addEventListener("input", lpApply);
  clr.addEventListener("click", function(){
    LIVEPRINT = {};
    box.value = "";
    pxManual = false; curPx = liqPx(curKey); setPxBox(curKey, curPx);
    lpPaint();
    lpRepaint();
  });
  lpPaint();
  /* The bar re-states its own age on the poll, so a print quietly ageing toward
     expiry is visible rather than discovered at the moment it vanishes. */
  setInterval(lpPaint, 30000);
})();

/* The ladder follows the tape, but a redraw collapses whatever detail row the
   reader has open — so it only redraws once price has moved far enough to change
   what the board actually says, which is a quarter of a typical 30-minute move.
   Under that the columns would shuffle by a rounding digit and cost the reader
   their place for nothing. Once they type their own price this stops touching it. */
function syncLadderPx(){
  if (pxManual) return;
  var p = liqPx(curKey);
  if (p == null || p === curPx) return;
  var mv = MOVES[curKey], tol = (mv && mv.t30 > 0) ? mv.t30 * 0.25 : 0;
  if (Math.abs(p - curPx) < tol) return;
  curPx = p;
  setPxBox(curKey, curPx);
  drawLadder();
}
/* A test seam, on the same contract as drawLiq and drawCat. The assertion worth
   making from outside is the one this function exists to guarantee: that a price
   the reader typed SURVIVES the next tape update. That cannot be checked by
   waiting for a poll — the harness runs with the network aborted — so the sync
   has to be callable directly. */
window.__wf.syncLadderPx = syncLadderPx;
/* Exposed so the guard can check the DECLARED tick against the tape rather than
   trusting this file's arithmetic about its own contracts. */
window.__wf.TICK = TICK;
window.__wf.CONTRACT = CONTRACT;
window.__wf.ladState = function(){
  return { key: curKey, px: curPx, manual: pxManual, src: pxManual ? "manual" : pxSource(curKey) };
};

/* How far is that, in time rather than points? A distance of 3.4 typical moves
   says the level is not reachable inside the next half hour without a change of
   regime — which is the entry-timing question, and points alone cannot answer it. */
function moveMult(dist, atMs){
  var p = pace(curKey, atMs);
  if (!p || !(p.v > 0)) return null;
  return Math.abs(dist) / p.v;
}
/* Was a hand-written twin of the liquidity map's footnote, justifying a
   different divisor in different words. Both now print the same sentence from
   the same function, so the only way they can disagree about how far a level is
   is if they disagree about the level. */
function moveKey(atMs){ return paceTxt(curKey, atMs); }

/* The ladder has a clock now, where it used to have none. Its × column divides
   by the pace of the current session, so it draws one board overnight and a
   different one after the bell — which is the correct behaviour and also a new
   way for the static bake to ship a lie, since a card that reads Date.now() at
   build time freezes whatever session the build happened to run in. Hence the
   explicit instant: paintAll passes the frozen one, everything else passes
   nothing and gets now. baketest holds the seam shut. */
var ladDiscOpen = false;   /* survives the repaint that destroys the element */
function drawLadder(atMs){
  var now = atMs == null ? Date.now() : atMs;
  var L = LADDERS[curKey], host = document.getElementById("ladder");
  host.innerHTML = "";

  /* The sub is the longest prose on the page and it sits ABOVE the rungs, so
     every reader pays for all of it before reaching the thing they opened the
     card for. Fold it:  LEAD ||| SUMMARY ||| WORKING , with a single | between
     paragraphs of the working. The lead has to stand alone as the answer — what
     frame the ladder is quoted in and what basis converts it — because that is
     the part a level is unusable without. Everything that justifies those two
     facts is working, and working belongs behind a disclosure.

     A sub with no ||| renders whole and unfolded, which is what HSI's does. The
     convention is opt-in on purpose: the failure mode of an automatic split is
     a ladder silently losing its second half the day somebody writes a shorter
     paragraph than the splitter expected. */
  var parts = String(L.sub).split("|||");
  var sub = el("div","card-sub", parts[0].trim());
  sub.style.marginBottom = parts.length > 2 ? "2px" : "10px";
  host.appendChild(sub);
  if (parts.length > 2){
    var d = el("details","disc");
    d.appendChild(el("summary", null, "<span>" + parts[1].trim() + "</span>"));
    d.appendChild(el("div","disc-body", parts.slice(2).join("|||").split("|")
      .map(function(x){ return "<p>" + x.trim() + "</p>"; }).join("")));
    /* This is the page's first <details> built by a painter rather than written
       into the document, and that difference has a cost the two static ones do
       not pay: drawLadder clears its host, so every poll would destroy this
       element and rebuild it shut, snapping closed under a reader mid-sentence
       roughly once a minute. The open flag therefore lives outside the paint.
       Any future painter-built disclosure needs the same treatment. */
    d.open = ladDiscOpen;
    d.addEventListener("toggle", function(){ ladDiscOpen = d.open; });
    d.style.marginBottom = "10px";
    host.appendChild(d);
  }

  /* The HK board is the one ladder whose levels are quoted in a different
     instrument from the one they are traded in, so the countdown belongs here,
     directly above the rungs it qualifies, rather than in a card about sessions. */
  if (curKey === "HSI"){
    var mx = mhiExpiry(now);
    if (mx) host.appendChild(mx);
    var mf = mhiFutures(now);
    if (mf) host.appendChild(mf);
  }

  /* Every rung below is derived from the profile and the stop model, both of
     which pool bars across the archive window — so a break in that window is a
     fact about this list, not merely about the card that draws the profile. */
  var ladRoll = rollChip(curKey, L);
  if (ladRoll) host.appendChild(ladRoll);

  var rows = L.levels.slice().sort(function(a,b){ return b.p - a.p; });
  var maxDist = Math.max.apply(null, rows.map(function(r){ return Math.abs(r.p - curPx); })) || 1;
  var placed = false;

  rows.forEach(function(lv, idx){
    if (!placed && lv.p < curPx){ host.appendChild(hereRow(L)); placed = true; }

    var m = STATE_META[lv.st];
    var dist = lv.p - curPx;
    var pct = (dist / curPx) * 100;
    var w = Math.max(2, Math.abs(dist) / maxDist * 100);
    var ordc = ORD[Math.min(4, Math.max(0, lv.tests - 1))];
    var mult = moveMult(dist, now);

    var row = el("div","lrow");
    row.innerHTML =
      '<div class="lprice">'+fmt(lv.p, L.dp)+'</div>'+
      '<div class="lmid">'+chip(m)+
        '<div class="lname">'+lv.name+(lv.tests?' · '+lv.tests+'× tested':'')+'</div>'+
        '<div class="barwrap"><div class="bar" style="width:'+w+'%;background:'+ordc+'"></div></div>'+
      '</div>'+
      '<div class="ldist">'+(dist>0?"+":"")+fmt(dist, L.dp)+
        '<br><span style="color:var(--text-muted);font-size:10.5px">'+(pct>0?"+":"")+pct.toFixed(2)+'%</span>'+
        (mult==null ? "" : '<span class="lmove'+(mult<1?" near":"")+'">'+
          (mult<0.1 ? "&lt;0.1" : mult.toFixed(1))+'&times; 30m</span>')+
      '</div>';

    var det = el("div","detail", lv.why);
    row.onclick = function(){ det.classList.toggle("open"); };
    host.appendChild(row); host.appendChild(det);
  });

  if (!placed) host.appendChild(hereRow(L));

  var k = moveKey(now);
  if (k){
    var key = el("div","rt-key", k);
    host.appendChild(key);
  }
  drawTable(L, rows, now);
}

/* This row is the board's anchor, so it says where the anchor came from. A price
   presented without provenance is the one thing on the ladder that cannot be
   checked, and every other number is measured off it. */
function hereRow(L){
  var r = el("div","lrow here"), src = pxSource(curKey), note;
  /* "manual" used to be a state of this card alone. It is not one any more:
     typing here writes the same store the bar at the top writes, so the price
     funnel answers "yours" and the note can say what is actually true — the
     number governs the whole page, not just the rows underneath it. */
  if (src === "yours")     note = "Your number, typed " + printAge(curKey) + " — every distance on this page is measured from it";
  else if (src === "live") note = "Live print, tracking the tape — type over it to pin the board to your own fill";
  else if (src === "snap") note = "Snapshot price, " + snapWhen() + " — type over it to use your live print";
  else                     note = AS_OF + " — overwrite with your live print above";
  r.innerHTML =
    '<div class="lprice" style="color:var(--accent)">'+fmt(curPx, L.dp)+'</div>'+
    '<div class="lmid"><div class="youare">▸ You are here</div>'+
      '<div class="lname">'+note+'</div></div>'+
    '<div class="ldist" style="color:var(--accent)">—</div>';
  return r;
}
function snapWhen(){
  var t = SNAPSHOT && SNAPSHOT.ts_epoch;
  if (!t) return "taken with this file";
  return new Date(t*1000).toLocaleString("en-GB",{ weekday:"short", day:"numeric", month:"short",
           hour:"2-digit", minute:"2-digit", hour12:false, timeZone:"Asia/Hong_Kong" }) + " HKT";
}

function drawTable(L, rows, atMs){
  var tb = document.querySelector("#ladderTv tbody");
  tb.innerHTML = "";
  rows.forEach(function(lv){
    var d = lv.p - curPx;
    var tr = el("tr");
    var mm = moveMult(d, atMs);
    tr.innerHTML = "<td>"+fmt(lv.p,L.dp)+"</td><td>"+lv.name+"</td><td>"+STATE_META[lv.st].l+
      "</td><td>"+(lv.tests||"—")+"</td><td>"+(d>0?"+":"")+fmt(d,L.dp)+
      "</td><td>"+(mm==null ? "—" : mm.toFixed(1)+"×")+"</td>";
    tb.appendChild(tr);
  });
}

document.getElementById("tvBtn").onclick = function(){
  var t = document.getElementById("ladderTv");
  t.classList.toggle("open");
  this.textContent = t.classList.contains("open") ? "Hide table view" : "Show table view";
};

drawLadder();

/* ---- liquidity map ----
   The browser only ever holds the last 96 bars, so it cannot rebuild a 29-hour
   profile from scratch. LIQ arrives with the profile already built and the
   timestamp of its newest bar; the live layer adds only bars newer than that.
   Exact incremental merge, no double counting, and the structure still moves
   when the feed does. */
/* LIVEQ is "the best price the page currently has" and LIVEFEED is "did that come
   off the wire". They are two different questions and they were one variable for a
   while, which produced the worst kind of wrong: the page bootstraps by calling
   paintAll(SNAPSHOT), so LIVEQ is non-null from the first frame, and the ladder's
   anchor row cheerfully read "Live print, tracking the tape" over a baked number
   with the network unplugged. A stale price labelled stale is useful; a stale price
   labelled live is worse than no price at all. */
var LIVEBARS = {}, LIVEQ = null, LIVEFEED = false;
/* The live IIFE has its own num(); this block sits outside it, so it needs
   its own guard. Same contract: a real finite number, or null. */
function lnum(v){ return (typeof v === "number" && isFinite(v)) ? v : null; }
var liqKey = Object.keys(LIQ)[0];

/* Price, best available, in one place. The order matters and is not arbitrary:
   a live read beats the file's own snapshot beats a hand-typed seed. Before this
   had the middle rung, a no-network reader got the seed — a number typed by hand
   when the ladder was written, which on a morning like 31 July was Thursday's
   settlement while the tape was sixteen points higher. Every distance on the
   board was then measured from a price that had stopped existing overnight. */
/* YOUR OWN PRINT, and it outranks everything.

   The feed reaches this page about twenty-one minutes behind the tape: eleven
   of provider delay, five to ten of relay publish interval, up to five of CDN
   cache and up to one of poll. For levels, profiles and session structure that
   does not matter — none of them decay in twenty minutes, which is why the rest
   of this page is worth reading off a delayed feed. For DISTANCE it matters
   completely: "6.25 away, 1.0x" is a claim about now, and on ES at the measured
   cash pace the price on screen is roughly ten points wrong in an unknown
   direction.

   So the reader can type the price off their own platform, and every distance,
   multiple, reach time and pool proximity on the page recomputes from it. This
   is the one input on the board that beats the relay, because it is the only
   number here that came from the present.

   IT EXPIRES. A print typed twenty minutes ago is exactly the thing it was
   entered to replace, and a stale override is worse than a stale feed because
   the feed at least admits its age. PRINT_TTL_MS is the life of one; past it
   the value is dropped and the page silently returns to the relay — silently
   in the sense of not asking, never in the sense of not saying: the age rides
   next to the number for as long as it is in force. */
function printAt(sym, nowMs){
  /* LIVEPRINT is `undefined` here on the very first call and that is not a bug
     to declare away: the ladder reads liqPx() while establishing curPx, which
     happens before the live-state block further down has been assigned. liqPx
     has always survived that by short-circuiting on LIVEQ; this rung has to do
     the same or it takes the whole ladder out at parse time — which it did. */
  if (!LIVEPRINT) return null;
  var e = LIVEPRINT[sym];
  if (!e) return null;
  if ((nowMs || Date.now()) - e.at > PRINT_TTL_MS){ delete LIVEPRINT[sym]; return null; }
  return e;
}
/* ONE PRICE, EVERYWHERE — the overlay.
   ------------------------------------------------------------------------
   liqPx() gave the reader's typed print to whoever asked for it, and sixteen
   call sites asked. The rest of the board did not: drawPlan, biNow and biSess
   read d.quotes straight through, so the trade plan card and the invalidation
   ledger were evaluating a trigger, a stop and an invalidation level against a
   relay price minutes old while the print the reader had just typed sat three
   cards above them. scenTok's {{px}} was worse again — it read SNAPSHOT.quotes,
   the price baked into the file at build time.

   A price that beats the relay on some cards and not others is not a feature
   with gaps in it; it is two different boards sharing a scroll bar. So the
   print is overlaid into the quote object itself, once, before any painter
   runs, and every consumer of a quotes bag sees it without having to know it
   exists.

   WHAT THE DERIVED FIELDS DO, because overwriting px alone would leave a card
   deriving a change from the reader's price and the relay's close:

     px            the print.
     overridden    true. The flag every consumer can branch on.
     override_at   when it was typed, so its age is derived and not remembered.
     relay_px      the relay's price, KEPT, so a card can show both or diff them.
     relay_ts      the relay's stamp — the vintage of the window fields below.
     ts, age_s     the print's instant and age. These describe px, and px is now
                   the print; leaving the relay's age here is what "stale while
                   looking live" means.
     prev_close    UNCHANGED. A settled fact about yesterday, not a function of
                   the current price.
     chg, chg_pct  RECOMPUTED from px - prev_close. Both inputs are then the same
                   vintage. This is the field the defect note is about: leaving
                   the relay's chg beside the reader's px is a number that is
                   half his and half the relay's, and it renders identically to
                   one that is neither.
     d1_high/low   EXTENDED, never shrunk: max/min against px. A print above the
                   recorded high is evidence the high is at least the print. The
                   relay's extreme is a floor on the truth, so widening is sound
                   and narrowing would be invention.
     on_high/low   EXTENDED the same way, for the same reason.
     on_range      RECOMPUTED as on_high - on_low after any extension, or it
                   contradicts its own extremes.
     on_pos        RECOMPUTED from px inside the extended overnight range. A
                   position computed off the relay's price beside the reader's
                   price is precisely the mixed number this exists to prevent.
     on_open       UNCHANGED. A settled fact about where the session began.
     bars          UNCHANGED. A historical series; the print is one later tick,
                   not a rewrite of what already traded.
     src           annotated, so provenance survives into anything that prints it.

   Everything here is a pure function of the quote and the print. Nothing is
   invented, and every field that cannot be reconciled with the new price is
   recomputed rather than left to disagree with it. */
function overrideQuote(q, e, nowMs){
  var o = {}, k;
  for (k in q) if (q.hasOwnProperty(k)) o[k] = q[k];
  var px = lnum(e.px);
  if (px == null) return q;
  var at = e.at || (nowMs || Date.now());

  /* IDEMPOTENT. LIVEQ holds the payload paintAll already overlaid, so anything
     that overlays a bag a second time — a suite reading through __wf.qOverlay,
     a painter re-entering — arrives here with q.px ALREADY the print. Capturing
     relay_px from it then records the reader's own number as the relay's, and
     the one field that exists to let a card show both would quietly show the
     same number twice. Keep the first capture; it is the only one that saw the
     relay. */
  o.relay_px = q.overridden ? q.relay_px : lnum(q.px);
  o.relay_ts = q.overridden ? q.relay_ts : q.ts;
  o.px = px;
  o.overridden = true;
  o.override_at = at;
  o.ts = new Date(at).toISOString();
  o.age_s = Math.max(0, Math.round(((nowMs || Date.now()) - at) / 1000));
  o.src = (q.src ? q.src + "+" : "") + "print";

  var pc = lnum(q.prev_close);
  if (pc != null && pc !== 0){ o.chg = px - pc; o.chg_pct = (px - pc) / pc * 100; }
  else { o.chg = null; o.chg_pct = null; }

  var dh = lnum(q.d1_high), dl = lnum(q.d1_low);
  if (dh != null) o.d1_high = Math.max(dh, px);
  if (dl != null) o.d1_low  = Math.min(dl, px);

  var oh = lnum(q.on_high), ol = lnum(q.on_low);
  if (oh != null) o.on_high = Math.max(oh, px);
  if (ol != null) o.on_low  = Math.min(ol, px);
  if (o.on_high != null && o.on_low != null){
    o.on_range = o.on_high - o.on_low;
    o.on_pos = o.on_range > 0 ? (px - o.on_low) / o.on_range : null;
  }
  return o;
}
/* The bag, overlaid. Returns the SAME object when no print is in force, so the
   common path allocates nothing and identity tests upstream still hold. */
function qOverlay(bag, nowMs){
  if (!bag || !LIVEPRINT) return bag;
  var out = null, i, sym, e, k;
  for (i = 0; i < LP_SYMS.length; i++){
    sym = LP_SYMS[i];
    e = printAt(sym, nowMs);
    if (!e || !bag[sym]) continue;
    if (!out){ out = {}; for (k in bag) if (bag.hasOwnProperty(k)) out[k] = bag[k]; }
    out[sym] = overrideQuote(bag[sym], e, nowMs);
  }
  return out || bag;
}
/* A payload with its quotes overlaid, for the one caller that has a payload. */
function dOverlay(d, nowMs){
  if (!d || !d.quotes) return d;
  var q = qOverlay(d.quotes, nowMs);
  if (q === d.quotes) return d;
  var o = {}, k;
  for (k in d) if (d.hasOwnProperty(k)) o[k] = d[k];
  o.quotes = q;
  return o;
}
function liqPx(sym){
  var mine = printAt(sym);
  if (mine) return mine.px;
  var q = LIVEQ && LIVEQ.quotes && LIVEQ.quotes[sym];
  var p = q ? lnum(q.px) : null;
  if (p == null){
    var s = SNAPSHOT && SNAPSHOT.quotes && SNAPSHOT.quotes[sym];
    p = s ? lnum(s.px) : null;
  }
  return p != null ? p : (LADDERS[sym] ? LADDERS[sym].seed : null);
}
/* ONE repaint entry point, and it is the page's own.

   The first version of this called paintAll() directly and guarded with
   `typeof paintAll === "function"` — which is false here, because paintAll
   lives inside the live() IIFE and this code does not. So the guard was always
   false, the call never happened, and every handler quietly fell through to
   redrawing the ladder alone: the reader's print moved the card they were
   looking at and left every other card on the page measuring from the relay.
   It looked like it worked, which is the worst way for it not to.

   __wf.repaintAt is the same door the build's freeze and three suites use, so a
   card added later is repainted by default rather than by being remembered. The
   fallback is narrower and says so rather than pretending it did the job. */
function lpRepaint(){
  if (window.__wf && typeof window.__wf.repaintAt === "function"){
    window.__wf.repaintAt(Date.now());
    return true;
  }
  try { drawLadder(); } catch (e) {}
  return false;
}

/* How long ago the reader typed the print that is currently in force, spelled
   the way every other age on this page is spelled. */
function printAge(sym){
  var e = printAt(sym);
  if (!e) return "";
  var s = Math.max(0, Math.round((Date.now() - e.at) / 1000));
  if (s < 45) return "just now";
  var m = Math.round(s / 60);
  return m <= 1 ? "a minute ago" : m + " minutes ago";
}

/* ---- the live-print bar -------------------------------------------------
   Wiring, not arithmetic: the number goes into LIVEPRINT and liqPx() does the
   rest, so every card that already asks for a price gets the new one without
   knowing anything changed. That is the whole reason this went into the price
   funnel rather than into fourteen call sites. */
function lpSym(){
  var s = document.getElementById("lpSym");
  return (s && s.value) || LP_SYMS[0];
}
function lpApply(){
  var box = document.getElementById("lpIn");
  var v = box ? parseFloat(box.value) : NaN;
  var sym = lpSym();
  if (isFinite(v) && v > 0) LIVEPRINT[sym] = { px: v, at: Date.now() };
  else delete LIVEPRINT[sym];
  /* The ladder keeps its own cursor, so release its manual latch and let it
     re-read the funnel — otherwise the card the reader is most likely to be
     looking at is the one card that ignores what they just typed. */
  if (sym === curKey){ pxManual = false; curPx = liqPx(curKey); setPxBox(curKey, curPx); }
  lpPaint();
  lpRepaint();
}
function lpPaint(){
  var bar = document.getElementById("lpBar"), note = document.getElementById("lpNote");
  if (!bar || !note) return;
  var live = [], k, e;
  for (k = 0; k < LP_SYMS.length; k++){
    e = printAt(LP_SYMS[k]);
    if (e) live.push(LP_SYMS[k] + " " + fmt(e.px, (TICK[LP_SYMS[k]] && TICK[LP_SYMS[k]] < 1) ? 2 : 2));
  }
  if (bar.className.indexOf("on") >= 0 !== (live.length > 0))
    bar.className = live.length ? "lp on" : "lp";
  var age = printAge(lpSym());
  note.innerHTML = live.length
    ? "Every distance, &times; figure, reach time and pool proximity on this page is now measured from <b>" +
      live.join("</b>, <b>") + "</b>. Typed " + age +
      "; it expires after fifteen minutes and the board falls back to the relay, because a print you typed twenty minutes ago is the thing this field exists to replace."
    : "The relay reaches this page about <span class=\"warn\">twenty minutes behind the tape</span> &mdash; fine for levels and profiles, wrong for distances. Type the price off your platform and every distance below recomputes from it.";
}

/* Which of those rungs answered, so the board can say so out loud rather
   than presenting all of them with the same confidence. */
function pxSource(sym){
  if (printAt(sym)) return "yours";
  var q = LIVEFEED && LIVEQ && LIVEQ.quotes && LIVEQ.quotes[sym];
  if (q && lnum(q.px) != null) return "live";
  var s = SNAPSHOT && SNAPSHOT.quotes && SNAPSHOT.quotes[sym];
  if (s && lnum(s.px) != null) return "snap";
  return "seed";
}

/* Volume spread uniformly across the bins a bar's high-low covers. At five-minute
   resolution the bar genuinely did trade at every price in between; uniform is
   the assumption that invents the least structure. */
function liqBins(sym){
  var L = LIQ[sym];
  if (!L) return null;
  var bw = L.bw, bins = {}, i, j;
  for (i = 0; i < L.prof.length; i++) bins[Math.round(L.prof[i][0] / bw)] = L.prof[i][1];
  var added = 0, rows = LIVEBARS[sym] || [];
  for (i = 0; i < rows.length; i++){
    var r = rows[i];
    if (!r || r[0] <= L.last) continue;              /* already inside the baked profile */
    var v = lnum(r[5]), hi = lnum(r[2]), lo = lnum(r[3]);
    if (v == null || v <= 0 || hi == null || lo == null || hi < lo) continue;
    var a = Math.floor(lo / bw), b = Math.floor(hi / bw), share = v / (b - a + 1);
    for (j = a; j <= b; j++) bins[j] = (bins[j] || 0) + share;
    added++;
  }
  return { bins: bins, bw: bw, added: added, meta: L };
}

/* Value area by the standard construction: start at the point of control and
   keep taking whichever neighbour holds more volume until 70% is enclosed. */
function liqStats(B){
  var ks = Object.keys(B.bins).map(Number).sort(function(a,b){ return a-b; });
  if (!ks.length) return null;
  var total = 0, poc = ks[0], i;
  for (i = 0; i < ks.length; i++){ total += B.bins[ks[i]]; if (B.bins[ks[i]] > B.bins[poc]) poc = ks[i]; }
  var lo = poc, hi = poc, acc = B.bins[poc], guard = 0;
  while (acc < total * 0.70 && guard++ < 4000){
    var up = B.bins[hi+1], dn = B.bins[lo-1];
    if (up == null && dn == null) break;
    if ((up == null ? -1 : up) >= (dn == null ? -1 : dn)){ hi++; acc += up || 0; }
    else { lo--; acc += dn || 0; }
  }
  return { ks:ks, total:total, poc:poc, lo:lo, hi:hi,
           pocP: poc*B.bw, valP: lo*B.bw, vahP: (hi+1)*B.bw };
}

/* Only pools price has not already run. A cluster whose stops were triggered
   two hours ago is not liquidity, it is history — the baked list is filtered on
   the server side, this re-filters against anything that has happened since. */
function liqPools(sym, px){
  var L = LIQ[sym];
  if (!L) return [];
  var rows = LIVEBARS[sym] || [], out = [];
  L.stops.forEach(function(s){
    var buf = L.bw * 2, i, gone = false;
    for (i = 0; i < rows.length; i++){
      if (!rows[i] || rows[i][0] <= L.last) continue;
      if (s.side !== "below" && lnum(rows[i][2]) > s.p + buf) gone = true;
      if (s.side !== "above" && lnum(rows[i][3]) < s.p - buf) gone = true;
    }
    /* Direction sanity, which the bar scan alone does not give: buy stops above a
       level cannot still be resting if price is already trading above it. The bar
       history may not show the crossing (the level can be older than the window,
       or the quote can lead the last closed bar), but the current price settles it.
       Tolerance here is one bin, not two: the bar scan needs slack for noise, this
       does not — "buy stops above" printed under the current price reads as wrong
       even when it is only four points under. */
    if (s.side === "above" && px > s.p + L.bw) gone = true;
    if (s.side === "below" && px < s.p - L.bw) gone = true;
    if (!gone) out.push(s);
  });
  return out.sort(function(a,b){ return Math.abs(a.p - px) - Math.abs(b.p - px); });
}

function poolWord(side){
  return side === "above" ? "Buy stops above"
       : side === "below" ? "Sell stops below"
       : "Stops both sides of";
}

/* Time since price last traded through the level. A level defended four times an
   hour ago and one defended four times yesterday are not the same object: stops
   resting at a level nobody has been near in most of a day have largely been
   cancelled or moved, and the scoring already discounts for it. This says so out
   loud rather than leaving the discount invisible. */
function poolAge(h){
  if (h == null || !isFinite(h)) return "";
  if (h < 1)  return "touched in the last hour";
  if (h < 24) return "last touched " + Math.round(h) + "h ago";
  return "last touched " + (h/24).toFixed(1) + "d ago &mdash; stale";
}

/* Distance is only half of reachability; the session clock is the other half.
   Past roughly four times the typical thirty-minute range, a level is not being
   reached in thin overnight trade whatever the chart looks like — it needs the
   cash session's participation to get there.

   This takes the multiple the card itself just computed rather than the one
   baked upstream. The baked figure was measured against the last archived bar;
   the card measures against the live price, and when those two differ — which
   they do the moment the feed moves — a baked verdict of "in range now" can
   appear beside a distance of seven times the typical move. One card, one
   answer to "how far is that". */
function poolReach(x30, clock, mins){
  if (mins != null){                                   /* the measured answer wins */
    /* reachWord's three time branches return a bare "~2.5h". That is right in the
       chain card, where it lands in a figure slot with a label above it and one
       caller strips the tilde to use it as a headline — but at the foot of a pool
       row, under two lines of prose and beside four sibling rows that all say a
       PHRASE, an orphan number reads as a stray measurement rather than as the
       answer to "when does this come into reach". The verb goes on here rather
       than inside reachWord, so the two figure-slot callers keep the bare form. */
    var w = reachWord(mins);
    return w.charAt(0) === "~" ? w + " away" : w;
  }
  if (x30 == null || !isFinite(x30)) return "";
  if (x30 <= 1.0) return "in range now";
  if (x30 <= 4.0) return "reachable this session";
  return clock && clock.sess !== "RTH" && clock.to_open > 0
       ? "needs the cash session &mdash; it opens in " + clock.to_open + "h"
       : "needs cash-session participation";
}

/* ---- reachability, measured ---------------------------------------------
   The session clock in UTC, matching reach.py boundary for boundary. Two
   implementations of one clock in two languages is a bug waiting to happen; if
   either moves, both move. */
/* THE DIVISOR SELECTOR, and the single most consequential function on the page
   for the reason given at phaseAt: pace() reads it, and every x-distance reads
   pace(). It classified by hard-coded UTC hours, which is EDT written in a
   disguise that survives a code review — on 2 Nov 2026 it returns EVE for the
   power hour and EVE for the cash close, and the two busiest half hours of the
   day get divided by the post-close median.

   Now it asks the exchanges. RTH is the US cash session in New York's own
   clock, 09:30 to 16:00, whatever UTC that lands on. EVE is the thin book from
   the bell to the CME halt. EUR runs from London's open to New York's, which is
   the one window whose LENGTH changes for a week each autumn — Europe leaves
   DST on 25 Oct and the US on 1 Nov — and asking both clocks is the only way to
   get that week right. */
function sessAt(ms){
  var et  = (function(){ var o = tzOffMin(ms, "America/New_York");
               var d = new Date(ms);
               var m = d.getUTCHours() * 60 + d.getUTCMinutes() + o;
               return ((m % 1440) + 1440) % 1440; })();
  var lon = (function(){ var o = tzOffMin(ms, "Europe/London");
               var d = new Date(ms);
               var m = d.getUTCHours() * 60 + d.getUTCMinutes() + o;
               return ((m % 1440) + 1440) % 1440; })();
  if (et >= 570 && et < 960)  return "RTH";      /* 09:30–16:00 New York */
  if (et >= 960 && et < 1080) return "EVE";      /* 16:00–18:00, bell to halt */
  if (lon >= 480 && et < 570) return "EUR";      /* London open → New York open */
  return "ASIA";
}

/* The same thing liquidity2.py's clock() computes, computed HERE instead.
   ------------------------------------------------------------------------
   The data block carries a baked `clock` — the session and the hours-to-open as
   they stood when the profile was generated. Two cards read it, and both were
   quietly wrong by however long ago that was: the decision board headed its RTY
   panel "ASIA hours" while its own × column divided by European-hours pace, and
   the map told a reader at 16:11 HKT that the cash session "opens in 7.2h" when
   it opened in 5.3. That is the overnight-range card's "quote 78m old" bug
   wearing different clothes — a field that means "now" baked at a moment that
   has passed.

   It is also the same shape as the divisor problem this whole pass exists to
   close: a card labelling one session while dividing by another. There is no
   version of that which is not a lie, so the label comes off the same clock as
   the divisor now. L.clock stays in the block because the generator emits it and
   the brief text quotes it, but nothing on the page may read it again. */
function clockAt(atMs){
  var ms = atMs == null ? Date.now() : atMs;
  var d = new Date(ms), h = d.getUTCHours() + d.getUTCMinutes()/60, s = sessAt(ms);
  if (s === "RTH") return { sess:s, to_open:0, to_close:Math.round((20 - h) * 10) / 10 };
  /* Hours until the next 13:30 UTC bell. The weekend is not modelled — neither
     is it in the Python — because the feed does not publish weekend bars, so a
     Saturday reader has no live price for this to be wrong about. */
  var to = h < 13.5 ? (13.5 - h) : (24 - h + 13.5);
  return { sess:s, to_open:Math.round(to * 10) / 10, to_close:null };
}

/* Minutes until `dist` is inside normal one-directional travel, starting at
   `fromMs`. Accumulates each session's own measured pace as the clock crosses
   into it — which is the whole point: a level seven hours out is not waiting on
   seven hours of Asian drift, it is waiting on the cash open, and the walk
   discovers that without being told.

   Walked forward rather than solved, because the accumulator is not scale-free
   across a session boundary. Solving it in closed form would mean assuming the
   session you start in is the one you finish in, which is precisely the
   assumption this exists to remove. Capped at 24h; past that a level is not a
   decision, it is scenery. */
function minsToReach(sym, fromMs, dist){
  var R = REACH[sym];
  if (!R || !(dist > 0)) return null;
  var inv = 1 / R.H, acc = 0, t = fromMs, m = 0;
  while (m < 1440){
    acc += Math.pow(R.e30[sessAt(t)] || R.e30.ASIA, inv) * (5 / 30);
    m += 5; t += 300000;
    if (Math.pow(acc, R.H) >= dist) return m;
  }
  return null;
}

function reachWord(mins){
  if (mins == null)  return "not within a day of normal travel";
  if (mins <= 15)    return "in range now";
  if (mins < 60)     return "~" + mins + "m";
  if (mins < 180)    return "~" + (mins/60).toFixed(1) + "h";
  return "~" + Math.round(mins/60) + "h";
}

function zhm(ms){
  var d = new Date(ms);
  return ("0"+d.getUTCHours()).slice(-2) + ":" + ("0"+d.getUTCMinutes()).slice(-2) + "Z";
}
function hkt(ms){
  var d = new Date(ms + 8*3600000);
  return ("0"+d.getUTCHours()).slice(-2) + ":" + ("0"+d.getUTCMinutes()).slice(-2) + " HKT";
}

/* ======================= DAY SHAPE (clock seasonality) ====================== */
/* Declared out here, alongside drawLiq, and deliberately NOT inside live(). It is
   called from paintAll, which lives inside live() and can see out — but it also
   reads LIVEQ and SNAPSHOT, which live out here, and a painter has to be declared
   in the scope its callers can reach. The wrong side of that boundary does not
   throw; it produces a card that is silently blank forever. */

var seasKey = (typeof SEAS !== "undefined" && SEAS.syms && Object.keys(SEAS.syms)[0]) || "ES";

function seasOk(){
  return !!(typeof SEAS !== "undefined" && SEAS.syms && SEAS.syms[seasKey] &&
            SEAS.syms[seasKey].buckets && SEAS.syms[seasKey].buckets.length);
}

/* Median over a copy. Four different five-element lists on this card go through
   it, and every one of them is short enough that the sort is free and small
   enough that a mean would be dragged wherever the widest day went. */
function seasMed(a){
  if (!a || !a.length) return null;
  var s = a.slice().sort(function(x, y){ return x - y; }), n = s.length;
  return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2;
}

/* Which half hour of the Hong Kong clock a moment falls in — the same index the
   generator bucketed by, so a bucket number means one thing on both sides of the
   file. Everything else here is derived from it. */
function seasBucket(atMs){
  var d = new Date(atMs + 8 * 3600000);
  return d.getUTCHours() * 2 + (d.getUTCMinutes() >= 30 ? 1 : 0);
}
/* The day starts at the New York cash close, not at midnight, so the leftmost
   column is the first thing that happens after the number the reader last saw
   the market close at. openB comes off the block rather than being typed here. */
function seasSlot(b){ return (((b - (SEAS.openB || 0)) % 48) + 48) % 48; }
function seasHkt(b){ return ("0" + Math.floor(b / 2)).slice(-2) + ":" + (b % 2 ? "30" : "00"); }
function seasUtc(b){
  var m = (((b * 30 - 480) % 1440) + 1440) % 1440;
  return ("0" + Math.floor(m / 60)).slice(-2) + ":" + ("0" + (m % 60)).slice(-2);
}
var SEASZ = { Asia:"Asia", London:"London", NY:"New York" };

/* Today's range so far — and it has to be on_high/on_low rather than d1_high/
   d1_low, even though both sit on the same quote object. The generator anchors
   its day at the New York cash close, which is exactly the window the relay
   measures on_high/on_low over; d1 is a calendar window, and on ES today the two
   disagree by eight points. This card DIVIDES one of these by a fraction measured
   over the other, and the mistake would be invisible: both numbers look like a
   day's range, both are, and they would not be the same day's. */
function seasToday(sym){
  /* Overlaid, because the extremes move under an override: a print outside the
     recorded overnight range widens it, and a day-shape card drawing today's
     range from the relay while the ladder draws the price from the reader is
     the same split one card down. */
  var bag = qOverlay((LIVEQ && LIVEQ.quotes) || (SNAPSHOT && SNAPSHOT.quotes) || null);
  var q = bag ? bag[sym] : null;
  if (!q) return null;
  var hi = lnum(q.on_high), lo = lnum(q.on_low);
  return (hi != null && lo != null && hi > lo) ? { hi:hi, lo:lo, r:hi - lo } : null;
}

/* The zone behind each slot, built from the published buckets rather than from a
   second copy of the session table. A slot with no bucket is the exchange halt,
   and it is drawn as a genuine gap: an hour when nothing traded is a fact about
   the day's shape, and closing the gap would quietly redraw the clock. */
function seasZones(S){
  var z = new Array(48), i;
  for (i = 0; i < 48; i++) z[i] = null;
  S.buckets.forEach(function(x){ z[seasSlot(x.b)] = x.z; });
  var runs = [], cur = null;
  for (i = 0; i < 48; i++){
    if (z[i] && cur && z[i] === cur.z){ cur.to = i; continue; }
    if (cur) runs.push(cur);
    cur = z[i] ? { z:z[i], from:i, to:i } : null;
  }
  if (cur) runs.push(cur);
  return runs;
}

var SEAS_W = "calc(100% / 48)";
function seasLeft(slot){ return "calc(" + slot + " * 100% / 48)"; }

/* One panel: a labelled frame, the zone bands behind it, a gridline or two, and
   one series of columns. Every panel on this card is built by this function, so
   the three of them cannot drift into three different geometries — which is the
   only reason reading straight down between them is legitimate. */
function seasPanel(host, S, runs, opt){
  var pan = el("div", "seas-pan");
  var hd = el("div", "seas-pan-h");
  hd.appendChild(el("span", null, opt.title));
  /* Absent, not empty. The span carries an opaque chip so the marker breaks
     behind it, and an empty one is an 8px block of padding sitting in the top
     right corner with nothing in it. */
  if (opt.right) hd.appendChild(el("span", null, opt.right));
  pan.appendChild(hd);

  var fr = el("div", "seas-frame");
  fr.style.height = opt.h + "px";

  runs.forEach(function(r, i){
    var b = el("div", "seas-band" + (i % 2 ? " b2" : ""));
    b.style.left  = seasLeft(r.from);
    b.style.width = "calc(" + (r.to - r.from + 1) + " * 100% / 48)";
    fr.appendChild(b);
    if (opt.zlab && r.to - r.from >= 3){
      var t = el("div", "seas-zlab", SEASZ[r.z] || r.z);
      t.style.left = seasLeft(r.from);
      /* Chip matched to the band the label opens, so the marker breaks behind
         the word without a rectangle of the wrong grey appearing around it.
         Odd bands are .b2, which is transparent, so what shows through is the
         card surface. */
      t.style.background = (i % 2) ? "var(--surface-1)" : "var(--plane)";
      fr.appendChild(t);
    }
  });

  (opt.grid || []).forEach(function(g){
    var ln = el("div", "seas-gl");
    ln.style.bottom = (g / opt.max * opt.h) + "px";
    fr.appendChild(ln);
    var lb = el("div", "seas-glab", opt.glab(g));
    lb.style.bottom = (g / opt.max * opt.h) + "px";
    fr.appendChild(lb);
  });

  S.buckets.forEach(function(x){
    var v = opt.val(x);
    if (v == null) return;
    var d = el("div", "seas-bar" + (opt.thin(x) ? " dim" : ""));
    d.style.left   = "calc(" + seasLeft(seasSlot(x.b)) + " + 1px)";
    d.style.width  = "calc(" + SEAS_W + " - 2px)";
    d.style.height = Math.max(1, v / opt.max * opt.h) + "px";
    d.title = seasHkt(x.b) + " HKT · " + opt.tip(x);
    fr.appendChild(d);
  });

  pan.appendChild(fr);
  host.appendChild(pan);
}

function drawSeas(atMs){
  var host = document.getElementById("seasPlot");
  if (!host || !seasOk()) return;
  var now = atMs || Date.now();
  var S = SEAS.syms[seasKey], LD = LADDERS[seasKey] || { dp:2, unit:"pt", label:seasKey };
  var runs = seasZones(S), nb = seasBucket(now), nslot = seasSlot(nb);

  /* Travel and volume share a scale because they are percentages of the same
     day and the comparison between them is the finding. The cumulative panel is
     a percentage of something else and gets its own axis rather than a second
     scale on the first. */
  var mx = 0;
  S.buckets.forEach(function(x){
    if (x.m > mx) mx = x.m;
    if (x.v > mx) mx = x.v;
  });
  mx = Math.ceil(mx / 2.5) * 2.5;
  var full = S.days, thin = function(x){ return x.n < full; };

  host.innerHTML = "";
  seasPanel(host, S, runs, {
    title:"<b>Travel</b> &mdash; share of the day&rsquo;s movement", right:"one bar = 30 min",
    h:80, max:mx, grid:[mx / 2, mx], glab:function(g){ return g.toFixed(1) + "%"; },
    val:function(x){ return x.m; }, thin:thin, zlab:true,
    tip:function(x){ return "travel " + x.m.toFixed(2) + "% of the day, " + x.n + " days"; }
  });
  seasPanel(host, S, runs, {
    title:"<b>Volume</b> &mdash; share of the day&rsquo;s contracts", right:"same scale as above",
    h:80, max:mx, grid:[mx / 2, mx], glab:function(g){ return g.toFixed(1) + "%"; },
    val:function(x){ return x.v; }, thin:thin,
    tip:function(x){ return "volume " + x.v.toFixed(2) + "% of the day, " + x.n + " days"; }
  });
  seasPanel(host, S, runs, {
    /* No right-hand caption: the gridlines already read 50% and 100%, so
       "0-100%" was the axis stating its range twice, three pixels apart, in
       the same muted grey at the same right edge. */
    title:"<b>Range done</b> &mdash; how much is already behind you",
    h:64, max:100, grid:[50, 100], glab:function(g){ return g + "%"; },
    val:function(x){ return x.c; }, thin:function(x){ return x.cn < full; },
    tip:function(x){ return (x.c == null ? "not published" : x.c.toFixed(0) + "% of the day's range by now") + ", " + x.cn + " days"; }
  });

  var ax = el("div", "seas-axis");
  for (var s = 0; s < 48; s += 6){
    var b = ((s + (SEAS.openB || 0)) % 48 + 48) % 48;
    var t = el("div", "seas-tick", seasHkt(b));
    t.style.left = "calc(" + seasLeft(s) + " + 100% / 96)";
    ax.appendChild(t);
  }
  host.appendChild(ax);

  /* Only the horizontal is painted here. The marker used to measure the first
     frame off the DOM to find its own top, because the top of the plot was the
     first panel's header and the dot landed on the word "movement". The plot
     now carries ten pixels of padding for exactly this element, so both ends
     are constants in the stylesheet and there is no layout read left to go
     wrong on a card that happens to be laid out at zero height. The line and
     the dot are two elements so they can sit on opposite sides of the text in
     the stack — see .seas-mk-dot. */
  var mkL = "calc(" + seasLeft(nslot) + " + 100% / 96)";
  var mk = el("div", "seas-mk");
  mk.style.left = mkL;
  host.appendChild(mk);

  var dot = el("div", "seas-mk-dot");
  dot.style.left = mkL;
  host.appendChild(dot);

  drawSeasNow(S, LD, nb, now);
  drawSeasKey(S, full);
  drawSeasSess(S);
  drawSeasLm(S, LD);
  drawSeasAdv(S, LD, nb, now);
  drawSeasBody(S, LD);
  drawSeasTv(S);
  /* Last, and after every one of the four draws above, because it walks the
     finished DOM rather than being threaded through each builder. */
  seasFoldWire();
}

/* The bucket whose cumulative figure describes "by now": the newest published
   one at or before the current slot. Walking backwards rather than demanding an
   exact hit is what carries the card across the exchange halt, where the current
   bucket has no measurement at all and the last one before it is the honest
   answer to how much of the day is already made. */
function seasAt(S, nb){
  var target = seasSlot(nb), best = null;
  S.buckets.forEach(function(x){
    var s = seasSlot(x.b);
    if (s > target || x.c == null) return;
    if (!best || s > seasSlot(best.b)) best = x;
  });
  return best;
}

/* The open flags live OUTSIDE the paint because all three of this card's fold
   hosts are rebuilt wholesale on every repaint. Without the store, a fold the
   reader opened would close itself the next time the clock ticked the card --
   which on a card whose whole subject is the clock is every thirty seconds. */
var seasFoldOpen = {};

function seasFold(key, lead, work){
  return '<details class="fwork seas-f" data-t="' + key + '"><summary>' + lead +
         '</summary><div class="fwork-b">' + work + '</div></details>';
}

/* Called once at the foot of the card's paint, after every host that can carry a
   fold has been rebuilt, and it is only safe THERE: each of those hosts is
   replaced wholesale, so the elements this attaches to are new every time and
   listeners cannot accumulate on them.
   toggle does not bubble, so this is a listener per element rather than one on a
   container -- and it is keyed to the fold's own name rather than to its position
   in the document, because the landmark boxes drop out when the archive has no
   open or no close for them, and a fold that shifts up must not inherit the
   memory of the one that was above it. */
function seasFoldWire(){
  Array.prototype.forEach.call(document.querySelectorAll("details.seas-f"), function(x){
    var fk = x.getAttribute("data-t");
    if (seasFoldOpen[fk]) x.open = true;
    x.addEventListener("toggle", function(){ seasFoldOpen[fk] = x.open; });
  });
}

function drawSeasNow(S, LD, nb, now){
  var h = document.getElementById("seasNow");
  if (!h) return;
  var cur = null;
  S.buckets.forEach(function(x){ if (x.b === nb) cur = x; });
  var at = seasAt(S, nb);
  /* Renormalised against the column's own total, not against 100. These are
     per-bucket medians and medians do not add — the published column sums to
     about 108% — so a raw sum of the tail is a share of something that is not a
     whole. Same divisor as the advisory below, on purpose: one page, one
     answer to "how much is left". */
  var left = 0, denom = 0, tgt = seasSlot(nb);
  S.buckets.forEach(function(x){ denom += x.m; if (seasSlot(x.b) > tgt) left += x.m; });
  if (denom > 0) left = left / denom * 100;
  /* The one hour a day with no bucket to stand in. seasAt walks backwards to
     carry the rest of the card across it, which would otherwise label the halt
     with whatever session preceded it. */
  var zlab = cur ? SEASZ[cur.z] : "exchange halt &mdash; no session";
  h.innerHTML =
    "It is <b>" + hkt(now).replace(" HKT", "") + " HKT</b> (" + zhm(now) + "), the <b>" +
    (zlab || "&mdash;") + "</b>" + (cur ? " session" : "") + " &mdash; half hour <b>" +
    (seasSlot(nb) + 1) + " of 48</b> since the last cash close. On a typical day " +
    LD.label + " has made <b>" + (at ? at.c.toFixed(0) + "%" : "&mdash;") +
    "</b> of its range by this point" + (at ? " (" + at.cn + " days)" : "") +
    " and has <b>" + left.toFixed(0) + "%</b> of its movement still ahead.";
}

function drawSeasKey(S, full){
  var h = document.getElementById("seasKey");
  if (!h) return;
  /* 145 words of method, permanently on screen, under a chart that is 51 words
     wide. What survives above the fold is the legend and nothing else: the four
     marks a reader needs in order to read the picture at all. */
  h.innerHTML =
    "Clock is Hong Kong time &mdash; cash open <b>21:30</b>, cash close <b>04:00</b>. " +
    "The vertical line is now. The gap on the right of the first band is the one-hour " +
    "exchange halt, drawn rather than closed. <b>Grey bars rest on fewer than " + full +
    " days.</b>" +
    seasFold("key", "Why the travel panel looks flat, and why some bars are grey",
      "<b>The travel panel shares the volume panel&rsquo;s scale on purpose.</b> Both are " +
      "shares of the same day, and the whole point is that the open half hour is a modest " +
      "bar in one and a tower in the other. Giving each its own height would hide exactly " +
      "the thing worth seeing. The grey bars are the archive&rsquo;s two edges: it starts and " +
      "ends mid-session, so the buckets at either edge of the day have thinner evidence " +
      "than the ones in the middle. Every bar carries its own count on hover, and the " +
      "table view prints them all.");
}

function drawSeasSess(S){
  var h = document.getElementById("seasSess");
  if (!h) return;
  h.innerHTML = "";
  var hd = el("div", "seas-srow hd");
  hd.appendChild(el("div", null, "Session"));
  hd.appendChild(el("div", "seas-sval", "Travel"));
  hd.appendChild(el("div", "seas-sval", "Range&divide;travel"));
  h.appendChild(hd);

  var shTop = null, efTop = null, k;
  for (k in S.shWin) if (!shTop || S.shWin[k] > S.shWin[shTop]) shTop = k;
  for (k in S.efWin) if (!efTop || S.efWin[k] > S.efWin[efTop]) efTop = k;

  ["Asia", "London", "NY"].forEach(function(z){
    var d = S.sess[z];
    if (!d) return;
    var r = el("div", "seas-srow");
    var nm = el("div", "seas-sname", SEASZ[z] || z);
    var note = [];
    if (z === shTop) note.push("biggest mover on " + S.shWin[z] + " of " + S.shN + " days");
    if (z === efTop) note.push("best converter on " + S.efWin[z] + " of " + S.efN);
    nm.appendChild(el("i", null, note.length ? note.join(" &middot; ") : "&nbsp;"));
    r.appendChild(nm);
    r.appendChild(el("div", "seas-sval", seasMed(d.sh).toFixed(1) + "%"));
    r.appendChild(el("div", "seas-sval", seasMed(d.eff).toFixed(3)));
    h.appendChild(r);
  });

  /* The sample size leads, because it is the caveat that decides how much of the
     table to believe, and it was the last clause of the old paragraph. */
  var note = el("div", "subnote",
    "Both columns are medians over <b>" + S.shN + " days</b>. Travel is each session&rsquo;s " +
    "share of the day&rsquo;s total movement and the three sum to 100%." +
    seasFold("sess", "What range&divide;travel measures, and why a median of " + S.shN +
      " is not a number to take on trust",
      "Range&divide;travel is how much of that movement turned into displacement &mdash; a " +
      "pure number, so the two contracts are directly comparable. The disclosure at the " +
      "foot of the card prints every day separately, because a median of " + S.shN +
      " is not a number to take on trust."));
  h.appendChild(note);
}

function drawSeasLm(S, LD){
  var h = document.getElementById("seasLm");
  if (!h) return;
  h.innerHTML = "";
  var O = S.open, C = S.close;
  if (O){
    var a = el("div", "seas-lm");
    a.appendChild(el("div", "seas-lmt", seasUtc(O.b) + "Z<i>" + seasHkt(O.b) + " HKT</i>"));
    a.appendChild(el("div", null,
      "<b>The cash open is the day&rsquo;s biggest half hour, and it is not close.</b> " +
      "It carried <b>" + O.m.toFixed(1) + "%</b> of the day&rsquo;s travel and <b>" + O.v.toFixed(1) +
      "%</b> of its volume. Ranked against all 46 half hours it came <b>first on " + O.won +
      " of " + O.n + " days</b> and was <b>never worse than " + (O.worst === 2 ? "second" :
      O.worst + "th") + "</b>." +
      seasFold("lm-open", "Which of those two numbers to lean on",
        "The rank is the claim worth keeping: first-on-" + O.won + "-of-" + O.n +
        " is a coin flip away from a different fraction, never-worse-than-" +
        (O.worst === 2 ? "second" : O.worst + "th") + "-of-46 is not.")));
    h.appendChild(a);
  }
  if (C){
    var b = el("div", "seas-lm");
    b.appendChild(el("div", "seas-lmt", seasUtc(C.b) + "Z<i>" + seasHkt(C.b) + " HKT</i>"));
    b.appendChild(el("div", null,
      "<b>Volume and movement come apart at the close.</b> The half hour into the cash " +
      "close takes <b>" + C.v.toFixed(1) + "%</b> of the day&rsquo;s volume &mdash; second only to the " +
      "open &mdash; on <b>" + C.m.toFixed(1) + "%</b> of its travel, and it was the day&rsquo;s biggest " +
      "half hour <b>" + (C.won === 0 ? "not once" : "on " + C.won + " of " + C.n + " days") +
      "</b>, median rank " + C.med + " of 46." +
      seasFold("lm-close", "Why that gap is the expensive one",
        "Size crossing is not the same event as price moving, and this is the half hour " +
        "where reading one as the other costs the most.")));
    h.appendChild(b);
  }
}

/* SIX VERDICTS, AND THE ORDER THEY ARE ASKED IN IS THE DESIGN.
   "narrower than any closed day" is a strictly stronger claim than "shaping
   narrow" and is true of a smaller set of days, so it is tested first. Asking
   the percentage question first would swallow it and print the weaker of two
   true sentences every time the stronger one applied -- which is the failure the
   killzone verdict ladder was rewritten to avoid.

   The refusal outranks both, because when the multiplier is above five there is
   no projection for anything to be narrow or wide about. That is expressed as
   proj === null rather than by re-testing the multiplier here: one decision,
   taken in one place, consumed everywhere. */
function seasVerdict(proj, med, dayRng){
  if (proj == null) return { c:"mid", k:"TOO EARLY TO PROJECT" };
  var lo = null, hi = null, i;
  for (i = 0; i < dayRng.length; i++){
    if (lo == null || dayRng[i] < lo) lo = dayRng[i];
    if (hi == null || dayRng[i] > hi) hi = dayRng[i];
  }
  if (lo != null && proj < lo) return { c:"odd", k:"NARROWER THAN ANY CLOSED DAY" };
  if (hi != null && proj > hi) return { c:"odd", k:"WIDER THAN ANY CLOSED DAY" };
  var rel = med > 0 ? proj / med - 1 : 0;
  if (rel <= -0.25) return { c:"odd", k:"SHAPING NARROW" };
  if (rel >=  0.25) return { c:"odd", k:"SHAPING WIDE" };
  return { c:"mid", k:"INSIDE THE PACK" };
}

/* THE SCALE, and on this page it is the thing most likely to be silently wrong.
   The killzone card shipped a span bug through eleven build gates and twenty-two
   suites; it was found by rendering the card to a PNG and looking at it. So this
   is written so that "every mark the strip draws is inside the axis" is true by
   construction rather than by inspection: raw is the largest of the closed days,
   the range already on the board and the projection -- there is nothing else
   drawn -- and the headroom, the rounding and the guard all push it up, never
   down. The rounding step is a fifth of the leading power of ten, so the end
   label is a number a person can hold on a contract quoted in points and on one
   quoted in cents alike, without a table of magic constants per contract. */
function seasSpan(dayRng, soFar, proj){
  var raw = 0, i;
  for (i = 0; i < dayRng.length; i++) if (dayRng[i] > raw) raw = dayRng[i];
  if (soFar > raw) raw = soFar;
  if (proj != null && proj > raw) raw = proj;
  raw *= 1.08;
  if (!(raw > 0)) return 0;
  var step = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10)) / 5;
  var v = Math.ceil(raw / step) * step;
  /* Floating point can land ceil(raw/step)*step a hair BELOW raw, and a hair
     below is enough to push the furthest mark off the end of its own axis. One
     more step costs eight per cent of the track and closes the case. */
  return v < raw ? v + step : v;
}

/* Both of the above, handed to seastest.mjs, and nothing derived from them.
   They are pure -- same arguments, same answer -- and the whole reason they are
   reachable from outside is that the live archive exercises seasSpan at exactly
   one magnitude and seasVerdict at four of its six branches. The suite sweeps
   them over inputs this card will not see for months and asserts invariants: a
   stronger claim beats a weaker one, the verdict's rank never falls as the
   projection rises, the axis clears the furthest mark by between eight and
   thirty per cent at every magnitude from cents to thousands.
   seasState still hands over inputs only. That rule is what stops the suite
   marking the page's homework, and exporting a pure classifier does not bend it:
   an invariant a function must satisfy is not the function's own opinion. */
window.__wf.seasVerdict = seasVerdict;
window.__wf.seasSpan = seasSpan;

function seasStrip(S, LD, soFar, proj, med){
  var dr = S.dayRng || [], span = seasSpan(dr, soFar, proj), i;
  if (!(span > 0)) return "";
  var pos = function(x){ var v = x / span * 100; return v < 0 ? 0 : v > 100 ? 100 : v; };
  var mp = pos(med);
  var h = '<div class="sday"><div class="sday-track">' +
    '<span class="sday-lab" style="left:' + mp.toFixed(2) + '%;transform:' +
      (mp >= 88 ? "translateX(-100%)" : mp <= 12 ? "translateX(0)" : "translateX(-50%)") +
      '">median ' + fmt(med, LD.dp) + '</span>' +
    '<span class="sday-line"></span>' +
    '<span class="sday-done" style="width:' + pos(soFar).toFixed(2) + '%" title="on the board: ' +
      fmt(soFar, LD.dp) + ' ' + LD.unit + '"></span>' +
    '<span class="sday-cap" style="left:' + pos(soFar).toFixed(2) + '%"></span>';
  for (i = 0; i < dr.length; i++)
    h += '<span class="sday-t" style="left:' + pos(dr[i]).toFixed(2) +
         '%" title="a closed day: ' + fmt(dr[i], LD.dp) + ' ' + LD.unit + '"></span>';
  h += '<span class="sday-med" style="left:' + mp.toFixed(2) + '%"></span>';
  if (proj != null)
    h += '<span class="sday-proj" style="left:' + pos(proj).toFixed(2) +
         '%" title="projected full day: ' + fmt(proj, LD.dp) + ' ' + LD.unit + '">&#9670;</span>';
  h += '</div><div class="sday-ax"><span class="l">0</span><span class="r">' +
       fmt(span, LD.dp) + ' ' + LD.unit + '</span></div>' +
       /* Names the marks and stops. The old version also said the closed days
          are printed in the working below, which the fold directly under it
          says in its own summary -- a legend is not the place to trail a
          disclosure that is already trailing itself. */
       '<div class="sday-lg"><b>Bar</b> range so far' +
       (proj == null ? "" : ' &middot; <b>&#9670;</b> projected full day') +
       ' &middot; <b>&#124;</b> each of the ' + dr.length + ' closed days</div></div>';
  return h;
}

function drawSeasAdv(S, LD, nb, now){
  var h = document.getElementById("seasAdv");
  if (!h) return;
  var at = seasAt(S, nb), T = seasToday(seasKey), med = seasMed(S.dayRng);
  var p = ['<span class="advis-hdr">Where today sits in the shape</span>'];

  if (!at || !T || med == null){
    p.push("No live range to divide yet &mdash; the projection needs the contract&rsquo;s high and " +
           "low since the last cash close, and the feed is not carrying both.");
    h.innerHTML = p.join("");
    return;
  }

  var soFar = T.r, frac = at.c / 100, mult = 1 / frac;
  /* ONE decision about whether a projection exists, taken here and consumed by
     the verdict, the strip and the sentence alike. The multiplier is not
     re-tested downstream: three copies of a threshold is three chances for two
     of them to disagree after an edit, and this block used to branch on it
     twice. */
  var proj = mult > 5 ? null : soFar / frac;
  var V = seasVerdict(proj, med, S.dayRng);
  var say1, lead1, work1;

  if (proj == null){
    /* Refused rather than printed, and the threshold is the point: an estimate
       built by multiplying today's range by more than five is a statement about
       the divisor, not about the tape. Early in the ordinal day the cumulative
       fraction is a handful of per cent and the projection would swing hundreds
       of points on a single tick. */
    say1 = LD.label + " has covered <b>" + fmt(soFar, LD.dp) + " " + LD.unit + "</b>, and a " +
      "typical day is only <b>" + at.c.toFixed(0) + "%</b> through its range by this half hour.";
    lead1 = "Why no number is printed, and when one becomes worth reading";
    work1 = "Dividing by <b>" + at.c.toFixed(0) + "%</b> would multiply today&rsquo;s range by <b>" +
      mult.toFixed(1) + "&times;</b>. A number built that way moves hundreds of points on a single " +
      "tick and describes the divisor rather than the market. It becomes worth reading once a " +
      "typical day is a fifth of the way through its range. High " + fmt(T.hi, LD.dp) + " to low " +
      fmt(T.lo, LD.dp) + " since the cash close, and the fraction above is the middle of <b>" +
      at.cn + "</b> days at this half hour.";
  } else {
    var rel = proj / med - 1;
    say1 = LD.label + " has covered <b>" + fmt(soFar, LD.dp) + " " + LD.unit + "</b> and a typical " +
      "day is <b>" + at.c.toFixed(0) + "%</b> through its range by this half hour, which projects <b>" +
      fmt(proj, LD.dp) + "</b> against a <b>" + fmt(med, LD.dp) + "</b> median &mdash; <b>" +
      (rel >= 0 ? "+" : "") + (rel * 100).toFixed(0) + "%</b>.";
    lead1 = "How that projection is built, and the two different medians under it";
    work1 = "High " + fmt(T.hi, LD.dp) + " to low " + fmt(T.lo, LD.dp) + " since the cash close. " +
      "The projection is an <b>estimate</b>, and it leans on two different medians rather than one, " +
      "which the first draft of this sentence ran together into a single count that matched " +
      "neither. The fraction it divides by is the middle of <b>" + at.cn + "</b> days at this half " +
      "hour. The " + fmt(med, LD.dp) + " it is then measured against is the middle of <b>" +
      S.rngN + "</b> whole days that ran " +
      S.dayRng.map(function(x){ return fmt(x, LD.dp); }).join(", ") +
      " &mdash; printed rather than hidden, because a median of " + S.rngN + " is a weak thing to " +
      "divide a trading day by and the reader is entitled to see how weak." +
      (mult < 1.25
        ? " At this hour the multiplier is only <b>" + mult.toFixed(2) + "&times;</b>, so the " +
          "projection is very nearly the range already on the board and the comparison above is " +
          "really the plainer claim that today is a narrow day."
        : "");
  }

  p.push('<div class="sday-hd"><span class="sday-pill ' + V.c + '">' + V.k + '</span>' +
         '<span class="sday-say">' + say1 + '</span></div>');
  p.push(seasStrip(S, LD, soFar, proj, med));
  p.push(seasFold("adv", lead1, work1));

  /* The one forward-looking sentence this card is entitled to, and it is
     structural rather than directional: how much of the session that converts
     is left, and what that does to a level. Nothing here says which way.

     THREE STATES, NOT TWO, AND THE REASON IS THE ANCHOR.
     The first draft branched on "is there New York travel ahead of this slot"
     alone, and printed "New York is still ahead" at 18:16Z — two thirds of the
     way THROUGH New York. Every number in that sentence was correct and the
     sentence was false, which is the shape of error no guard on this page
     catches, because there is no wrong figure in it to catch.

     The deeper problem was that the two-branch design could not have been right
     under this card's anchoring. The ordinal day starts at the cash close, so
     New York is not somewhere in the middle of the clock — it is the LAST
     thirteen slots of the forty-eight. "New York is behind you" is therefore
     unreachable except in the final half hour, and the branch that read as the
     ordinary case was the one that almost never applied.

     So the split is on BOTH sides of the current slot, and it is pure slot
     arithmetic rather than a lookup on the bucket underfoot: at.z would have to
     walk backwards across the exchange halt to answer, and walking backwards
     from slot 0 lands on slot 47 and reports New York during the halt that
     follows it. */
  var tgt = seasSlot(nb), zBy = [], denom = 0;
  S.buckets.forEach(function(x){ zBy[seasSlot(x.b)] = x.z; denom += x.m; });

  /* THE CASH SESSION IS FOUND, NOT ASSUMED, AND NEW YORK APPEARS TWICE.
     The ordinal axis is anchored at the 20:00Z bell, and the phase table calls
     the hour of evening trade after that bell New York too — so slots 0 and 1
     carry the label as well as slots 35 through 47. They are not the same
     event. A test of the form "is there any New York behind me" answers yes at
     20:15Z, where the true answer is that today's cash session is seventeen
     hours away, and that is exactly what the first version of this branch said.
     The longest CONTIGUOUS run of New York buckets is today's session; the
     two-slot fragment at the start of the axis is yesterday's tail, and
     refusing to wrap is what keeps them apart. */
  var r0 = -1, r1 = -1, c0 = -1;
  for (var i = 0; i <= 48; i++){
    if (i < 48 && zBy[i] === "NY"){ if (c0 < 0) c0 = i; }
    else if (c0 >= 0){
      if (r0 < 0 || (i - 1 - c0) > (r1 - r0)){ r0 = c0; r1 = i - 1; }
      c0 = -1;
    }
  }

  var aheadNY = 0, aheadAll = 0;
  S.buckets.forEach(function(x){
    var s = seasSlot(x.b);
    if (s <= tgt) return;
    aheadAll += x.m;
    if (s >= r0 && s <= r1) aheadNY += x.m;
  });
  /* Renormalised, because these are MEDIANS and medians do not add. Each
     individual day's buckets sum to 100% exactly; the median of each bucket
     taken across days sums to about 108, since the middle day of one half hour
     is rarely the middle day of the next. Quoting the raw sum would print a
     share of a whole that is not a whole. The disclosure says so in the same
     words. */
  var pc = function(x){ return denom > 0 ? x / denom * 100 : 0; };
  var ny = S.sess.NY, asia = S.sess.Asia;
  var nyE = seasMed(ny.eff), asE = seasMed(asia.eff);
  /* Reworded to start after a subject, because it now appears behind the fold
     as its own sentence rather than spliced into the middle of another one. */
  var conv = "is the session that turns motion into displacement on this contract &mdash; " +
    nyE.toFixed(3) + " of range per unit of travel against Asia&rsquo;s " + asE.toFixed(3) +
    ", and the best of the three on " + (S.efWin.NY || 0) + " of " + S.efN + " days";
  var say, more = "";
  if (tgt < r0){
    say = "The New York cash session has not started. <b>" + pc(aheadNY).toFixed(0) + "%</b> of a " +
      "typical day&rsquo;s travel sits in that window, out of <b>" + pc(aheadAll).toFixed(0) + "%</b> " +
      "left in the day as a whole. Most of what builds today&rsquo;s range has not happened yet, and " +
      "a level that has held through Asia and London has not yet met the session that breaks them.";
  } else if (tgt < r1){
    say = "You are inside the New York cash session, with <b>" + pc(aheadNY).toFixed(0) + "%</b> of a " +
      "typical day&rsquo;s travel still in it. The hours that do the damage are underway rather than " +
      "pending, so today&rsquo;s range is nearer settled than open &mdash; and a level that has held " +
      "this far into the session has been tested by the only hours that test properly.";
  } else {
    say = "You are in the last half hour of New York, where volume and movement come apart: <b>" +
      S.close.v.toFixed(1) + "%</b> of the day&rsquo;s volume on <b>" + S.close.m.toFixed(1) +
      "%</b> of its travel. The range you have is close to the range you will get, and a level " +
      "taken on this bucket&rsquo;s volume alone is being read off the wrong number.";
    more = " That half hour has never once been the day&rsquo;s biggest mover, and size crossing is " +
      "not price moving.";
  }
  /* The conversion clause folds because the session table twelve pixels up this
     same card already prints range/travel as a column and the efficiency count
     beside it. One measurement stated twice on one card is the duplication the
     killzone card was stripped of, for the same reason: the second statement
     reads as a second piece of evidence. */
  p.push('<div class="sday-prep"><b>Preparing from this:</b> ' + say +
    " This card says nothing about direction." +
    seasFold("adv-prep", "Why New York is the session this hangs on, and where direction is asked",
      "New York " + conv + "." + more +
      " Direction is the killzone card&rsquo;s question, and it is asked and refused there rather " +
      "than answered here.") + '</div>');

  h.innerHTML = p.join("");
}

/* The inputs the day-size strip is drawn from, and only the inputs. seastest
   derives the span, every mark position and the verdict from these using
   arithmetic written separately from the painter's; anything DERIVED that
   appeared here would be the page marking its own homework, which is the rule
   kzState and decState were written to.

   atMs is threaded rather than defaulted inside, so a pinned clock in the suite
   reaches seasAt and seasToday the same way repaintAt reaches the painter. A
   suite whose assertions depend on the real date passes the day it is written
   and rots quietly afterwards. */
window.__wf.seasState = function(atMs){
  if (!seasOk()) return null;
  var now = atMs || Date.now();
  var S = SEAS.syms[seasKey], LD = LADDERS[seasKey] || { dp:2, unit:"pt", label:seasKey };
  var nb = seasBucket(now), at = seasAt(S, nb), T = seasToday(seasKey);
  return {
    key:    seasKey,
    dp:     LD.dp,
    unit:   LD.unit,
    label:  LD.label,
    dayRng: (S.dayRng || []).slice(),
    rngN:   S.rngN,
    today:  T  ? { hi:T.hi, lo:T.lo, r:T.r } : null,
    at:     at ? { c:at.c, cn:at.cn }        : null
  };
};

function drawSeasBody(S, LD){
  var h = document.getElementById("seasBody");
  if (!h) return;
  var C = SEAS.cal, sp = SEAS.span, r = [];

  r.push("<p><b>What is counted.</b> Every five-minute bar in the relay&rsquo;s archive is dropped " +
    "into the half hour it belongs to. <b>Travel</b> sums the bars&rsquo; own high-lows, which is " +
    "additive and therefore partitions a day exactly &mdash; within any single day the buckets sum " +
    "to 100%. The figure published per bucket is the <b>median across days</b>, and medians do not " +
    "add: the middle day of one half hour is rarely the middle day of the next, so the column you " +
    "see sums to roughly 108%, not 100. Nothing on this card quotes that sum as a whole; where a " +
    "run of buckets is reported as a share &mdash; &ldquo;so much travel still ahead&rdquo; &mdash; it is " +
    "divided by the column&rsquo;s own total rather than by 100. <b>Range</b> is high minus low over " +
    "a span, which is not additive either: a session " +
    "can travel enormously and finish where it started, and that gap is the entire subject of " +
    "the range&divide;travel column. Volume is the same bars&rsquo; volume, as a share of the day. " +
    "Nothing here is a price, so nothing here goes stale when the market moves; it goes stale " +
    "when the archive grows, and the header on the block carries the window it was measured over.</p>");

  r.push("<p><b>Which days count, and it is two different answers.</b> The bucket table needs a " +
    "day whose total travel is a day&rsquo;s travel, so a day-label is measured only if it traded " +
    "all three sessions. That test is not cosmetic: the archive&rsquo;s day begins at the New York " +
    "cash close, which peels the hour of trade after a Friday off into a label of its own &mdash; " +
    "twelve bars, two buckets, and inside that label those two buckets are half the day&rsquo;s " +
    "travel each and 100% of its range. The day-range median needs something stricter still, " +
    "because the projection above divides by it: only a <b>finished</b> day has a whole day&rsquo;s " +
    "range, and the newest label in the archive is the one being published into right now. So " +
    "the buckets are measured on <b>" + S.days + " days</b> and the day-range median on <b>" +
    S.rngN + "</b>, and the two numbers are different on purpose.</p>");

  var days = S.sess.NY.sh.length;
  r.push('<table class="disc-tbl"><thead><tr><th style="text-align:left">Day</th>' +
    '<th>Asia trav</th><th>Lon trav</th><th>NY trav</th><th>Asia eff</th><th>Lon eff</th><th>NY eff</th></tr></thead><tbody>');
  for (var i = 0; i < days; i++){
    r.push("<tr><td style=\"text-align:left\">day " + (i + 1) + "</td><td>" +
      S.sess.Asia.sh[i].toFixed(1) + "%</td><td>" + S.sess.London.sh[i].toFixed(1) + "%</td><td>" +
      S.sess.NY.sh[i].toFixed(1) + "%</td><td>" + S.sess.Asia.eff[i].toFixed(3) + "</td><td>" +
      S.sess.London.eff[i].toFixed(3) + "</td><td>" + S.sess.NY.eff[i].toFixed(3) + "</td></tr>");
  }
  r.push("</tbody></table>");
  r.push("<p>Read down the last three columns rather than across the medians: New York converts " +
    "motion into displacement better than Asia on <b>" + (S.efWin.NY || 0) + " of " + S.efN +
    "</b> days and carries the most travel on <b>" + (S.shWin.NY || 0) + " of " + S.shN +
    "</b>, and unanimity on a five-day sample is worth more than the size of any one median.</p>");

  r.push("<p><b>The cumulative curve is not guaranteed to rise.</b> Each figure is the median of " +
    "that bucket over the days that reached it, and different buckets were reached by different " +
    "subsets of days, so two neighbours can be measured on different evidence. That is why the " +
    "third panel is columns rather than a line &mdash; a line would draw an interpolation between " +
    "two numbers that were never measured together &mdash; and why every bar carries its own day " +
    "count on hover and in the table.</p>");

  r.push("<p><b>Three things this refuses to publish.</b> First, any day-of-week or month-of-year " +
    "statistic. The archive holds <b>" + sp.days + " trading days</b>, which is one observation " +
    "of each weekday and none of any month; a weekday table built on that would be five numbers " +
    "with an n of one apiece, and the fact that it would look exactly like the tables above is " +
    "what makes it dangerous. It becomes measurable at <b>" + C.need + "</b> trading days &mdash; " +
    (C.eta ? "about <b>" + C.eta + "</b>" : "<b>now</b>") + ". Second, any direction rate: " +
    SEAS.up[0] + " of the " + SEAS.up[1] + " days closed up, so up-day share, close-above-open " +
    "and high-made-in-session are all that one fact wearing different hats. Magnitude does not " +
    "have that problem, which is why this card measures magnitude. Third, a " +
    "continuation-versus-reversal rate &mdash; and this card could have produced one by a back " +
    "door, from the first New York sweep of the London range. It measured ES continuing 2 of 5 " +
    "and RTY 4 of 5. Those disagree with each other, are one sample of five apiece, and would " +
    "have sat on the same page as a killzone card that says in its own words that the direction " +
    "question is not yet answerable. One page does not get two answers to one question " +
    "depending on which card you read.</p>");

  r.push("<p><b>Two contracts, and only two.</b> The relay banks five-minute bars for ES and RTY. " +
    "Everything else on this page arrives as a six-minute quote sample, which is coarser than " +
    "the half hour this card counts in &mdash; a &ldquo;travel&rdquo; figure built from it would be " +
    "reporting the sampler&rsquo;s step size as the market&rsquo;s movement. That is the same reason the " +
    "depth board below has no HSI panel.</p>");

  r.push("<p class=\"subnote\">Window " + sp.from + " to " + sp.to + " &mdash; " + sp.labels +
    " day-labels, " + sp.days + " of which traded all three sessions. Generated by seasgen.py " +
    "and swapped in by refresh.sh; never edited by hand.</p>");

  h.innerHTML = r.join("");
}

function drawSeasTv(S){
  var t = document.getElementById("seasTv");
  if (!t) return;
  var r = ['<thead><tr><th style="text-align:left">HKT</th><th>UTC</th>' +
           '<th style="text-align:left">Session</th><th>Travel</th><th>Volume</th>' +
           '<th>Rank</th><th>Worst</th><th>Range done</th><th>Days</th></tr></thead><tbody>'];
  S.buckets.forEach(function(x){
    r.push('<tr><td style="text-align:left">' + seasHkt(x.b) + '</td><td>' + seasUtc(x.b) +
      '</td><td style="text-align:left">' + (SEASZ[x.z] || x.z) + '</td><td>' + x.m.toFixed(2) +
      '%</td><td>' + x.v.toFixed(2) + '%</td><td>' + x.rk + '</td><td>' + x.wr + '</td><td>' +
      (x.c == null ? "&ndash;" : x.c.toFixed(0) + "%") + '</td><td>' + x.n + '</td></tr>');
  });
  r.push("</tbody>");
  t.innerHTML = r.join("");
}

/* TWO LISTS, TWO SENTENCES, and the split is the whole point of this painter.
   "Coming" is a promise, and it is true of a contract that is still filling its
   archive and false of one whose trading hours cannot span the day this card
   measures. Saying it of both would be the cheap version -- one warning that
   reads as temporary, over a contract for which nothing is temporary.
   Neither list is typed here. seasgen decides which is which by measuring how
   many killzones the symbol's own bars have ever reached, so if HKEX extends
   the session this note changes on its own. */
(function drawSeasAbsent(){
  var h = document.getElementById("seasAbsent");
  if (!h || typeof SEAS === "undefined") return;
  var pend = SEAS.pending || {}, never = SEAS.never || {};
  var pk = Object.keys(pend), nk = Object.keys(never);
  h.innerHTML = "";
  if (!pk.length && !nk.length) return;      /* every contract covered: say nothing */

  var lab = function(k){ return (LADDERS[k] && LADDERS[k].label) || k; };
  var p = [];

  if (pk.length){
    p.push('<div class="sab-row"><b>Not yet on this card:</b> ' +
      pk.map(function(k){
        var d = pend[k];
        return lab(k) + ' &mdash; ' + d.bars.toLocaleString() + ' bars over ' +
               d.labels + ' day-label' + (d.labels === 1 ? '' : 's') +
               ', none of them a day that has closed across all ' + d.need + ' killzones yet';
      }).join('; ') +
      '. These are accumulating and will appear once the archive holds a closed ' +
      'day for them.</div>');
  }

  /* NAMED BY THE RELAY SYMBOL, not by LADDERS' label. The ladder labels HSI as
     "MHI" because the rungs a reader trades are the future; this sentence is
     about the hours of the CASH INDEX the relay carries, and the two do not keep
     the same hours. Calling the cash session by the future's name would be the
     mislabel the MHI block above exists to undo. */
  nk.forEach(function(k){
    var d = never[k];
    p.push('<div class="sab-row sab-never"><b>' + k + ' is not coming, and that is not ' +
      'about the size of the archive.</b> ' +
      'A day counts on this card only when its bars span every one of the ' + d.need +
      ' killzones, because every figure here is a share of one whole day&rsquo;s travel ' +
      'and a partial day has no denominator. ' + k + ' is the Hong Kong cash index, ' +
      'whose day sits inside Asia and London: across ' + d.bars.toLocaleString() +
      ' bars and ' + d.labels + ' day-labels its best day has reached ' + d.zones +
      ' of the ' + d.need + ' and has never reached more, and its widest single day ' +
      'spans ' + d.span_h.toFixed(1) + ' hours of the twenty-four a killzone day covers. ' +
      'No amount of waiting closes that gap, so &ldquo;coming&rdquo; would be false. ' +
      'What CAN be measured on those hours is measured &mdash; the Hong Kong structure ' +
      'has its own board on the tape card, built on the future that actually trades.</div>');
  });

  h.innerHTML = p.join("");
})();

(function buildSeasTabs(){
  var host = document.getElementById("seasTabs");
  if (!host || typeof SEAS === "undefined" || !SEAS.syms) return;
  host.innerHTML = "";
  Object.keys(SEAS.syms).forEach(function(k){
    var b = el("button", "tab", (LADDERS[k] && LADDERS[k].label) || k);
    b.type = "button"; b.setAttribute("role", "tab");
    b.setAttribute("aria-selected", k === seasKey ? "true" : "false");
    b.onclick = function(){
      seasKey = k;
      Array.prototype.forEach.call(host.children, function(c){
        c.setAttribute("aria-selected", "false"); });
      b.setAttribute("aria-selected", "true");
      drawSeas();
    };
    host.appendChild(b);
  });
})();

if (document.getElementById("seasTvBtn")) document.getElementById("seasTvBtn").onclick = function(){
  var w = document.getElementById("seasTvWrap");
  var on = w.classList.toggle("on");
  this.textContent = on ? "Hide table view" : "Show table view";
};


/* The open flags live OUTSIDE the paint, the same reason they do on cards 2 and
   3: drawLiq clears #liqBody wholesale on every repaint, so without the store a
   fold the reader opened would shut itself the next time the clock ticked. This
   card repaints on the live feed as well as on the clock, so on a moving market
   that is more often than every thirty seconds, not less. */
var liqFoldOpen = {};

function liqFold(key, lead, work, cls){
  return '<details class="fwork liq-f' + (cls ? " " + cls : "") + '" data-t="' + key +
         '"><summary>' + lead + '</summary><div class="fwork-b">' + work + '</div></details>';
}

/* Called as the last statement of the paint, after every host that can carry a
   fold has been rebuilt. toggle does not bubble, so this is a listener per
   element rather than one on the container, and it is keyed to the fold's own
   name rather than to its position -- the session-weight fold only exists when
   the archive has a cash-session profile for this contract, so a fold below it
   must not inherit the memory of the one that dropped out from above. */
function liqFoldWire(){
  Array.prototype.forEach.call(document.querySelectorAll("details.liq-f"), function(x){
    var fk = x.getAttribute("data-t");
    if (liqFoldOpen[fk]) x.open = true;
    x.addEventListener("toggle", function(){ liqFoldOpen[fk] = x.open; });
  });
}

/* ======================= THE TRADE JOURNAL =======================
   The scorecard grades the ANALYSIS — whether a call this page made came good.
   Nothing here recorded what was actually DONE, and those are different
   questions: a board can be right about a level all week while the account
   bleeds out in a session nobody looked at. The audit that asked for this made a
   specific bet worth testing rather than assuming — that Asian-hours trades are
   net negative and the New York open carries the account. This card does not
   assert that. It measures it, and prints "not enough trades to say" until there
   are enough, because a P&L split three trades deep is a story rather than a
   finding.

   NOTHING PERSISTS. Browser storage stays out by the same standing rule that
   keeps it out of the sizing card, and the card says so on its face rather than
   letting a reader discover it by closing a tab. What survives is the EXPORT: a
   block to copy, which pastes into the next brief and is baked in the way PLAN
   and CALLS already are.

   The multiplier comes from SIZE_SPEC — the same table the sizing card prices a
   stop with — so the two cards cannot disagree about what a point is worth. The
   session comes from sessAt(), the same function the clock, the pace model and
   the liquidity weights all use. Neither is re-derived here. */
var JOURNAL = [];
var JR_SEQ = 0;

function jrSpec(k){
  for (var i = 0; i < SIZE_SPEC.length; i++) if (SIZE_SPEC[i].k === k) return SIZE_SPEC[i];
  return null;
}
/* One trade's money, in its own currency. Signed by side, and NOT rounded until
   it is printed: a hundred small roundings is how a total stops matching its
   own rows. */
function jrPnl(e){
  var sp = jrSpec(e.inst);
  if (!sp || e.in == null || e.out == null || !(e.qty > 0)) return null;
  var pts = (e.dir === "short") ? (e.in - e.out) : (e.out - e.in);
  return { pts: pts, money: pts * sp.mult * e.qty, ccy: sp.ccy, mult: sp.mult };
}
function jrAdd(e){
  var sp = jrSpec(e.inst);
  if (!sp) return null;
  var at = e.at || Date.now();
  var row = { id: ++JR_SEQ, at: at, inst: e.inst, dir: e.dir === "short" ? "short" : "long",
              in: lnum(e.in), out: lnum(e.out), qty: Math.max(1, Math.round(e.qty || 1)),
              note: String(e.note || ""), sess: sessAt(at) };
  JOURNAL.push(row);
  return row;
}
/* By session, which is the whole reason this card exists. Totals are kept per
   CURRENCY as well as per session: MHI settles in Hong Kong dollars and adding
   it to a US-dollar total would be a category error wearing a number's clothes —
   the same error the sizing card refuses one card above. */
function jrBySession(){
  var out = {}, i, k;
  for (i = 0; i < JOURNAL.length; i++){
    var e = JOURNAL[i], p = jrPnl(e);
    if (!p) continue;
    k = e.sess;
    if (!out[k]) out[k] = { n:0, win:0, ccy:{} };
    out[k].n++;
    if (p.money > 0) out[k].win++;
    out[k].ccy[p.ccy] = (out[k].ccy[p.ccy] || 0) + p.money;
  }
  return out;
}
window.__wf.journal = function(){ return JOURNAL.slice(); };
window.__wf.jrAdd = function(e){ var r = jrAdd(e); drawJournal(); return r; };
window.__wf.jrBySession = jrBySession;
window.__wf.jrClear = function(){ JOURNAL = []; drawJournal(); return JOURNAL.length; };
window.__wf.drawJournal = function(){ drawJournal(); };

function jrMoney(v, ccy){
  return (v < 0 ? "\u2212" : "+") + ccy +
         Math.abs(v).toLocaleString("en-US", { maximumFractionDigits: 0 });
}

function drawJournal(){
  var host = document.getElementById("jrBody");
  if (!host) return;
  host.innerHTML = "";
  if (!JOURNAL.length){
    host.appendChild(el("div","jr-note",
      "No trades recorded in this session. Record one above and the by-session split " +
      "appears here. <b>Nothing is stored</b> &mdash; use Export before you close the page, " +
      "and paste that block into the next brief to have it baked in."));
    return;
  }

  /* THREE COLUMNS, not eight. The first version laid one column per field and
     ran off the right edge of a 430px card, taking the money column — the only
     one anybody opens this card for — with it. What a reader needs per row is
     what it was, what it did, and what it paid; the rest is detail that belongs
     under those three rather than beside them. */
  var r = ['<table class="jr-tbl"><thead><tr><th>Trade</th><th>Prices</th>' +
           '<th>Result</th></tr></thead><tbody>'];
  var i;
  for (i = JOURNAL.length - 1; i >= 0; i--){
    var e = JOURNAL[i], p = jrPnl(e);
    var cls = !p ? "" : p.money > 0 ? " class=\"pos\"" : p.money < 0 ? " class=\"neg\"" : "";
    r.push('<tr><td><b>' + e.inst + '</b> ' + e.dir + ' &times;' + e.qty +
        '<span class="jr-sub">' + hkt(e.at) + ' &middot; ' + (SESSTAG[e.sess] || e.sess) +
        (e.note ? ' &middot; ' + e.note : '') + '</span></td>' +
      '<td>' + (e.in == null ? "&mdash;" : fmt(e.in, 2)) + ' &rarr; ' +
        (e.out == null ? "&mdash;" : fmt(e.out, 2)) + '</td>' +
      '<td' + cls + '>' + (p ? jrMoney(p.money, p.ccy) : "&mdash;") +
        '<span class="jr-sub">' + (p ? (p.pts > 0 ? "+" : "") + fmt(p.pts, 2) + ' pt' : '') +
        '</span></td></tr>');
  }
  r.push('</tbody></table>');
  var tbl = el("div", null); tbl.innerHTML = r.join("");
  host.appendChild(tbl);

  var by = jrBySession(), order = ["RTH","EUR","EVE","ASIA"], sess = el("div","jr-sess");
  var any = false;
  for (i = 0; i < order.length; i++){
    var k = order[i], b = by[k];
    if (!b) continue;
    any = true;
    var ccys = Object.keys(b.ccy);
    var row = el("div","jr-row");
    /* EACH TOTAL COLOURED BY ITS OWN SIGN. The first version took the row's
       colour from the first currency, so a session that lost twenty dollars and
       made four hundred Hong Kong dollars printed the four hundred in the loss
       colour — a positive number in red, which is the one thing a colour on this
       page must never say. They are separate totals for the same reason they are
       not added: they are different money. */
    row.innerHTML =
      '<div class="jr-lab">' + (SESSTAG[k] || k) + '</div>' +
      '<div class="jr-fig">' + ccys.map(function(c){
        var v = b.ccy[c];
        return '<span class="' + (v > 0 ? "pos" : v < 0 ? "neg" : "flat") + '">' +
               jrMoney(v, c) + '</span>';
      }).join(' <span class="flat">&middot;</span> ') + '</div>' +
      '<div class="jr-say">' + b.n + (b.n === 1 ? " trade" : " trades") + ', ' +
        b.win + ' of them up' +
        (ccys.length > 1 ? ' &mdash; kept in separate currencies on purpose; adding ' +
          'them would be a category error' : '') + '</div>';
    sess.appendChild(row);
  }
  if (any) host.appendChild(sess);

  /* The audit's bet, and the refusal to answer it early. Four trades split
     across four sessions is one trade per session, and one trade is an anecdote
     wearing a P&L's clothes. The threshold is stated rather than hidden so a
     reader knows what would change the answer. */
  var need = 12, have = JOURNAL.filter(function(e){ return jrPnl(e); }).length;
  host.appendChild(el("div","jr-note", have < need
    ? "<b>" + have + " of " + need + " trades</b> before this card will read the session split " +
      "as a finding. Below that it is arithmetic on a handful of trades, and the shape it " +
      "shows would be noise you could act on. The counts and totals above are exact; what " +
      "is withheld is the conclusion."
    : "<b>" + have + " trades recorded.</b> The session split above is now worth reading as a " +
      "pattern rather than a list &mdash; the question it was built for is whether the quiet " +
      "sessions are paying for themselves, and it answers that from your own fills rather " +
      "than from this page&rsquo;s opinion of them."));
  host.appendChild(el("div","jr-note",
    "<b>Nothing here is stored.</b> Export before closing; paste the block into the next " +
    "brief and it is baked in beside PLAN and CALLS."));
}
/* The first paint, issued HERE — one statement after the state it reads was
   declared, and after the painter that reads it. The wiring IIFE above cannot do
   this: it runs earlier in the file, where JOURNAL is hoisted and undefined. */
try { drawJournal(); } catch (e) {}

/* DECLARED OUT HERE, alongside drawLiq and the summary, and deliberately NOT
   inside live(). Its form is wired by an IIFE that runs before live() is even
   reached, so an engine inside live() is a ReferenceError at page load — and on
   this page a top-level throw does not cost one card, it aborts the rest of the
   script and takes every painter after it down. That is what it did on the first
   run of this feature, and it is the fourth time this boundary has bitten.
   Everything below reads only outer-scope things: SIZE_SPEC, sessAt, SESSTAG,
   hkt, fmt, lnum, el. */
/* ====================== THE SIX-LINE SUMMARY ======================
   This board is thirty-five thousand pixels tall and its answer to "what is going
   on right now" is spread across six cards a reader has to visit in order. Most
   of the time the answer is short — the session, what the composite reads, where
   price sits against structure, whether the standing plan is armed, whether the
   feed is honest, and what is next on the calendar. Six lines, at the top, before
   anything that needs scrolling.

   THE ONE RULE THAT MAKES THIS SAFE: it does not compute anything. A summary that
   re-derives its own figures is a second implementation of six calculations, and
   this project has spent a week learning what happens when two implementations of
   one thing drift — the gate guards a sentence the page never printed. So every
   line here is PUBLISHED BY THE CARD THAT OWNS IT, from the card's own rendered
   values, at the moment it finishes painting. The summary cannot disagree with a
   card below it, because the string it shows is the string the card wrote.

   The two exceptions are the two that have no card: the session clock, which is
   clockAt() — the same call the session card makes, not a copy of it — and the
   next catalyst, which is nextEvent(), extracted so the hero countdown and this
   line select from one list by one rule.

   A line whose publisher did not run this paint says so. That is not defensive
   coding, it is the most valuable thing on the bar: paintAll's caller swallows
   throws, so a painter that dies takes its own card down silently, six screens
   below where anyone is looking. A dash at the top of the page is the fastest
   possible notice that something stopped measuring. */
var SUMMARY = {};
var SUM_ORDER = [
  { k:"clock", lab:"Session" },
  { k:"tone",  lab:"Risk" },
  { k:"kz",    lab:"Levels" },
  { k:"plan",  lab:"Plan" },
  { k:"feed",  lab:"Feed" },
  { k:"next",  lab:"Next" }
];
/* at = the instant the publishing painter was called with, NOT Date.now(). The
   whole page is repainted at a chosen instant by the pre-render and by every
   suite, and a summary stamping wall-clock time would report every line stale on
   exactly the runs that pin the clock. */
function sumSet(key, at, o){
  if (!o) { delete SUMMARY[key]; return; }
  SUMMARY[key] = { fig:o.fig, txt:o.txt, st:o.st || "ok", at:at };
}
window.__wf.sumState = function(){ return SUMMARY; };
/* A test seam, same contract as syncLadderPx: the bar's central claim is that a
   line whose publisher did not run reports itself dead rather than keeping the
   last good number, and that state cannot be reached by waiting — it needs a
   render with one publisher suppressed. */
window.__wf.drawSummary = function(atMs){ drawSummary(atMs); };

/* The next catalyst, selected once. The hero countdown above and the summary
   line below used to be two loops over one list, which is two chances to
   disagree about which event is next across a boundary minute. */
function nextEvent(nowMs){
  if (typeof EVENTS === "undefined") return null;
  for (var i = 0; i < EVENTS.length; i++)
    if (new Date(EVENTS[i].t).getTime() > nowMs) return EVENTS[i];
  return null;
}

function drawSummary(nowMs){
  var host = document.getElementById("sumBody");
  if (!host) return;
  var now = nowMs || Date.now();
  host.innerHTML = "";
  var missing = 0, i;

  /* Line 1 and line 6 are computed here because they have no card to publish
     them — but each calls the single function its counterpart calls. */
  var c = clockAt(now);
  var sessTxt = (typeof SESSTAG !== "undefined" && SESSTAG[c.sess]) || c.sess;
  sumSet("clock", now, {
    fig: c.to_close != null ? c.to_close.toFixed(1) + "h" : c.to_open.toFixed(1) + "h",
    txt: c.to_close != null ? sessTxt + " &mdash; that long until the cash close"
                            : sessTxt + " &mdash; that long until the New York open",
    st: "ok"
  });
  var nx = nextEvent(now);
  if (nx){
    var dms = new Date(nx.t).getTime() - now;
    var hh = Math.floor(dms / 3600000), mm = Math.floor(dms % 3600000 / 60000);
    sumSet("next", now, {
      fig: (hh > 0 ? hh + "h " : "") + mm + "m",
      txt: nx.n + " &mdash; " + nx.h,
      st: dms < 3600000 ? "warn" : "ok"
    });
  } else {
    sumSet("next", now, { fig: "—", txt: "nothing left on this week&rsquo;s calendar", st: "ok" });
  }

  for (i = 0; i < SUM_ORDER.length; i++){
    var spec = SUM_ORDER[i], e = SUMMARY[spec.k];
    var row = el("div","sum-row");
    /* A line is stale if its publisher did not run at THIS instant. Strict
       equality, deliberately: every publisher is handed the same nowMs by
       paintAll, so anything that does not match did not run. */
    var dead = !e || e.at !== now;
    if (dead) missing++;
    row.className = "sum-row" + (dead ? " dead" : e.st === "warn" ? " warn"
                                                : e.st === "bad" ? " bad" : "");
    row.setAttribute("data-k", spec.k);
    row.innerHTML =
      '<div class="sum-lab">' + spec.lab + '</div>' +
      '<div class="sum-fig">' + (dead ? "&mdash;" : e.fig) + '</div>' +
      '<div class="sum-txt">' + (dead
        ? (e ? "measured " + Math.max(0, Math.round((now - e.at) / 1000)) +
               "s ago, not on this paint &mdash; that card has stopped reporting"
             : "this card has not reported once &mdash; it is not painting")
        : e.txt) + '</div>';
    host.appendChild(row);
  }

  var note = document.getElementById("sumNote");
  if (note){
    note.innerHTML = missing
      ? '<b>' + missing + ' of ' + SUM_ORDER.length + ' lines did not report on this paint.</b> ' +
        'Every figure here is published by the card that owns it, so a dash means that ' +
        'card stopped rather than that the number is zero.'
      : 'Each line is published by the card that owns it, not recomputed here &mdash; ' +
        'so this bar cannot disagree with the board below it.';
  }
}

/* ========================= THE CONTRACT ROLL =========================
   The feed publishes a CONTINUOUS FRONT-MONTH ticker. When the exchange rolls ES
   from U6 to Z6 around the second Thursday of the quarter month, "ES" stops
   meaning one contract and starts meaning another, and the printed price steps
   by the calendar spread -- thirty to fifty points -- without one lot having
   changed hands at any price in between.

   Nothing downstream of the archive knows that. The volume profile, the point of
   control, the value area, the shelf-and-gap map, the inferred stop pools, the
   ladder built on top of them, the killzone level history and the seasonality
   medians are all built by pooling bars across the window, so a roll inside the
   window renders as a wide, clean, entirely convincing hollow that no market
   ever traded through. It is the most persuasive artefact this toolchain can
   manufacture, precisely because every other check on the page would agree the
   structure is really there: the bars are real, the volume is real, the hole is
   real, and the hole is nothing.

   So it is DISCLOSED and never back-adjusted. A large gap with a quiet bar is a
   roll under one reading and a genuine event under another, and silently
   subtracting the step would be a guess about which -- one that would corrupt
   the true case in order to tidy the false one. Naming the break and handing
   over its size is correct under both readings.

   Detected server-side in liquidity2.roll_break(); proven to fire in rolltest.py
   against a synthetic roll, because the live archive correctly contains none and
   a detector that has only ever returned the right empty list is a detector
   nobody has tested. */
function rollHits(sym){
  var L = (typeof LIQ !== "undefined") && LIQ[sym];
  if (!L || !L.roll || !L.roll.length) return null;
  var out = [], i;
  for (i = 0; i < L.roll.length; i++){
    var r = L.roll[i];
    if (r && lnum(r.jump) != null && lnum(r.at) != null) out.push(r);
  }
  return out.length ? out : null;
}

/* The most recent break is the one that matters: it is the one whose near side
   is the contract currently being traded, and its `after` count is the share of
   the picture that is actually about that contract. */
function rollLast(sym){
  var h = rollHits(sym);
  return h ? h[h.length - 1] : null;
}

function rollEl(sym, LD){
  var r = rollLast(sym), all = rollHits(sym);
  if (!r) return null;
  LD = LD || LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  var dp = LD.dp == null ? 2 : LD.dp;
  var at = r.at * 1000;
  var up = r.jump > 0;
  var box = el("div","rollb");

  var hd = el("div","rollb-hd");
  hd.innerHTML = '<i>&#9888;</i><span>Roll &mdash; this window spans a price break</span>';
  box.appendChild(hd);

  /* The figure, and beside it the only thing that separates a roll from a fast
     market: the gapping bar's own range. A violent tape has a large range and a
     small gap; a contract change has a small range and a large gap. Stating
     both lets the reader make that judgement instead of taking mine. */
  var fig = el("div","rollb-fig");
  fig.innerHTML = (up ? "+" : "&minus;") + fmt(Math.abs(r.jump), dp) + " " + (LD.unit || "pt") +
    '<em>' + (r.x != null ? r.x.toFixed(1) + "&times; a typical 30-minute move" : "") +
    (lnum(r.rng) != null && r.x != null ? " &middot; " : "") +
    (lnum(r.rng) != null ? "that bar's own range was " + fmt(r.rng, dp) : "") + '</em>';
  box.appendChild(fig);

  /* The date is built rather than sliced out of toUTCString, which yields
     "Fri, 07 Aug" — a comma and a leading zero the rest of this page does not
     use. Shifted by eight hours first so the weekday belongs to the HKT day the
     time beside it is quoted in; a break at 23:30Z is Saturday in Hong Kong and
     labelling it Friday would put the reader on the wrong session. */
  var hd8 = new Date(at + 8 * 3600000);
  var dayTxt = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][hd8.getUTCDay()] + " " +
    hd8.getUTCDate() + " " +
    ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][hd8.getUTCMonth()];
  var when = el("div","rollb-when");
  when.innerHTML = 'Closed <b>' + fmt(r.from, dp) + '</b>, reopened <b>' + fmt(r.to, dp) +
    '</b> at <b>' + hkt(at) + '</b> (' + zhm(at) + ') on ' + dayTxt +
    (all.length > 1 ? ' &mdash; and ' + (all.length - 1) + ' more in this window' : '') + '.';
  box.appendChild(when);

  /* The archive is cumulative rather than a rolling window -- LIQ.from is the
     first bar ever written -- so a break does not age out of the picture on its
     own. That makes the near-side share the number a reader most needs and the
     one no other card carries. */
  if (lnum(r.after) != null && lnum(r.of) != null && r.of > 0){
    var pct = r.after / r.of;
    var sh = el("div","rollb-share");
    sh.innerHTML =
      '<div class="rollb-bar"><u style="width:' + (pct * 100).toFixed(1) + '%"></u>' +
        '<u style="width:' + ((1 - pct) * 100).toFixed(1) + '%"></u></div>' +
      '<div class="rollb-slab"><b>' + r.after.toLocaleString() + ' of ' +
        r.of.toLocaleString() + '</b> bars below the break are on the contract you are ' +
        'trading now (' + Math.round(pct * 100) + '%). The hatched remainder is the ' +
        'previous contract, priced ' + fmt(Math.abs(r.jump), dp) + ' ' +
        (up ? "lower" : "higher") + '. This does not age out: the archive only grows.</div>';
    box.appendChild(sh);
  }

  var f = el("details","rollb-fold");
  f.appendChild(el("summary", null, "What this does to the numbers below"));
  f.appendChild(el("p", null,
    "Everything on this board that pools bars across the window absorbed the step: the " +
    "profile and its point of control, the value area, the shelf and gap map, the inferred " +
    "stop pools, the ladder built on them, and the killzone level history. A level whose " +
    "evidence predates " + hkt(at) + " is quoted in the old contract and reads <b>" +
    fmt(Math.abs(r.jump), dp) + "</b> " + (up ? "low" : "high") + " against today's tape."));
  f.appendChild(el("p", null,
    "Nothing here has been back-adjusted, on purpose. A large gap across a quiet bar is a " +
    "contract change under one reading and a real event under another; subtracting the step " +
    "would corrupt the second case to tidy the first. The break is named and its size is " +
    "given so the correction is yours to make, or not."));
  box.appendChild(f);
  return box;
}

/* One line, for cards that consume the profile rather than draw it. It carries
   the step, because on a levels card the step is the arithmetic the reader has
   to do by hand and a chip that only says "roll" sends them hunting for it. */
function rollChip(sym, LD){
  var r = rollLast(sym);
  if (!r) return null;
  LD = LD || LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  var dp = LD.dp == null ? 2 : LD.dp, up = r.jump > 0;
  var c = el("div","rollchip");
  c.innerHTML = '<i>&#9888; Roll</i> &mdash; the window breaks at <b>' + hkt(r.at * 1000) +
    '</b>. Levels older than that are the previous contract and read <b>' +
    fmt(Math.abs(r.jump), dp) + '</b> ' + (up ? "low" : "high") +
    '. Not adjusted; see Session liquidity.';
  return c;
}

/* ====================== MHI EXPIRY ======================
   The HK board carries one number that no other board here carries: a basis,
   measured once, between the cash index every level is drawn on and the future
   every fill happens on. That basis has a death date. MHI Aug-26 stops trading
   at the SEHK bell on Friday 28 August, and past it the -5.8 is not stale, it is
   describing a contract that no longer exists — the September basis is a
   different measurement, not a continuation of this one.

   The page already knew this. It is written into the comment above BI_BASIS in
   plain English and it was, until now, visible nowhere a reader would ever look.
   A fact that exists only in a source comment is a fact the board does not have.

   Deliberately NOT modelled. Carry-and-dividends theory says a basis decays
   linearly toward zero at expiry, and a linear estimate would be easy to print
   here and would look authoritative. This board's own measurements refuse it:
   the day-session median basis over 03-07 August ran +29, -5, +22, +15, +16 —
   thirty-five points of wander inside one week, on a figure a decay model would
   have moving by about one. So the number is stated with its age and its death
   date and no curve is drawn through it. Re-measure it; do not extrapolate it. */
/* Arithmetic and paint are split, and the arithmetic is the exported half. This
   row says something different on four different days — far out, inside the last
   fortnight, on the final session, and after — and three of those four cannot be
   reached by waiting. A guard that can only see the state today can only ever
   check one of them. */
/* ================= MHI, AS MEASURED ON THE FUTURE =================
   The rungs below this are still the six-minute cash sample the relay carries.
   This is the other measurement — the same window seen on the contract that
   actually trades — and it is drawn beside them rather than instead of them,
   because they answer different questions and neither one is the other's
   correction. The cash sample is live and coarse; this is dated and real.

   Every figure names its provenance, because the failure mode of putting two
   measurements of one market on one card is a reader taking a number off the
   wrong one. */
function mhiFutures(nowMs){
  var M = (typeof MHI !== "undefined") ? MHI : null;
  if (!M || !M.all) return null;
  var now = nowMs || Date.now();
  var box = el("div","mhif");

  /* The pull date, parsed once. Date.parse on the block's own ISO stamp rather
     than a second field to keep in step with it. */
  var pulledMs = Date.parse(M.pulled);
  var pulledTxt = isFinite(pulledMs)
    ? new Date(pulledMs + 8 * 3600000).toUTCString().slice(5, 16) + " HKT"
    : String(M.pulled);
  var ageD = isFinite(pulledMs) ? Math.max(0, Math.round((now - pulledMs) / 86400000)) : null;
  box.appendChild(el("div","mhif-hd",
    "Measured on the future &mdash; <b>" + M.bars.toLocaleString() + "</b> fifteen-minute bars, <b>" +
    M.vol.toLocaleString() + "</b> contracts"));

  /* The one number this board has never had: what a point is worth per unit of
     time. The cash index cannot produce it, because an index has no contract. */
  var t = el("div","mhif-t30");
  t.innerHTML = '<div class="mhif-fig">' + fmt(M.t30, 0) + '<u>pt / 30 min</u></div>' +
    '<div class="mhif-say">The contract&rsquo;s own typical thirty-minute travel &mdash; <b>HK$' +
    (M.t30 * 10).toLocaleString() + '</b> a contract. Every stop on this board can now be ' +
    'read against what the instrument actually does in half an hour, rather than against ' +
    'what the index does.</div>';
  box.appendChild(t);

  box.appendChild(el("div","mhif-row",
    "<b>Value " + fmt(M.all.val, 0) + "&ndash;" + fmt(M.all.vah, 0) + "</b>, point of control <b>" +
    fmt(M.all.poc, 0) + "</b> &mdash; 70% of every contract traded in this window, on the future. " +
    (M.day && M.day.poc === M.all.poc
      ? "The Hong Kong day session alone picks the same price, so the after-hours trade is not " +
        "distorting the structure here &mdash; which is the opposite of what the same test says on ES."
      : "The day session alone picks " + fmt(M.day ? M.day.poc : 0, 0) + ", so the two disagree and " +
        "the day-session figure is the one real size was transacted at.")));

  /* The session split, measured, and the reason the turn counts below are
     weighted rather than counted. */
  if (M.barsBySess && M.volBySess && M.barsBySess.AH && M.volBySess.AH){
    var tb = M.barsBySess.AH + (M.barsBySess.DAY || 0);
    var tv = M.volBySess.AH + (M.volBySess.DAY || 0);
    box.appendChild(el("div","mhif-row",
      "The after-hours session carries <b>" + Math.round(100 * M.barsBySess.AH / tb) +
      "%</b> of the bars and <b>" + Math.round(100 * M.volBySess.AH / tv) + "%</b> of the volume, " +
      "so a turn made there counts <b>" + (M.w.AH != null ? M.w.AH.toFixed(2) : "?") +
      "</b> against 1.00 in the day session. That weight is measured from this window&rsquo;s own " +
      "volume, not assumed."));
  }

  /* The levels, and they are TURNS rather than inferred stop pools: this feed has
     no order book either, and calling a turn count a stop pool on a card that
     already refuses to do so elsewhere would be the same error twice. */
  var top = (M.levels || []).slice(0, 5);
  if (top.length){
    var tbl = ['<table class="mhif-tbl"><thead><tr><th>Level</th><th>Turns</th>' +
               '<th>Weighted</th><th>Last</th></tr></thead><tbody>'];
    for (var i = 0; i < top.length; i++){
      var L = top[i], by = L.by || {};
      tbl.push('<tr><td>' + fmt(L.p, 0) + '</td><td>' + L.n +
        '<span class="mhif-sub">' + (by.DAY || 0) + ' day &middot; ' + (by.AH || 0) + ' after</span></td>' +
        '<td>' + L.w.toFixed(1) + '</td><td>' +
        new Date(L.last * 1000 + 8 * 3600000).toUTCString().slice(5, 12) + '</td></tr>');
    }
    tbl.push('</tbody></table>');
    var tw = el("div", null); tw.innerHTML = tbl.join("");
    box.appendChild(tw);
  }

  /* The basis, refused rather than quoted, with the measurement that refuses it. */
  var b = M.basis;
  if (b && b.enough && !b.usable){
    box.appendChild(el("div","mhif-warn",
      "<b>The basis is not resolvable from these two feeds, and that is a measurement rather " +
      "than a shrug.</b> Across <b>" + b.n + "</b> instants where both series print, the middle " +
      "half of the readings spans <b>" + b.iqr + "</b> points against a <b>" + b.floor +
      "</b>-point floor set by the cash feed&rsquo;s own movement between prints. Tightening the " +
      "match from five minutes to thirty seconds changed nothing, which rules out timestamp slop " +
      "and leaves feed lag. The <b>&minus;5.8</b> this card used to publish was false precision. " +
      "It matters less than it did: the figures above need no basis at all."));
  } else if (b && b.enough){
    box.appendChild(el("div","mhif-row",
      "Basis vs cash across <b>" + b.n + "</b> matched instants: median <b>" +
      (b.med > 0 ? "+" : "") + b.med + "</b>, middle half spanning " + b.iqr + " points."));
  }

  box.appendChild(el("div","mhif-note",
    "Pulled from HKFE through a broker connection <b>" + pulledTxt + "</b>" +
    (ageD != null ? ", <b>" + ageD + "</b> " + (ageD === 1 ? "day" : "days") + " ago" : "") +
    " &mdash; this block " +
    "does NOT refresh with the page, so its age is part of every claim above. Fifteen-minute bars " +
    "against the five-minute bars ES and RTY get, so each count here is a coarser observation than " +
    "its equivalent on those boards. The rungs below remain the live cash sample."));
  return box;
}

function mhiExpiryState(nowMs){
  var C = (typeof CONTRACT !== "undefined") && CONTRACT.HSI;
  if (!C || !C.ltdMs) return null;
  var now = nowMs || Date.now();
  var msLeft = C.ltdMs - now;
  /* Calendar days, rounded toward the reader's disadvantage: 1.9 days left is
     "1", never "2". A countdown that rounds up is a countdown that says there is
     a session left on the morning there is not. */
  var dLeft = Math.floor(msLeft / 86400000);
  /* Sessions, which is what a countdown is actually for — eighteen calendar days
     is fifteen chances to trade. Weekdays only, and it says so: HK public
     holidays are not in this page, and a count that quietly assumed none would
     be wrong every October without ever looking wrong. Walked in HKT, because
     the last trading day is a Hong Kong date and counting it in UTC drops or
     doubles a session for every reader east of Greenwich. */
  var sess = 0;
  if (msLeft > 0){
    var d0 = new Date(now + 8 * 3600000), e0 = new Date(C.ltdMs + 8 * 3600000);
    var d = Date.UTC(d0.getUTCFullYear(), d0.getUTCMonth(), d0.getUTCDate());
    var endD = Date.UTC(e0.getUTCFullYear(), e0.getUTCMonth(), e0.getUTCDate());
    while (d <= endD){
      var wd = new Date(d).getUTCDay();
      if (wd !== 0 && wd !== 6) sess++;
      d += 86400000;
    }
  }
  return {
    month: C.month, ltd: C.ltd, basis: C.basis, basisOn: C.basisOn,
    msLeft: msLeft, days: dLeft, sessions: sess,
    hours: msLeft > 0 ? Math.floor(msLeft / 3600000) : 0,
    basisAge: C.basisMs ? Math.floor((now - C.basisMs) / 86400000) : null,
    state: msLeft <= 0 ? "dead" : (dLeft <= 14 ? "near" : "far")
  };
}

function mhiExpiry(nowMs){
  var s = mhiExpiryState(nowMs);
  if (!s) return null;
  var dead = s.state === "dead";
  var box = el("div","mhix" + (dead ? " dead" : s.state === "near" ? " near" : ""));

  var n = el("div","mhix-n");
  n.innerHTML = dead
    ? '&mdash;<u>expired</u>'
    : (s.msLeft < 86400000
        ? Math.max(0, s.hours) + '<u>' + (s.hours === 1 ? "hour" : "hours") + '</u>'
        : s.sessions + '<u>' + (s.sessions === 1 ? "session" : "sessions") + '</u>');
  box.appendChild(n);

  /* NO BASIS IS A SENTENCE, NOT A DASH -- and fmt() would throw on the null
     rather than render one, because it calls toLocaleString on its argument.
     The refusal is assembled from MHI.basis's own figures rather than typed, so
     if the pair ever resolves this text stops being reachable instead of going
     stale. */
  var nb = (s.basis == null);
  var bq = (typeof MHI !== "undefined" && MHI && MHI.basis) ? MHI.basis : null;
  var noBasis =
    'There is <b>no measured basis</b> for ' + s.month + ', and none is invented. ' +
    'The figure this board used for Aug-26 was measured against that contract and ' +
    'is not carried over &mdash; a basis decays to zero into its own expiry, so last ' +
    'month\'s number says nothing about this one. The broker pull behind it, ' +
    '<i>mhi-ibkr.json</i>, is a frozen 7 August fixture covering Aug-26 only and ' +
    'cannot refresh itself' +
    (bq && bq.iqr != null && bq.floor != null
      ? '; and the cash-versus-futures pair on this page does not resolve one either, ' +
        'its middle half spanning <b>' + bq.iqr + '</b> points against a <b>' + bq.floor +
        '</b>-point floor set by the cash feed\'s own bar-to-bar movement'
      : '') +
    '. Convert levels off this card by hand until a Sep-26 basis is measured.';

  var t = el("div","mhix-t");
  t.innerHTML = nb
    ? (dead
        ? '<i>' + s.month + ' has expired.</i> Last trading day was <b>' + s.ltd + '</b>. ' + noBasis
        : '<i>' + s.month + '</i> &middot; last trading day <b>' + s.ltd + '</b>' +
          (s.days <= 14 ? ', <b>' + s.days + '</b> calendar ' + (s.days === 1 ? "day" : "days") : '') +
          '. Counted in weekdays &mdash; HK holidays are not in this page. ' + noBasis)
    : dead
    ? '<i>' + s.month + ' has expired.</i> Last trading day was <b>' + s.ltd +
      '</b>. The <b>' + fmt(s.basis, 1) + '</b> basis this board converts with was measured at the ' +
      s.basisOn + ', against a contract that no longer trades &mdash; the next month is a ' +
      'different measurement, not a continuation of this one. Re-measure it before taking a ' +
      'level off this card.'
    : '<i>' + s.month + '</i> &middot; last trading day <b>' + s.ltd + '</b>' +
      (s.days <= 14 ? ', <b>' + s.days + '</b> calendar ' + (s.days === 1 ? "day" : "days") : '') +
      '. Counted in weekdays &mdash; HK holidays are not in this page. The <b>' +
      fmt(s.basis, 1) + '</b> basis below was measured at the ' + s.basisOn +
      (s.basisAge != null ? ', <b>' + s.basisAge + '</b> ' +
        (s.basisAge === 1 ? "day" : "days") + ' ago' : '') +
      '; it dies with the contract and has to be re-measured, not carried over.';
  box.appendChild(t);
  return box;
}
window.__wf.mhiExpiryState = mhiExpiryState;

/* ================ THE CROSS-CHECK, PAINTED ================
   Split arithmetic from paint for the same reason mhiExpiry is: this row says one
   thing when the feeds agree and a different thing when they do not or when the
   check has aged out, and only one of those three states can be reached by
   waiting. A guard that can only see today's state can only ever check one. */
function xchkState(nowMs){
  if (typeof XCHK === "undefined" || !XCHK || !XCHK.rows) return null;
  var now = nowMs || Date.now();
  var ageH = (now - XCHK.at) / 3600000;
  var rows = [], worst = 0, i;
  for (i = 0; i < XCHK.rows.length; i++){
    var r = XCHK.rows[i];
    /* Basis points of DIFFERENCE between the two session moves. Signed on the
       row so a reader can see whether the relay runs consistently hot or cold;
       the headline takes the magnitude, because the question the headline
       answers is "how far apart at worst". */
    var bp = (r.theirs - r.ours) * 100;
    if (Math.abs(bp) > worst) worst = Math.abs(bp);
    rows.push({ k:r.k, proxy:r.proxy, ours:r.ours, theirs:r.theirs, bp:bp });
  }
  /* Ten basis points. An ETF's tracking difference over one session is a
     fraction of that, so anything wider is not tracking and wants looking at —
     but it is a THRESHOLD FOR ATTENTION, not a verdict that either feed is
     wrong, and the card says so. */
  var TOL_BP = 10;
  var stale = ageH > (XCHK.ttlH || 60);
  return { ageH:ageH, stale:stale, rows:rows, worst:worst, wide:(worst > TOL_BP),
           tol:TOL_BP, vendor:XCHK.vendor, session:XCHK.session,
           method:XCHK.method, unchecked:XCHK.unchecked || [], ttlH:XCHK.ttlH || 60 };
}

function drawXchk(atMs){
  var host = document.getElementById("xchk");
  if (!host) return;
  host.innerHTML = "";
  var x = xchkState(atMs);
  if (!x){
    /* No block at all is a state worth naming. A row that renders nothing looks
       identical to a board that has never been checked, and one of those is a
       missing feature while the other is a missing fact. */
    host.className = "xchk warn";
    host.innerHTML = "<i>&#9888;</i> <b>Never independently checked.</b> Every figure on this " +
                     "board comes from one relay and no second source has been asked.";
    return;
  }
  host.className = "xchk" + ((x.stale || x.wide) ? " warn" : "");
  var d = new Date(x.at || XCHK.at);
  var lead;
  if (x.wide)
    lead = "<i>&#9888;</i> <b>The two feeds disagree.</b> Worst gap <b>" + x.worst.toFixed(1) +
           "bp</b> against " + x.vendor + " on " + XCHK.session + ", wider than the " +
           x.tol + "bp that tracking explains.";
  else if (x.stale)
    lead = "<i>&#9888;</i> <b>The independent check has gone stale</b> &mdash; taken " +
           (x.ageH / 24).toFixed(1) + " days ago against " + x.vendor + ", past the " +
           (x.ttlH / 24).toFixed(1) + "-day life this board gives it. It agreed then. " +
           "It is not evidence about now.";
  else
    lead = "Independently checked against <b>" + x.vendor + "</b> on " + XCHK.session +
           ", " + x.ageH.toFixed(0) + "h ago: worst gap <b>" + x.worst.toFixed(1) +
           "bp</b> across " + x.rows.length + " indices.";
  var det = '<details><summary>what was compared, and what this does not check</summary>';
  det += '<table><thead><tr><th>Index</th><th>this board</th><th>' + x.vendor +
         '</th><th>proxy</th><th>gap</th></tr></thead><tbody>';
  for (var j = 0; j < x.rows.length; j++){
    var r = x.rows[j];
    det += '<tr><td>' + r.k + '</td><td>' + (r.ours > 0 ? "+" : "") + r.ours.toFixed(4) +
           '%</td><td>' + (r.theirs > 0 ? "+" : "") + r.theirs.toFixed(4) + '%</td><td>' +
           r.proxy + '</td><td>' + (r.bp > 0 ? "+" : "") + r.bp.toFixed(1) + 'bp</td></tr>';
  }
  det += '</tbody></table>';
  det += '<p>' + XCHK.method.charAt(0).toUpperCase() + XCHK.method.slice(1) +
         '. That makes it a check on DIRECTION AND MAGNITUDE, not on price: an ETF ' +
         'tracks its index with a few basis points of slippage from fees and dividends, ' +
         'so a small gap is expected and is not evidence of a fault in either feed.</p>';
  det += '<p>It says nothing about the FUTURES prices the levels are drawn on &mdash; it ' +
         'checks the cash indices those futures are quoted against.</p>';
  if (x.unchecked.length){
    var names = [], w = [];
    for (var u = 0; u < x.unchecked.length; u++){ names.push(x.unchecked[u].k); w.push(x.unchecked[u].why); }
    det += '<p><b>NOT checked: ' + names.join(" and ") + '.</b> ' + w[0] +
           '. They are named here rather than quietly left out, because a check that ' +
           'silently skips what it cannot reach and reports a clean bill is the same ' +
           'defect in a new place.</p>';
  }
  det += '<p>It does not run itself. There is no path from this toolchain to an ' +
         'independent vendor without a key, and keys do not enter the build container, ' +
         'so it is refreshed by hand and its age is the warning.</p>';
  det += '</details>';
  host.innerHTML = lead + det;
}
window.__wf.xchkState = xchkState;
window.__wf.drawXchk = drawXchk;
/* A seam, and the justification is the same one seedRoll carries: three of this
   row's four states cannot be reached by waiting. It agrees today, it will agree
   tomorrow, and the states worth having — the two feeds disagreeing, the check
   aged out, the block absent entirely — would never once be drawn before the
   morning they mattered. It writes, repaints, and RETURNS the resulting state, so
   a caller asserts the write landed rather than assuming it. */
window.__wf.seedXchk = function(patch, atMs){
  if (typeof XCHK === "undefined" || !XCHK) return null;
  if (patch && patch.rows !== undefined) XCHK.rows = patch.rows;
  if (patch && patch.at !== undefined) XCHK.at = patch.at;
  if (patch && patch.ttlH !== undefined) XCHK.ttlH = patch.ttlH;
  drawXchk(atMs);
  return xchkState(atMs);
};
window.__wf.xchkRaw = function(){
  return (typeof XCHK === "undefined" || !XCHK) ? null
    : { at: XCHK.at, ttlH: XCHK.ttlH, rows: JSON.parse(JSON.stringify(XCHK.rows || [])) };
};

/* ================= anchored VWAP ==========================================
   Where size has traded since each of four moments. The block carries a mean
   and a dispersion per anchor; everything a reader sees as a DISTANCE is
   computed here, live, against the spot price the rest of the page is using.

   THE LIKELIHOOD BAN IS THE DESIGN CONSTRAINT, not a style note. Every
   vocabulary this card could reach for -- extended, stretched, overbought,
   due, rich, cheap, reverting -- is a claim about what happens next, and
   nothing in the archive that produced these numbers measures that. A
   volume-weighted mean says where the average contract traded. The distance
   from it says how far spot is now. Neither says what spot does next, and a
   card that quietly implies otherwise is worse than one that says nothing,
   because it is read as though the page checked. avwaptest asserts the words
   never appear in anything this painter renders.

   The three units are deliberate and none of them is the headline. Points is
   what a stop gets written in. Sigma is the only one comparable across
   contracts -- 40 points is enormous on RTY and nothing on YM. x t30 is the
   one that answers "how long", using the same typical-move figure the ladder
   and the decision board divide by, so the three cards cannot disagree about
   what a thirty-minute move is.                                           */
var avwKey = null;

function avwSyms(){
  return (typeof AVWAP !== "undefined" && AVWAP.syms) ? Object.keys(AVWAP.syms).sort() : [];
}

/* THE ANCHOR ORDER IS FIXED AND THE MEMBERSHIP IS NOT. The four anchors mean
   different things and read best in a settled order -- nearest in time first --
   but an anchor the generator stops emitting must not leave a hole, and one it
   starts emitting must not be invisible because this list never heard of it.
   So the order is a preference applied to whatever the block carries, the same
   shape ladgen's lead tuple uses, rather than the list of what may appear. */
var AVW_ORDER = ["sess_open", "swept", "pd_high", "pd_low"];
function avwKeys(d){
  var seen = {}, out = [], i, k;
  for (i = 0; i < AVW_ORDER.length; i++){
    k = AVW_ORDER[i];
    if (d.a[k] || d.short[k]){ out.push(k); seen[k] = 1; }
  }
  Object.keys(d.a).concat(Object.keys(d.short)).forEach(function(x){
    if (!seen[x]){ seen[x] = 1; out.push(x); }
  });
  return out;
}

function avwRow(sym, a, px, LD, t30){
  var r = el("div", "avw-row");
  r.appendChild(el("div", "",
    '<div class="avw-hd">' + a.lab + '</div>' +
    '<div class="avw-of">' + a.of + ' &middot; anchored at ' + fmt(a.p, LD.dp) + '</div>'));
  r.appendChild(el("div", "",
    '<div class="avw-mean">' + fmt(a.v, LD.dp) + '</div>' +
    '<div class="avw-band">&plusmn;1&sigma; ' + fmt(a.v - a.sd, LD.dp) + ' / ' +
      fmt(a.v + a.sd, LD.dp) + '<br>&plusmn;2&sigma; ' +
      fmt(a.v - 2 * a.sd, LD.dp) + ' / ' + fmt(a.v + 2 * a.sd, LD.dp) + '</div>'));

  /* NO DISTANCE WITHOUT A SPOT, and no silent zero in its place. A card that
     prints "0.0 pt from the mean" because the feed is down has said something
     false about the market rather than something true about the feed. */
  var d = el("div", "avw-d");
  if (px == null){
    d.innerHTML = '<div style="grid-column:1 / -1">No live price for ' + LD.label +
      ', so the distance from this line cannot be computed. The line itself is ' +
      'measured and stands; what is missing is where spot is relative to it.</div>';
    r.appendChild(d);
    return r;
  }
  var dp = px - a.v;
  var sg = a.sd > 0 ? dp / a.sd : null;
  var tx = (t30 && t30.v > 0) ? dp / t30.v : null;
  var side = dp === 0 ? "level with" : (dp > 0 ? "above" : "below");
  d.innerHTML =
    '<div><b>' + (dp > 0 ? "+" : dp < 0 ? "&minus;" : "") + fmt(Math.abs(dp), LD.dp) +
      '</b><u>' + LD.unit + ', ' + side + '</u></div>' +
    '<div><b>' + (sg == null ? "&mdash;" :
      (sg > 0 ? "+" : sg < 0 ? "&minus;" : "") + Math.abs(sg).toFixed(2)) +
      '</b><u>' + (sg == null ? "no dispersion to divide by" : "&sigma;, volume-weighted") + '</u></div>' +
    '<div><b>' + (tx == null ? "&mdash;" :
      (tx > 0 ? "+" : tx < 0 ? "&minus;" : "") + Math.abs(tx).toFixed(2)) +
      '</b><u>' + (tx == null ? "no typical move for this session" :
        "&times; a typical 30 min" + (t30.src === "archive" ? ", archive" : "")) + '</u></div>';
  r.appendChild(d);
  return r;
}

function avwWait(a, LD){
  var r = el("div", "avw-row avw-wait");
  r.appendChild(el("div", "",
    '<div class="avw-hd">' + a.lab + '</div>' +
    '<div class="avw-of">' + a.of + ' &middot; anchored at ' + fmt(a.p, LD.dp) + '</div>'));
  r.appendChild(el("div", "", '<div class="avw-mean">&mdash;</div>'));
  /* WHAT IS MISSING, HOW MUCH, AND WHY THAT NUMBER. "Not enough data" is the
     sentence that makes a reader stop trusting a card; "9 bars of the 17 this
     needs" is one they can act on, because it tells them to look again after
     the session has run a while. */
  r.appendChild(el("div", "avw-wait-why",
    a.novol
      ? 'Withheld &mdash; the bars since this anchor carry no volume, so there is ' +
        'nothing to weight a mean with.'
      : 'Withheld &mdash; <b>' + a.n + ' bar' + (a.n === 1 ? '' : 's') +
        '</b> since this anchor, against the <b>' + a.need + '</b> this measurement ' +
        'needs. That floor is the page&rsquo;s own typical-move floor converted into ' +
        'archive bars, not a number chosen for this card. It will fill on its own ' +
        'as the session runs.'));
  return r;
}

function drawAvwap(atMs){
  var host = document.getElementById("avwBody");
  if (!host || typeof AVWAP === "undefined") return;
  host.innerHTML = "";

  var ex = document.getElementById("avwExcl");
  if (ex){
    var E = AVWAP.excl || {}, ek = Object.keys(E);
    ex.innerHTML = !ek.length ? "" :
      '<b>Not on this card' + (ek.length === 1 ? '' : ', and why') + ':</b> ' +
      ek.map(function(k){ return k + ' &mdash; ' + E[k]; }).join(' ');
  }

  var syms = avwSyms();
  if (!syms.length){
    host.appendChild(el("div", "avw-wait-why",
      "No contract on the relay carries both bars and volume, so there is no " +
      "anchored mean to draw."));
    return;
  }
  if (avwKey == null || syms.indexOf(avwKey) < 0) avwKey = syms[0];

  var now = atMs || Date.now();
  var sym = avwKey, d = AVWAP.syms[sym];
  var LD = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  var px = liqPx(sym), t30 = pace(sym, now);

  avwKeys(d).forEach(function(k){
    host.appendChild(d.a[k] ? avwRow(sym, d.a[k], px, LD, t30)
                            : avwWait(d.short[k], LD));
  });

  /* TWO VINTAGES, BOTH STAMPED, because they are genuinely different ages and
     the card would otherwise invite a reader to assume the older one is as
     fresh as the newer. The lines come from the bar archive; the distances come
     from a live quote. House rule: every displayed price carries its age. */
  /* THE AGE COMES OFF THE SAME OBJECT AS THE PRICE. printAt() was the first
     thing tried here and it is the wrong door: it answers only when the reader
     has typed a print, so on every ordinary load it returned null and the
     distances shipped with no age beside them at all — a bare price on a card,
     which is the one thing this page's house rules say never happens.
     The quote bag is the right door because the reader's print is OVERLAID into
     it before any painter runs, so one lookup gets the price and its age
     whether that price came from the relay or from the reader.
     The equality test is not defensive noise. liqPx has a fallback the quote bag
     does not — the ladder's baked seed — and a seed carries no age. Attaching
     the relay's age to a build-time seed would be a stamp that lies in the exact
     way a stamp exists to prevent, so when the two disagree the card says the
     age is unavailable and names why rather than printing a plausible one. */
  var qb = (typeof LIVEQ !== "undefined" && LIVEQ && LIVEQ.quotes && LIVEQ.quotes[sym]) ||
           (SNAPSHOT && SNAPSHOT.quotes && SNAPSHOT.quotes[sym]) || null;
  var qAge = (qb && qb.age_s != null && px != null && lnum(qb.px) === px)
             ? qb.age_s : null;
  var st = el("div", "avw-stamp");
  st.innerHTML =
    'Lines measured on archive bars through <b>' + stamp(AVWAP.gen) + '</b> on ' +
    new Date(AVWAP.gen * 1000).toLocaleDateString([], {weekday:"short", day:"numeric", month:"short"}) +
    ' (' + ago(Math.max(0, now / 1000 - AVWAP.gen)) + ' ago). ' +
    (px == null
      ? 'No live price, so no distance is drawn.'
      : 'Distances measured against <b>' + fmt(px, LD.dp) + '</b>, ' +
        (qAge != null
          ? ago(qAge) + ' old.'
          : 'whose age this card cannot establish &mdash; it is not the price the ' +
            'live quote carries, so it is the ladder&rsquo;s baked seed and is as old ' +
            'as the build.'));
  host.appendChild(st);
}

(function buildAvwTabs(){
  var host = document.getElementById("avwTabs");
  if (!host) return;
  host.innerHTML = "";
  var syms = avwSyms();
  if (avwKey == null && syms.length) avwKey = syms[0];
  syms.forEach(function(k){
    var b = el("button", "tab", (LADDERS[k] && LADDERS[k].label) || k);
    b.type = "button"; b.setAttribute("role", "tab");
    b.setAttribute("aria-selected", k === avwKey ? "true" : "false");
    b.onclick = function(){
      avwKey = k;
      Array.prototype.forEach.call(host.children, function(c){
        c.setAttribute("aria-selected", "false"); });
      b.setAttribute("aria-selected", "true");
      drawAvwap();
    };
    host.appendChild(b);
  });
})();

/* ONE SENTENCE, TWO CARDS. The decision board's rows are built out of LIQ, so a
   contract with no LIQ entry is missing from that card for exactly the reason it
   is missing from this one -- and the answer to "why is there no HSI row" is the
   same answer in both places. Written once here and read by both painters rather
   than copied into the second card's voice: two copies of a refusal is how the
   liquidity map ends up saying "no volume" while the decision board says "not
   covered", and a reader who sees both concludes there are two problems.
   Mounted OUTSIDE either painter's early return, for the reason rollEl is: the
   state in which a reader most needs to know a contract is absent is the state
   in which the card has nothing else to show. */
function liqExclHtml(){
  var E = (typeof LIQ_EXCL !== "undefined" && LIQ_EXCL) || {};
  var ks = Object.keys(E);
  if (!ks.length) return "";
  return '<b>Not on this map' + (ks.length === 1 ? '' : ', and why') + ':</b> ' +
         ks.map(function(k){ return k + ' &mdash; ' + E[k]; }).join(' ');
}

function paintLiqExcl(id){
  var h = document.getElementById(id);
  if (h) h.innerHTML = liqExclHtml();
}

function drawLiq(atMs){
  var now = atMs || Date.now();
  paintLiqExcl("liqExcl");
  var host = document.getElementById("liqBody");
  host.innerHTML = "";                                /* idempotent: ships pre-rendered */
  var sym = liqKey, L = LIQ[sym], LD = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  /* Mounted ahead of the early return on purpose. A window that spans a break is
     a fact about the archive, not about whether today's price arrived — and the
     one state in which a reader most needs to be told the picture is broken is
     the state in which there is no picture to look at. */
  var rb = rollEl(sym, LD);
  if (rb) host.appendChild(rb);
  var B = liqBins(sym), S = B && liqStats(B), px = liqPx(sym);
  if (!S || px == null){
    host.appendChild(el("div","rt-key","No bar history for this contract yet."));
    return;
  }

  var H = 300, n = S.ks.length, rowH = H / n;
  var mx = 0;
  S.ks.forEach(function(k){ if (B.bins[k] > mx) mx = B.bins[k]; });
  var yOf = function(k){ return H - (S.ks.indexOf(k) + 1) * rowH; };
  var loP = S.ks[0] * B.bw, hiP = (S.ks[n-1] + 1) * B.bw;
  var yPrice = function(p){
    return Math.max(0, Math.min(H, H - (p - loP) / (hiP - loP) * H));
  };

  /* Pools are read HERE rather than down in the call section where they used to
     be, because the chart now draws them and the chart comes first. One call,
     one list, and the rail and the rows below cannot disagree about what is on
     it — which they could, and silently, if each fetched its own. */
  var pools = liqPools(sym, px);
  /* Extracted for the same reason: the rail's mark width and the row's bar count
     are two renderings of one number, and if they were computed in two places a
     later edit to either would make the picture contradict the list. */
  var poolStrength = function(sc){ return Math.max(1, Math.min(3, Math.round(sc / 4))); };

  var wrap = el("div","liq-wrap");
  var prof = el("div","liq-prof");

  S.ks.forEach(function(k){
    var d = el("div","liq-bin" + (k >= S.lo && k <= S.hi ? " in" : ""));
    d.style.top    = yOf(k) + "px";
    d.style.height = Math.max(2, rowH - 1) + "px";
    d.style.width  = Math.max(1.5, B.bins[k] / mx * 100) + "%";
    prof.appendChild(d);
  });

  /* Rules and their right-hand labels. Collected first so overlapping labels can
     be pushed apart — at 4px a row, POC and price land on top of each other often. */
  var marks = [
    { y: yPrice(S.vahP), cls:"edge", tag:"", lab:"Value high", val:fmt(S.vahP, LD.dp) },
    { y: yPrice(S.valP), cls:"edge", tag:"", lab:"Value low",  val:fmt(S.valP, LD.dp) },
    { y: yOf(S.poc) + rowH/2, cls:"poc", tag:"poc", lab:"Point of control", val:fmt(S.pocP, LD.dp) },
    { y: yPrice(px), cls:"", tag:"px", lab:"Price now", val:fmt(px, LD.dp), px:true }
  ];
  marks.forEach(function(m){
    var r = el("div","liq-rule" + (m.cls ? " " + m.cls : ""));
    r.style.top = m.y + "px";
    prof.appendChild(r);
    if (m.px){
      var t = el("div","liq-px");
      t.style.top = m.y + "px";
      prof.appendChild(t);
    }
  });
  marks.slice().sort(function(a,b){ return a.y - b.y; }).reduce(function(prev, m){
    var y = (prev != null && m.y - prev < 26) ? prev + 26 : m.y;
    var t = el("div","liq-tag" + (m.tag ? " " + m.tag : ""), "<b>"+m.val+"</b>"+m.lab);
    t.style.top = y + "px";
    prof.appendChild(t);
    return y;
  }, null);

  /* the stop pools on the profile's own axis — the reasoning is at .liq-rail */
  var rail = el("div","liq-rail");
  pools.slice(0, 6).forEach(function(s){
    var m = el("div","liq-pm");
    if (s.p < loP || s.p > hiP){
      m.className = "liq-pm off " + (s.p > hiP ? "up" : "dn");
      m.style.top = (s.p > hiP ? -3 : H - 2) + "px";
    } else {
      m.style.top   = yPrice(s.p) + "px";
      m.style.width = [5, 9, 13][poolStrength(s.score) - 1] + "px";
    }
    m.title = fmt(s.p, LD.dp) + " · " + poolWord(s.side).toLowerCase() + " this level";
    rail.appendChild(m);
  });
  prof.appendChild(rail);

  wrap.appendChild(prof);
  host.appendChild(wrap);

  /* The sample size and what blue means stay on the card: one is whether to
     believe the picture at all and the other is how to read its only colour.
     What goes behind the fold is the glossary -- what the accent rule is called
     and what the horizontal axis is -- which a reader needs once and then never
     again, and which was costing 21 of this card's visible words every paint. */
  var pct = Math.round(S.total ? 70 : 0);
  host.appendChild(el("div","rt-key", liqFold("liq-leg",
    "Built from <b>" + (L.bars + B.added) + "</b> five-minute bars covering <b>" +
    (Math.round(L.hours * 10 + Math.round(B.added * 5 / 6)) / 10) + " hours</b>" +
    (B.added ? " (" + B.added + " added live since the snapshot)" : "") +
    ". Blue is the value area &mdash; the band holding " + pct +
    "% of all volume in the window.",
    "The point of control is the single busiest price in it. " +
    "Bar length is contracts traded at that price, nothing else.", "liq-rd")));

  /* ---- what the cash session alone says ----
     The all-hours profile counts a bar traded at 3am Hong Kong the same as one
     traded at the New York open. It should not: measured on this window, the
     Asian session holds roughly half the bars and under a tenth of the volume.
     Where the two profiles disagree, the cash-session one is the one real size
     was transacted at, and the gap between them is itself a tradeable fact. */
  if (L.rth && lnum(L.rth.poc) != null){
    var drift = L.rth.poc - S.pocP;
    /* The weights themselves are a fold rather than a sentence. That turns are
       weighted at all is something the reader has to know, because it changes
       what a turn count means; the three numbers are something they only need
       when they want to check the arithmetic. */
    var wtxt = L.w ? liqFold("liq-w8",
        "Turns are <b>weighted</b> by the liquidity present when they happened, " +
        "so a quiet overnight turn does not count the same as one at the bell.",
        "A turn in the cash session counts <b>1.00</b>, one in the European morning <b>" +
        (L.w.EUR != null ? L.w.EUR.toFixed(2) : "?") + "</b>, one in Asian hours <b>" +
        (L.w.ASIA != null ? L.w.ASIA.toFixed(2) : "?") + "</b>. Those weights are measured from " +
        "this window's own volume, not assumed.") : "";
    host.appendChild(el("div","rt-key",
      "<b>Cash session only</b> (" + L.rth.bars + " bars): value <b>" + fmt(L.rth.val, LD.dp) +
      "&ndash;" + fmt(L.rth.vah, LD.dp) + "</b>, point of control <b>" + fmt(L.rth.poc, LD.dp) + "</b>. " +
      (Math.abs(drift) < L.bw
        ? "That is the same price the all-hours profile picks, so the overnight trade is not distorting the structure here."
        : "That sits <b>" + (drift > 0 ? "+" : "") + fmt(drift, LD.dp) + "</b> from the all-hours point of control &mdash; " +
          "the overnight session is dragging the profile " + (drift < 0 ? "higher" : "lower") +
          " than where real size actually changed hands.") + wtxt));
  }

  /* ---- the call ---- (pools were read up at the chart, which now draws them) */
  var above = pools.filter(function(p){ return p.p > px && p.side !== "below"; })[0];
  var below = pools.filter(function(p){ return p.p < px && p.side !== "above"; })[0];
  /* This used to reach for L.t30 — the median of the last eight hours — with a
     comment claiming it was "measured on the same window this map was built
     from". It was not: the profile spans 53.6 hours and that figure spans the
     last eight, so the comment described a consistency the code did not have,
     and the ladder above divided by a third number again. One divisor now, from
     pace(), keyed on the session this map is being drawn for. */
  var P = pace(sym, now);
  var t30 = P ? P.v : null;
  var xx = function(p){ return t30 ? (Math.abs(p - px) / t30).toFixed(1) + "&times; 30m" : null; };
  var inside = px >= S.valP && px <= S.vahP;

  /* whyLead is the one sentence of the reasoning that stays on the card, and it
     is the same sentence in every branch: WHERE price is standing relative to
     value. That is not restated by the lean above it -- the lean says what to do
     about it -- and it is the fact the rest of the paragraph is derived from, so
     a reader who never opens the fold is still told the thing the call rests on
     rather than only the call. Everything after it is working. */
  var lean, why, whyLead, invalid;
  if (inside){
    var near = (above && below)
      ? (Math.abs(above.p - px) <= Math.abs(px - below.p) ? above : below)
      : (above || below);
    lean = near
      ? "Rotational &mdash; the pull is toward " + fmt(near.p, LD.dp)
      : "Rotational &mdash; no clean stop pool in range";
    whyLead = "Price is <b>inside value</b>, the band where most of the window's volume traded.";
    why = "Inside value, moves tend to rotate rather than run, and the point of control at <b>" +
      fmt(S.pocP, LD.dp) + "</b> acts as the magnet" +
      (t30 ? " (" + xx(S.pocP) + " away)" : "") + ". " +
      (above && below
        ? "Untouched stops sit <b>" + fmt(above.p, LD.dp) + "</b> above (" + xx(above.p) +
          ") and <b>" + fmt(below.p, LD.dp) + "</b> below (" + xx(below.p) +
          "). Price reaches for the nearer pool more often than the far one."
        : "There is no untouched stop pool on both sides, so there is no obvious side to lean.");
    invalid = "This read is wrong the moment price closes outside value &mdash; below <b>" +
      fmt(S.valP, LD.dp) + "</b> or above <b>" + fmt(S.vahP, LD.dp) +
      "</b>. Outside value the rotational logic stops applying and it becomes a trend read.";
  } else if (px > S.vahP){
    lean = "Above value &mdash; acceptance higher until " + fmt(S.vahP, LD.dp) + " fails";
    whyLead = "Price is trading <b>above</b> the value area, which means it is being accepted at " +
      "prices the window's volume never justified.";
    why = "That is either the start of a genuine move up or a thin overshoot. " +
      (above ? "The next untouched pool of buy stops is <b>" + fmt(above.p, LD.dp) + "</b> (" + xx(above.p) + "). " : "") +
      "The reference is value high at <b>" + fmt(S.vahP, LD.dp) + "</b>.";
    invalid = "Wrong if price trades back <b>below " + fmt(S.vahP, LD.dp) +
      "</b> and stays there &mdash; a failed move above value usually runs the whole way back to the point of control at <b>" +
      fmt(S.pocP, LD.dp) + "</b>.";
  } else {
    lean = "Below value &mdash; sellers hold it while " + fmt(S.valP, LD.dp) + " caps";
    whyLead = "Price is trading <b>below</b> the value area, which keeps the burden of proof " +
      "on buyers.";
    why = "Sellers are finding acceptance under the band where most volume traded. " +
      (below ? "The next untouched pool of sell stops is <b>" + fmt(below.p, LD.dp) + "</b> (" + xx(below.p) + "). " : "") +
      "Value low at <b>" + fmt(S.valP, LD.dp) + "</b> is the line that has to be reclaimed.";
    invalid = "Wrong if price reclaims <b>" + fmt(S.valP, LD.dp) +
      "</b> and holds above it &mdash; that puts it back inside value and the point of control at <b>" +
      fmt(S.pocP, LD.dp) + "</b> becomes the upside magnet instead.";
  }

  var call = el("div","liq-call");
  call.innerHTML = '<div class="liq-lean">'+lean+'</div>' +
    liqFold("liq-why", whyLead, why, "liq-w");
  host.appendChild(call);
  host.appendChild(el("div","invalid", "<b>What breaks it &mdash;</b> " + invalid));

  /* ---- stop pools ---- */
  host.appendChild(el("div","sectlabel","Where stops are likely resting &mdash; nearest first"));
  if (!pools.length){
    host.appendChild(el("div","rt-key","Every pool in the window has already been run. Nothing obvious left to reach for."));
  }
  pools.slice(0, 6).forEach(function(s){
    var d = s.p - px, bars = "", b;
    var strength = poolStrength(s.score);
    for (b = 1; b <= 3; b++) bars += '<i class="'+(b<=strength?"on":"")+'" style="height:'+(b*3+2)+'px"></i>';
    var row = el("div","liq-pool");
    /* poolAge already ends "&mdash; stale" past 24 hours, and the generator's why
       list carries its own "stale" tag on a different threshold. On four of six
       rows today that prints the word twice, two lines apart, which reads as two
       separate findings about the level rather than one. Drop it from the why
       list only when poolAge is about to say it anyway — under 24 hours the two
       are not making the same claim and the generator's tag is the only one
       there is, so filtering unconditionally would delete information. */
    var wy = s.why;
    if (s.age_h != null && s.age_h >= 24)
      wy = wy.filter(function(t){ return t !== "stale"; });
    /* Distance and the ATR multiple go on separate lines. On one line the cell
       wraps mid-token at 390px and breaks "0.4x 30m" across the break. */
    row.innerHTML =
      '<div><div class="pp">'+fmt(s.p, LD.dp)+'</div>'+
        '<div class="pd">'+(d>0?"+":"")+fmt(d, LD.dp)+'</div>'+
        (t30 ? '<div class="pd">'+xx(s.p)+'</div>' : '')+'</div>'+
      '<div class="pn"><b>'+poolWord(s.side)+'</b> this level<br>'+wy.join(" &middot; ")+
        (poolAge(s.age_h) ? '<br><span class="pmeta">'+poolAge(s.age_h)+'</span>' : '')+
        '<br><span class="pmeta">'+poolReach(t30 ? Math.abs(s.p - px)/t30 : null, clockAt(now),
                                             minsToReach(sym, now, Math.abs(s.p - px)))+'</span>'+
      '</div>'+
      '<div class="pw"><u>'+bars+'</u>'+["weak","fair","heavy"][strength-1]+'</div>';
    host.appendChild(row);
  });
  /* 260 words, 331px, and more than a third of everything this card showed. It
     is now a two-line lead over a fold, and what stayed out is chosen by one
     test: does the reader need it to DECODE THE ROWS DIRECTLY ABOVE. Two things
     pass. The first is that the pools are inferred, which is the caveat that
     stops a reader treating a heavy pool as a measured order book. The second is
     the session key, because "24 turns (12A+10EU+1RTH+1EV)" is unreadable
     without it and it sits three pixels below the last row that uses it.
     The key is also CORRECTED here. It read "<b>RTH</b> is the US cash session,
     <b>E</b> European hours, <b>A</b> Asian hours" -- but liquidity2.py emits
     RTH / EU / EV / A, so the legend named a token the rows never print and left
     the evening one undefined entirely. Anyone who read a row containing EV had
     nothing to look it up against.
     paceTxt leads the fold body rather than trailing it, because its first
     sentence is what the "x 30m" column means and that is the question opening
     this fold is most often being asked. */
  host.appendChild(el("div","rt-key", liqFold("liq-meth",
    "Stop pools are <b>inferred</b>, not measured. Turn counts are by session &mdash; " +
    "<b>RTH</b> US cash, <b>EU</b> European, <b>EV</b> evening, <b>A</b> Asian.",
    paceTxt(sym, now) +
    " Whether <i>today</i> is running at that pace is a separate question and the decision board answers it, by " +
    "checking the last hour's realised travel against what this session normally does. " +
    "There is no order-book or depth data in this feed &mdash; these are levels " +
    "obvious enough (repeated turns, session extremes, round numbers) that most desks would rest stops beyond them, " +
    "and price has not yet traded through them. The session split matters because a level turned six times in Asian trade " +
    "and one turned three times at the New York open are not the same level, however similar they look on a chart. " +
    "Treat a heavy pool as somewhere price is <i>drawn to</i>, not as a level that holds.")));

  drawLiqTable(sym, S, B, pools, LD, px);
  liqFoldWire();
}

function drawLiqTable(sym, S, B, pools, LD, px){
  var t = document.getElementById("liqTv");
  t.innerHTML = "";                                    /* idempotent */
  var L = LIQ[sym];
  var r = ['<thead><tr><th>Price</th><th>What it is</th><th>Dist</th><th>Age</th><th>Weight</th></tr></thead><tbody>'];
  var add = function(p, what, age, w){
    r.push('<tr><td>'+fmt(p, LD.dp)+'</td><td style="text-align:left;white-space:normal">'+what+
           '</td><td>'+((p-px)>0?"+":"")+fmt(p-px, LD.dp)+'</td><td>'+age+'</td><td>'+w+'</td></tr>');
  };
  add(S.vahP, "Value area high", "—", "—");
  add(S.pocP, "Point of control (busiest price)", "—", "—");
  add(S.valP, "Value area low", "—", "—");
  if (L && L.rth && lnum(L.rth.poc) != null){
    add(L.rth.vah, "Value area high — cash session only", "—", "—");
    add(L.rth.poc, "Point of control — cash session only", "—", "—");
    add(L.rth.val, "Value area low — cash session only", "—", "—");
  }
  pools.forEach(function(s){
    add(s.p, poolWord(s.side) + " — " + s.why.join(", "),
        (s.age_h == null ? "—" : (s.age_h < 24 ? Math.round(s.age_h) + "h" : (s.age_h/24).toFixed(1) + "d")),
        s.score);
  });
  r.push('</tbody>');
  t.innerHTML = r.join("");
}

(function buildLiqTabs(){
  var host = document.getElementById("liqTabs");
  host.innerHTML = "";                                 /* idempotent */
  Object.keys(LIQ).forEach(function(k){
    var b = el("button","tab", (LADDERS[k] && LADDERS[k].label) || k);
    b.type = "button"; b.setAttribute("role","tab");
    b.setAttribute("aria-selected", k === liqKey ? "true" : "false");
    b.onclick = function(){
      liqKey = k;
      Array.prototype.forEach.call(host.children, function(c){ c.setAttribute("aria-selected","false"); });
      b.setAttribute("aria-selected","true");
      drawLiq();
    };
    host.appendChild(b);
  });
})();

drawLiq();
/* Beside drawLiq's own first paint and not inside it: this card reads AVWAP and
   the live quote, and shares nothing with the profile but the tab idiom. */
drawAvwap();

document.getElementById("liqTvBtn").onclick = function(){
  var w = document.getElementById("liqTvWrap");
  var on = w.classList.toggle("on");
  this.textContent = on ? "Hide table view" : "Show table view";
};

/* ---- catalyst board ----
   Every value here derives from a supplied instant rather than an implicit
   "now", for the same reason the session clock does: the pre-render step has
   to be able to freeze the card at the snapshot time instead of baking a
   moment that is wrong by tomorrow.

   The one claim this card makes that the rest of the dashboard does not is a
   forward one — "this event can reach that level". It is built from one
   measured number and one judged number, and it says which is which on the
   card rather than blending them into a single confident figure. */
/* The live calendar when one has landed, otherwise the list baked at the last
   brief. Read through a function rather than captured in a variable, because the
   swap can happen at any moment between two of this card's own redraws. */
function catFuture(now){
  return (CATLIVE || CATALYSTS).filter(function(c){ return new Date(c.t).getTime() > now; });
}

/* Half-width of the blast radius, in points of the named contract. Returns null
   rather than a guess when either half is missing — a band drawn from a made-up
   typical move would look exactly as authoritative as a real one. */
/* Which half-hour is the event landing in? A 12:30Z print lands twenty minutes
   before the New York open and its first move happens in cash-session liquidity;
   a 01:00Z print lands in Asian hours. Measured on this archive the cash session
   moves roughly twice as far in the same thirty minutes, so drawing both bands
   against one all-hours median understates the one that matters and overstates
   the one that does not. RTH here is 13:30–20:00Z, and the pre-open half hour is
   folded in because that is where a 12:30Z number is actually traded. */
function catInRTH(c){
  var t = new Date(c.t).getTime();
  if (!isFinite(t)) return false;
  var d = new Date(t), h = d.getUTCHours() + d.getUTCMinutes()/60;
  return h >= 12.5 && h < 20;
}

function catReach(c){
  var m = MOVES[c.sym], x = lnum(c.x);
  if (!m || x == null || x <= 0) return null;
  var rth = catInRTH(c), t30 = rth ? (lnum(m.rth) || lnum(m.t30)) : lnum(m.t30);
  if (t30 == null || t30 <= 0) return null;
  return { r: t30 * x, t30: t30, est: m.src === "est",
           rth: rth && lnum(m.rth) != null };
}

function catCountdown(ms){
  var d = Math.floor(ms/86400000), h = Math.floor(ms%86400000/3600000),
      mi = Math.floor(ms%3600000/60000), s = Math.floor(ms%60000/1000);
  if (d > 0) return d + "d " + h + "h";
  if (h > 0) return h + "h " + String(mi).padStart(2,"0") + "m";
  return String(mi).padStart(2,"0") + "m " + String(s).padStart(2,"0") + "s";
}

/* Which stop pools sit inside the band, nearest first. HSI has no entry in LIQ
   — the relay banks ES and RTY bars only — so this returns an empty list and
   the caller says so out loud instead of drawing an empty band and implying
   there is nothing there. */
function catPools(c, px, r){
  if (!LIQ[c.sym] || px == null || r == null) return [];
  return liqPools(c.sym, px)
    .filter(function(p){ return Math.abs(p.p - px) <= r; })
    .sort(function(a,b){ return Math.abs(a.p - px) - Math.abs(b.p - px); });
}

function catVerdict(c, px, r, inBand, all, dp){
  if (px == null || r == null)
    return "No typical-move figure for " + c.sym + " yet, so there is no honest way to size this one.";
  if (!LIQ[c.sym])
    return "The relay banks five-minute bars for ES and RTY only, so there is no volume profile behind " +
           c.sym + " and no stop pools to reach. The band is the expected travel and nothing more.";
  if (!all.length)
    return "No stop pools survive on the " + c.sym + " map right now — price has already run the ones that were there. " +
           "A move of this size lands in open air, which is the condition where it keeps going rather than stalling.";
  if (!inBand.length){
    var n = all[0], d = Math.abs(n.p - px);
    return "Nothing in reach. The nearest pool is " + fmt(n.p, dp) + ", " + fmt(d, dp) +
           " away — this event would have to be about " + (d / r).toFixed(1) + "× bigger than " +
           (c.judged === false ? "the default band for its impact rating" : "expected") +
           " to get there. Treat it as a range event, not a breakout one.";
  }
  var w = inBand.map(function(p){
    return (p.side === "above" ? "buy stops at " : p.side === "below" ? "sell stops at " : "stops both sides of ") + fmt(p.p, dp);
  });
  /* The band for an unmatched release is a generic multiplier for its impact
     rating, so "a move of the expected size runs that pool" would be a default
     wearing the clothes of a call. The pools are still real and worth naming —
     the forecast about reaching them is what has to be withdrawn. */
  if (c.judged === false)
    return "Nearby: " + w.join(", ") + ". This release is not on my judged list, so the band around it is a " +
           "generic figure rather than a measured expectation for this event. Read that as “there is liquidity " +
           "close by”, not as a target — and size it off the level, not off the band.";
  return "In reach: " + w.join(", ") + ". A move of the expected size runs " +
         (inBand.length === 1 ? "that pool" : "those pools") +
         ", so the first push after the print has somewhere to accelerate into. " +
         "That is an argument for waiting out the initial spike, not for fading it.";
}

/* ---------------------------------------------------------------
   WHAT HAS LANDED — the other half of a catalyst board.

   A calendar that only looks forward is a list of things to be nervous about
   and never a record of whether the nervousness was warranted. This half reads
   the same events after the fact and asks two questions the forward half cannot:
   what did the result argue for, and what did the tape actually do.

   THE TWO HALVES COME FROM DIFFERENT PLACES ON PURPOSE.
     what the tape did  — MEASURED, in CATR, regenerated every refresh
     what it argued for — JUDGED, in CATJ's `arg`, written by hand and dated

   They are never mixed. A measurement that quietly absorbed a judgement would
   be a judgement wearing a measurement's authority, which is the failure this
   whole page is arranged against.

   AND THE VERDICT IS SCORED AGAINST A BASE RATE, NOT AGAINST ZERO. This tape
   rose in about two of every three windows of the length these reactions are
   measured over. "It went up after the print" is therefore almost no
   information; the percentile is the information, and a move smaller than three
   in four ordinary windows is reported as noise however neatly it points the
   right way.
   --------------------------------------------------------------- */

var LD_NOISE = 75;    /* percentile below which a move is not evidence */

function ldOk(){
  return typeof CATR !== "undefined" && CATR && CATR.ev && CATR.ev.length;
}

/* "7.359M" / "68K" / "54.5" / "0.3%" -> a number that can be compared with
   another from the SAME release. Never across releases: the units are the
   feed's own and this makes no attempt to normalise them, because a comparison
   between a percentage and a headcount is not a comparison. */
function ldNum(v){
  if (v == null || v === "") return null;
  var m = String(v).replace(/,/g, "").match(/^\s*([+-]?\d+(?:\.\d+)?)\s*([KMB])?/i);
  if (!m) return null;
  var x = parseFloat(m[1]), u = (m[2] || "").toUpperCase();
  if (!isFinite(x)) return null;
  return u === "K" ? x * 1e3 : u === "M" ? x * 1e6 : u === "B" ? x * 1e9 : x;
}

function ldSign(x){ return x > 0 ? 1 : x < 0 ? -1 : 0; }

/* Sentence-case a phrase written to be used mid-sentence. The provenance
   strings in CATACT are phrases on purpose -- "the release, as cited in this
   board's 5 Aug brief" reads correctly after "recovered from", and would read
   as a shout if it were stored capitalised and then quoted inline. */
function ldCap(t){ return t ? t.charAt(0).toUpperCase() + t.slice(1) : t; }

/* UTC epochs in, the page's Hong Kong clock out — the same rendering catHKT
   gives the forward half, so a landed row and an upcoming row read as one
   board rather than as two feeds that happen to share a card. */
function ldWhen(at){
  var d = new Date(at * 1000);
  if (!isFinite(d.getTime())) return "";
  return d.toLocaleDateString("en-GB", { timeZone:"Asia/Hong_Kong", day:"numeric", month:"short" }) +
         " " + d.toLocaleTimeString("en-GB", { timeZone:"Asia/Hong_Kong",
               hour:"2-digit", minute:"2-digit", hour12:false });
}

/* The curated actual outranks the derived one. A figure someone read off the
   release is a different object from one reconstructed out of next week's prior
   field, and where both exist the card should be quoting the first. */
function ldActual(e){
  var c = (typeof CATACT !== "undefined" && CATACT) ? CATACT[e.at] : null;
  if (c && c.a) return { a:c.a, src:c.src || "curated", f:c.f || "", curated:1 };
  if (e.a) return { a:e.a, src:"the following week&rsquo;s prior field", curated:0 };
  return null;
}

/* Everything the verdict needs, in one place, so the chip and the sentence and
   the disclosure cannot disagree about what this row concluded. */
function ldRead(e){
  var act = ldActual(e), arg = catArg(e.n),
      f = ldNum(e.f), a = act ? ldNum(act.a) : null,
      es = e.legs && e.legs.ES, m30 = es && es.m30,
      pct = (m30 && m30.base) ? m30.base.pct : null,
      moved = m30 ? ldSign(m30.d) : 0,
      surp = (a != null && f != null) ? ldSign(a - f) : null,
      argued = (surp != null && arg) ? surp * arg : 0,
      /* Is this a numeric release at all? A speech, a holiday, a "member speaks"
         — the relay carries them because they move the tape, and they have no
         forecast, no prior and no result, and never will. Everything this card
         says about a missing actual is FALSE about them, and it said all of it
         about a Trump speech: "the actual is missing", and a promise to recover
         it "a week later from the next occurrence's prior field". There is no
         figure to recover and no next occurrence with a prior field. A reader
         who came back a week later to look for it would have been looking for
         something that was never going to be there.

         The test is all three fields empty, not just the actual, because the
         absence of an EXPECTATION is what distinguishes the two cases. A
         release that is late is late with a forecast sitting beside it.

         A numeric release whose relay row is missing both expectation fields
         lands here too, and that is the right place for it: with no forecast
         and no prior there is nothing on this board to score its actual
         against when it does arrive, which the chain below would otherwise
         reach one branch later as "not comparable". Same answer, said sooner
         and without a week of waiting for a number that would not help. */
      num = !!(e.f || e.p || (act && act.a)),
      st, lab;

  if (!m30)                    { st = "wait";    lab = "reaction not in yet"; }
  else if (!act && !num)       { st = "none";    lab = "no figure to score"; }
  else if (!act)               { st = "none";    lab = "no actual yet"; }
  else if (f == null || a == null) { st = "none"; lab = "not comparable"; }
  else if (!arg)               { st = "none";    lab = "no direction to test"; }
  else if (surp === 0)         { st = "none";    lab = "in line"; }
  else if (pct == null || pct < LD_NOISE) { st = "noise"; lab = "inside noise"; }
  else if (moved === argued)   { st = "agree";   lab = "as argued"; }
  else                         { st = "against"; lab = "against"; }

  return { act:act, arg:arg, f:f, a:a, m30:m30, pct:pct, moved:moved,
           surp:surp, argued:argued, num:num, st:st, lab:lab };
}

/* The arm that did not join in. Same idea the cross-market card draws on
   swings: four contracts off one provider, and the interesting case is the one
   that refused. Here it is refusing a REACTION rather than a swing — the Dow
   sitting out a move the other three took is a breadth statement about the
   release, not about the Dow. Deliberately conservative: one arm under the
   median while two others clear p75, and nothing flagged otherwise. */
function ldOdd(e){
  var out = [], s, L, p, hi = 0, lo = null;
  for (s in e.legs){
    L = e.legs[s]; p = (L.m30 && L.m30.base) ? L.m30.base.pct : null;
    if (p == null) continue;
    out.push({ s:s, p:p, d:L.m30.d });
    if (p >= 75) hi++;
    if (p < 50 && (lo == null || p < lo.p)) lo = { s:s, p:p };
  }
  return { arms:out, odd:(hi >= 2 && lo) ? lo.s : null };
}

/* One row per arm: ticker, direction, a bar on a fixed 0-100 track, the figure.

   The bar is the whole point of this function now, and the thing that makes it
   legitimate is that a percentile is ALREADY on a common scale — nothing here
   is normalised, rescaled or fitted, so a bar half the track long means the
   fiftieth percentile on every row of every event on this card. That is the one
   property a strip like this has to have to be worth drawing, and it is why the
   cross-market card's raw point moves are not drawn this way.

   The width is clamped to 0-100 rather than trusted. base.pct comes out of the
   archive's own window sampling and should be a percentile, but a bar is the
   one element on this page that turns a bad number into a silently wrong
   PICTURE — 140% renders as a full bar and looks like a confident reading of
   the top of the range. Clamped, it is still a full bar, but the figure printed
   beside it says 140 and the two disagree where a reader can see it. */
function ldArmsHtml(e){
  var o = ldOdd(e), h = "", i, a, dir;
  if (!o.arms.length) return "";
  for (i = 0; i < o.arms.length; i++){
    a = o.arms[i];
    dir = a.d > 0 ? "up" : a.d < 0 ? "dn" : "";
    h += '<div class="ld-arm' + (o.odd === a.s ? " odd" : "") + '">' +
         '<span class="s">' + a.s + '</span>' +
         '<span class="d ' + dir + '">' +
         (a.d > 0 ? "▲" : a.d < 0 ? "▼" : "–") + '</span>' +
         '<span class="ld-trk" aria-hidden="true">' +
           '<span class="ld-fil ' + dir + '" style="width:' +
             Math.max(0, Math.min(100, a.p)) + '%"></span>' +
           '<span class="ld-ref" style="left:' + LD_NOISE + '%"></span>' +
         '</span>' +
         '<span class="pc">' + a.p + '</span></div>';
  }
  h = '<div class="ld-arms">' + h + '</div>';
  if (o.odd){
    var od = null, k;
    for (k = 0; k < o.arms.length; k++) if (o.arms[k].s === o.odd) od = o.arms[k];
    h += '<div class="ld-oddnote"><b>' + o.odd + ' did not join in</b> &mdash; its move was ' +
         'ordinary for the span (' + od.p + 'th percentile) while the others were not. ' +
         'A release the whole quartet takes is a different event from one that moves three of them.</div>';
  }
  return h;
}

/* The sentence outside the fold. It has to be the ANSWER — a reader who never
   opens the disclosure should still leave with the finding, not with a label
   for where the finding is kept. */
function ldLead(e, R){
  var m = R.m30, dir = m ? (m.d > 0 ? "up" : m.d < 0 ? "down" : "sideways") : "";
  if (!m)
    return 'It has landed and the reaction cannot be measured yet: the archive ' +
           'ends before the window this board reads closes. It fills itself in on the next refresh.';
  var mv = '<b>ES ' + (m.d > 0 ? "+" : "") + fmt(m.d, 2) + '</b> over the ' + m.span +
           ' minutes bracketing the print, bigger than <b>' + (m.base ? m.base.pct : "?") +
           '%</b> of windows that long';
  /* Both no-actual leads used to close with the same twenty-word sentence about
     nothing being scorable yet, printed once per row. Three rows carried it and
     the chip beside every one of them already said the same thing in three
     words. The mechanism now sits in the section intro, once, with a count; the
     chip carries the state; and the row is left with the one fact only it has,
     which is what the tape did. The speech keeps a closer because its reason is
     the opposite of the others' and the intro's sentence is not about it. */
  if (!R.act && !R.num)
    return 'The tape went ' + dir + ': ' + mv + '. Nothing here prints a number, ' +
           'so the move is the whole of what this row can say.';
  if (!R.act)
    return 'The tape went ' + dir + ': ' + mv + '.';
  if (!R.arg)
    return 'The tape went ' + dir + ': ' + mv + '. This board carries no view on which ' +
           'way a beat argues for this release, so the move is reported and not scored.';
  if (R.surp === 0)
    return 'It printed in line, so there was no surprise to react to. ' +
           'The tape still went ' + dir + ': ' + mv + '.';
  var argw = R.argued > 0 ? "up" : "down",
      sw = R.surp > 0 ? "beat" : "miss";
  if (R.st === "noise")
    return 'The ' + sw + ' argued <b>' + argw + '</b>, and the tape did not really argue back: ' +
           mv + ' &mdash; ordinary for the span. On this board a move that small is not evidence ' +
           'either way, whichever way it points.';
  if (R.st === "agree")
    return 'The ' + sw + ' argued <b>' + argw + '</b> and the tape went <b>' + dir + '</b>, hard: ' +
           mv + '.';
  return 'The ' + sw + ' argued <b>' + argw + '</b> and the tape went <b>' + dir + '</b> instead: ' +
         mv + '. Either the argument was wrong for this regime or something else owned the hour.';
}

function ldSurpHtml(e, R){
  /* Nothing at all for a non-numeric event. The old branch printed "Consensus
     was not published" for a speech, which is true in the way that "the speech
     did not have a temperature" is true: it states the absence of a thing the
     event never had, and it costs a line of the reader's screen to do it. */
  if (!R.act && !R.num) return "";
  /* Awaiting: the two numbers this row has and the state it is in, and not one
     word about the recovery mechanism — that is in the intro, said once. */
  if (!R.act){
    var bits = [];
    if (e.f) bits.push('Consensus <b>' + e.f + '</b>');
    if (e.p) bits.push('prior <b>' + e.p + '</b>');
    return '<div class="ld-none">' + (bits.length ? bits.join(", ") + ' &mdash; ' : "") +
           '<b>no actual yet</b>.</div>';
  }
  var word = R.surp > 0 ? "above" : R.surp < 0 ? "below" : "level with";
  /* Two sources disagreeing about what was expected is information. The board
     computes the surprise against the relay's field, because that is the field
     it computes everything else against, and names the other rather than
     quietly picking a winner. */
  var alt = "";
  if (R.act.f && e.f && R.act.f !== e.f)
    alt = ' <span style="color:var(--text-muted)">(this board cited <b>' + R.act.f +
          '</b> as consensus on the day; the relay&rsquo;s field now reads ' + e.f +
          ', which changes the size of the miss and not its direction)</span>';
  return '<div class="ld-surp"><b>' + R.act.a + '</b> against <b>' + (e.f || "?") + '</b> expected' +
         (e.p ? ', prior <b>' + e.p + '</b>' : '') + ' &mdash; ' + word + ' consensus.' + alt +
         (R.act.curated ? '' : ' <span style="color:var(--text-muted)">(recovered from the following week&rsquo;s prior, ' +
                               'which may be a revision rather than the figure that printed)</span>') +
         '</div>';
}

function ldBodyHtml(e, R){
  var h = "", m = R.m30, es = e.legs && e.legs.ES;

  h += '<p><b>Where the numbers come from.</b> The move is measured on the ' +
       'quote archive, and every timestamp in it has the provider delay taken ' +
       'out. A row labelled 12:18 carries an ES price that was true about ' +
       (CATR.delay && CATR.delay.ES ? Math.round(CATR.delay.ES / 60) : 10) +
       ' minutes earlier, so an event read off its row label would have its ' +
       'whole "reaction" measured before the print. That correction is the ' +
       'single thing this section depends on being right.</p>';

  if (m){
    h += '<p><b>The window is ' + m.span + ' minutes, not thirty.</b> The archive steps ' +
         'every six, so the last row before a print can be a step early and the ' +
         'first row past the half-hour a step late. Rather than pretend to a ' +
         'round number, the base rate below is computed at the span actually ' +
         'measured &mdash; a longer window compared against a thirty-minute yardstick ' +
         'would flatter every reaction on this board.</p>';

    h += '<table class="disc-tbl"><tr><th>&nbsp;</th><th>30m</th><th>vs typical</th>' +
         '<th>pct</th><th>2h</th><th>pct</th></tr>';
    var s, L;
    for (s in e.legs){
      L = e.legs[s];
      h += '<tr><td>' + s + '</td>' +
           '<td>' + (L.m30 ? (L.m30.d > 0 ? "+" : "") + fmt(L.m30.d, 2) : "&ndash;") + '</td>' +
           /* Magnitude only. The column to the left already carries the sign, and
              a move stated as "-1.73x typical" invites the reading that the move
              was negative-relative-to-typical rather than downward-and-1.73x. */
           '<td>' + (L.m30 && L.m30.typ != null ? Math.abs(L.m30.typ).toFixed(2) + "×" : "&ndash;") + '</td>' +
           '<td>' + (L.m30 && L.m30.base ? L.m30.base.pct : "&ndash;") + '</td>' +
           '<td>' + (L.h2 ? (L.h2.d > 0 ? "+" : "") + fmt(L.h2.d, 2) : "&ndash;") + '</td>' +
           '<td>' + (L.h2 && L.h2.base ? L.h2.base.pct : "&ndash;") + '</td></tr>';
    }
    h += '</table>';

    if (es && es.m30 && es.m30.base)
      h += '<p><b>Read the percentile, not the direction.</b> Over this archive ES ' +
           'rose in <b>' + es.m30.base.upsh + '%</b> of all ' + m.span + '-minute windows ' +
           '&mdash; so "it went up after the print" is close to no information at all. The ' +
           'percentile is what carries the claim: it says where this move sits among the ' +
           '<b>' + es.m30.base.n + '</b> ordinary windows of the same length, whose median ' +
           'move was <b>' + fmt(es.m30.base.med, 2) + '</b>. Anything under the ' + LD_NOISE +
           'th is reported as noise here however tidily it points the right way.</p>';

    if (es && es.h2)
      h += '<p><b>The two-hour column is not attribution.</b> At two hours the release ' +
           'is one of many things that happened, and this board has no way to separate ' +
           'them. It is there because a reaction that is given straight back is a ' +
           'different event from one that holds &mdash; not because the release owns it.</p>';
  }

  h += '<p><b>Which way a beat argues is a judgement, and it is dated.</b> ' +
       (R.arg ? 'This release is marked <b>' + (R.arg < 0 ? "hawkish" : "cyclical") + '</b>: an actual ' +
                'above consensus argues the index <b>' + (R.arg < 0 ? "down" : "up") + '</b>. '
              : 'This release carries no mark, so nothing here is scored. ') +
       'That mapping rests on the regime this tape is in &mdash; pricing a hike rather than ' +
       'a cut &mdash; and it would flip with the regime. It is also <b>first order only</b>: ' +
       'mild labour weakness is rate relief and severe labour weakness is a growth scare, ' +
       'and they point opposite ways, so a monotone sign is wrong in the tails by ' +
       'construction. A row scored <i>against</i> is as likely to be this map failing as ' +
       'the market misbehaving.</p>';

  if (R.act)
    h += '<p><b>Where the actual came from.</b> ' + ldCap(R.act.src) + '. The relay publishes no ' +
         'result field, so every figure on this half of the board arrives by one of two ' +
         'routes and the card names which. A number recovered from a later prior may be a ' +
         'revision rather than what printed on the day, which is a different quantity from ' +
         'the one the market traded.</p>';

  return h;
}

function drawLanded(host, now){
  if (!host || !ldOk()) return;
  var evs = CATR.ev.slice().sort(function(a, b){ return b.at - a.at; });
  if (!evs.length) return;

  /* Read every event ONCE, here, and hand the same objects to the intro and to
     the rows. The intro below states a count of what is in the list underneath
     it, and a count computed from a second pass is a count that can disagree
     with the thing it describes. Nothing on this page would catch that: both
     halves would be internally consistent and the reader would be the only
     check. Same lesson the scorecard's fold summary was built around. */
  var reads = evs.map(ldRead);
  var awaiting = reads.filter(function(R){ return !R.act && R.num; }).length,
      one = awaiting === 1;

  host.appendChild(el("div", "sectlabel", "What has landed"));

  var intro = el("div", "ld-none");
  intro.innerHTML = 'Scheduled events that have already printed, newest first, with what ' +
    'the tape did afterwards measured against every ordinary window of the same length. ' +
    '<b>Green means the tape agreed with what the result argued for</b> &mdash; never that it ' +
    /* Eight words, said once, for twenty bars. The strip under each row is on a
       fixed 0-100 scale and nothing else on the card says what its length is,
       so without this the bars are a texture; with it they are a reading. */
    'went up. Direction is the arrow; the bar is how unusual the move was.' +
    /* Said once, here, instead of once per row. Three of four rows carried this
       mechanism verbatim — thirty-five identical words apiece, about two hundred
       pixels of a card that was the longest on the page. It is genuine context
       and it is worth its space exactly once; what it was not worth was being
       re-read three times by someone scrolling for the one number that differs.
       The count is what makes a single statement work: without it the reader
       cannot tell which rows it is about, and with it they can, because the
       rows say "no actual yet" and there are this many of them. */
    (awaiting ? ' <b>' + awaiting + ' of the ' + evs.length + ' below ' + (one ? 'is' : 'are') +
      ' still waiting on ' + (one ? 'its' : 'their') + ' actual.</b>' : '');
  host.appendChild(intro);

  /* And the mechanism itself goes under a fold, which is a second and smaller
     version of the same argument. Deduplicating it from three rows to one place
     was the change that mattered; what stayed behind was forty-one words of
     PROCEDURE sitting between the reader and the rows, above the fold, on every
     load, forever. The count belongs outside — it is the finding, it is specific
     to today, and it is what tells a reader which rows the chips are about. How
     the number eventually gets filled in is worth reading once, when you first
     wonder, and never again.

     The split is a CUT, not a rewrite. The sentences below are the ones that
     were in the paragraph, moved, so there is nothing here that can drift away
     from what it used to say. landtest asserts both halves of that: the
     mechanism appears exactly once in textContent, which is losslessness, and
     zero times in innerText, which is the fold actually being closed. Getting
     those two the wrong way round is how a losslessness check passes on a card
     that has lost something. */
  if (awaiting){
    var mech = document.createElement("details");
    mech.className = "disc";
    mech.innerHTML = '<summary><span>How a missing actual gets filled in</span></summary>' +
      '<div class="disc-body"><p>The relay&rsquo;s calendar carries a forecast and a prior and ' +
      'no result, so this page recovers ' + (one ? 'it' : 'them') + ' a week later from the next ' +
      'occurrence&rsquo;s prior field, or sooner by hand. Until then ' +
      (one ? 'that row reports' : 'those rows report') + ' the move and score' + (one ? 's' : '') +
      ' nothing.</p></div>';
    host.appendChild(mech);
  }

  var wrap = el("div", "ld-wrap");
  /* Three releases can share one clock minute -- payrolls day ships the
     headline, average earnings and the unemployment rate in a single 12:30Z
     print. The tape moved ONCE, so the measured reaction is the same object
     under every name, and repeating it verbatim reads as three independent
     95th-percentile moves: evidence triple-counted by layout. The move is
     stated in full under the cluster's first row; the rows beneath name the
     cluster and point up, each worded with its own ordinal so no two rows
     print the same paragraph -- the duplicate-paragraph check treats a
     verbatim repeat inside one card as the defect it is. */
  var clusterAt = null, clusterHead = null, clusterLead = null, clusterN = 0;
  var ORD = ["second", "third", "fourth", "fifth", "sixth"];
  evs.forEach(function(e, i){
    var R = reads[i], row = el("div", "ld-row");
    var top = el("div", "ld-top");
    top.innerHTML = '<div class="ld-nm">' + e.n + '</div>' +
                    '<div class="ld-when">' + ldWhen(e.at) + '</div>';
    row.appendChild(top);

    var chip = el("div");
    chip.innerHTML = '<span class="ld-chip ' + R.st + '">' + R.lab + '</span>';
    row.appendChild(chip);

    var lead = ldLead(e, R);
    if (e.at === clusterAt && lead === clusterLead){
      clusterN += 1;
      lead = 'The ' + (ORD[clusterN - 2] || (clusterN + "th")) + ' release of a simultaneous ' +
        'print cluster: it landed and the reaction &mdash; one tape move for the whole ' +
        'cluster &mdash; is measured once, under <b>' + clusterHead + '</b> above.';
    } else {
      clusterAt = e.at; clusterHead = e.n; clusterLead = lead; clusterN = 1;
    }
    row.appendChild(el("div", "ld-lead", lead));
    /* ldSurpHtml returns "" for an event that has no figure attached, and an
       empty wrapper appended anyway is a zero-height div today and a stray
       eight-pixel gap the first time anything in this card gets a margin. */
    var sh = ldSurpHtml(e, R);
    if (sh){
      var sp = document.createElement("div");
      sp.innerHTML = sh;
      row.appendChild(sp);
    }

    /* Same guard as the surprise line above, and for the same reason. m30 says
       ES has a measured window; it does not say any leg came back with a
       percentile, and ldArmsHtml returns "" when none did. Appending the
       wrapper regardless left an empty div in the row — invisible today,
       an eight-pixel gap the first time this card grows a margin. */
    var ah = R.m30 ? ldArmsHtml(e) : "";
    if (ah){
      var arms = document.createElement("div");
      arms.innerHTML = ah;
      row.appendChild(arms);
    }

    var d = document.createElement("details");
    d.className = "disc";
    d.innerHTML = '<summary><span>How this was measured, and what it cannot say</span></summary>' +
                  '<div class="disc-body">' + ldBodyHtml(e, R) + '</div>';
    row.appendChild(d);
    wrap.appendChild(row);
  });
  host.appendChild(wrap);
}

/* Split a news entry's working into the sentence that answers it and the rest.

   Every one of these entries opens with its numbers -- the percentages, the
   closing levels, the print -- and then spends a paragraph arguing about them.
   That first sentence is what a reader needs to have seen even if they read
   nothing else, so it stays above the fold and the argument goes below.

   The split is on a full stop followed by whitespace, which does not fire
   inside "81.51" or "4.28%" because a decimal point has no space after it. It
   is suppressed after a token short enough to be an initialism, so "U.S. jobs"
   stays whole. If the first sentence is very short the next is pulled up with
   it -- "Down from 17.09." is true but it is not yet an answer.

   The failure mode is benign in both directions: a missed split leaves a long
   lead, an over-eager one leaves a short one, and neither loses a word. */
var NEWS_LEAD_MIN = 70;   /* characters below which the lead takes another sentence */
var NEWS_ABBR = /(?:^|\s)(?:[A-Z]|U\.?S|Mr|Mrs|Dr|St|No|vs|approx|Inc|Ltd|Co|Jr|Sr|Fig|est)$/i;

function newsSplit(w){
  if (!w) return { lead:"", rest:"" };
  var cuts = [], re = /\.\s+/g, m;
  while ((m = re.exec(w))){
    if (!NEWS_ABBR.test(w.slice(0, m.index))) cuts.push(m.index + 1);
  }
  if (!cuts.length) return { lead:w, rest:"" };
  var at = cuts[0], k = 0;
  /* A short first sentence is only thin if it is prose. "SPX +0.698%, NDX
     +0.593%, RUT -0.522%." is a complete reading of the session and stands on
     its own at thirty-eight characters, while "Down from 17.09." does not.
     Three or more numbers is the test, and it is deliberately blunt: getting it
     wrong costs a reader one extra sentence above the fold, in a section whose
     previous state was the entire paragraph. */
  var first = w.slice(0, at), nums = first.match(/-?[\d][\d,.]*%?/g);
  if (!(nums && nums.length >= 3))
    while (at < NEWS_LEAD_MIN && k + 1 < cuts.length) at = cuts[++k];
  /* Never fold away almost nothing: if what is left would be a sentence or two,
     the fold costs the reader a tap to save them four lines and is not worth it. */
  var rest = w.slice(at).replace(/^\s+/, "");
  if (rest.length < 90) return { lead:w, rest:"" };
  return { lead:w.slice(0, at), rest:rest };
}

/* Which event rows have their "why" note open, keyed by name+timestamp. Declared
   out here on purpose: drawCat rebuilds every row on every poll, so a flag living
   inside it is a flag that resets every poll. See the note at the fold below. */
var catFoldOpen = {};

/* The same flag for the dollar card's hand-written half, keyed by entry title.
   Out here for the same reason and one worse one: FXN is a STATIC object, so the
   yen block's HTML is byte-identical on every paint and it is easy to convince
   yourself it is not repainted. It is — paintFX rewrites it on every tick along
   with everything else on that card, and a flag living inside paintFX would drop
   the reader's open entry at the next quote. */
var fxFoldOpen = {};

function drawCat(atMs){
  var host = document.getElementById("catBody");
  if (!host) return;
  host.innerHTML = window.genStamp('CATR', typeof CATR !== 'undefined' ? CATR : null, atMs);  /* idempotent */
  var now = atMs, up = catFuture(now);

  /* --- the quiet-window header. The gap to the next event that can actually
     move something is a different fact from the gap to the next event. --- */
  var hd = el("div","cat-hd");
  var big = null, i;
  for (i = 0; i < up.length; i++){ if (up[i].imp >= 3){ big = up[i]; break; } }
  if (!up.length){
    hd.innerHTML = '<div class="ch-lab">Calendar</div>' +
      '<div class="ch-fig">Nothing scheduled</div>' +
      '<div class="ch-note">Every catalyst on this board has passed. ' +
      (CATLIVE ? 'The relay publishes a rolling week, so this is a genuinely empty stretch rather than a list that ran out. '
               : 'This page has not reached the calendar feed, so it is showing the list baked in at the last brief — which has now run out. Open it in a browser and it refills itself. ') +
      'Treat moves as flow rather than news.</div>';
  } else {
    var gap = new Date((big || up[0]).t).getTime() - now;
    var hrs = gap / 3600000;
    var posture = hrs < 0.5
      ? "You are inside the window. Position size, not conviction, is the thing to be adjusting."
      : hrs < 3
      ? "Close enough that a level breaking now is as likely to be positioning as it is to be a decision. Breaks in this window get retested."
      : hrs < 10
      ? "Enough room for a range to form and be traded on its own terms before anything decides it."
      : "A long quiet stretch. This is where the volume profile earns its keep — with no catalyst to break it, price tends to rotate back to the point of control.";
    /* The headline tracks the next event that can MOVE something, which is not
       always the next event. When a smaller one fires first and fires soon, the
       posture line has to say so out loud — otherwise the card reads "1h 30m"
       while something goes off in thirty seconds. */
    var sgap = up[0] === big ? null : new Date(up[0].t).getTime() - now;
    var soon = (big && sgap != null && gap - sgap > 900000) ? up[0] : null;
    if (soon) posture += ' Before that, <b>' + soon.n + '</b> lands in ' +
      catCountdown(sgap) + ' — smaller, but it is the one that moves first.';
    hd.innerHTML = '<div class="ch-lab">' + (big ? "Next event that can move it" : "Next on the calendar") + '</div>' +
      '<div class="ch-fig">' + catCountdown(gap) + ' · ' + (big || up[0]).n + '</div>' +
      '<div class="ch-note">' + posture + '</div>';
  }
  host.appendChild(hd);

  /* --- the next three, in detail. The rest live in the table view: four
     countdowns on one phone screen is a list, not a board. --- */
  up.slice(0, 3).forEach(function(c){
    var LD = LADDERS[c.sym] || { dp:2, label:c.sym };
    var dp = LD.dp, ms = new Date(c.t).getTime() - now;
    var row = el("div","cat-row");

    /* Own loop counter, not the outer `i` — the two never overlap today, but a
       shared counter across a closure is the kind of thing that only breaks
       later, when someone adds a second loop above. */
    var bars = "", k;
    for (k = 1; k <= 3; k++) bars += '<i class="' + (k <= c.imp ? "on" : "") + '" style="height:' + (k*3+2) + 'px"></i>';

    var top = el("div","cat-top");
    top.innerHTML =
      '<div><div class="cat-nm"><span class="cat-imp">' + bars + '</span>' + c.n + '</div>' +
        '<div class="cat-when">' + c.h + ' · ' + LD.label + '</div></div>' +
      '<div class="cat-cd' + (ms < 3600000 ? " imminent" : "") + '" data-t="' + c.t + '">' +
        catCountdown(ms) + '<span>to go</span></div>';
    row.appendChild(top);

    /* READING ORDER, changed 6 Aug, and the change is the whole point.
       The row used to open with c.why — fifty-odd words on why this release is
       worth a band at all — and only then draw the band, the verdict and the
       tails. That is the methodology in front of the finding, three times over on
       one card, and it is exactly what "the dashboard is still very word heavy"
       means in practice. The card's own subtitle promises "what is coming, and
       whether it can reach anything that matters"; the reader had to walk past a
       paragraph to reach the second half of that sentence.
       Now: WHAT it is, WHETHER it reaches, WHICH WAY, and then WHY — folded.
       Nothing is deleted. The fold's summary carries the consensus and the last
       print, because two numbers are the whole reason a release is a binary
       rather than a headline and they belong above any fold. */
    var px = liqPx(c.sym), R = catReach(c), howHtml = "";
    if (px != null && R){
      var r = R.r, pools = LIQ[c.sym] ? liqPools(c.sym, px) : [];
      var inB = pools.filter(function(p){ return Math.abs(p.p - px) <= r; });

      var band = el("div","cat-band");
      var pct = function(p){ return Math.max(0, Math.min(100, (p - (px - r)) / (2*r) * 100)); };
      var h = '<div class="cat-axis"></div>' +
              '<div class="cat-now" style="left:50%"></div>' +
              '<div class="cat-nowl" style="left:50%">' + fmt(px, dp) + '</div>' +
              '<div class="cat-edge">' + fmt(px - r, dp) + '</div>' +
              '<div class="cat-edge r">' + fmt(px + r, dp) + '</div>';
      /* Only the reachable half of each side is painted accent — the axis
         itself is the full number line and stays muted. */
      inB.forEach(function(p, k){
        var L = pct(p.p);
        h += '<div class="cat-pool hit" style="left:' + L.toFixed(2) + '%"></div>' +
             '<div class="cat-pl hit' + (k % 2 ? " lo" : "") + '" style="left:' + L.toFixed(2) + '%">' + fmt(p.p, dp) + '</div>';
      });
      band.innerHTML = h;
      row.appendChild(band);

      var v = el("div","cat-verdict");
      v.innerHTML = '<u>' + catVerdict(c, px, r, inB, pools, dp) + '</u>';
      row.appendChild(v);

      /* Built here, where the numbers are, and rendered below inside the fold.
         It is a statement about how the band was computed, not about the band —
         the honest caveat that half of it is measured and half is my judgement.
         It has to stay attached to the band it describes, so it is the first
         thing inside the fold rather than the last. */
      howHtml = '<div class="cat-how">±' + fmt(r, dp) + ' = ' + fmt(R.t30, dp) + ' measured 30m range' +
        (R.rth ? ' <b>in the cash session</b>, which is where this lands' : ' across all hours') + ' × ' + c.x +
        (c.judged === false ? ' <b>default</b> for its impact rating — not a judgement about this release'
                            : ' judged for this event') +
        (R.est ? ' · the 30m figure for ' + c.sym + ' is estimated, not measured from bars' : '') + '</div>';
    }

    /* --- the two branches of a binary, and the one thing this card kept getting
       backwards. "Upside tail" and "Downside tail" name the SURPRISE — a hot
       print and a soft one — and every reader on a phone screen reads them as
       the PRICE. On the payrolls row they are exactly inverted: the "upside"
       branch is the one that sends RTY through the hollow to 2,996.9, and the
       "downside" branch is the only print all week that lets small caps lead.

       The landed half of this same card already fixed this class of mis-read,
       with a sentence — "Green means the tape agreed with what the result
       argued for, never that it went up. Direction is the arrow." The forward
       half never got it, and prose could not fix it here anyway, because the
       fault is in the label rather than beside it.

       So a branch now names its CONDITION in the author's words and carries the
       price direction as its own mark. Two axes, two elements, instead of one
       adjective doing both jobs and losing.

       THE DIRECTION IS AUTHORED BESIDE THE PROSE AND NEVER DERIVED FROM catArg.
       Deriving it was the first design and a probe killed it before a line was
       written. catArg returns 0 for "Non-Farm Payrolls · 85K f, 57K p" — the
       judged table matches "Non-Farm Employment Change" and the baked name says
       Payrolls — so the week's biggest event would have rendered with no mark at
       all. And it returns +1 for Unemployment Claims, whose own hot branch
       argues the index DOWN; a derived arrow would have pointed up, directly
       above prose saying the opposite, and it would have rendered perfectly.
       catArg is a first-order regime map and these strings are about the tails,
       where the page's own fold says "a monotone sign is wrong by construction".
       They are ALLOWED to disagree. whytest pins the one place they do, so a
       second divergence has to be looked at rather than absorbed.

       Folded, because the condition and the direction are the whole of what a
       reader scrolling for a re-entry needs, and the paragraph under each is
       the working. Two summary lines in place of two paragraphs. --- */
    if (c.hot || c.cold){
      var brs = el("div", "cat-brs"), bk = c.n + "|" + c.t;
      [["hot", c.hot, c.hotL, c.hotD], ["cold", c.cold, c.coldL, c.coldD]].forEach(function(B){
        if (!B[1]) return;
        var dir = B[3],
            /* Three marks, three meanings, and the third is a real answer and
               not a gap. "The labour market is still tight, so the long end has
               no relief coming" takes an upside catalyst away without arguing
               the index down; a dash says that and an arrow would invent it. */
            mark = dir < 0 ? "↓" : dir > 0 ? "↑" : "–",
            cls  = dir < 0 ? "dn" : dir > 0 ? "up" : "nx",
            outc = dir < 0 ? LD.label + " down" : dir > 0 ? LD.label + " up" : "neither way",
            /* The fallback is the old wording, so a branch authored without a
               label is never blank — and whytest fails on exactly this, so the
               fallback is a floor the shipped data never stands on. */
            lab  = B[2] || (B[0] === "hot" ? "The upside surprise" : "The downside surprise"),
            key  = bk + "|" + B[0],
            d    = el("details", "fwork cat-br");
        if (catFoldOpen[key]) d.open = true;
        d.innerHTML = '<summary><span class="br-dir ' + cls + '">' + mark + '</span>' +
          '<span class="br-if">' + lab + '</span>' +
          '<span class="br-out ' + cls + '">' + outc + '</span></summary>' +
          '<div class="fwork-b br-b">' + B[1] + '</div>';
        /* Keyed to the EVENT and the branch, never to the loop index: the list
           shifts up the moment an event passes, and an index-keyed flag would
           move the reader's open branch onto a different release. toggle does
           not bubble, so this is a listener per element. */
        d.addEventListener("toggle", (function(k, node){
          return function(){ catFoldOpen[k] = node.open; };
        })(key, d));
        brs.appendChild(d);
      });
      row.appendChild(brs);
    }

    var fpHtml = (c.f || c.p)
      ? '<span style="color:var(--text-muted)">' +
        (c.f ? 'Consensus <b style="color:var(--text-secondary)">' + c.f + '</b>' : '') +
        (c.f && c.p ? ' · ' : '') +
        (c.p ? 'last <b style="color:var(--text-secondary)">' + c.p + '</b>' : '') + '</span>'
      : '';

    if (c.why || howHtml){
      /* The open flag lives OUTSIDE this function and is keyed to the EVENT, not
         to the row's position. drawCat repaints on every poll and rebuilds these
         rows from nothing; a flag declared in here would shut the disclosure
         under the reader about once a minute, which this page has already shipped
         once as ladDiscOpen. Keyed to name+timestamp rather than to the loop
         index because the index moves the moment an event passes and the list
         shifts up — at which point the reader's open note would jump to a
         different release without either of them touching anything. */
      var key = c.n + "|" + c.t;
      var d = el("details", "fwork cat-fold");
      if (catFoldOpen[key]) d.open = true;
      /* fpHtml alone, with no placeholder behind it. The marker on this summary
         already names what is inside — a release with no published consensus was
         rendering "How this one is judged ▸ why this one matters", two labels for
         one fold, in two colours, saying the same thing in different words. An
         empty summary is not a bare one: the marker is its label, exactly as on
         the card intro's "▸ how it's built". */
      d.innerHTML = '<summary>' + fpHtml + '</summary>' +
        '<div class="fwork-b">' + (c.why ? '<div class="cat-whyb">' + c.why + '</div>' : '') + howHtml + '</div>';
      /* toggle does NOT bubble, so there is no delegating this from the host. */
      d.addEventListener("toggle", (function(k, node){
        return function(){ catFoldOpen[k] = node.open; };
      })(key, d));
      row.appendChild(d);
    } else if (fpHtml) {
      row.appendChild(el("div","cat-why", fpHtml));
    }
    host.appendChild(row);
  });

  /* The landed board sits between the two, and that is the reading order the
     card is for: what is coming, then what came and what the tape did with it,
     then the stories that are not on any calendar. Its own failures are
     contained -- drawLanded returns at the door if CATR is missing or empty,
     which is what a page built before catgen.py ran looks like. */
  drawLanded(host, now);

  /* --- headlines ---
     Renamed. "What has already landed" now belongs to the board above, which
     is about scheduled releases with a forecast to be judged against. These are
     headlines: unscheduled, unforecast, and nothing to score. Two sections
     called the same thing is a worse fault than either name being imperfect. */
  if (NEWS.length){
    host.appendChild(el("div","sectlabel","Stories behind the tone"));
    NEWS.forEach(function(n){
      var age = (now - new Date(n.t).getTime()) / 3600000;
      var d = el("div","cat-news");
      var W = newsSplit(n.w);
      d.innerHTML = '<div class="nh">' + n.h + '</div>' +
        '<div class="nm2">' + n.s + ' · ' +
        (age < 1 ? "under an hour ago" : age < 48 ? Math.round(age) + "h ago" : Math.round(age/24) + "d ago") + '</div>' +
        '<div class="nw">' + W.lead + '</div>' +
        (W.rest ? '<details class="disc"><summary><span>The working</span></summary>' +
                  '<div class="disc-body"><p>' + W.rest + '</p></div></details>' : '');
      host.appendChild(d);
    });
  }

  drawCatTable(now);
}

/* Everything on the calendar, including what the three-row view drops. */
function drawCatTable(now){
  var t = document.getElementById("catTv");
  if (!t) return;
  var rows = '<thead><tr><th>When (HKT)</th><th>Event</th><th>Hits</th><th>Impact</th><th>Band</th><th>In reach</th></tr></thead><tbody>';
  catFuture(now).forEach(function(c){
    var LD = LADDERS[c.sym] || { dp:2, label:c.sym };
    var px = liqPx(c.sym), R = catReach(c);
    var band = "—", reach = "—";
    if (px != null && R){
      band = "±" + fmt(R.r, LD.dp);
      var inB = LIQ[c.sym] ? liqPools(c.sym, px).filter(function(p){ return Math.abs(p.p - px) <= R.r; }) : [];
      reach = LIQ[c.sym] ? (inB.length ? inB.map(function(p){ return fmt(p.p, LD.dp); }).join(", ") : "none")
                         : "no profile";
    }
    rows += '<tr><td>' + c.h + '</td><td>' + c.n +
            (c.judged === false ? ' <span class="dim">(default band)</span>' : '') +
            '</td><td>' + LD.label + '</td><td>' +
            (["low","medium","high"][c.imp-1] || "medium") + '</td><td>' + band + '</td><td>' + reach + '</td></tr>';
  });
  t.innerHTML = rows + '</tbody>';
}

/* The countdowns want a second's resolution; nothing else on the card does.
   Rebuilding the whole card every second to move three digits would also throw
   away any text the reader had selected mid-sentence, so the fast path touches
   only the countdown nodes and leaves the rest of the DOM alone. */
function tickCat(atMs){
  var ns = document.querySelectorAll("#catBody .cat-cd"), i;
  for (i = 0; i < ns.length; i++){
    var t = ns[i].getAttribute("data-t");
    if (!t) continue;
    var ms = new Date(t).getTime() - atMs;
    if (ms <= 0){ drawCat(atMs); return; }        /* an event just passed — restructure */
    ns[i].firstChild.nodeValue = catCountdown(ms);
    ns[i].className = "cat-cd" + (ms < 3600000 ? " imminent" : "");
  }
}

drawCat(Date.now());

document.getElementById("catTvBtn").onclick = function(){
  var w = document.getElementById("catTvWrap");
  var on = w.classList.toggle("on");
  this.textContent = on ? "Hide table view" : "Show table view";
};

/* Same contract as paintSession: the pre-render step has to be able to freeze
   this card at the snapshot instant rather than at build time. */
window.__wf.drawCat = drawCat;
/* A test seam, not a feature. The whole page lives inside one IIFE, so there is
   otherwise no way to ask from outside whether the live calendar actually
   replaced the baked one — and "did the handover happen" is exactly the thing
   worth asserting. Read-only: it hands back a copy of the count, not the list. */
window.__wf.catState = function(){
  return { live: !!CATLIVE, n: CATLIVE ? CATLIVE.length : 0,
           unjudged: (CATLIVE || []).filter(function(c){ return c.judged === false; }).length };
};

setInterval(function(){ tickCat(Date.now()); }, 1000);
/* The header's posture line and the blast radii change slowly. A full rebuild a
   minute keeps them honest without the cost of doing it every second. */
setInterval(function(){ drawCat(Date.now()); }, 60000);

/* ---- decision board -----------------------------------------------------
   The liquidity map answers "where are the levels". The catalyst board answers
   "what is scheduled". Neither answers the question that decides whether a
   level is tradeable today, which is the join of the two:

       can price even GET there before the next event fires?

   A pool six hours out is not a trade on current flow. It is a bet on whatever
   lands first. Same price, same distance, completely different position — and
   until this card existed nothing on the page said so.

   Two things this card deliberately does NOT do. It does not predict
   direction: every time here is "when the level enters normal travelling
   range", never "when price arrives". A level can sit in reach all day and
   never trade. And it does not blend the measured half into the judged half —
   the walk is measured off bars, the event bands are judged per release, and
   each row says which is which rather than presenting one confident number. */

/* Every level worth a row, with the structural ones folded into a nearby pool
   instead of printed twice. A value-area high sitting four points from a stop
   cluster is one decision, not two, and two rows would double-count it in a
   list whose whole job is ordering. */
function decLevels(sym, px){
  var L = LIQ[sym];
  if (!L || px == null) return [];
  var out = liqPools(sym, px).slice(0, 6).map(function(s){
    return { p:s.p, kind:"pool", side:s.side, score:s.score,
             why:s.why || [], age_h:s.age_h, tags:[] };
  });
  var B = liqBins(sym), S = B && liqStats(B), merge = L.bw * 2;
  var add = function(p, tag){
    if (p == null || !isFinite(p)) return;
    var i;
    for (i = 0; i < out.length; i++){
      if (Math.abs(out[i].p - p) <= merge){
        if (out[i].tags.indexOf(tag) < 0) out[i].tags.push(tag);
        return;
      }
    }
    out.push({ p:p, kind:"struct", side:null, score:null, why:[], age_h:null, tags:[tag] });
  };
  if (S){
    add(S.vahP, "value high");
    add(S.pocP, "point of control");
    add(S.valP, "value low");
    /* The cash-session point of control only earns its own mention when it is
       somewhere else. When the two agree, saying it twice implies a second
       level that does not exist. */
    if (L.rth && lnum(L.rth.poc) != null && Math.abs(L.rth.poc - S.pocP) >= L.bw)
      add(L.rth.poc, "cash-session point of control");
  }
  return out;
}

/* Ordered by WHEN, not by how far. That single change is the card. The
   liquidity map sorts by distance because it is answering "what is near"; this
   sorts by time because it is answering "what is next", and on a contract that
   travels four times faster in the cash session than overnight those two lists
   are not the same list. */
var decFoldOpen = {};

/* The rail. Everything it draws comes from the same `all` array the rows below
   are built from and from catFuture, so it cannot say anything the card does
   not already say somewhere else in words.

   nowMs is passed in and never read off the clock. This whole card is repainted
   through repaintAt at a chosen instant by three suites, and a painter that
   reaches for Date.now() renders a different picture than the one the rows
   underneath it describe. */
function decRail(all, syms, nowMs){
  var near = all.filter(function(r){ return r.mins != null; });
  if (!near.length) return null;                 /* an empty axis reads as a broken one */

  /* The span is the furthest thing in reach, rounded up to a whole hour, with a
     one-hour floor so a board where everything is twenty minutes out still has
     an axis to sit on rather than one point at 100%. */
  var maxM = near.reduce(function(m, r){ return Math.max(m, r.mins); }, 0);
  var span = Math.min(1440, Math.max(60, Math.ceil(maxM / 60) * 60));
  var pos  = function(m){ return Math.max(1.5, Math.min(98.5, m / span * 100)); };

  var evs = catFuture(nowMs).map(function(c){
    var t = new Date(c.t).getTime();
    return isFinite(t) ? { n:c.n, t:t, m:(t - nowMs) / 60000 } : null;
  }).filter(function(e){ return e && e.m > 0 && e.m <= span; })
    .sort(function(a, b){ return a.m - b.m; });

  var wrap = el("div","dec-rail");
  var h = '<div class="drl-hd">The next ' + (span >= 120 ? Math.round(span / 60) + ' hours' : span + ' minutes') +
          ', both contracts on one axis</div>';

  syms.forEach(function(sym){
    var LD = LADDERS[sym] || { dp:2, label:sym };
    var rows = near.filter(function(r){ return r.sym === sym; })
                   .sort(function(a, b){ return a.mins - b.mins; });
    h += '<div class="drl-lane"><div class="drl-sym">' + LD.label + '</div>' +
         '<div class="drl-track"><span class="drl-line"></span>';
    evs.forEach(function(e){
      h += '<span class="drl-ev" style="left:' + pos(e.m).toFixed(2) + '%"></span>';
    });
    if (!rows.length){
      h += '<span class="drl-lab" style="left:0">nothing in reach</span>';
    } else {
      rows.forEach(function(r){
        var g = decGate(sym, nowMs, r), x = pos(r.mins);
        h += '<span class="drl-m ' + g.cls + '" style="left:' + x.toFixed(2) + '%">' +
             (r.d > 0 ? "\u25B2" : "\u25BC") + '</span>';
      });

      /* Only the nearest level in each lane is labelled, and it goes in the band
         directly above its own marker rather than to one side of it. Beside-the-
         marker placement needs a side, and whichever side is chosen the label
         ends up somewhere on the time axis that is not where its level is: RTY's
         two nearest levels are fifteen minutes apart, so hanging the label right
         put it on the second one, and flipping it left put it on the far side of
         the dashed release from the level it names. A number sitting at the
         wrong time on a time axis is the one error this card cannot afford.

         The centre is clamped six percent off each end so the label cannot be
         clipped by the card; at those positions the marker is still underneath
         it and the pair still read as one object. */
      var x0 = pos(rows[0].mins);
      h += '<span class="drl-lab" style="left:' +
           Math.max(6, Math.min(94, x0)).toFixed(2) + '%">' +
           fmt(rows[0].p, LD.dp) + '</span>';
    }
    h += '</div></div>';
  });

  /* The axis. A tick every round STEP rather than at fixed fractions of the
     span, because a tick at a quarter of a ten-hour rail is at +2.5h and calling
     it "+3h" puts the label half an hour from the thing it names. The step is
     the smallest one that keeps the axis to six labels or fewer; when the span
     is not a whole number of steps the last tick simply falls short of the right
     end, which is honest, where a rounded label is not. */
  var STEPS = [15, 30, 60, 120, 180, 240, 360, 720], step = 1440;
  for (var si = 0; si < STEPS.length; si++)
    if (span / STEPS[si] <= 5){ step = STEPS[si]; break; }

  h += '<div class="drl-ax">';
  for (var m = 0; m <= span; m += step){
    var ax = m / span * 100;
    h += '<span style="left:' + ax.toFixed(2) + '%' +
         (ax >= 97 ? ';transform:translateX(-100%)' : '') + '">' +
         (m === 0 ? "now" : m % 60 === 0 ? "+" + (m / 60) + "h" : "+" + m + "m") +
         '</span>';
  }
  h += '</div>';

  /* The events are named here rather than beside their own rules. Two releases
     forty minutes apart overprint each other at this width, and a name nudged
     clear of a collision points at the wrong time — which on this card is the
     one error that would matter. */
  h += '<div class="drl-key">' + (evs.length
    ? '<b>Dashed</b> is a scheduled release: ' +
      evs.map(function(e){ return hkt(e.t) + ' ' + e.n; }).join(' &middot; ') +
      '. A marker to the right of one is on the far side of it.'
    : 'Nothing scheduled lands inside this window, so every marker here is a question of flow.') +
    ' Markers are levels; &#9650; is above the current price and &#9660; below.</div>';

  wrap.innerHTML = h;
  return wrap;
}



/* The scenery, once. Every one of these rows would have carried the identical
   "beyond a day of normal travel" sentence from decGate, so that sentence is
   stated in the summary and the rows behind it carry only what differs: the
   price, how far away it is in points and in typical thirty-minute moves, and
   what the level is. No time column — the whole point is that there isn't one. */
function decFar(sym, far){
  var LD = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  var d = document.createElement("details");
  d.className = "fwork dec-far";
  d.setAttribute("data-far", sym);
  /* The symbol is in the sentence, not just the card header: two boards can
     legitimately count the same number of far levels (both hit 5 the evening
     the HSI board grew its session-open row), and two identical visible
     paragraphs in one card read as a copy-paste defect — bakedup rightly
     refuses them. Named, the coincidence stops being a repeat. */
  var h = '<summary><b>' + far.length + ' more ' + sym + ' level' + (far.length === 1 ? '' : 's') +
          '</b>, all beyond a day of normal travel &mdash; scenery, not decisions.' +
          '</summary><div class="fwork-b">';
  far.forEach(function(r){
    h += '<div class="dfr"><div class="dfp">' + fmt(r.p, LD.dp) +
         '<span>' + (r.d > 0 ? "+" : "") + fmt(r.d, LD.dp) +
         /* "× 30m" in full, not a bare "×". The unit is what makes the figure a
            distance rather than a ratio of nothing, and paceguard reads every
            ×30m figure on this card to prove they all divide by one pace — a
            level does not stop being covered by that because it is folded. */
         (r.x30 != null ? ' &middot; ' + r.x30.toFixed(1) + '&times; 30m' : '') + '</span></div>' +
         '<div class="dfw">' + decWhat(r) + '</div></div>';
  });
  d.innerHTML = h + '</div>';
  if (decFoldOpen[sym]) d.open = true;
  d.addEventListener("toggle", function(){ decFoldOpen[sym] = d.open; });
  return d;
}

function decRows(sym, nowMs){
  var px = liqPx(sym);
  if (px == null) return [];
  var P = pace(sym, nowMs), t30 = P ? P.v : null;
  return decLevels(sym, px).map(function(v){
    var d = v.p - px, ad = Math.abs(d);
    /* A level price is standing on is reachable in zero minutes, not "beyond a
       day". minsToReach declines a zero distance, so it is answered here. */
    var mins = ad <= 0 ? 0 : minsToReach(sym, nowMs, ad);
    return { sym:sym, px:px, p:v.p, kind:v.kind, side:v.side, score:v.score,
             why:v.why, age_h:v.age_h, tags:v.tags, d:d, ad:ad, mins:mins,
             at: mins == null ? null : nowMs + mins*60000,
             x30: t30 ? ad/t30 : null };
  }).sort(function(a, b){
    if (a.mins == null && b.mins == null) return a.ad - b.ad;
    if (a.mins == null) return 1;
    if (b.mins == null) return -1;
    return (a.mins - b.mins) || (a.ad - b.ad);
  });
}

/* The join. What is scheduled to fire between now and the moment this level
   comes into normal reach — and, when the event is one with a measured band,
   whether that band covers the distance on its own.

   Gates are taken from the WHOLE calendar, not just the releases tagged to
   this contract. The tag says which contract the band was sized for, not which
   contract the event touches; a US number lands on both of these. But the
   band itself is only quoted where it was judged. Borrowing a multiplier
   judged for RTY and applying it to ES would assert the two contracts react by
   the same multiple of their own typical range, which is exactly the sort of
   number that looks measured and is not. */
function decGate(sym, nowMs, r){
  var LD = LADDERS[sym] || { dp:2, label:sym }, dp = LD.dp;
  if (r.mins == null)
    return { cls:"far", head:null,
             txt:"Beyond a day of normal travel from here. This is scenery, not a decision.",
             tail:"Beyond a day of normal travel from here. This is scenery, not a decision." };

  var ups = catFuture(nowMs).filter(function(c){
    var t = new Date(c.t).getTime();
    return isFinite(t) && t <= r.at;
  });
  /* The gate is the biggest thing in the window, not the first. A tier-one
     release two hours out governs a level more than a tier-three one does
     twenty minutes out, and the reader is trying to find out what decides this
     level rather than what happens next. */
  var big = ups.slice().sort(function(a, b){
    return (b.imp || 0) - (a.imp || 0) ||
           (new Date(a.t).getTime() - new Date(b.t).getTime());
  })[0];

  /* No event in the window. The first version left head null here, arguing
     "nothing is scheduled" is not a fact that gets cheaper by being said once.
     The census said otherwise: on a closed Saturday every level on both lanes
     is clear water, and the card printed the same thirty-one-word paragraph
     six times — a sixth of the board's visible words carrying one bit. The
     premise IS shared (it is the same calendar being empty), so it now rides
     the same hoisting engine as a shared event: stated once per run, with the
     short per-row line keeping the class readable row by row. A run of one
     still prints the full standalone sentence via txt, as everywhere else.
     The "now" rows stay ungrouped on purpose — in-reach-right-now is urgent,
     rare, and worth its whole sentence every time it appears. */
  if (!big){
    if (r.mins <= 15)
      return { cls:"now", head:null,
        txt:"In reach right now with nothing scheduled on top of it. Whatever happens here is flow, and flow is fadeable in a way that a print is not.",
        tail:"In reach right now with nothing scheduled on top of it. Whatever happens here is flow, and flow is fadeable in a way that a print is not." };
    return { cls:"clear",
      head:"Clear water &mdash; nothing on the calendar lands before any of these come into reach.",
      txt:"Clear water &mdash; nothing on the calendar lands before this comes into reach. Getting here is a question of flow, so it is the honest kind of level to trade against current positioning.",
      tail:"Clear water &mdash; flow decides this level, not the calendar." };
  }

  var ms = new Date(big.t).getTime() - nowMs, R = catReach(big);
  var head = "<b>" + big.n + "</b> lands first, in " + catCountdown(ms);

  /* The hoistable premise. Same event, same countdown, same band, for every
     level this event gates -- so it is built once here and the painter prints it
     once per run of rows that share it. The band is only named when it was
     judged on THIS contract, which is the same restriction the prose has always
     had; borrowing a multiplier sized for RTY and quoting it in ES points would
     be a made-up number wearing a measurement's clothes. */
  var shared = head + (R && big.sym === sym
    ? ", expected move &plusmn;" + fmt(R.r, dp) + "." : ".");

  if (r.mins <= 15)
    return { cls:"gated", head: shared,
      txt: head + " &mdash; and this level is already in reach. A level sitting this close to a scheduled print is where the first spike goes, not where it stops. Size for being run through it.",
      tail: "This level is <b>already in reach</b>. Sitting this close to a scheduled print, it is where the first spike goes rather than where it stops &mdash; size for being run through it." };

  if (big.sym !== sym || !R)
    return { cls:"gated", head: shared,
      txt: head + ". " + (big.sym !== sym
      ? "Its expected move is sized for " + ((LADDERS[big.sym] || {}).label || big.sym) + " and there is no honest way to restate it in " +
        LD.label + " points, so how far it carries this contract is unknown."
      : "There is no measured band behind it, so how far it reaches is unknown.") +
      " What is certain is that this level sits on the far side of a scheduled event, which makes it an event level rather than a flow one.",
      tail: (big.sym !== sym
      ? "Its band is sized for " + ((LADDERS[big.sym] || {}).label || big.sym) + " and does not restate honestly in " +
        LD.label + " points, so how far it carries this level is <b>unknown</b>."
      : "No measured band behind it, so how far it reaches is <b>unknown</b>.") +
      " What is certain is that this level sits on the far side of a scheduled event &mdash; an event level, not a flow one." };

  var cover = r.ad > 0 ? R.r / r.ad : 2;
  if (cover >= 1)
    return { cls:"gated", head: shared, cover: cover,
      txt: head + ", and its expected move of &plusmn;" + fmt(R.r, dp) + " covers the " + fmt(r.ad, dp) +
      " to here on its own. Price does not have to travel to this level &mdash; one print can hand it over. Trade it as an event level: the entry is the reaction, not the approach.",
      tail: "<b>One print can hand this over</b> &mdash; trade the reaction, not the approach." };
  if (cover >= 0.5)
    return { cls:"gated", head: shared, cover: cover,
      txt: head + ", expected move &plusmn;" + fmt(R.r, dp) + " &mdash; about " + Math.round(cover*100) +
      "% of the way here. Enough to put this level in play on the print, not enough to deliver it. The follow-through decides, which means waiting out the first candle costs you nothing.",
      tail: "<b>In play, not delivered</b> &mdash; the follow-through decides, so waiting out the first candle costs nothing." };
  return { cls:"gated", head: shared, cover: cover,
    txt: head + ", but its expected move of &plusmn;" + fmt(R.r, dp) + " is only " + Math.round(cover*100) +
    "% of the distance. Even a clean surprise does not reach this on its own; it needs a trend after the headline, which is a different bet with a different stop.",
    tail: "<b>Needs a trend</b>, not just a surprise &mdash; a different bet, with a different stop." };
}

/* What breaks the whole board, stated so it can be checked rather than felt.
   Every time on this card assumes the contract keeps travelling at the pace
   this archive measured for the session it is in. If it is not, every figure
   here is wrong in a known direction — so measure the pace actually being
   travelled over the last hour and compare.

   The expectation is scaled by the same fitted exponent the walk uses, on the
   window length actually available, because comparing a forty-minute realised
   excursion against a sixty-minute expectation would manufacture a slowdown
   out of nothing but a sparse feed. */
function decPace(sym, nowMs){
  var R = REACH[sym], rows = LIVEBARS[sym] || [];
  if (!R) return null;
  var cut = nowMs/1000 - 3600;
  var w = rows.filter(function(r){ return r && r[0] >= cut && lnum(r[2]) != null && lnum(r[3]) != null; });
  if (w.length < 6) return null;                  /* under half an hour of bars is not a pace */
  var o = lnum(w[0][1]);
  if (o == null) return null;
  var hi = -Infinity, lo = Infinity;
  w.forEach(function(r){
    var h = lnum(r[2]), l = lnum(r[3]);
    if (h != null && h > hi) hi = h;
    if (l != null && l < lo) lo = l;
  });
  if (!isFinite(hi) || !isFinite(lo)) return null;
  var mins = (w[w.length-1][0] - w[0][0]) / 60 + 5;
  var base = R.e30[sessAt(nowMs)] || R.e30.ASIA;
  var exp  = base * Math.pow(mins / 30, R.H);
  if (!(exp > 0)) return null;
  return { act: Math.max(hi - o, o - lo), exp: exp,
           ratio: Math.max(hi - o, o - lo) / exp, mins: Math.round(mins), bars: w.length };
}

function decPaceTxt(sym, nowMs){
  var P = decPace(sym, nowMs), LD = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
  if (!P)
    return "Not enough recent bars to check the pace these times assume. Treat them as the archive's typical behaviour rather than as a reading of the last hour.";
  var head = "Over the last " + P.mins + " minutes this contract has travelled <b>" + fmt(P.act, LD.dp) + " " + LD.unit +
             "</b> in one direction against the <b>" + fmt(P.exp, LD.dp) + "</b> the session's measured pace expects";
  if (P.ratio >= 1.5)
    return head + " &mdash; about <b>" + P.ratio.toFixed(1) + "&times; faster</b>. Every time on this board is too slow while that holds, and the far levels are nearer than they read.";
  if (P.ratio <= 0.6)
    return head + " &mdash; about <b>" + P.ratio.toFixed(1) + "&times;</b> of it. The market is quieter than the archive, so treat these times as optimistic; a level marked two hours out may not come at all today.";
  return head + ", which is <b>normal</b>. The times below stand as measured.";
}

function decWhen(r){
  if (r.mins == null) return { big:"&mdash;", sub:"beyond a day" };
  if (r.mins <= 15)   return { big:"now", sub:"in reach" };
  return { big: reachWord(r.mins).replace("~",""), sub: hkt(r.at) };
}

/* What the level IS, in one line. Pools carry their evidence; structural
   levels carry their name. A merged row carries both, which is the point of
   merging them. */
function decWhat(r){
  var bits = [];
  if (r.kind === "pool"){
    bits.push("<b>" + poolWord(r.side) + "</b> this level");
    if (r.why && r.why.length) bits.push(r.why.join(" &middot; "));
  }
  if (r.tags && r.tags.length)
    bits.push((r.kind === "pool" ? "also the " : "The ") + r.tags.join(" and the ") + " of the profile");
  if (r.kind === "pool" && poolAge(r.age_h)) bits.push(poolAge(r.age_h));
  return bits.join(" &mdash; ");
}

function drawDecide(atMs){
  var host = document.getElementById("decBody");
  /* Inherited, not restated. This board's contracts ARE Object.keys(LIQ), so
     whatever LIQ refuses is absent here for the identical reason, and the
     liquidity map has already written that reason down. Painted before the early
     return below for the same reason drawLiq paints it before its own. */
  paintLiqExcl("decExcl");
  if (!host) return;
  host.innerHTML = "";                                  /* idempotent */
  var now = atMs || Date.now(), syms = Object.keys(LIQ), all = [];

  syms.forEach(function(sym){
    decRows(sym, now).forEach(function(r){ all.push(r); });
  });

  /* ---- the header: what the board as a whole says ----
     Deliberately the first level that is NOT already in reach. A level price is
     standing on is the present, and the present is what the liquidity map is
     for. The decision on this card is always about something that has not
     happened yet. */
  var next = all.filter(function(r){ return r.mins != null && r.mins > 15; })
                .sort(function(a, b){ return a.mins - b.mins; })[0];
  var hd = el("div","cat-hd");
  if (!all.length){
    hd.innerHTML = '<div class="ch-lab">Decision board</div><div class="ch-fig">No levels mapped</div>' +
      '<div class="ch-note">Neither contract has a usable volume profile or a live price right now, so there is nothing to order. ' +
      'This card is a join of the two below it and goes quiet when either side is missing rather than inventing a level to fill itself.</div>';
  } else if (!next){
    hd.innerHTML = '<div class="ch-lab">Decision board</div><div class="ch-fig">Everything mapped is already in reach</div>' +
      '<div class="ch-note">Every level on both maps sits inside normal travelling range from here. That makes this a question of direction rather than of distance &mdash; ' +
      'which is the liquidity map’s job, not this one’s. When the levels are all this close, the edge is in what price does at them, not in getting to them.</div>';
  } else {
    var nLD = LADDERS[next.sym] || { dp:2, label:next.sym };
    var nG = decGate(next.sym, now, next);
    hd.innerHTML = '<div class="ch-lab">Next level to come into reach</div>' +
      '<div class="ch-fig">' + nLD.label + ' ' + fmt(next.p, nLD.dp) + ' &middot; ' + reachWord(next.mins) + '</div>' +
      '<div class="ch-note">' + (nG.cls === "clear"
        ? "Nothing scheduled stands between here and there, so this one is decided by flow."
        : nG.cls === "gated"
        ? "There is a scheduled event in the way, so this is an event level rather than a flow level."
        : "") +
      ' It comes into range around <b>' + hkt(next.at) + '</b> (' + zhm(next.at) + ') on the pace measured for the sessions in between. ' +
      'That is when it becomes <i>reachable</i> &mdash; not a claim that price goes there.</div>';
  }
  host.appendChild(hd);

  var rail = decRail(all, syms, now);
  if (rail) host.appendChild(rail);

  /* ---- both contracts, stacked, no tabs ----
     A tab would cost a tap to compare ES against RTY, and comparing them is
     most of why anyone opens this card on a phone. */
  syms.forEach(function(sym){
    var LD = LADDERS[sym] || { dp:2, unit:"pt", label:sym };
    var rows = all.filter(function(r){ return r.sym === sym; });
    var px = liqPx(sym), L = LIQ[sym];
    var hdr = el("div","dec-sym");
    hdr.innerHTML = '<div class="dsn">' + LD.label + '</div>' +
      '<div class="dsp">' + (px == null ? "no price" : fmt(px, LD.dp)) +
      /* Off the live clock, not the block's baked one: this label sits directly
         above a column of × figures that divide by pace(sym, now), and a header
         naming ASIA above a column divided by European pace is the same card
         disagreeing with itself in two places at once. */
      ' &middot; ' + (SESSTAG[clockAt(now).sess] || clockAt(now).sess) + '</div>';
    host.appendChild(hdr);

    /* Under the symbol's own header rather than at the top of the card, because
       the break belongs to one contract's archive: ES can be mid-roll while RTY
       is not, and a card-level banner would smear the warning across a symbol it
       is not true of. */
    var rc = rollChip(sym, LD);
    if (rc) host.appendChild(rc);

    if (!rows.length){
      host.appendChild(el("div","rt-key","No levels survive on this contract's map &mdash; price has already run every pool that was there."));
      return;
    }

    /* In reach inside a day, and everything else. The five-deep cap applies to
       the DECISIONS only: it existed to stop a long map turning into a long
       card, and a one-line entry behind a fold is not what it was protecting
       against. So the scenery fold below is uncapped and carries every level
       the map has, which is more than the old five-deep view showed. */
    var near = rows.filter(function(r){ return r.mins != null; });
    var far  = rows.filter(function(r){ return r.mins == null; });
    if (near.length > 5)
      host.appendChild(el("div","rt-key", "Showing the <b>5</b> nearest of " + near.length +
        " levels in reach; the table view at the foot of this card has all of them."));

    /* Rows gated by the same event share a premise, and that premise is stated
       once above them instead of at the top of each. Grouping by position is
       sound here because decGate takes the biggest event in the window between
       now and the level and that window only grows as the levels get further
       out, so the gating event can only stay the same or get bigger going down
       the list: a run of rows sharing a head is always contiguous.

       A run of ONE keeps the full self-contained sentence. Hoisting a premise
       above a single row would cost a line and save nothing, and it would break
       that row's prose in half for no reader's benefit. */
    var shown = near.slice(0, 5), heads = shown.map(function(r){ return decGate(sym, now, r); });
    var runOf = function(i){
      var k = heads[i].head, n = 0;
      if (k == null) return 1;
      while (i + n < heads.length && heads[i + n].head === k) n++;
      return n;
    };

    var ghN = 0;
    for (var di = 0; di < shown.length; ){
      var run = runOf(di), grouped = run > 1;
      /* One reference for the whole run. Bounded below at 1 so a group where
         nothing is covered still shows the 100% mark on the track, and above at
         3 so a level sitting a tenth of an expected move away cannot compress
         every other bar in the group into the left edge. */
      var covMax = 1;
      if (grouped)
        for (var ci = di; ci < di + run; ci++)
          if (heads[ci].cover != null) covMax = Math.max(covMax, heads[ci].cover);
      var covScale = Math.min(3, covMax);

      /* The ownership tag. Null on an ungrouped row on purpose: absence of a
         tag is the statement that this row's premise is in its own sentence,
         and a tag pointing at no band would be worse than no tag at all. */
      var ghId = grouped ? sym + ":" + (ghN++) : null;

      if (grouped){
        var gh = el("div","dec-gh");
        gh.setAttribute("data-gh", ghId);
        /* The note under the head must match the premise it hoists: the event
           note talks about a print and its coverage bars; a clear-water group
           has no print, no bars, and saying "the far side of it" above one
           would point the reader at nothing. */
        gh.innerHTML = heads[di].head +
          (heads[di].cls === "clear"
            ? '<span class="dghn">Everything below to ' + fmt(shown[di + run - 1].p, LD.dp) +
              ' is the same case: getting there is a question of flow, the honest kind of ' +
              'level to trade against current positioning.</span>'
            : '<span class="dghn">Everything below to ' + fmt(shown[di + run - 1].p, LD.dp) +
              ' sits on the far side of it. Each bar is the share of that level&rsquo;s distance ' +
              'the print covers on its own; the mark is 100%.</span>');
        host.appendChild(gh);
      }
      for (var dj = di; dj < di + run; dj++){
        var r = shown[dj], g = heads[dj], w = decWhen(r);
        var row = el("div","dec-row " + g.cls);
        if (ghId) row.setAttribute("data-gh", ghId);
        row.innerHTML =
          '<div class="dwhen">' + w.big + '<span>' + w.sub + '</span></div>' +
          '<div><div class="dlvl">' + fmt(r.p, LD.dp) +
            '<span class="dd">' + (r.d > 0 ? "+" : "") + fmt(r.d, LD.dp) +
            (r.x30 != null ? ' &middot; ' + r.x30.toFixed(1) + '&times; 30m' : '') + '</span></div>' +
          '<div class="dwhat">' + decWhat(r) + '</div>' +
          '<div class="dgate">' + (grouped ? g.tail : g.txt) +
            /* Drawn only inside a group, and only where a ratio was actually
               measured. On an ungrouped row there is nothing to compare the bar
               against and the sentence beside it already carries the figure; on
               a row with no band behind its event there is no ratio at all, and
               a bar drawn from a missing number would look exactly as measured
               as a real one. */
            (grouped && g.cover != null
              ? '<div class="dcov"><div class="dcov-t">' +
                '<span class="dcov-f" style="width:' +
                  Math.max(2, Math.min(100, g.cover / covScale * 100)).toFixed(1) + '%"></span>' +
                '<span class="dcov-1" style="left:' + (100 / covScale).toFixed(1) + '%"></span></div>' +
                '<div class="dcov-l"><b>' + Math.round(g.cover * 100) + '%</b> covered</div></div>'
              : '') +
          '</div></div>';
        host.appendChild(row);
      }
      di += run;
    }

    if (!near.length)
      host.appendChild(el("div","rt-key", "Nothing on this contract&rsquo;s map comes into reach " +
        "inside a day of normal travel. That is a statement about distance, not about direction &mdash; " +
        "price can still move; it just cannot get to any of these levels on the pace measured for the " +
        "sessions between here and this time tomorrow."));
    if (far.length) host.appendChild(decFar(sym, far));

    host.appendChild(el("div","invalid", "<b>What breaks these times &mdash;</b> " + decPaceTxt(sym, now)));
  });

  /* ---- provenance ----
     This is the one card on the page that makes a forward claim, so it carries
     its own error bar rather than leaving it in a commit message. */
  var gr = syms.map(function(s){
    var R = REACH[s];
    return R ? ((LADDERS[s] || {}).label || s) + " " + R.H.toFixed(3) : null;
  }).filter(Boolean).join(", ");
  var er = syms.map(function(s){
    var R = REACH[s];
    return (R && R.grade && R.grade.ALL != null)
      ? ((LADDERS[s] || {}).label || s) + " " + (R.grade.ALL > 0 ? "+" : "") + R.grade.ALL + "%" : null;
  }).filter(Boolean).join(", ");
  var under = syms.every(function(s){
    var R = REACH[s];
    return R && R.grade && R.grade.ALL != null && R.grade.ALL < 0;
  });

  var meth = document.createElement("details");
  meth.className = "fwork dec-meth";
  meth.innerHTML = '<summary><b>These times are measured, and their current out-of-sample error is ' +
    (er ? er : "not graded") + '.</b> The walk is fitted per contract on this archive and ' +
    'graded on every rebuild' +
    (under ? ", and it is under-predicting &mdash; the safe direction, because the board calls a level out " +
             "of reach slightly before it truly is rather than promising a touch it cannot deliver"
           : "") +
    '. None of it is a forecast of direction.</summary><div class="fwork-b">' +
    decMethTxt(gr, er, under) + '</div>';
  if (decFoldOpen.__meth) meth.open = true;
  meth.addEventListener("toggle", function(){ decFoldOpen.__meth = meth.open; });
  host.appendChild(meth);

  drawDecideTable(all, now);
}

/* The derivation, unchanged in substance from when it was printed in full at
   the foot of the card. It is a separate function only so the painter above
   reads as a sequence of appends rather than trailing off into an essay. */
function decMethTxt(gr, er, under){
  return "<b>How the timing is built.</b> The typical thirty-minute one-directional excursion is measured separately for " +
    "Asian, European, cash and evening hours, then the clock is walked forward five minutes at a time from now, " +
    "picking up whichever session's pace applies as it crosses into it. That is why a level eight times the Asian " +
    "thirty-minute range away can still read a few hours: it is not waiting on hours of overnight drift, it is " +
    "waiting on the cash open, and the walk finds that without being told. Distance grows as time<sup>H</sup> with " +
    "<b>H</b> fitted per contract on this archive (" + (gr || "not fitted yet") + ") rather than assumed to be the " +
    "textbook 0.5. " +
    "<u>The method grades itself out of sample on every rebuild &mdash; fitted on fifteen minutes to two hours, then " +
    "asked to predict the four-hour excursion it never saw. Current error across all sessions: <b>" +
    (er || "not measured") + "</b>." +
    (under ? " Both are under-predicting, which is the safe direction to be wrong in: the board calls a level out of " +
             "reach slightly before it truly is, rather than promising a touch it cannot deliver."
           : "") + "</u> " +
    "<b>None of this is a forecast of direction.</b> It says when a level enters normal travelling range, never that " +
    "price is going there. A level can sit in reach all day and never trade.";
}

/* Everything, including the rows the five-deep view drops, and the raw minutes
   behind each rounded figure. */
function drawDecideTable(all, now){
  var t = document.getElementById("decTv");
  if (!t) return;
  var r = ['<thead><tr><th>Contract</th><th>Level</th><th>Dist</th><th>&times;30m</th><th>In reach</th><th>At (HKT)</th><th>Gate</th></tr></thead><tbody>'];
  all.slice().sort(function(a, b){
    if (a.mins == null && b.mins == null) return a.ad - b.ad;
    if (a.mins == null) return 1;
    if (b.mins == null) return -1;
    return a.mins - b.mins;
  }).forEach(function(x){
    var LD = LADDERS[x.sym] || { dp:2, label:x.sym };
    var g = decGate(x.sym, now, x);
    r.push('<tr><td>' + LD.label + '</td><td>' + fmt(x.p, LD.dp) + '</td><td>' +
      (x.d > 0 ? "+" : "") + fmt(x.d, LD.dp) + '</td><td>' +
      (x.x30 == null ? "—" : x.x30.toFixed(1)) + '</td><td>' +
      (x.mins == null ? ">24h" : x.mins + "m") + '</td><td>' +
      (x.at == null ? "—" : hkt(x.at)) + '</td><td style="text-align:left;white-space:normal">' +
      (g.cls === "clear" ? "clear water" : g.cls === "now" ? "already in reach" :
       g.cls === "far" ? "out of range" : "event first") + '</td></tr>');
  });
  t.innerHTML = r.join("") + '</tbody>';
}

drawDecide(Date.now());

document.getElementById("decTvBtn").onclick = function(){
  var w = document.getElementById("decTvWrap");
  var on = w.classList.toggle("on");
  this.textContent = on ? "Hide table view" : "Show table view";
};

/* Same freeze contract as the cards above it. */
window.__wf.drawDecide = drawDecide;
window.__wf.drawLiq = drawLiq;

/* ---- the roll: a reader and a seam ----
   Reading first. rollState reports what the block is carrying per contract, so a
   guard can assert the field survived a block swap without scraping rendered
   text — and so the day a real roll DOES land, the failure "the data has it and
   the page does not" is separable from "the data never had it".

   Then the seam, and it needs its justification stated rather than assumed,
   because a setter that exists only for tests is usually a smell. Here it is
   the only way the feature can be observed at all: the archive spans one
   contract month, `roll` is correctly an empty list every single day, and a
   painter that has never once been asked to draw is a painter nobody has
   watched work. The alternative is discovering that rollEl throws on a missing
   field on the quarter-end morning it finally matters. Same shape as
   syncLadderPx above — it writes, repaints, and RETURNS the resulting state, so
   a caller can assert the write landed rather than assuming it. */
window.__wf.rollState = function(sym){
  var out = {};
  Object.keys(LIQ).forEach(function(k){
    var L = LIQ[k];
    out[k] = { has: !!(L && L.roll && L.roll.length),
               n: (L && L.roll && L.roll.length) || 0,
               hits: (L && L.roll) || null };
  });
  return sym ? out[sym] : out;
};
window.__wf.seedRoll = function(sym, list, atMs){
  if (!LIQ[sym]) return null;
  LIQ[sym].roll = list;
  drawLiq(atMs);
  try { drawLadder(atMs); } catch (e) {}
  try { drawDecide(atMs); } catch (e) {}
  return window.__wf.rollState(sym);
};
/* A test seam: the times are the claim this card makes, so they have to be
   assertable from outside the IIFE without scraping rendered text. */
window.__wf.decState = function(atMs){
  var now = atMs || Date.now(), out = {};
  Object.keys(LIQ).forEach(function(sym){
    out[sym] = decRows(sym, now).map(function(r){
      return { p:r.p, d:+r.d.toFixed(2), mins:r.mins, gate:decGate(sym, now, r).cls };
    });
  });
  return out;
};

/* The gate wording depends on a countdown, so it goes stale like the catalyst
   board does. Same minute cadence, same reason. */
setInterval(function(){ drawDecide(Date.now()); }, 60000);

/* ---- scenarios ---- */
/* One definition of where the fold falls, because there are two readers of it —
   the painter below and scenState, which is what scentest.mjs checks the painter
   against. Two copies of a split rule is how a suite ends up confirming that the
   page agrees with a second copy of the page's own arithmetic. */
/* ---- prose tokens: measured figures that CANNOT drift -------------------
   {{age SYM PRICE}} resolves at render time from LIQ[SYM].stops — the same
   arrays the prose guard reads — so a pool age quoted in curated prose is the
   measurement itself rather than a copy of it. This exists because copies
   drifted on every refresh: the guard's ±2h tolerance was crossed by the mere
   passage of an afternoon, and every rebuild cost a hand repair of figures
   nobody had decided to change. A token has no figure to repair.
   THE HONEST ABSENCE: a token whose pool has dropped off the map renders as a
   bracketed statement of that fact in the warning colour — words first, colour
   second — never as a blank, because a blank reads as an editing accident and
   an absence here is information: the structure the sentence leans on is gone.
   prose_levels resolves the same tokens from the same data at check time and
   HARD-FAILS on any left unresolved, so a broken resolver cannot silently
   un-check the figures this machinery exists to check. */
function scenWordNum(n){
  var ones = ["zero","one","two","three","four","five","six","seven","eight",
              "nine","ten","eleven","twelve","thirteen","fourteen","fifteen",
              "sixteen","seventeen","eighteen","nineteen"];
  var tens = ["","","twenty","thirty","forty","fifty","sixty","seventy",
              "eighty","ninety"];
  n = Math.round(n);
  if (n < 0) return String(n);
  if (n < 20) return ones[n];
  if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 ? "-" + ones[n % 10] : "");
  /* To 999, MATCHING prose_levels' numword exactly — same words, same "and",
     same digit fallback above 999. This stopped at 200 while the checker spelled
     to 999, and the two are two implementations of ONE rule: the day a pool's
     age crossed 200 hours, {{age}} read "204" on the card and "two hundred and
     four" at check time, and toktest went red with neither side wrong about the
     measurement. The registry lesson in one line — the split was invisible from
     both sides until the data walked into the 200-999 band nothing had visited. */
  if (n < 1000) {
    var h = ones[Math.floor(n / 100)] + " hundred";
    return h + (n % 100 ? " and " + scenWordNum(n % 100) : "");
  }
  return String(n);
}
function scenMiss(what){
  return '<b style="color:var(--warning)">[' + what + ']</b>';
}
/* 1 -> first. Words while they read as words, digits once they stop — cut at
   twelfth for the same reason scenWordNum stops where it does. */
function scenOrdWord(n){
  var w = ["","first","second","third","fourth","fifth","sixth","seventh",
           "eighth","ninth","tenth","eleventh","twelfth"];
  if (n >= 1 && n < w.length) return w[n];
  var r = n % 100, suf = (r >= 10 && r <= 20) ? "th"
    : (n % 10 === 1 ? "st" : n % 10 === 2 ? "nd" : n % 10 === 3 ? "rd" : "th");
  return n + suf;
}
function scenProf(sym){
  return (typeof LIQ !== "undefined" && LIQ[sym] && LIQ[sym].prof && LIQ[sym].total)
    ? LIQ[sym] : null;
}
function scenPct(x){ return x.toFixed(2); }

/* THE PRICE INSIDE A POOL TOKEN IS AN ANCHOR, NOT A CLAIM.

   A stop pool is a cluster of turns, and the generator re-keys it every time the
   archive grows. The ES pool this page called 7,775.94 was keyed 7,777.08 one
   refresh later, having gained four turns — nothing about the market had changed
   that the sentence was wrong about, but the sentence had been pinned to a
   coordinate instead of to a structure, and it took the build down along with
   twelve others. Hand-repairing thirteen numbers would have made the build green
   and re-armed the identical trap for the next refresh, which is the trade this
   project stopped making when the ladder was generated rather than typed.

   So: the anchor selects the pool, and every figure comes from the pool. The
   tolerance is ONE BIN WIDTH and that is not a taste — inside a bin the profile
   cannot tell two prices apart, so a pool that has drifted less than a bin is the
   same object by the only measure this page owns. Beyond that it is a different
   structure, and the sentence needs rewriting rather than nudging.

   Two failures, and the ambiguous one is the dangerous half: a token matching two
   pools resolves SILENTLY, to whichever the array yields first, and can resolve
   to the other tomorrow with no figure ever looking wrong. */
function scenPool(sym, anchor){
  var L = (typeof LIQ !== "undefined") ? LIQ[sym] : null;
  if (!L || !L.stops) return { miss: sym + ' has no pool map' };
  var bw = L.bw || 0.005, near = [], i;
  for (i = 0; i < L.stops.length; i++)
    if (Math.abs(L.stops[i].p - anchor) <= bw) near.push(L.stops[i]);
  if (!near.length) return { miss: 'the ' + anchor + ' pool is no longer on the map' };
  if (near.length > 1) return { miss: anchor + ' matches ' + near.length + ' pools — re-anchor' };
  return { pool: near[0] };
}
/* The turn count and the session mix live in the pool's why-list as text, which
   is where the generator writes them, so they are parsed from the one place
   rather than duplicated into a field this painter would then have to trust. */
function scenWhy(pool){
  var w = (pool.why || []).join(" ");
  var mt = /(\d+) turns/.exec(w), mc = /turns \(([^)]*)\)/.exec(w);
  var comp = {}, re = /(\d+)(RTH|EU|EV|A)/g, m;
  if (mc) while ((m = re.exec(mc[1]))) comp[m[2]] = +m[1];
  return { turns: mt ? +mt[1] : null, comp: comp };
}

/* opts.frozen — the caller renders ONCE, at load, and never again.
   ------------------------------------------------------------------------
   renderScenarios is a load-time IIFE: paintAll does not call it, and it must
   not, because every branch is a fold and rebuilding the card snaps the reader's
   open branch shut mid-sentence. Line 5674 records what that cost the scorecard.

   So the scenario card cannot show a live price, and after D1(b) that became
   visible rather than merely true: every other card moved onto the reader's
   typed print and this one went on quoting the price baked at build time. One
   card disagreeing with the board is a worse failure than the whole board being
   wrong together, which is the reason paceguard exists.

   The disagreement is closed by making the claim honest, not by making it live.
   A frozen caller's prices are LABELLED as what they are — the levels as they
   stood when the page was built, which is what the branches were written
   against — and the house rule this satisfies is the one about measured and
   remembered numbers being labelled differently. The live price is three cards
   up on the ladder and always was.

   Passed explicitly rather than inferred, and passed by scenState as well as by
   the painter: scenState's own comment requires it to resolve through the same
   function the painter uses, so a suite comparing it against the DOM is
   comparing two applications of one resolver. A flag on one and not the other
   would make those two disagree, which is this defect again one level down. */
function scenTok(txt, opts){
  var frozen = !!(opts && opts.frozen);
  return String(txt)
  .replace(/\{\{age (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var r = scenPool(sym, parseFloat(p));
    if (r.miss) return scenMiss(r.miss);
    return r.pool.age_h == null ? scenMiss('the ' + p + ' pool carries no age')
                                : scenWordNum(r.pool.age_h);
  })
  /* AN ABSENCE, and it is the only token here that asserts something is NOT
     there. The prose is full of these — "3,030.44 is no longer listed", "that
     level ends the week carrying no pool at all" — and every one of them becomes
     false the moment the clustering re-forms at that price, silently, with the
     sentence still reading perfectly. RTY 3,038.31 was listed, de-listed and
     listed again inside three sessions, which the prose itself describes; nothing
     was checking the claim while it happened.
     It renders the price, formatted, so the sentence reads exactly as written and
     the figure is generated rather than typed. If a pool has come back, the
     reader is told here instead of being handed a confident false clause.
     Opt-in ON PURPOSE: a detector that tried to find absence claims in free text
     would fire on every "no" in the paragraph, and a noisy check is a check that
     gets switched off. The author writes the token where the claim is. */
  .replace(/\{\{gone (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var L = (typeof LIQ !== "undefined") ? LIQ[sym] : null;
    if (!L || !L.stops) return scenMiss(sym + ' has no pool map, so an absence cannot be checked');
    var r = scenPool(sym, parseFloat(p));
    if (r.pool) return scenMiss('a pool has re-formed at ' + fmt(r.pool.p, 2) + ' — this level is listed again');
    if (r.miss && /matches/.test(r.miss)) return scenMiss(r.miss);
    return fmt(parseFloat(p), 2);
  })
  /* the pool's CURRENT key, so the prose never carries the coordinate itself */
  .replace(/\{\{pool (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var r = scenPool(sym, parseFloat(p));
    return r.miss ? scenMiss(r.miss) : fmt(r.pool.p, 2);
  })
  /* how many times it has been turned */
  .replace(/\{\{turns (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var r = scenPool(sym, parseFloat(p));
    if (r.miss) return scenMiss(r.miss);
    var w = scenWhy(r.pool);
    return w.turns == null ? scenMiss('the ' + p + ' pool carries no turn count')
                           : scenWordNum(w.turns);
  })
  /* how many of those turns one session made. The phrasing stays with the author
     and only the number is generated — "{{mix SYM PRICE A}} of them Asian" reads
     as the writer intended and cannot go stale. A session with no turns resolves
     to "none", which is a true clause rather than a blank. */
  .replace(/\{\{mix (\w+) ([\d.]+) (RTH|EU|EV|A)\}\}/g, function(_m, sym, p, tag){
    var r = scenPool(sym, parseFloat(p));
    if (r.miss) return scenMiss(r.miss);
    var c = scenWhy(r.pool).comp[tag];
    return c ? scenWordNum(c) : "none";
  })
  /* where it sits in the stop map by score. Rank claims were five of the
     thirty-seven failures the day the ladder was still hand-maintained, and they
     rot in the quietest way of all: the sentence stays grammatical, the number
     stays plausible, and the ordering it asserts has simply been overtaken. A
     tie is REPORTED rather than broken — two pools on one score are not first
     and second in any sense the measurement supports. */
  .replace(/\{\{rank (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var r = scenPool(sym, parseFloat(p));
    if (r.miss) return scenMiss(r.miss);
    var me = r.pool.score;
    if (me == null) return scenMiss('the ' + p + ' pool carries no score');
    var st = LIQ[sym].stops, above = 0, tied = -1, i;
    for (i = 0; i < st.length; i++){
      if (st[i].score > me) above++;
      else if (st[i].score === me) tied++;
    }
    return (tied > 0 ? "joint " : "") + scenOrdWord(above + 1);
  })
  /* the share of the window a single bin holds */
  .replace(/\{\{share (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var L = scenProf(sym), pf = parseFloat(p), i;
    if (L) for (i = 0; i < L.prof.length; i++)
      if (Math.abs(L.prof[i][0] - pf) < 0.005)
        return scenPct(100 * L.prof[i][1] / L.total);
    return scenMiss('no ' + p + ' bin in the profile');
  })
  /* the share traded at or above a price */
  .replace(/\{\{above (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var L = scenProf(sym), pf = parseFloat(p), acc = 0, i;
    if (!L) return scenMiss(sym + ' has no profile');
    for (i = 0; i < L.prof.length; i++)
      if (L.prof[i][0] >= pf - 1e-9) acc += L.prof[i][1];
    return scenPct(100 * acc / L.total);
  })
  /* THE COUNT BEHIND THE PERCENTAGE, and the reason it is a token at all. The
     sentences that quote {{above}} read "X% of the window traded at or above P
     -- N bins out of M", and N and M were TYPED. A generated percentage with a
     hand-typed count beside it is the floor-beside-typed-list defect exactly: the
     percentage follows every refresh and the count does not, so the clause goes
     false silently while the number in front of it stays true. It broke on 17 Aug
     when the ES window went 189 -> 196 bins and RTY's 156 -> 173, and five
     sentences had to be retyped by hand -- which would simply have set the same
     trap for the next refresh.
     Spelled out via scenWordNum, because these sit mid-sentence in prose that
     spells its counts, and the words are generated for the same reason the
     figures are. */
  .replace(/\{\{abovebins (\w+) ([\d.]+)\}\}/g, function(_m, sym, p){
    var L = scenProf(sym), pf = parseFloat(p), n = 0, i;
    if (!L) return scenMiss(sym + ' has no profile');
    for (i = 0; i < L.prof.length; i++)
      if (L.prof[i][0] >= pf - 1e-9) n++;
    return scenWordNum(n);
  })
  /* and the window it is out of */
  .replace(/\{\{bins (\w+)\}\}/g, function(_m, sym){
    var L = scenProf(sym);
    if (!L) return scenMiss(sym + ' has no profile');
    return scenWordNum(L.prof.length);
  })
  /* the share held between two prices inclusive, and its per-bin density */
  .replace(/\{\{range(bin)? (\w+) ([\d.]+) ([\d.]+)\}\}/g, function(_m, per, sym, lo, hi){
    var L = scenProf(sym), a = parseFloat(lo), b = parseFloat(hi), acc = 0, n = 0, i;
    if (!L) return scenMiss(sym + ' has no profile');
    for (i = 0; i < L.prof.length; i++)
      if (L.prof[i][0] >= a - 1e-9 && L.prof[i][0] <= b + 1e-9){ acc += L.prof[i][1]; n++; }
    if (!n) return scenMiss('no bins between ' + lo + ' and ' + hi);
    var pct = 100 * acc / L.total;
    return scenPct(per ? pct / n : pct);
  })
  /* Spot, through the SAME rung ladder every other card reads. This read
     SNAPSHOT.quotes — the price baked into the file at build time — so a
     scenario's spot could be hours behind the ladder three cards above it and
     days behind the print the reader had typed. liqPx is the page's one answer
     to "what is this worth now": print, then live, then snapshot, then seed. */
  .replace(/\{\{px (\w+)\}\}/g, function(_m, sym){
    var v = (typeof liqPx === "function") ? liqPx(sym) : null;
    if (v == null) return scenMiss(sym + ' has no price');
    /* The read path is live either way — liqPx returns the print when one is in
       force, and a repainting caller such as drawPlan gets exactly that. Only
       the LABEL is conditional, because only a frozen caller is making a claim
       it cannot keep. */
    return fmt(v, 2) + (frozen ? ' <span class="dim">as built</span>' : '');
  });
}
function scenSplit(tag){
  var p = String(tag).split("|||");
  return { lead: p[0].trim(), work: p.length > 1 ? p.slice(1).join("|||").trim() : "" };
}
(function renderScenarios(){
  /* The sub-heading is COMPUTED from the branches, not typed above them. It used to
     be typed, and on 3 Aug it was still telling the reader that branch C was anchored
     to market-implied July hike odds several hours after branch C had become a
     prices-paid branch at a different weight. Every number in it now comes from the
     same array the branches themselves are drawn from, so the only way for it to be
     wrong is for the branches to be wrong, which is one problem instead of two.

     It reports the ACTUAL sum rather than asserting 100. A card-sub that says "these
     sum to 100%" is worth nothing — it says that whether they do or not. A card-sub
     that says "summing to 97%" has caught a curation error in the one place a reader
     is guaranteed to look. */
  var sHost = document.getElementById("scenSub");
  if (sHost && SCENARIOS.length) {
    var tot = 0, top = SCENARIOS[0];
    SCENARIOS.forEach(function(x){ tot += x.prob; if (x.prob > top.prob) top = x; });
    sHost.innerHTML =
      SCENARIOS.length + ' branches, summing to <b>' + tot + '%</b>' +
      (tot === 100 ? '' : ' — which is not 100, so one of them is mis-weighted') +
      '. The modal case is <b>' + top.id + ' &middot; ' + top.name + '</b> at ' + top.prob +
      '%. Every branch carries the level that invalidates it; tap one for its targets ' +
      'and for that level.' +
      /* Said once, here, rather than six times inside the prose. Each price in a
         branch carries a small "as built"; this is the sentence that tells the
         reader what that means, and why the number beside it on the ladder may
         differ. Written in the card's own voice because the card is the thing
         making the claim: it renders once, at load, and cannot keep a promise to
         be current. Saying so is the whole fix — the alternative was repainting
         it, which snaps the reader's open branch shut. */
      ' <span class="dim">Prices in these branches are marked <b>as built</b>: ' +
      'they are the levels as they stood when this page was built, which is what ' +
      'the branches were written against &mdash; structural anchors, not live ' +
      'quotes. This card renders once and does not repaint, so it cannot follow ' +
      'the tape. The live price is on the ladder above.</span>';
  }
  var host = document.getElementById("scenarios");
  host.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  SCENARIOS.forEach(function(s){
    var col = "var(--"+s.st+")";
    var box = el("div","scen");
    var head = el("button","scen-head");
    head.type = "button";
    /* LEAD ||| WORKING, the same split the ladder subs and the killzone folds
       use, and here for a reason particular to this card: the head used to
       carry the WHOLE tag, and a tag on this board runs to a hundred and eighty
       words. Three branches of that is forty-five lines of prose standing
       between a reader and the one thing a branch map exists to show, which is
       which branch is the heavy one. The lead is the branch's current standing
       in a sentence or two and the rest moves down behind the tap that has
       always been there — so this hides nothing that was not already one press
       away, and it adds no affordance the card did not already have.
       The split is a CUT and not a rewrite. Every word of the old tag is still
       in the string, in the same order on B and C, and on A with one structural
       sentence moved below the fold so the lead can be the news rather than the
       recap. A summary that paraphrases the thing it covers is two versions of
       one paragraph to keep in step; a summary that is literally its first
       sentences cannot drift from it.
       A tag with no ||| renders whole and unfolded, which is the same fallback
       the HSI ladder sub relies on. */
    var tg = scenSplit(scenTok(s.tag, { frozen:true }));
    head.innerHTML =
      '<div><div class="scen-name">'+s.id+' · '+s.name+'</div>'+
      '<div class="scen-tag">'+tg.lead+'</div>'+
      '<div class="meter"><div style="width:'+s.prob+'%;background:'+col+'"></div></div></div>'+
      /* The chevron rides under the weight rather than beside it: .scen-prob is
         tabular-nums and right-aligned so the three weights form a column a
         reader can compare down, and a glyph on the same line would put a
         variable-width character inside that column. */
      '<div class="scen-prob">'+s.prob+'%<span class="scen-chev">&#9656;</span></div>';
    var body = el("div","scen-body");
    body.innerHTML =
      (tg.work ? '<div class="scen-why">'+tg.work+'</div>' : '')+
      '<table><thead><tr><th></th><th>First reaction &amp; targets</th></tr></thead><tbody>'+
      s.rows.map(function(r){ return "<tr><td>"+r[0]+"</td><td>"+scenTok(r[1], { frozen:true })+"</td></tr>"; }).join("")+
      '</tbody></table><div class="invalid">'+scenTok(s.invalid, { frozen:true })+'</div>';
    head.setAttribute("aria-expanded", "false");
    head.onclick = function(){
      var open = body.classList.toggle("open");
      head.setAttribute("aria-expanded", open ? "true" : "false");
      var ch = head.querySelector(".scen-chev");
      if (ch) ch.innerHTML = open ? "&#9662;" : "&#9656;";
    };
    box.appendChild(head); box.appendChild(body); host.appendChild(box);
  });
})();

/* The inputs the branch map is drawn from, and only the inputs. scentest.mjs
   derives the weights, the sum, the modal branch, the fold contents and the
   meter widths from these, with arithmetic written separately from the
   painter's — the card's sub-heading is itself computed from SCENARIOS, so a
   suite that read the sub-heading back off the page would be checking that one
   line of the painter agreed with another. */
window.__wf.scenState = function(){
  return SCENARIOS.map(function(s){
    /* Resolved through the SAME function the painter uses, so a suite comparing
       this against the DOM is comparing two applications of one resolver — a
       token mis-resolving breaks both sides identically and is caught by
       prose_levels instead, which resolves independently in python. */
    var tg = scenSplit(scenTok(s.tag, { frozen:true }));
    return { id:s.id, name:s.name, prob:s.prob, st:s.st, lead:tg.lead, work:tg.work,
             rows:s.rows.length, invalid:scenTok(String(s.invalid), { frozen:true }) };
  });
};
window.__wf.scenTok = scenTok;
/* Exported so a suite can assert the price FUNNEL took the reader's print, not
   merely that a card printed a sentence saying so. */
window.__wf.pxSource = pxSource;
window.__wf.liqPx = liqPx;
/* The overlay, exposed so a suite can assert the invariant directly rather than
   inferring it from rendered text. */
window.__wf.qOverlay = function(bag, nowMs){ return qOverlay(bag || (LIVEQ && LIVEQ.quotes), nowMs); };
window.__wf.overrideQuote = overrideQuote;

/* ---- chain ---- */
(function renderChain(){
  var host = document.getElementById("chain");
  host.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  var LST = { transmitting:{c:"var(--good)",i:"✓"}, weakened:{c:"var(--warning)",i:"◆"}, broken:{c:"var(--critical)",i:"✕"} };
  /* An st value outside those three used to throw on meta.c and take the WHOLE
     page down — every card, not just this one — because one curated word was
     mistyped. It happened for real: a chain link was written st:"untested",
     which is a reasonable-sounding state this renderer has never had.

     The fallback is deliberately not silent and deliberately not pretty. A
     rendered "?" in the axis colour says the state is unrecognised, on the page,
     where the person editing the prose will see it; console.error says the same
     thing where the gates can see it. Swallowing it into a plausible ✓ would be
     worse than the crash, because the crash at least could not be mistaken for
     an assessment this page had actually made. */
  CHAIN.forEach(function(n){
    var node = el("div","node",'<div class="node-name">'+n.node+'</div><div class="node-val">'+n.val+'</div>');
    host.appendChild(node);
    /* A NODE CAN CARRY ITS OWN DEFEAT CONDITION, and until 13 August none did.
       The ledger watches OPEN CALLS, and between trades there are none — today
       there are none at all, forty-four hits and nine other resolutions and not
       one live position. So the standing chain rules, which are the claims this
       board actually holds all the time, were the only assertions on the page
       with no machine watching them: prose in a fold, read on the morning it was
       written. A rule is a claim whether or not money is on it.
       Filled later, not here. biCond and BI_META are declared further down the
       file and this painter runs on the way past, so the slot is registered and
       drawChainBi populates it on every poll alongside the ledger itself. */
    if (n.bi && n.bi.length){
      var slot = el("div","chain-bi");
      node.appendChild(slot);
      CHAINBI.push({ node:n, host:slot });
    }
    if (!n.link) return;
    var lk = el("div","link "+n.link.st);
    var meta = LST[n.link.st];
    if (!meta) {
      console.error('chain link state not recognised: "' + n.link.st + '" on node "' + n.node + '" — expected transmitting, weakened or broken');
      meta = { c:"var(--axis)", i:"?" };
    }
    var btn = el("button","link-btn",'<span style="color:'+meta.c+'">'+meta.i+'</span> <span>→ '+n.link.to+' — '+n.link.label+'</span>');
    btn.type = "button";
    var why = el("div","link-why", n.link.why);
    btn.onclick = function(){ why.classList.toggle("open"); };
    lk.appendChild(btn); lk.appendChild(why); host.appendChild(lk);
  });
})();

/* ==========================================================
   THE INVALIDATION LEDGER
   Every call here is written as a lean plus the condition that would break it.
   That second half has never been held to any standard: it is prose, it is read
   once on the morning it is written, and nothing is obliged to notice when the
   condition it names actually occurs. Two failures follow, with different fixes.

   The first is a selection effect. The published hit rate is computed over the
   calls I chose to resolve, so a pending call whose invalidation fired three
   sessions ago sits here marked pending, in neither numerator nor denominator,
   and the only thing between it and a miss is whether I remember to look. A rate
   computed over a set you curate measures attention, not accuracy.

   The second is worse because it cannot be seen from inside. An invalidation
   written against something this page cannot observe looks exactly like one
   written against something it can — both are a sentence in grey text, both read
   as a promise, and only one of them is a stop.

   So a call carries `bi`: conditions in a form this page can evaluate. It breaks
   if ANY condition fires; a condition fires if ALL its legs are true. That is the
   shape the sentences already have — "this breaks two ways" is two conditions,
   "the 30-year below 5.15 AND the dollar above 100" is two legs.

   THE RULE THE WHOLE THING TURNS ON: a positive observation is definitive, a
   negative conclusion requires complete coverage. One bar through the level
   proves a breach however thin the record. Zero bars through the level proves
   nothing at all unless every bar in the window is present — otherwise the
   correct answer is BLIND, which is not "survived" and is not "broken".

   That is the same fault the sentiment card had this morning, in a different
   card: a clamped value and a measured one scored identically, and only one of
   them could still move. "No bar shows a breach" and "no bars" render identically
   as not-broken, and only one of them is a measurement.
   ========================================================== */

var BI_META = {
  fired:    { c:"var(--critical)",   l:"Broken" },
  defeated: { c:"var(--good)",       l:"Survived" },
  /* "Armed" rather than "Live" or "Open", because this board already has that
     vocabulary and uses it for exactly this idea — the chain nodes re-arm above
     85.94, and a node that has re-armed is one whose condition is watched and
     has not fired. Reusing the word costs nothing and a second word for the same
     state is one more thing the reader has to hold. */
  open:     { c:"var(--warning)",    l:"Armed" },
  waiting:  { c:"var(--text-muted)", l:"Not yet" },
  blind:    { c:"var(--text-muted)", l:"Blind" },
  unmapped: { c:"var(--text-muted)", l:"Unmapped" }
};
/* Cash to futures, never the reverse and never a fixed addition: the ratio
   survives a move and a constant does not. A leg quoted in cash on a symbol with
   no ratio here is UNMAPPED rather than passed through — a level in the wrong
   frame is off by thirty points on ES and eight on RTY, which is the difference
   between a stop and a decoration.

   `unit` is named for what the evaluator does with it rather than for what it
   describes: the only distinction that changes an answer is whether a conversion
   is owed, so it reads "cash" or "quoted" rather than cash/futures/index. The
   limit is the same one the category split has — nothing here can check that a
   level marked "quoted" was not copied out of a cash-quoted brief. The field
   makes the frame a thing that must be stated; it cannot make it true. */
/* Re-derived 4 Aug from the archive, at the OPEN of the 20:00Z bar against the
   settled cash close: 31 Jul ES 7520.00/SPX 7489.72 and RTY 2939.60/RUT 2931.34,
   3 Aug ES 7628.25/SPX 7600.50 and RTY 2990.00/RUT 2981.91. These read 1.0041 and
   1.0030 until this morning, which the ladder subs corrected in prose while this
   line went on converting stops with the old numbers — the page agreeing with
   itself in the paragraph and disagreeing with itself in the machine. Against
   Monday's close the old ES constant put a cash-quoted level 3.4 points high,
   more than one 2.5-point bin, and the comment above says exactly what a level
   in the wrong frame is worth.

   The residual is not small enough to ignore. A second estimator on the same
   feed reads ES 1.00334 against this 1.00365, so the honest span is about 2.4
   points on a cash-quoted ES level. A cash-quoted stop sitting within three
   points of a decision is not resolvable by this page and should be written in
   futures instead — biLevel() will convert it without complaint either way. */
/* RTY moved to 1.0024 on 6 August with the ladder sub above and the guard's own
   BAND table, and this line is the reason that move needed a checker rather than
   a memory: the constant lives in two languages — here, where stops get converted,
   and in prose_levels.py, where quoted levels get audited — and nothing connected
   them. It went stale here for exactly one build. prose_levels.py now parses this
   literal out of the page and hard-fails when the two disagree, so the next move
   cannot land in one place only. The comment above already described this failure
   happening once. Describing it was not enough. */
/* HSI joined this table on 6 August, and it is the only entry here whose basis
   was measured ONCE. ES and RTY are re-derived from paired closes every time the
   archive grows; 0.99978 is HKEX's MHI Aug-26 settlement of 25,910 on 5 August
   over this relay's HK close of 25,915.82 the same session, which is minus 5.8
   index points, HK$58 on one contract. Two vendors quoting the same index that
   day sat 2.1 points apart, so the feed's own error is bounded well inside the
   basis and the number survives its own noise.
   It will not survive August. A basis is carry plus dividends and it walks to
   zero at expiry, and MHI Aug-26 dies on Friday 28 August. Past that date this
   line is not slightly stale, it is measuring a contract that no longer exists,
   and the roll has to be re-measured rather than assumed to carry over.
   Stated as a ratio to match its neighbours and because the drift is
   proportional; on a 25-point HSI bin the difference between 0.99978 and 1.0 is
   under a quarter of a bin, so no level classification turns on it. What turns
   on it is that a cash-quoted HK stop now converts at all. */
/* HSI IS NULL, AND IT IS THE SAME WITHDRAWAL AS CONTRACT.HSI.basis.
   0.99978 was HKEX's MHI Aug-26 settlement of 25,910 on 5 August expressed as a
   ratio -- the same measurement as the -5.8 points above, in the other form the
   page keeps it in. Rolling the contract to Sep-26 and leaving this behind would
   put the two forms in disagreement, which is exactly what the mhi guard checks
   for and exactly what it caught: it reported CONTRACT.HSI.basis null against a
   BI_BASIS implying -5.62 points on the current index.
   biLevel already returns null when the constant is missing, so a cash-quoted
   HSI leg now yields NO level rather than one converted at last month's basis.
   That is the right failure: an unconvertible stop is not a stop at a wrong
   price, it is a stop this page cannot place, and the ledger says so. */
var BI_BASIS = { ES:1.0037, RTY:1.0024, HSI:null };
var BI_BARMS = 300000;   /* the feed's bar interval; coverage is counted in these */

function biLevel(leg){
  if (leg.unit !== "cash") return lnum(leg.v);
  var k = BI_BASIS[leg.sym];
  return k == null ? null : lnum(leg.v) * k;
}
/* The curve a condition is being evaluated against.
   It comes off the PAYLOAD when the payload carries one and off YCD otherwise,
   and the order matters for a reason that is about testability rather than
   taste: bitest drives this evaluator with synthetic inputs and refuses to
   mutate page state, so a leg that could only ever read a global would be a leg
   whose branches are exercised by whatever the curve happens to say today. Four
   of this ledger's six states are already unreachable on a live tape; adding a
   fifth input nobody can vary would be moving in the wrong direction. */
function biCurve(d){
  if (d && d.curve) return d.curve;
  return (typeof YCD !== "undefined" && YCD && YCD.mv) ? YCD.mv : null;
}
function biNow(leg, d){
  if (leg.src === "rate") return d && d.rates ? lnum(d.rates[leg.sym]) : null;
  /* TWO INSTRUMENTS AGAINST EACH OTHER, in basis points of session return.
     Every other leg compares one instrument's price against a fixed level, and
     the 3 August ledger entry recorded that gap by name: the long-end DEFEAT
     condition compares RUT's day against NDX's, "there is no shape in the ledger
     for a spread condition, which is a schema gap rather than a feed gap and is
     therefore fixable here rather than upstream". This is that fix.
     It reads chg_pct, which the feed already carries per symbol, rather than
     differencing prices — the two are the same arithmetic and only one of them
     has to guess what the previous close was. */
  if (leg.src === "chgspread"){
    var qa = d && d.quotes && d.quotes[leg.sym], qb = d && d.quotes && d.quotes[leg.vs];
    if (!qa || !qb) return null;
    /* THROUGH THE LIST, both legs. The comment above says this reads chg_pct so
       that "only one of them has to guess what the previous close was" -- which
       is exactly the guess UNTRUSTED_PREV exists to refuse. lnum() is a numeric
       coercion and carries no guard, so reading through it consulted nothing.
       Either leg untrusted kills the spread rather than half of it: a difference
       of two percentages is only as good as the worse reference behind it, and
       there is no honest way to report a spread with one end unpublishable. */
    var ca = liveChg(qa, leg.sym), cb = liveChg(qb, leg.vs);
    return (ca == null || cb == null) ? null : (ca - cb) * 100;
  }
  /* ONE TENOR'S DAY, in basis points, as a MAGNITUDE — the question is whether
     the long end moved, not which way. Taken from YCD.mv, which the curve
     generator computes from paired official closes, rather than differenced here:
     a second implementation of one subtraction is how the ladder guard and pace()
     came to disagree, and this page has paid for that once already. */
  if (leg.src === "curvechg"){
    var mv = biCurve(d);
    if (!mv || !mv.length) return null;
    var dv = mv[mv.length - 1].dv;
    var v = dv ? lnum(dv[leg.sym]) : null;
    return v == null ? null : Math.abs(v);
  }
  var q = d && d.quotes && d.quotes[leg.sym];
  return q ? lnum(q.px) : null;
}
/* WHICH SESSION A LEG IS TALKING ABOUT, as a UTC date.
   The two sources in a spread condition run on different clocks: the cash indices
   freeze at the New York close and carry that session's chg_pct for the next
   thirteen hours, while treasury.gov publishes its curve on its own schedule. Pair
   them without checking and the condition compares one index's Wednesday against
   the curve's Tuesday — the two would each be correct and the sentence between
   them false, which is the failure mode this whole ledger exists to remove.
   Returns null for legs whose session is not a meaningful question (a price
   against a level is about now, not about a day). */
function biSess(leg, d){
  if (leg.src === "curvechg"){
    var mv = biCurve(d);
    return (mv && mv.length) ? mv[mv.length - 1].d : null;
  }
  if (leg.src === "chgspread"){
    var q = d && d.quotes && d.quotes[leg.sym];
    if (!q || q.ts == null) return null;
    return new Date(q.ts * 1000).toISOString().slice(0, 10);
  }
  return null;
}
function biFmt(leg, v){
  return v == null ? "n/a" : fmt(v, leg.dp == null ? 2 : leg.dp) + (leg.suf || "");
}
/* The window is UTC hours on the UTC day the call was made. No local time and no
   DST anywhere in here: the sessions this board runs on are defined in UTC and
   converting twice is how an hour goes missing in October. */
function biWindow(cond){
  if (!cond.win || cond.from == null) return null;
  var day = Math.floor(cond.from / 86400) * 86400 * 1000;
  return { s: day + cond.win[0]*3600000, e: day + cond.win[1]*3600000 };
}

/* One condition, one verdict. `bars` is passed in rather than read off LIVEBARS
   so the suite can drive this with synthetic bars and a synthetic clock without
   mutating page state — the six states include four that are unreachable on any
   tape that exists today, and a state machine tested only on today's tape is
   tested on one branch. */
function biCond(cond, d, bars, nowMs){
  if (cond.why) return { st:"unmapped", txt:cond.why };
  var legs = cond.legs || [];
  if (!legs.length) return { st:"unmapped", txt:"no legs recorded, and no reason given for that &mdash; which is a defect in the entry rather than a property of the market" };

  var w = biWindow(cond), i;

  /* ---- unwindowed: every leg read off the payload in hand ---- */
  if (!w){
    var parts = [], all = true;
    for (i = 0; i < legs.length; i++){
      var lg = legs[i], lv = biLevel(lg), nv = biNow(lg, d);
      /* The condition tested here is that THIS PAGE holds no basis for the
         symbol, which is a fact about BI_BASIS above and not a fact about the
         world. It used to say "on a symbol with no measured basis" flatly, and
         that was false the moment the HK basis was measured while the table
         had not been updated. Name the table, not the universe. */
      if (lv == null) return { st:"unmapped", txt:lg.label + " is quoted in cash and this page carries no cash-to-futures basis for " + lg.sym + ", so the level cannot be put in the same frame as the price" };
      /* An unreadable input is NOT a false leg. Scoring a missing number as
         "condition not met" is how a break goes unnoticed on the day the feed
         breaks, which is the day it matters most. */
      if (nv == null) return { st:"unmapped", txt:lg.label + " is not in this payload, so the leg cannot be read at all &mdash; and a missing input is not the same as a leg that is false" };
      /* Four ops rather than two. The inclusive pair arrived with the spread
         conditions, where the threshold is a MAGNITUDE derived from a measured
         distribution — "two basis points or less" — and writing that as `below
         2.001` to reuse a strict comparison is the kind of number that reads as a
         typo six weeks later and gets tidied into a different condition. */
      var hit = lg.op === "below"     ? nv <  lv
              : lg.op === "not_above" ? nv <= lv
              : lg.op === "not_below" ? nv >= lv
              :                         nv >  lv;
      if (!hit) all = false;
      /* A leg that has not fired states its DISTANCE, not just its falsity. "the
         dollar is not above 100" and "the dollar is 0.30 from the 100 that breaks
         it" are the same fact and only the second one can be sized against. The
         gap is printed without the leg's suffix on purpose: 0.12 beneath a yield
         quoted in per cent would read as a relative move if it carried one. */
      var WORD = { below:"below ", not_above:"at or below ", not_below:"at or above " };
      parts.push(lg.label + " " + biFmt(lg, nv) + (hit
        ? " is " + (WORD[lg.op] || "above ") + biFmt(lg, lv)
        : " is " + fmt(Math.abs(nv - lv), lg.dp == null ? 2 : lg.dp) +
          " from the " + biFmt(lg, lv) + " that breaks it"));
    }
    /* Every leg that names a session must name the SAME one. Checked after the
       legs are read rather than before, so the message can say which two days it
       was being asked to compare. */
    var sess = null, clash = null;
    for (i = 0; i < legs.length; i++){
      var sv = biSess(legs[i], d);
      if (sv == null) continue;
      if (sess == null) sess = { d:sv, who:legs[i].label };
      else if (sv !== sess.d) clash = { a:sess, b:{ d:sv, who:legs[i].label } };
    }
    if (clash)
      return { st:"waiting", txt: clash.a.who + " is reporting " + clash.a.d + " and " +
        clash.b.who + " is reporting " + clash.b.d + ", so the legs would be describing " +
        "different sessions. The condition waits for both halves of one day rather than " +
        "comparing across two &mdash; each figure would be right and the sentence between " +
        "them wrong, which is the reading this ledger exists to prevent" };
    return { st: all ? "fired" : "open",
             txt: parts.join("; ") + (sess ? " (session " + sess.d + ")" : "") };
  }

  /* ---- windowed: one leg, measured across bars ---- */
  if (legs.length !== 1)
    return { st:"unmapped", txt:"a windowed condition carries one leg. Several instruments measured simultaneously across a bar window needs them delivered in lockstep, which this feed does not do, so the schema refuses it rather than approximating it" };

  var leg = legs[0], lvl = biLevel(leg);
  if (lvl == null) return { st:"unmapped", txt:leg.label + " is quoted in cash and this page carries no cash-to-futures basis for " + leg.sym };

  var winTxt = biClock(w.s) + "&ndash;" + biClock(w.e) + "Z";
  if (nowMs < w.s)
    return { st:"waiting", txt:"the window is " + winTxt + " and it has not opened" };

  var rows = (bars && bars[leg.sym]) || [], inWin = [], breach = false;
  for (i = 0; i < rows.length; i++){
    var r = rows[i];
    if (!r) continue;
    var t = lnum(r[0]);
    if (t == null) continue;
    t *= 1000;
    if (t < w.s || t >= w.e) continue;
    inWin.push(r);
    var hi = lnum(r[2]), lo = lnum(r[3]);
    if ((leg.op === "below" || leg.op === "stays_above") && lo != null && lo <= lvl) breach = true;
    if ((leg.op === "above" || leg.op === "stays_below") && hi != null && hi >= lvl) breach = true;
  }
  var stays = leg.op === "stays_above" || leg.op === "stays_below";
  var side  = (leg.op === "below" || leg.op === "stays_above") ? "below " : "above ";
  var lvlTxt = leg.label + " " + biFmt(leg, lvl);

  /* The positive observation, and it is definitive on any coverage at all. For a
     touch condition the breach IS the break; for a stays-condition the breach is
     what makes the break impossible. Same bar, opposite meaning, and the state
     machine has to say which — "survived" and "broken" are not interchangeable
     even though both are settled. */
  if (breach)
    return stays ? { st:"defeated", txt:"price traded " + side + lvlTxt + " inside " + winTxt + ", so this condition can no longer fire" }
                 : { st:"fired",    txt:"price traded " + side + lvlTxt + " inside " + winTxt };

  if (nowMs < w.e)
    return { st:"open", txt:"nothing " + side + lvlTxt + " yet; the window " + winTxt + " has "
             + Math.max(0, Math.round((w.e - nowMs)/60000)) + " min left" };

  /* Window closed, nothing seen. That is only a verdict if every bar is here. */
  var exp = Math.round((w.e - w.s) / BI_BARMS);
  if (inWin.length < exp)
    return { st:"blind", txt:"the window " + winTxt + " has closed and this page holds " + inWin.length +
             " of its " + exp + " five-minute bars, which cannot rule out a trade " + side + lvlTxt +
             ". The browser keeps a rolling 96 bars, so a window falls out of view about eight hours after it closes" };

  return stays ? { st:"fired",    txt:"all " + exp + " bars of " + winTxt + " held " + (side === "below " ? "above " : "below ") + lvlTxt }
               : { st:"defeated", txt:"all " + exp + " bars of " + winTxt + " stayed clear of " + lvlTxt + ", so this condition can no longer fire" };
}
function biClock(ms){
  var t = new Date(ms);
  return ("0"+t.getUTCHours()).slice(-2) + ":" + ("0"+t.getUTCMinutes()).slice(-2);
}

/* Hoisted out of renderScore, where these two were declared, because biRow now
   needs them and biRow is a sibling of renderScore rather than inside it. Nothing
   about them changed. They are the page's one disclosure primitive: first sentence
   out as the summary, the rest behind the marker, and a string too short to have a
   second sentence is returned untouched rather than wrapped in an affordance that
   opens onto nothing.

   The naive split — first ". " past character 40 — is deliberate and was measured
   before it was trusted: the two things that could break it pull in opposite
   directions (decimals like "82.25." and initialisms like "U.S."), and guarding
   against the second mis-fires on the first in a ledger made of numbers. Across
   all 52 ledger entries, both computed paragraphs and all five break-condition
   reasons there is not one initialism, and every long note splits cleanly with
   leads running 43 to 326 characters. A bad split costs a long summary line,
   never a wrong one. */
function cutLead(t, minLen){
  var x = (t == null) ? "" : String(t);
  if (x.length < minLen) return null;
  var k = x.indexOf(". ", 40);
  return k < 0 ? null : { lead: x.slice(0, k + 1), rest: x.slice(k + 2) };
}
function foldSub(t, minLen, isOpen){
  var cut = cutLead(t, minLen);
  if (!cut) return t;
  return '<details class="fwork fwork-sub"' + (isOpen ? " open" : "") + '>' +
         '<summary>' + cut.lead + '</summary>' +
         '<div class="fwork-b">' + cut.rest + '</div></details>';
}

/* One call's worth. Returns null for anything that is not an open market call —
   a resolved call's invalidation is history and a build entry has none. */
function biCall(c, d, bars, nowMs){
  if (c.cat !== "market" || c.r !== "pending") return null;
  if (!c.bi || !c.bi.length) return [];      /* the caller prints this as a defect */
  return c.bi.map(function(cond){ return { cond:cond, v:biCond(cond, d, bars, nowMs) }; });
}
function biRow(c, d, bars, nowMs){
  var res = biCall(c, d, bars, nowMs);
  if (res == null) return "";
  if (!res.length)
    return '<div class="fbreak"><span class="fbi" style="color:var(--critical)">No condition</span>' +
           'This call names no break condition that the page can read. That is a defect in the entry, not a property of the market.</div>';
  /* WHAT IS FOLDED HERE, AND WHY IT IS NOT THE THING THE GUARD FORBIDS.
     score_guardtest case G exists because folding a break condition is the single
     most tempting way to buy another screen back on this card, and it is the one
     place where density is not worth buying: a stop one tap deep is a stop that
     gets missed. That is still true and this does not do it.
     Three things sit on one of these lines. The chip is the STATE. The bold run is
     the STOP — the number and the shape that invalidate the call. Both of those
     are printed unconditionally, at the front, exactly as before. The tail is the
     EVALUATION, and for every state the page can actually read it is one computed
     clause ("the window is 13:30-20:00Z and it has not opened") that is shorter
     than the fold marker would be.
     The exception is UNMAPPED, where the tail is not an evaluation at all. It is a
     hand-written paragraph explaining why this page cannot check the stop — a
     schema gap, a feed that carries no bars for the instrument, a release with no
     published ACTUAL. Three hundred to five hundred and eighty characters of it,
     inline, in the first row of the card, and every one of the five splits with
     its whole answer in the first sentence. So the first sentence stays out and
     the rest goes behind the marker. The reader still sees the state, the stop,
     and the reason the page is blind to it, without tapping anything.
     Scoped by STATE rather than by length on purpose. A length rule would fold
     whichever tail happened to grow past the threshold, including a computed one,
     and the day a computed evaluation got long enough to qualify is the day the
     guard's defect ships wearing this change's clothes. */
  return res.map(function(x){
    var m = BI_META[x.v.st] || BI_META.unmapped;
    var raw  = x.v.txt;
    var tail = x.v.st === "unmapped" ? foldSub(raw, 240, false) : raw;
    /* The em-dash only earns its place when the tail runs on from the stop. A
       <details> is a block and starts its own line, so the dash would be left
       hanging off the end of the bold run looking like a typo. foldSub returns
       the string it was given when there was nothing to fold, so comparing
       against it is how this asks "did that fold" without asking twice. */
    var sep  = tail === raw ? ' &mdash; ' : '';
    return '<div class="fbreak"><span class="fbi" style="color:'+m.c+'">'+m.l+'</span><b>'+
           x.cond.n+'</b>'+sep+tail+'</div>';
  }).join("");
}

/* The standing rules, evaluated on the same payload and the same poll as the
   ledger. Same visual grammar as biRow on purpose: a defeat condition on a chain
   rule and an invalidation on a trade are the same object, and giving them two
   appearances would teach the reader they are two kinds of promise. */
function drawChainBi(d, bars, nowMs){
  CHAINBI_LAST = [];
  for (var i = 0; i < CHAINBI.length; i++){
    var e = CHAINBI[i], out = "";
    for (var j = 0; j < e.node.bi.length; j++){
      var cond = e.node.bi[j], v = biCond(cond, d, bars, nowMs);
      /* Kept so the suite can compare the DOM against what was actually DRAWN,
         rather than against a fresh evaluation it ran itself. Those are different
         questions and only the first one catches a painter that has stopped
         painting what the evaluator said. */
      CHAINBI_LAST.push({ n:cond.n, st:v.st, txt:v.txt });
      var m = BI_META[v.st] || BI_META.unmapped;
      var tail = v.st === "unmapped" ? foldSub(v.txt, 240, false) : v.txt;
      var sep = tail === v.txt ? " &mdash; " : "";
      out += '<div class="fbreak"><span class="fbi" style="color:'+m.c+'">'+m.l+'</span><b>'+
             cond.n+'</b>'+sep+tail+'</div>';
    }
    e.host.innerHTML = out;
  }
}
window.__wf = window.__wf || {};
window.__wf.drawChainBi = drawChainBi;
window.__wf.chainBi = function(){ return CHAINBI.map(function(e){ return e.node; }); };
window.__wf.chainBiDrawn = function(){ return CHAINBI_LAST; };

/* Exposed for the suite. The DOM test proves the wiring; this proves the logic,
   and the logic has six states of which four are unreachable on today's tape. */
window.__BI = { cond:biCond, call:biCall, meta:BI_META };

/* The tally. Deliberately counts CONDITIONS rather than calls, because a call
   with two named branches has two invalidations and they can be in different
   states — today's term-premium call has one branch this page can check and one
   it cannot, and averaging those into a single verdict per call would hide
   exactly the thing worth seeing. Every number below is counted; none is typed. */
function biSummary(d, bars, nowMs){
  var tot = 0, un = 0, fired = 0, open = 0, blind = 0, calls = 0, none = 0, why = [];
  CALLS.forEach(function(c){
    var res = biCall(c, d, bars, nowMs);
    if (res == null) return;
    calls++;
    if (!res.length){ none++; return; }
    res.forEach(function(x){
      tot++;
      if (x.v.st === "unmapped"){ un++; why.push(x.cond.n); }
      else if (x.v.st === "fired") fired++;
      else if (x.v.st === "blind") blind++;
      else open++;
    });
  });
  if (!calls) return "";
  var s = "<b>" + (tot - un) + " of the " + tot + "</b> break condition" + (tot===1?"":"s") +
          " attached to the " + calls + " open market call" + (calls===1?"":"s") +
          " can be evaluated from this page&rsquo;s own data";
  s += un === 0
    ? ", which is every one of them."
    : ". The " + (un===1 ? "one that cannot" : un + " that cannot") + " &mdash; " +
      why.join(", ") + " &mdash; " + (un===1?"is":"are") +
      " written against something this feed does not carry, and " + (un===1?"is":"are") +
      " named below with the reason. An invalidation the page cannot check is a sentence, not a stop, and until this line existed the two were indistinguishable.";
  if (fired) s += " <b>" + fired + "</b> " + (fired===1?"has":"have") +
    " already fired and the call" + (fired===1?"":"s") + " above " + (fired===1?"is":"are") +
    " still marked pending &mdash; that is the selection effect this check was built to catch, and it is now visible rather than dependent on my going to look.";
  if (blind) s += " " + blind + " sit" + (blind===1?"s":"") +
    " on a window that has closed and scrolled out of the browser&rsquo;s rolling bar history, so " +
    (blind===1?"it is":"they are") + " reported blind rather than survived.";
  if (none) s += " " + none + " call" + (none===1?"":"s") +
    " carr" + (none===1?"ies":"y") + " no machine-readable condition at all, which is a defect in the entry.";
  return s;
}

var RESCORE = null;
/* ---- scorecard ---- */
(function renderScore(){
  /* Two ledgers behind one list. counts is MARKET calls, which is what the
     headline is about and the only bucket where a result carries information.
     sys is the build log — guards, suppressions, withdrawals — where the result
     is "hit" by construction because nobody writes down a change that did not
     work, so averaging the two reports engineering diligence as market accuracy.

     Category is read, never inferred. An entry that declares neither is counted
     in NEITHER and reported as a defect: defaulting it into the market bucket is
     how the headline moves without anyone being told, which is the failure this
     split exists to end. */
  /* cutLead and foldSub used to be declared here. They moved up beside biRow, which
     now needs them too; the definitions are unchanged and every call below still
     reads the same. Three places on this card carry a paragraph that justifies a
     number printed directly above it, and in all three the justification is the
     thing that made the card 8.3 phone screens long. */

  var counts = { hit:0, partial:0, miss:0, notrade:0, pending:0 };
  var sys    = { hit:0, partial:0, miss:0, notrade:0, pending:0 };
  var unc = 0;
  CALLS.forEach(function(c){
    if (c.cat === "system") sys[c.r]++;
    else if (c.cat === "market") counts[c.r]++;
    else unc++;
  });
  var resolved = counts.hit + counts.partial + counts.miss;
  var sysRes   = sys.hit + sys.partial + sys.miss;
  var rate = function(n, d){ return d ? Math.round(n / d * 100) : 0; };

  var stats = document.getElementById("scoreStats");
  stats.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  var oldNote = document.getElementById("scoreNote");
  if (oldNote && oldNote.parentNode) oldNote.parentNode.removeChild(oldNote);
  [["hit","Hit"],["partial","Partial"],["miss","Missed"],["notrade","No trade"],["pending","Pending"]].forEach(function(p){
    var d = el("div","sstat");
    d.innerHTML = '<div class="sstat-v">'+counts[p[0]]+'</div>'+
      '<div class="sstat-l"><i style="color:'+RES_META[p[0]].c+';font-style:normal">'+RES_META[p[0]].i+'</i> '+p[1]+'</div>';
    stats.appendChild(d);
  });

  /* Every number in this sentence is COUNTED, including the miss count. It used
     to read "the two misses" as a literal, and by 3 Aug there were three — the
     sentence had been wrong for two days and nothing could tell, because a
     hand-typed count beside a computed one looks exactly like a computed one.
     Same bug class as the hand-typed tile prices; same fix. */
  var missNote = counts.miss === 0
    ? "Nothing has missed yet, which says more about how short the board is than about how good the calls are."
    : counts.miss === 1
      ? "The one miss stays on the board permanently — a call deleted after it fails is not a record, it is advertising."
      : "All " + counts.miss + " misses stay on the board permanently — a call deleted after it fails is not a record, it is advertising.";
  /* Both rates are computed and shown together. Printing only the honest one
     would hide how far off the old headline was; printing only the difference
     would need a hand-typed baseline, which is the bug class this page has spent
     the day removing. So: what it is, what it would be, and the reason. */
  var sysNote = sysRes === 0 ? "" :
    " The " + sysRes + " build entries — a suppression, a withdrawn level, a guard added the day it caught something — sit in their own filter and are counted in neither number above. They are only ever written down after they work, so their result is hit by construction and says nothing about calibration. Folded in they read " +
    rate(counts.hit + sys.hit, resolved + sysRes) + "% instead of " + rate(counts.hit, resolved) +
    "%, which is what this board reported until the two were separated.";
  /* Said wherever the hit rate is said. A denominator that silently drops a
     category is the same defect as a count that silently drops a row. */
  var ntNote = counts.notrade === 0 ? "" :
    " " + counts.notrade + " call" + (counts.notrade === 1 ? "" : "s") +
    " specified a trigger that never fired, so no position was taken; " +
    (counts.notrade === 1 ? "it is" : "they are") + " in neither number above. " +
    "A conditional whose condition never happened says nothing about the forecast, " +
    "and counting it either way would be a claim about a trade that does not exist.";
  var uncNote = unc === 0 ? "" :
    " " + unc + " entr" + (unc===1?"y carries":"ies carry") + " no category and " + (unc===1?"is":"are") +
    " in neither count — that is a defect in the entry, not a result.";
  /* The first sentence of this paragraph is the number the card exists to print.
     Everything after it is why that number is shaped the way it is: why the misses
     are never deleted, why the build log is counted separately, what the headline
     read before the two were split. All of it true, none of it needed to answer
     "is this board's judgement any good", and ninety words of it sat between the
     answer and the record it is drawn from. */
  /* C1: the answer to "is this board's judgement any good" is ONE number, and
     it used to open a ninety-word paragraph at body size. Promoted to a figure
     row above the tiles; the paragraph keeps everything else (misses stay on
     the board, the build-log split, the uncategorised note) — nothing removed,
     one thing enlarged. Remove-if-present like #scoreNote beneath it: freeze()
     bakes this markup in, and without the removal the next load would print a
     second figure on top of the first. */
  var oldFig = document.getElementById("scoreFig");
  if (oldFig && oldFig.parentNode) oldFig.parentNode.removeChild(oldFig);
  if (resolved > 0){
    var figRow = el("div","score-figrow");
    figRow.id = "scoreFig";
    figRow.innerHTML =
      '<div class="score-fig">' + rate(counts.hit, resolved) + '%</div>' +
      '<div class="score-figsub">clean hit rate &middot; ' + resolved + ' resolved market calls<br>' +
      rate(counts.hit + counts.partial*0.5, resolved) + '% counting partials as half' +
      (counts.notrade ? '<br>' + counts.notrade + ' more never triggered &mdash; counted in neither' : '') +
      '</div>';
    stats.parentNode.insertBefore(figRow, stats);
  }
  var noteTxt = resolved === 0
    ? "Nothing resolved yet — " + counts.pending + " market call" + (counts.pending===1?"":"s") + " still open, and a hit rate computed on nothing would be a made-up number." + sysNote + uncNote
    : missNote + ntNote + sysNote + uncNote;
  var note = el("div","card-sub", foldSub(noteTxt, 220, false));
  note.style.marginBottom = "12px";
  note.id = "scoreNote";
  stats.parentNode.insertBefore(note, document.getElementById("scoreFilters"));

  /* ---- the record as a shape ----
     Everything above this point is a COUNT, and a count has no time axis. "21 of
     28" is the same sentence whether the three misses are the three oldest calls
     on the board or the three newest, and those are opposite facts about whether
     this thing is working. The sentiment chart added a trajectory to the tone
     score for exactly that reason; this is the same move applied to the record.

     Market only. The build log is hit by construction — nobody writes down a
     change that did not work — so plotting it would draw a wall of green that
     means nothing and would swamp the twenty-eight marks that do.

     Built here rather than inside list(), because CALLS is static: the strip is a
     function of the ledger and not of the tape, so it does not belong in the
     thing that repaints every poll. It IS removed-if-present, because freeze()
     bakes this markup into the shipped file and the next build's renderScore
     finds it already in the document — the same reason #scoreNote is removed. */
  var oldRec = document.getElementById("scoreRecord");
  if (oldRec && oldRec.parentNode) oldRec.parentNode.removeChild(oldRec);
  /* How many recent resolved calls count as "the recent stretch". One number, used
     in two places and deliberately not typed in two places: the caption below
     computes the recent hit rate over this many calls, and list() shows exactly
     these calls in the default view with the older ones folded underneath. If the
     two ever drifted apart the card would print a sentence about the last ten
     above a list of eight, and nothing on this page would catch it — both halves
     would be internally consistent and the reader would be the only check. */
  var RECENT_N = 10;
  var mkSeq = CALLS.filter(function(c){ return c.cat === "market"; }).slice().reverse();
  if (mkSeq.length >= 6) {
    var rec = el("div","srec");
    rec.id = "scoreRecord";
    var pips = mkSeq.map(function(c){
      var mm = RES_META[c.r] || RES_META.pending;
      /* the title is desktop-only comfort — there is no hover on a phone — so
         nothing in the caption below is allowed to depend on it */
      return '<i class="spip" data-r="' + c.r + '" title="' + c.d + ' — ' + mm.l + '"></i>';
    }).join("");

    /* Two computed readings, and only two, because the strip is small and a
       caption longer than the picture defeats the point of drawing it. */
    /* The tail measures a HIT RATE, so it must be drawn from the same
       population the rate is: never-fired calls are excluded here for the same
       reason they are excluded from `resolved`, or the recent stretch would be
       diluted by trades nobody took. */
    var seqRes = mkSeq.filter(function(c){ return c.r !== "pending" && c.r !== "notrade"; });
    var tail   = seqRes.slice(-RECENT_N);
    var tHit   = tail.filter(function(c){ return c.r === "hit"; }).length;
    var rTail  = rate(tHit, tail.length), rAll = rate(counts.hit, resolved);
    var drift  = tail.length < 4 || resolved === 0 ? "" :
      rTail === rAll
        ? " The last " + tail.length + " resolved ran at " + rTail + "%, the same rate as the whole record."
        : " The last " + tail.length + " resolved ran " + rTail + "% against " + rAll +
          "% across the whole record, so the recent stretch is the " +
          (rTail > rAll ? "stronger" : "weaker") + " half &mdash; which on " + tail.length +
          " calls is noise until it persists.";

    /* Where the misses sit is the question a reader actually brings to a record,
       and it is the one thing a phone reader cannot get by hovering a mark. */
    var lastMiss = -1;
    mkSeq.forEach(function(c, i){ if (c.r === "miss") lastMiss = i; });
    var missWhere = lastMiss < 0 ? "" :
      (function(){
        var back = mkSeq.length - 1 - lastMiss;
        return back === 0
          ? " The newest call on the board is a miss."
          : " The most recent miss is " + back + " call" + (back===1?"":"s") +
            " back, on " + mkSeq[lastMiss].d + ".";
      })();

    rec.innerHTML =
      '<div class="srec-track" role="img" aria-label="' + mkSeq.length +
        ' market calls, oldest to newest: ' + counts.hit + ' hit, ' + counts.partial +
        ' partial, ' + counts.miss + ' missed, ' +
        (counts.notrade ? counts.notrade + ' never triggered, ' : '') +
        counts.pending + ' still open">' + pips + '</div>' +
      /* The four tiles directly above already print the colour key with its icons
         and labels, so repeating it here would be a legend for a legend. What is
         NOT up there is the direction convention, and that is one clause. */
      '<div class="srec-cap">Oldest left; hits above the line, misses below.' +
        missWhere + drift + '</div>';
    stats.parentNode.insertBefore(rec, note);
  }

  var cur = "all";
  var fhost = document.getElementById("scoreFilters");
  fhost.innerHTML = "";   /* idempotent: this markup ships pre-rendered */
  [["all","All"],["hit","Hit"],["partial","Partial"],["miss","Missed"],["notrade","No trade"],["pending","Pending"],["system","Build log"]].forEach(function(p){
    var b = el("button","toggle",p[1]); b.type="button";
    if (p[0]===cur) b.style.color = "var(--text-primary)";
    b.onclick = function(){
      cur = p[0];
      Array.prototype.forEach.call(fhost.children,function(c){ c.style.color="var(--text-secondary)"; });
      b.style.color = "var(--text-primary)";
      list();
    };
    fhost.appendChild(b);
  });

  /* Sits under the filters and is rewritten on every repaint. It carries the
     number this whole patch exists to produce: not how many calls are open, but
     how many of their stated invalidations this page can actually evaluate. */
  /* removed-if-present, for the same reason #scoreNote and #scoreRecord are, and
     it was missing here until a screenshot of the built file showed the sentence
     printed twice under the filters. renderScore runs once per page, so on a fresh
     load there is nothing to duplicate and every check that reads the FIRST match
     of an id sees a correct element. It only appears after freeze() has baked this
     div into the shipped markup and the next build's renderScore inserts a second
     one beside it. Both are individually correct; there are simply two. */
  var oldBrk = document.getElementById("scoreBreak");
  if (oldBrk && oldBrk.parentNode) oldBrk.parentNode.removeChild(oldBrk);
  var brk = el("div","card-sub");
  brk.id = "scoreBreak";
  brk.style.margin = "10px 0 2px";
  fhost.parentNode.insertBefore(brk, fhost.nextSibling);

  /* The instant this card was last painted at. paintAll threads ONE instant
     through every painter so the whole page agrees on what "now" is; this card
     took the argument and then called Date.now() anyway. While the page is live
     the two differ by microseconds, so the bug is invisible everywhere except
     the one place it matters: the build. freeze() repaints at the SNAPSHOT
     instant and every other card obeyed, so a static file whose every number
     comes from 12:48 was carrying break states evaluated at whatever moment the
     build happened to run — and an invalidation baked at the wrong clock is the
     precise failure this ledger was added to stop shipping. It is REMEMBERED
     rather than read straight off the argument because the filter buttons call
     list() with no argument: a click must not silently jump the card forward to
     the wall clock while the prices above it stay frozen. */
  var painted = null;
  var brkOpen = false;   /* survives the repaint that rewrites the line */

  /* ---- the working note, folded ----
     Open state lives OUT here for the same reason ladDiscOpen does: RESCORE = list,
     paintAll calls it on every poll, and list() clears #scoreList — so a <details>
     built inside it is destroyed and rebuilt shut roughly once a minute, snapping
     closed under a reader mid-sentence. Keyed by the entry's index in CALLS rather
     than by date, because two entries share a date more often than not. */
  var workOpen = {};
  var W_FOLD = 150;   /* shorter than this and the fold costs more lines than it saves */
  function workHtml(c, ci){
    var o = (c.o == null) ? "" : String(c.o);
    if (!o) return "";
    var cut = cutLead(o, W_FOLD);
    if (!cut) return '<div class="fout">' + o + '</div>';
    return '<details class="fwork"' + (workOpen[ci] ? " open" : "") + '>' +
           '<summary>' + cut.lead + '</summary>' +
           '<div class="fwork-b">' + cut.rest + '</div></details>';
  }

  /* ---- the older half of the ledger ----
     #scoreList was 3,844 of this card's 4,251 px, and about three thousand of that
     was thirty resolved calls from 20 July onward. The record is the point of the
     card and none of it may quietly go away; what CAN go away is the requirement
     to scroll past twenty of them to reach the second open call.

     So the default view keeps the pending calls and the RECENT_N most recent
     resolved — the same ten the caption above is already describing — and folds
     the rest. Three properties make that a view rather than a shorter ledger, and
     all three are load-bearing:

       the summary states the count, the span and the breakdown, so a reader who
       never taps it still knows exactly what is behind it and how it resolved;

       the tiles and the hit rate above are computed over the whole of CALLS before
       any of this runs, so folding cannot move the headline;

       and the window applies ONLY to `all`. Tap Missed and every miss in the
       ledger is listed, because a reader who taps Missed is asking for the misses
       and answering with the recent ones would be the exact dishonesty this fold
       is meant to avoid.

     What it does NOT claim is that everything folded is drawn in the strip above.
     The strip is market-only and this list shows any entry that is not system —
     true of all 30 today, and a sentence that would quietly become false the day
     a third category is added. The two claims it does make are structural and
     cannot come apart. */
  var restOpen = false;
  function restFold(rows, cs){
    var hc = { hit:0, partial:0, miss:0 }, parts = [];
    cs.forEach(function(c){ if (hc[c.r] != null) hc[c.r]++; });
    if (hc.hit)     parts.push(hc.hit + " hit");
    if (hc.partial) parts.push(hc.partial + " partial");
    if (hc.miss)    parts.push(hc.miss + " missed");
    var det = el("details","fwork frest");
    if (restOpen) det.setAttribute("open","");
    /* oldest to newest, because CALLS is authored newest-first and a span printed
       in the order the array happens to sit in would read backwards */
    det.innerHTML = '<summary>' + rows.length + ' older resolved call' +
      (rows.length === 1 ? "" : "s") + ', ' + cs[cs.length - 1].d + ' to ' + cs[0].d +
      (parts.length ? ' &mdash; ' + parts.join(", ") : "") +
      '. All of them are counted in the tiles and the rate above, and the filter ' +
      'buttons search the whole ledger. This is the default view, not a shorter record.' +
      '</summary>';
    var body = el("div","fwork-b");
    rows.forEach(function(r){ body.appendChild(r); });
    det.appendChild(body);
    /* listener last, so the open attribute set above cannot bounce through it */
    det.addEventListener("toggle", function(){ restOpen = det.open; });
    return det;
  }

  function list(atMs){
    if (atMs) painted = atMs;
    var host = document.getElementById("scoreList");
    var d = LIVEQ || SNAPSHOT, nowMs = painted || Date.now();
    host.innerHTML = "";
    /* Build entries appear only under their own filter. Left in the default view
       they would be read as calls — which is how they got into the rate in the
       first place — and an entry with no category still shows here, so a missing
       label is visible in the list as well as stated in the note. */
    /* forEach over the whole ledger with an early return, rather than filter().
       forEach(), because the fold needs the entry's index in CALLS and a filtered
       forEach reports the index in the FILTERED array — which changes the moment
       anyone taps a filter button, so the open notes would jump to different rows. */
    var restR = [], restC = [], resSeen = 0;
    CALLS.forEach(function(c, ci){
      if (cur === "system") { if (c.cat !== "system") return; }
      else if (c.cat === "system") return;
      else if (cur !== "all" && c.r !== cur) return;
      var m = RES_META[c.r];
      var r = el("div","frow");
      r.innerHTML =
        '<div><div class="fcall">'+c.c+'</div><div class="fdate">'+c.d+'</div>'+
        workHtml(c, ci)+
        biRow(c, d, LIVEBARS, nowMs)+'</div>'+
        '<div>'+chip(m)+'</div>';
      /* toggle does NOT bubble, so this cannot be delegated to the host. The
         listener dies with the row on the next repaint, which is correct. */
      var dt = r.querySelector("details.fwork");
      if (dt) dt.addEventListener("toggle", function(){ workOpen[ci] = dt.open; });
      /* The window. Counted in ITERATION order, which is newest-first, so the ten
         that stay out are the ten most recent — the same ten the caption above is
         describing. Pending never counts against it and never goes in: an open
         call is the thing the reader came for, and burying one because eleven
         resolved calls happen to sit above it would be the worst version of this
         change. `cur === "all"` is the whole of the exemption — every explicit
         filter renders its complete set. */
      if (cur === "all" && c.r !== "pending" && ++resSeen > RECENT_N) { restR.push(r); restC.push(c); }
      else host.appendChild(r);
    });
    if (restR.length) host.appendChild(restFold(restR, restC));
    /* Same fold as the note, with one difference that matters: this line is
       rewritten on every poll, so its open flag has to survive the rewrite or it
       snaps shut under the reader. The lead carries the count of invalidations
       this page can actually evaluate, which is the load-bearing fact; the tail
       names which ones it cannot and why. The per-row .fbreak lines underneath
       stay unfolded regardless — those are stop logic, not commentary. */
    brk.innerHTML = foldSub(biSummary(d, LIVEBARS, nowMs), 220, brkOpen);
    var bd = brk.querySelector("details.fwork");
    if (bd) bd.addEventListener("toggle", function(){ brkOpen = bd.open; });
  }
  list();
  /* Handed out so paintAll can repaint it. The break states are a function of the
     tape, so a scorecard drawn once at load starts going stale the moment the
     first poll lands — and a stale invalidation state is the one kind this
     feature exists to stop shipping. The filter lives in this closure and stays
     put across repaints, which is the reason for handing out `list` rather than
     re-running the whole IIFE. */
  RESCORE = list;
})();

/* =====================================================================
   LIVE LAYER
   Polls the public relay mirror and repaints the top of the page.
   Everything below the range map is the twice-daily narrative and is
   deliberately NOT touched here — that gets rewritten at brief time.
   ===================================================================== */
/* HOISTED OUT OF live() ON 27 AUG, and the move is the fix rather than a tidy.
   Both are pure formatters over a number, both were declared inside the live()
   IIFE, and both were therefore invisible to every painter outside it. The
   anchored-VWAP card is outside it -- like drawLiq and drawDecide -- and calling
   stamp() from there threw `stamp is not defined` at paint time, which is the
   var-scope trap this page documents beside rollEl in exactly the opposite
   direction: not a painter declared inside and wired outside, but a helper
   declared inside and needed outside.
   Copying them would have been the smaller diff and the worse one: two
   implementations of "how old is this" drift, and this card's whole job is
   stamping the age of two different vintages side by side. */
function ago(s){
  if (s==null) return "—";
  s = Math.round(s);
  if (s < 90)   return s + "s";
  if (s < 5400) return Math.round(s/60) + "m";
  return (s/3600).toFixed(1) + "h";
}
function stamp(ts){
  return new Date(ts*1000).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"});
}

(function live(){

/* Two independent public mirrors of the same file. GitHub raw is the primary;
   jsDelivr is a CDN edge that often survives networks where raw is blocked.
   Tried in order, each with a short leash — a phone user must not stare at a
   spinner while a dead socket runs down a 12-second clock. */
var MIRRORS = [
  { n:"GitHub raw", u:"https://raw.githubusercontent.com/waltywalty/waft-data/main/latest/free.json" },
  { n:"jsDelivr",   u:"https://cdn.jsdelivr.net/gh/waltywalty/waft-data@main/latest/free.json" }
];
/* The 5-minute bar history, used only to measure the typical 30-minute move.
   Same two mirrors, but a much slower poll: the file cannot change more often
   than every five minutes, and it is four times the size of the quote file. */
var BAR_MIRRORS = [
  { n:"GitHub raw", u:"https://raw.githubusercontent.com/waltywalty/waft-data/main/latest/free-bars.json" },
  { n:"jsDelivr",   u:"https://cdn.jsdelivr.net/gh/waltywalty/waft-data@main/latest/free-bars.json" }
];
/* The economic calendar. This is the file that stops the catalyst board running
   dry two days after every brief: the relay refreshes it hourly, so the FACTS —
   what is scheduled, when, and the consensus impact — maintain themselves. The
   judgement half stays in CATJ above, where it belongs. */
var CAL_MIRRORS = [
  { n:"GitHub raw", u:"https://raw.githubusercontent.com/waltywalty/waft-data/main/latest/calendar.json" },
  { n:"jsDelivr",   u:"https://cdn.jsdelivr.net/gh/waltywalty/waft-data@main/latest/calendar.json" }
];
/* ---- HOW OFTEN TO ASK ----
   A fixed sixty seconds is wrong in both directions at once. Over a weekend halt
   it is nine hundred pointless requests against a file nobody is rewriting, on a
   phone, on a borrowed connection. Twenty minutes either side of the cash open it
   is far too slow: that is the window where a minute of staleness is the
   difference between a level being live and being history, and it is the one
   window this whole board exists to be right in.

   So the cadence is chosen from the clock, and the choice is MEASURED rather than
   asserted wherever the data can settle it. The Asian tier is the clearest case:
   this archive's own session weights put roughly half the five-minute bars in
   Asian hours and under a tenth of the volume, so a level turned at 3am Hong Kong
   was turned by nobody and polling for it twice a minute buys nothing.

   THE CADENCE IS PRINTED. A reader who sees a two-minute-old quote must be able
   to tell "quiet by design" from "broken", and a page that changes its own
   refresh rate without saying so makes that impossible — it would look exactly
   like the lag the guard banner exists to report. */
var POLL_TIERS = [
  { k:"event", ms:20000,  say:"every 20s &mdash; inside the twenty minutes either side of a scheduled release" },
  { k:"bell",  ms:20000,  say:"every 20s &mdash; around the cash open and close, where a minute of staleness costs the most" },
  { k:"rth",   ms:45000,  say:"every 45s &mdash; the New York cash session" },
  { k:"eur",   ms:60000,  say:"every minute &mdash; European hours" },
  { k:"asia",  ms:120000, say:"every two minutes &mdash; Asian hours carry about half this archive&rsquo;s bars and under a tenth of its volume" },
  { k:"shut",  ms:900000, say:"every 15 minutes &mdash; the contracts are in the weekend halt and the file is not being rewritten" }
];
function pollTier(nowMs){
  var now = nowMs || Date.now();
  if (typeof cmeClosed === "function" && cmeClosed(now)) return POLL_TIERS[5];
  var d = new Date(now), h = d.getUTCHours() + d.getUTCMinutes() / 60;
  /* Scheduled releases first: an event moves the tape harder than the hour does,
     and nextEvent() is the same selector the countdown and the summary use. */
  var nx = (typeof nextEvent === "function") ? nextEvent(now) : null;
  if (nx){
    var dt = (new Date(nx.t).getTime() - now) / 60000;
    if (dt <= 20) return POLL_TIERS[0];
  }
  /* The bell, both ends. 13:30Z is the cash open and 20:00Z the close. */
  if (Math.abs(h - 13.5) <= 0.34 || Math.abs(h - 20) <= 0.34) return POLL_TIERS[1];
  var sess = (typeof sessAt === "function") ? sessAt(now) : "RTH";
  if (sess === "RTH") return POLL_TIERS[2];
  if (sess === "EUR") return POLL_TIERS[3];
  if (sess === "EVE") return POLL_TIERS[3];
  return POLL_TIERS[4];
}
var POLL_MS = 60000;   /* the fallback, and the figure every older comment means */
var BARS_MS = 300000;  /* bar history re-poll — it only moves every 5 minutes */
var CAL_MS  = 900000;  /* calendar re-poll — the relay only rewrites it hourly */
var TRY_MS  = 4000;    /* patience per mirror */
var HINT_MS = 1500;    /* when to admit we are still waiting */


var last = null, timer = null, bTimer = null, cTimer = null, rzTimer = null, busy = false;

function $(id){ return document.getElementById(id); }
function clamp(x,a,b){ return x<a?a:(x>b?b:x); }
function num(v){ return (typeof v === "number" && isFinite(v)) ? v : null; }
function pct(v){ return v==null ? "—" : (v>0?"+":"") + v.toFixed(2) + "%"; }
function pcol(v){
  return v==null ? "var(--text-muted)" : v>0 ? "var(--up)" : v<0 ? "var(--down)" : "var(--text-secondary)";
}

/* ================= composite sentiment =====================================
   Every component maps to -1 (risk-off) .. +1 (risk-on), carries a weight, and
   declares which quotes it is computed from. Three things make this more than a
   weighted average:

   1. A REGIME DETECTOR runs first and can flip a component's sign. The textbook
      rule is "weaker dollar = easier conditions = risk-on". That rule is wrong
      when yields are rising AND the dollar is falling AND gold is bid, because
      then dollar weakness is an inflation risk premium, not easing. The old
      version of this card scored that tape as constructive. It was not.
   2. STALENESS IS PRICED, not ignored. A component computed off an old quote
      keeps counting at half weight and says so; past a hard limit it drops out
      and its weight redistributes. Continuously-traded contracts get strict
      limits because their staleness means the feed broke; cash indices get
      lenient ones because their staleness just means the market is shut.
   3. The card names WHAT IS CARRYING THE READ and how far it is from changing
      its mind, because a number with no invalidation line is not a call.

   The judgement inputs — the levels this scores against — live in the block
   below so a brief can move them without touching the engine. */

/* SENT-BEGIN */
/* Reviewed 3 Aug. THE OIL COMPONENT HAS FIRED AND IS NOW PINNED — read this
   before reading the Crude row on the card.

   oil_trigger was written as a forward test: "WTI back at the pre-strike floor
   means the war premium has gone." It has gone. It did not go the way this
   paragraph used to say it did, and the correction is worth more than the claim
   it replaces.

   What stood here was "on Friday it went — crude closed 80.36". Nothing closed at
   80.36: it is a single sample at 01:48Z on MONDAY, occurring exactly once in five
   days of archive. Friday ran the other way — 81.45 at 06:00Z, 85.85 by 15:18Z,
   and the last sample inside the session at 21:00Z was 84.57. One sample under
   81.51 in the whole of Friday, and fifteen hours above it afterwards.

   What Friday SETTLED at, this archive cannot tell you, and that second correction
   is worth more than the first. Two samples printed after the 21:00Z close — 85.94,
   then 86.80 — and 86.80 then held for thirty-one hours across Saturday, which is
   what a weekend placeholder looks like and not what a settle looks like. At 04:00Z
   on Sunday, before any reopen, the feed replaced it with 84.67, about where the
   regular session ended, and 84.67 is what the payload now carries as prev_close.
   The publisher has put out two different Friday closes and swapped one for the
   other mid-weekend. An earlier draft of THIS note asserted the first of them,
   86.80, as "the close, and the high of the day" — the same error as the one it was
   written to correct, in the other direction: a print read off the feed and called
   a settle, only this time the print was a placeholder rather than a live tick. The
   lesson did not take the first time because it was filed as a fact about 80.36
   instead of as a fact about the word "closed".

   Two properties of the source govern all of the above and are worth stating once,
   here, where the arguing about crude happens. It is a SIX-MINUTE SAMPLE, not a
   tape: any extreme between samples is invisible, so it can establish that a level
   was crossed and can never establish that one was not touched. And it has a hole —
   nothing between 16:30Z Thursday and 06:00Z Friday, thirteen and a half hours
   covering the US Thursday afternoon and the Friday Asian morning. The CALLS
   ledger's 81.06 test and its 86.45 rally both sit outside what this archive saw,
   the first inside the hole and the second plausibly between two samples. The
   archive does not contradict the ledger. It was not looking.

   The break was the Sunday reopen, and that part survives all of the above intact.
   At 22:06Z on 2 August the sample was 84.67; six minutes later it was 79.55. The
   premium did not bleed out across a session, it gapped out across a weekend,
   straight THROUGH 81.51 without trading there — and that is much the more useful
   of the two stories, because a level that gets tested and rejected has an auction
   behind it and a level that gets skipped does not. Since that reopen crude has
   sampled 95 times and not once above 81.25, against 84.67 as the last price
   before the gap. Those 3.42 dollars are the part to carry into the week: no
   transacted supply anywhere inside them, so a retrace up into that pocket should
   travel easily and should mean nothing until it reaches the far side of it.

   Keep how the wrong version got written, because it was not a typo. It asserted
   a CLOSE for crude — the one instrument on this page carrying an explicit note,
   in UNTRUSTED_PREV, saying its previous close is not to be trusted. The page had
   already written down that it cannot source a crude close, and then a curated
   paragraph quoted one. A live tick was relabelled as a settle: the
   number was real and the word attached to it was not, which is the same error
   the TILES block was rewritten for.

   And the page had already caught it. CALLS carries a 31 Jul entry scoring the
   "oil premium is leaking" node a MISS, on the grounds that crude did not close
   under the level and rallied instead — written on the day, by the mechanism that
   exists to grade exactly this kind of claim. So the ledger recorded a miss, and
   a paragraph written days later quietly re-graded it to a hit, in the same file,
   about the same instrument. A calibration ledger only does its job if the prose
   is made to agree with the ledger, and never once the other way round.

   Crude has not printed above 81.51 since the reopen, so the component's level leg
   ((oil_resist - px) / span) * 2 - 1  evaluates well over +1 and clamps to +1. The
   change leg is null now that crude is on UNTRUSTED_PREV. The component is
   therefore sitting flat against its rail at +1, carrying its full 12 points of
   weight, and every WTI price from 81.51 all the way to zero scores identically.
   It has stopped discriminating. It is not wrong — cheap crude IS an input-cost
   tailwind for domestic small caps and the read is the right sign — it simply
   contains no new information until crude comes back inside the band.

   This paragraph used to be the whole of the fix, which is to say it was not one.
   The card claims to name what is carrying the read; the fact that the named
   component could not move was recorded in a comment nobody reading the page can
   see. So tone() now keeps every component's PRE-CLAMP legs and marks a component
   pinned when none of them is still inside its range, the row says so, and the
   lead sentence says so in the same breath as the name — along with the largest
   component that IS still free to answer its input. Nothing below is hand-typed:
   the condition is computed from the same legs that produce the score, so it
   un-marks itself the morning crude trades back under 85.94.

   The rails are NOT being re-cut to make the component move again. Both are
   measured events — 81.51 is the pre-strike floor, 85.94 the Iran-headline spike
   high (its DATE is wrong, see the rail's own note) — and refitting a scale so that today's price lands
   somewhere interesting is how a measurement turns into an opinion. They get
   redrawn when there is a new measured range to draw them from, which means a
   fresh consolidation, not a fresh preference.

   Consequence worth carrying into the week: the sentiment card now has one leg
   pinned (oil), and on this payload the regime leg drops out entirely because
   the 10-year quote is 55 hours old, past the 30-hour session limit. That is 32
   of 100 points either saturated or absent, so treat the composite as a coarser
   instrument than usual until the cash session refreshes the rates leg. */
var SENT = {
  oil_trigger: 81.51,   /* pre-strike floor — FIRED on the 2 Aug reopen, 84.67 down to
                           79.55 through the level inside six minutes. It did NOT fire on
                           31 Jul, which is what this line used to say; see the note above
                           and the 31 Jul miss on the CALLS board. */
  oil_resist:  85.94,   /* an Iran-headline spike high, dated 30 Jul when it was written.
                           The archive disagrees with the DATE: Thursday's highest sample
                           is 85.20, and the only 85.94 in five days is Fri 21:06Z — six
                           minutes AFTER the 21:00Z close, in the same two-print window
                           that produced the 86.80 the feed later revised away. So the
                           rail's own provenance sits in the least trustworthy patch of
                           the record, which argues for leaving it exactly where it is
                           rather than for re-cutting it to 86.80: a post-close print is
                           thin evidence for a level, and thin evidence should not be
                           promoted merely because it is higher. Friday's best INTRADAY
                           sample is 85.85, nine cents under the rail and the closest
                           thing to a measured spike high the archive actually holds —
                           which is a decent argument that 85.94 was right all along and
                           only its date was wrong. Left alone on purpose either way; the
                           note above refuses to re-cut a rail to free a pinned leg. */
  vix_mid:     22,      /* VIX scores 0 here, +1 at 14, -1 at 30 */
  curve_full:  0.75,    /* 2s10s slope that scores a full +1; 2s10s is +0.47 today */
  updated:     "2026-08-03"
};
/* SENT-END */

/* Quotes whose staleness means the RELAY broke rather than the market being shut. */
var CONTINUOUS = { ES:1, NQ:1, RTY:1, YM:1, DXY:1, GOLD:1, CRUDE:1 };
var AGE_LIMITS = {
  cont: { warn: 1800,  half: 5400,  drop: 21600  },   /* 30m / 90m / 6h  */
  sess: { warn: 21600, half: 43200, drop: 108000 }    /* 6h  / 12h / 30h */
};

/* The trap this exists for: age_s is measured against the payload's OWN ts, not
   the wall clock. A quote showing age_s:1 inside a seven-hour-old payload is
   seven hours old. Effective age adds the payload's own drift back in. */
function effAge(q, d, nowMs){
  if (!q) return null;
  var a = num(q.age_s); if (a == null) return null;
  var pts = num(d.ts_epoch); if (pts == null) return a;
  return a + Math.max(0, nowMs/1000 - pts);
}

function ageState(keys, d, nowMs){
  var worst = null, cont = false;
  keys.forEach(function(k){
    var a = effAge(d.quotes && d.quotes[k], d, nowMs);
    if (a == null) return;
    if (worst == null || a > worst){ worst = a; cont = !!CONTINUOUS[k]; }
  });
  if (worst == null) return { age:null, mult:1, label:null };
  var L = cont ? AGE_LIMITS.cont : AGE_LIMITS.sess;
  if (worst >= L.drop) return { age:worst, mult:0,   label:"dropped" };
  if (worst >= L.half) return { age:worst, mult:0.5, label:"half weight" };
  if (worst >= L.warn) return { age:worst, mult:1,   label:"ageing" };
  return { age:worst, mult:1, label:null };
}

/* The one honest reason a continuously-traded contract has no recent quote:
   the CME weekend halt. Everything on this card is still history during it —
   the band stays suppressed either way — but the wording has to change, because
   telling him the feed is broken at 3pm on a Saturday sends him to fix a droplet
   that is working fine. Window in UTC, deliberately wide on the reopen side
   (Fri 21:00 → Sun 23:00) to straddle EDT/EST; over-calling the reopen costs
   nothing, since by then quotes are fresh and this label is never read. */
function cmeClosed(nowMs){
  var t = new Date(nowMs), day = t.getUTCDay(), h = t.getUTCHours();
  if (day === 6) return true;                    /* all Saturday UTC */
  if (day === 5 && h >= 21) return true;         /* Friday after the close */
  if (day === 0 && h < 23) return true;          /* Sunday before the reopen */
  return false;
}

/* --- the regime detector -------------------------------------------------
   Read in order; the first rule that matches wins. usd is the sign applied to
   the dollar component: +1 means the textbook reading, -1 means inverted. */
var REGIMES = [
  { id:"infl", y:+1, u:-1, g:+1, s:-0.60, usd:-1,
    name:"Inflation risk premium",
    why:"Yields up while the dollar falls and gold bids. That is the market pricing policy as behind the curve, not as restrictive — so dollar weakness is scoring NEGATIVE here, not positive." },
  { id:"real", y:+1, u:+1, g:-1, s:-0.50, usd:+1,
    name:"Real-rate tightening",
    why:"Yields and the dollar up together with gold soft. Genuine tightening of financial conditions — historically the hardest regime for small caps." },
  { id:"ftq",  y:-1, u:+1, g:+1, s:-0.40, usd:+1,
    name:"Flight to quality",
    why:"Yields down, dollar up, gold up together. Money is paying for safety on three fronts at once." },
  { id:"refl", y:-1, u:-1, g:+1, s:+0.50, usd:+1,
    name:"Reflation",
    why:"Yields easing with a softer dollar and firm gold. The friendliest backdrop on this list for anything cyclical." },
  { id:"ease", y:-1, u:-1, g:-1, s:+0.40, usd:+1,
    name:"Benign easing",
    why:"Yields and the dollar both giving way with no scramble into gold. Conditions loosening quietly." }
];

function sgn(v, floor){ if (v == null) return null; return v > floor ? 1 : (v < -floor ? -1 : 0); }

function regime(d){
  var q = d.quotes || {};
  /* Routed through liveChg so that if the relay's frozen-reference bug ever
     spreads to one of these three legs, the regime reads "unreadable" instead
     of confidently naming a regime off a two-session percentage. */
  var y = sgn(liveChg(q.US10Y, "US10Y", "chg"), 0.015);  /* 1.5bp */
  var u = sgn(liveChg(q.DXY,   "DXY"),          0.15);
  var g = sgn(liveChg(q.GOLD,  "GOLD"),         0.30);
  var parts = { y:y, u:u, g:g };
  if (y == null || u == null || g == null){
    /* This message used to name gold and the date: "On 3 Aug that leg is gold".
       It was true when it was typed. It is a hand-typed fact about a payload,
       sitting inside a function whose entire job is to read whichever payload it
       is handed, on a page where the same species of sentence has already gone
       stale twice today. So it is computed, and it distinguishes the two ways a
       leg can fail — absent, or present but measured from a price that never
       traded — because those want different responses from whoever reads it. One
       is a feed to chase; the other is a curated entry that is doing its job. */
    var out = [];
    [ { s:"US10Y", n:"the 10-year", v:y, q:q.US10Y },
      { s:"DXY",   n:"the dollar",  v:u, q:q.DXY },
      { s:"GOLD",  n:"gold",        v:g, q:q.GOLD } ].forEach(function(L){
      if (L.v != null) return;
      var r = untrusted(L.q, L.s);
      if (r) out.push(L.n + " is measured against a price it never traded from — " + r);
      else if (!L.q) out.push(L.n + " is missing from this payload");
      else out.push(L.n + " carries no usable change in this payload");
    });
    return { id:"unknown", name:"Regime unreadable", s:null, usd:1, parts:parts,
             why:"The regime is the 10-year, the dollar and gold read together, and " +
                 (out.length === 3 ? "none of the three is readable" :
                  out.length === 2 ? "two of the three are not readable" :
                                     "one of the three is not readable") +
                 ", so it is not being scored rather than scored off what is left: " +
                 out.join("; ") + ". Two legs agreeing is not a regime, it is a coincidence " +
                 "with one fewer chance to be contradicted." };
  }
  for (var i = 0; i < REGIMES.length; i++){
    var R = REGIMES[i];
    if (R.y === y && R.u === u && R.g === g) return { id:R.id, name:R.name, s:R.s, usd:R.usd, why:R.why, parts:parts };
  }
  return { id:"mixed", name:"No coherent regime", s:0, usd:1, parts:parts,
           why:"The 10-year, the dollar and gold are not telling one story today. The dollar is being read the textbook way and the regime itself scores neutral." };
}

/* THE SPAN GUARD'S YARDSTICK, populated by the HOST rather than read from a
   data block inside the engine.

   The guard needs each contract's normal day, which lives in SEAS — but the
   sentiment engine is sliced out of this file verbatim and HASHED, and the
   trajectory chart is refused whenever that hash moves. Reading SEAS from
   inside tone() would fold the day-shape archive into the engine's fingerprint,
   so every refresh that banked a new session would invalidate the chart and
   demand a regeneration that changed nothing about the rules. The fingerprint
   has to hash the RULES; the data arrives through this door.

   Null, or a symbol missing from it, means "no yardstick for this contract" and
   the guard stands down for that contract rather than guessing — refusing to
   score something because the ruler is missing would be a different error from
   the one the guard exists to fix, and a quieter one. */
var TONE_NORMAL_DAY = null;

var TONE_DEF = [
  { k:"regime",  w:20, dep:["US10Y","DXY","GOLD"], name:"Macro regime",   sub:"10y · dollar · gold, read together" },
  /* NOT "the overnight range". on_high/on_low arrive from the relay bit-
     identical to d1_high/d1_low on all four contracts — one object wearing two
     labels — so this measures place in the TRAILING SESSION range, whatever
     span that currently covers, and the name now says so. See SPAN GUARD in
     tone(): the span is checked against the contract's own measured normal day
     before the number is allowed to carry weight. */
  { k:"pos",     w:18, dep:["ES","RTY","NQ","YM"], name:"Futures position", sub:"place in the session range so far" },
  { k:"breadth", w:15, dep:["RTY","NQ"],           name:"Small-cap lead",   sub:"RTY minus NQ on the day" },
  { k:"vol",     w:15, dep:["VIX"],                name:"Volatility",       sub:"VIX level and change" },
  { k:"oil",     w:12, dep:["CRUDE"],              name:"Crude",            sub:"distance to the long trigger" },
  { k:"usd",     w:10, dep:["DXY"],                name:"Dollar",           sub:"DXY, sign set by regime" },
  { k:"curve",   w:10, dep:[],                     name:"Curve",            sub:"2s10s slope" }
];

/* Builds the span guard's yardstick from the day-shape archive and hands it to
   the engine. Lives OUTSIDE the engine slice on purpose (see TONE_NORMAL_DAY):
   this function reads SEAS, the engine does not. Median of the contract's own
   closed-day ranges — never a typed constant, never another contract's figure,
   and absent rather than guessed for a symbol with no banked session yet. */
function buildToneNormalDay(){
  if (typeof SEAS === "undefined" || !SEAS || !SEAS.syms) return null;
  var out = null, k, S, a, n;
  for (k in SEAS.syms){
    if (!SEAS.syms.hasOwnProperty(k)) continue;
    S = SEAS.syms[k];
    if (!S || !S.dayRng || !S.dayRng.length) continue;
    a = S.dayRng.slice().sort(function(x, y){ return x - y; });
    n = a.length;
    out = out || {};
    out[k] = n % 2 ? a[(n - 1) / 2] : (a[n / 2 - 1] + a[n / 2]) / 2;
  }
  return out;
}
var TONE_POS_THIN = null;

function tone(d, nowMs){
  /* pre[k] holds each component's legs BEFORE the clamp. A clamped value has
     thrown away the one thing worth knowing about it — whether its input was
     still inside the range. +1 measured and +1 overshot render identically and
     score identically, and only one of them will move when the price does. */
  var q = d.quotes || {}, r = d.rates || {}, s = {}, raw = {}, pre = {};
  var reg = regime(d);

  if (reg.s != null){ s.regime = reg.s; raw.regime = reg.name.toLowerCase().indexOf("no coherent") === 0 ? "mixed" : reg.name.split(" ")[0].toLowerCase(); }

  /* THE SPAN GUARD. "Where does price sit inside the range" is only a reading
     if the range is a range. The relay's window is short and variable, and on
     10 Aug it handed back an RTY span of 4.9 points against a measured normal
     day of about 46 — eleven per cent of a day. Inside a window that narrow,
     "at the top of the range" is not a position, it is the sign of the last
     tick, and it was arriving at weight 18: the largest live weight on the
     board once the regime component drops.

     So each contract is checked against ITS OWN measured median closed-day
     range, taken from the day-shape card's archive rather than from a constant.
     A contract whose current span is under a third of a normal day is not
     saying anything about position and is left out. If none of the four clear
     the floor, the component carries no weight at all — which the card then
     reports the same way it reports a stale input, because a statistic that
     cannot mean anything and one that has gone stale are the same kind of
     absence.

     A third is a judgement, and it is recorded as one rather than tuned: below
     it the "range" is inside a single typical thirty-minute move on most of
     these contracts, and a position inside one move is a tick. */
  var POS_MIN_SPAN = 1/3;
  var ps = [], posThin = [], posSpans = [];
  ["ES","RTY","NQ","YM"].forEach(function(k){
    var v = q[k] && num(q[k].on_pos);
    if (v == null) return;
    var span = q[k] && num(q[k].on_range);
    var norm = TONE_NORMAL_DAY ? TONE_NORMAL_DAY[k] : null;
    if (span != null && norm != null && norm > 0){
      var frac = span / norm;
      posSpans.push({ k:k, frac:frac });
      if (frac < POS_MIN_SPAN){ posThin.push(k); return; }
    }
    ps.push(v);
  });
  if (ps.length){
    var mean = ps.reduce(function(a,b){ return a+b; },0) / ps.length;
    pre.pos = [(mean-0.5)*2];
    s.pos = clamp(pre.pos[0], -1, 1);
    raw.pos = Math.round(mean*100) + "%";
  }
  /* Named, not silent. The card prints this so a component that quietly halved
     its own input count cannot look like one that did not. */
  TONE_POS_THIN = { thin:posThin, used:ps.length, spans:posSpans, floor:POS_MIN_SPAN };

  /* The standing framework is that RTY cushions on down tapes and lags on up
     tapes. Measured on the day's percentage change, not on range position:
     range position compares two different ranges and quietly flatters RTY. */
  var rc = liveChg(q.RTY, "RTY"), nc = liveChg(q.NQ, "NQ");
  if (rc != null && nc != null){
    var gap = rc - nc;
    pre.breadth = [gap/1.2];
    s.breadth = clamp(pre.breadth[0], -1, 1);
    raw.breadth = (gap>=0?"+":"") + gap.toFixed(2) + "pp";
  }

  var vx = q.VIX && num(q.VIX.px), vc = liveChg(q.VIX, "VIX");
  if (vx != null){
    pre.vol = [(SENT.vix_mid - vx)/8, vc == null ? null : -vc/8];
    var lvl = clamp(pre.vol[0], -1, 1);
    var chg = vc == null ? 0 : clamp(pre.vol[1], -1, 1);
    s.vol = clamp(vc == null ? lvl : 0.6*lvl + 0.4*chg, -1, 1);
    raw.vol = vx.toFixed(2);
  }

  /* Cheaper crude is an input-cost tailwind for domestic small caps, and the
     long trigger is a specific price rather than a direction. Score the
     distance to it, then let the day's move nudge it. */
  /* cc comes back null while crude is on the frozen list, which drops the change
     leg and leaves the component on its measured distance-to-trigger alone. That
     is deliberately a no-op TODAY — both legs are pinned at +1, so the score does
     not move by a single point — which is exactly why this is the right morning
     to make the change rather than the morning it would have moved something. */
  var cp = q.CRUDE && num(q.CRUDE.px), cc = liveChg(q.CRUDE, "CRUDE");
  if (cp != null){
    var span = SENT.oil_resist - SENT.oil_trigger;
    pre.oil = [span > 0 ? ((SENT.oil_resist - cp)/span)*2 - 1 : null,
               cc == null ? null : -cc/3];
    var olvl = pre.oil[0] == null ? 0 : clamp(pre.oil[0], -1, 1);
    var och  = pre.oil[1] == null ? null : clamp(pre.oil[1], -1, 1);
    s.oil = clamp(och == null ? olvl : 0.65*olvl + 0.35*och, -1, 1);
    raw.oil = fmt(cp, 2);
  }

  var dc = liveChg(q.DXY, "DXY");
  if (dc != null){ pre.usd = [-dc*3*reg.usd]; s.usd = clamp(pre.usd[0], -1, 1); raw.usd = pct(dc); }

  var sl = num(r.S2s10s);
  if (sl != null){ pre.curve = [sl/SENT.curve_full]; s.curve = clamp(pre.curve[0], -1, 1); raw.curve = (sl>=0?"+":"") + sl.toFixed(2); }

  /* A leg is MOVING if its pre-clamp magnitude is under 1 — inside its range,
     still answering its input. A component is PINNED iff no leg is moving. That
     is exact rather than a heuristic: if every leg is railed the blend of them is
     a constant, and if any one leg is inside its range the blend responds to it.

     A component with no legs recorded is not pinned and not unpinned — it is not
     that kind of thing. Regime is the case: a lookup over five discrete regimes,
     each carrying a fixed score, with no scale to overshoot. */
  var pinned = function(k){
    var legs = pre[k];
    if (!legs) return false;
    for (var i = 0; i < legs.length; i++)
      if (legs[i] != null && Math.abs(legs[i]) < 1) return false;
    return true;
  };

  var wsum = 0, acc = 0, comps = [], dropped = 0;
  TONE_DEF.forEach(function(c){
    var v = s[c.k];
    var st = c.dep.length ? ageState(c.dep, d, nowMs) : { age:null, mult:1, label:null };
    /* pin is only set on a component that is actually carrying weight. On a
       dropped or absent one it would be true and meaningless — the question is
       not "is this railed" but "is weight being held by something that cannot
       move", and weight of zero is not being held by anything. */
    if (v == null){ comps.push({ def:c, v:null, raw:"n/a", age:st, ew:0, pin:false }); return; }
    if (st.mult === 0){ dropped++; comps.push({ def:c, v:v, raw:raw[c.k], age:st, ew:0, pin:false }); return; }
    var ew = c.w * st.mult;
    /* A component running on a fraction of its inputs carries a fraction of its
       weight, for the same reason a stale one does. TONE_DEF's 18 was set for a
       four-contract mean; on 10 Aug three of the four were refused by the span
       guard and the survivor was carrying the full eighteen points on its own —
       a narrower, noisier reading dressed in the weight of a broader one.
       Scaling here rather than at the score keeps it visible: the weight column
       in the table view drops with it, and the headline's missing-weight bound
       widens automatically, which is the correct consequence rather than a
       second thing to remember to do. */
    if (c.k === "pos" && TONE_POS_THIN && TONE_POS_THIN.thin.length && TONE_POS_THIN.used){
      ew = ew * TONE_POS_THIN.used / (TONE_POS_THIN.used + TONE_POS_THIN.thin.length);
    }
    wsum += ew; acc += ew * v;
    comps.push({ def:c, v:v, raw:raw[c.k], age:st, ew:ew, pin:pinned(c.k) });
  });
  if (!wsum) return null;

  var score = Math.round(acc/wsum*100);

  /* What is carrying the read: the single largest signed contribution. */
  var lead = null;
  comps.forEach(function(c){
    if (!c.ew || c.v == null) return;
    var contrib = c.ew * c.v / wsum * 100;
    if (!lead || Math.abs(contrib) > Math.abs(lead.contrib)) lead = { c:c, contrib:contrib };
  });

  /* If the lead is pinned, the useful question is what is left that ISN'T —
     the largest contribution that still answers its input. And how much of the
     live weight is railed, because "some of this cannot move" and "12 of the 80
     points cannot move" are different sentences to act on. */
  var mover = null, pinW = 0;
  comps.forEach(function(c){
    if (!c.ew || c.v == null) return;
    if (c.pin){ pinW += c.ew; return; }
    var contrib = c.ew * c.v / wsum * 100;
    if (!mover || Math.abs(contrib) > Math.abs(mover.contrib)) mover = { c:c, contrib:contrib };
  });

  /* How far from changing its mind: the nearest band edge. */
  var edges = [-50,-20,20,50], near = null;
  edges.forEach(function(e){
    var dist = Math.abs(score - e);
    if (!near || dist < near.dist) near = { edge:e, dist:dist };
  });

  return { score:score, comps:comps, reg:reg, wsum:wsum, dropped:dropped, lead:lead, mover:mover, pinW:pinW, near:near };
}

function band(sc){
  if (sc >=  50) return { l:"Risk-on",      c:"var(--div-pos)" };
  if (sc >=  20) return { l:"Constructive", c:"var(--div-pos)" };
  if (sc >  -20) return { l:"Mixed",        c:"var(--text-secondary)" };
  if (sc >  -50) return { l:"Cautious",     c:"var(--div-neg)" };
  return           { l:"Risk-off",     c:"var(--div-neg)" };
}

function divFill(node, v){            /* v in -1..+1, fills out from the midpoint */
  var w = Math.abs(v) * 50;
  node.style.width = w + "%";
  node.style.left  = (v >= 0 ? 50 : 50 - w) + "%";
  node.style.background = v >= 0 ? "var(--div-pos)" : "var(--div-neg)";
}

/* TONEHIST-BEGIN */
/* Generated by /tmp/dash/tonegen.mjs, do not hand-edit.
   The page's OWN tone() replayed over the six-minute quote archive. Read the
   header of that generator before trusting the level: chg, on_pos and age are
   reconstructed archive-natively because the provider's settles are not in the
   archive, so the SHAPE is one consistent measurement and the LEVEL is offset
   from the headline by tone_gap, which is computed here rather than assumed. */
var TONEHIST = {
  eng: "b67361c89249",
  n: 4391,
  t0: 1785477592, t1: 1787882402,
  lo: -46, hi: 69,
  minw: 70, thin: 2370,
  reg: ["mixed","real","refl","ease","infl","ftq"],
  live: 17,
  live_t: 1787882402,
  live_w: 82,
  gap: -13,
  gap_by: [["breadth",-14.2],["usd",1.2],["regime",0.0],["pos",0.0],["vol",0.0],["oil",0.0],["curve",0.0]],
  d: { h1: 1, h6: 11, h24: 9, d3: 22 },
  rows: [
    [1785477592,20,72,0,0],
