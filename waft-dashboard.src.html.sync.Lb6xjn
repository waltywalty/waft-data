      { p:3001.0, name:"Value-area low", st:"untested", tests:0,
        why:"Lower edge of the 70% value area across the whole window, on 0.71% of window volume, with 77.22% of everything traded at or above it. Thin, which is what makes it a boundary rather than a shelf." },
